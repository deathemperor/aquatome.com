{
  "sourceLanguage": "vi",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome memakai Bluetooth untuk menemukan dan mengendalikan lampu akuarium Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome menggunakan Bluetooth untuk mencari dan mengawal lampu akuarium anda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome ใช้บลูทูธเพื่อค้นหาและควบคุมโคมไฟตู้ปลาของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome dùng Bluetooth để tìm và điều khiển đèn bể cá của bạn."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome memakai kamera untuk memotret ikan yang ingin Anda kenali."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome menggunakan kamera untuk mengambil gambar ikan yang ingin anda kenal pasti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome ใช้กล้องเพื่อถ่ายรูปปลาที่คุณต้องการระบุชนิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome dùng máy ảnh để chụp con cá bạn muốn nhận diện."
          }
        }
      }
    }
  },
  "version": "1.0"
}
