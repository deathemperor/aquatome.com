          }
        }
      }
    },
    "Lịch đang lưu trên đèn, kể cả lịch đặt bằng ứng dụng My Chihiros, sẽ bị thay bằng lịch này. Ghi lịch?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal yang tersimpan di lampu, termasuk yang diatur lewat aplikasi My Chihiros, akan diganti dengan jadwal ini. Simpan jadwal?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadual yang disimpan pada lampu, termasuk jadual yang ditetapkan menggunakan aplikasi My Chihiros, akan digantikan dengan jadual ini. Simpan jadual?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเวลาที่เก็บอยู่ในโคมไฟ รวมถึงตารางเวลาที่ตั้งด้วยแอป My Chihiros จะถูกแทนที่ด้วยตารางเวลานี้ บันทึกตารางเวลาหรือไม่"
          }
        }
      }
    },
    "Lịch đã ghi cho đèn này": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal yang sudah disimpan untuk lampu ini"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadual yang disimpan untuk lampu ini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเวลาที่บันทึกให้โคมไฟนี้"
          }
        }
      }
    },
    "Lịch đặt bằng ứng dụng My Chihiros (nếu có) vẫn chạy; đèn không cho đọc lại lịch đó.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal yang diatur lewat aplikasi My Chihiros (jika ada) tetap berjalan; lampu tidak mengizinkan jadwal itu dibaca kembali."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadual yang ditetapkan menggunakan aplikasi My Chihiros (jika ada) masih berjalan; lampu tidak membenarkan jadual itu dibaca semula."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเวลาที่ตั้งด้วยแอป My Chihiros (ถ้ามี) ยังทำงานอยู่ แต่โคมไฟไม่อนุญาตให้อ่านตารางเวลานั้น"
          }
        }
      }
    },
