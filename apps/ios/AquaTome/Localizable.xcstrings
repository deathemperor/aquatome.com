          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการเปลี่ยนแปลง"
          }
        }
      }
    },
    "Hung dữ": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agresif"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดุร้าย"
          }
        }
      }
    },
    "Hôm nay bạn đã báo cáo nhiều lần. Hãy thử lại vào ngày mai.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah melapor berkali-kali hari ini. Coba lagi besok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้คุณรายงานหลายครั้งแล้ว ลองอีกครั้งพรุ่งนี้"
          }
        }
      }
    },
    "Hơi dữ": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agak agresif"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่อนข้างดุ"
          }
        }
      }
    },
    "Hướng dẫn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panduan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
