    "Xóa bể “%@” cùng %lld đèn đã lưu trên bể?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus akuarium “%1$@” beserta %2$lld lampu yang tersimpan di dalamnya?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam tangki “%@” bersama %lld lampu yang disimpan padanya?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบตู้ “%1$@” พร้อมไฟ %2$lld ดวงที่บันทึกไว้ในตู้นี้หรือไม่"
          }
        }
      }
    },
    "Xóa bể “%@”?": {
