          }
        }
      }
    },
    "1 giờ, tới %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1 jam, sampai %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1 jam, hingga %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ชั่วโมง ถึง %@"
          }
        }
      }
    },
    "1–2 tuần, kèm thay nước, vệ sinh.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1–2 minggu, disertai ganti air dan pembersihan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1–2 minggu, bersama tukar air dan pembersihan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1–2 สัปดาห์ ควบคู่กับการเปลี่ยนน้ำและทำความสะอาด"
          }
        }
      }
    },
    "2 giờ, tới %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "2 jam, sampai %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "2 jam, hingga %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "2 ชั่วโมง ถึง %@"
          }
        }
      }
    },
    "2–4 tuần đầu: ít giờ, đèn nhẹ để rêu khó bám.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "2–4 minggu pertama: jam nyala singkat, lampu redup agar lumut sulit tumbuh."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "2–4 minggu pertama: tempoh pencahayaan singkat dan lampu lembut supaya alga sukar melekat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "2–4 สัปดาห์แรก: เปิดไฟน้อยชั่วโมงและแสงอ่อน เพื่อไม่ให้ตะไคร่เกาะง่าย"
          }
        }
      }
    },
    "6–8 tiếng là vừa cho bể thủy sinh.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
