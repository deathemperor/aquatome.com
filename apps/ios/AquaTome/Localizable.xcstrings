            "state": "translated",
            "value": "เปลี่ยนชื่อโคมไฟแล้ว"
          }
        }
      }
    },
    "Đã đủ %lld loài chưa có trang trên bể này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium ini sudah punya %lld jenis tanpa halaman."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Had %lld spesies tanpa halaman bagi tangki ini sudah dicapai."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้นี้มีชนิดที่ยังไม่มีหน้าครบ %lld ชนิดแล้ว"
          }
        }
      }
    },
    "Đã đủ 50 bể: xóa bớt bể cũ để thêm.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah mencapai 50 akuarium: hapus akuarium lama untuk menambah yang baru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah cukup 50 tangki: padam tangki lama untuk menambah yang baharu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ครบ 50 ตู้แล้ว ลบตู้เก่าออกก่อนจึงจะเพิ่มได้"
          }
        }
      }
    },
    "Đã đủ 6 loài: bỏ bớt một loài để thêm.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah 6 spesies: hapus satu spesies untuk menambah yang lain."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah cukup 6 spesies: buang satu spesies untuk menambah yang lain."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ครบ 6 ชนิดแล้ว: นำออกหนึ่งชนิดก่อนจึงจะเพิ่มได้"
          }
        }
      }
    },
    "Đã ở bể này": {
      "localizations": {
