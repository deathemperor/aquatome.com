          }
        }
      }
    },
    "Gói dùng thử IoT Core của dự án đã hết hạn: gia hạn trong Tuya console (Cloud → Cloud Services → IoT Core) rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Uji coba IoT Core proyek sudah berakhir: perpanjang di konsol Tuya (Cloud → Cloud Services → IoT Core), lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelan percubaan IoT Core projek telah tamat tempoh: perbaharui dalam konsol Tuya (Cloud → Cloud Services → IoT Core), kemudian cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพ็กเกจทดลอง IoT Core ของโปรเจกต์หมดอายุแล้ว ต่ออายุในคอนโซล Tuya (Cloud → Cloud Services → IoT Core) แล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Gõ tên Việt hoặc tên khoa học": {
      "localizations": {
