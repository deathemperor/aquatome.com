      }
    },
    "Gửi ảnh": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim foto"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งรูปภาพ"
          }
        }
      }
    },
    "Gửi ảnh %@ của bạn": {
      "localizations": {
        "id": {
          "stringUnit": {
