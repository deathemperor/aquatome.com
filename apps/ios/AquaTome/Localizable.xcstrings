    "Claude không nhớ những gì ở trên": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude tidak ingat apa pun yang di atas"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude tidak ingat apa-apa yang di atas"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude จำสิ่งที่คุยด้านบนไม่ได้"
          }
        }
      }
    },
    "Claude (AI của Anthropic) trả lời theo cẩm nang AquaTome, chỗ nào cẩm nang chưa nói đến thì dùng kiến thức chung về nuôi cá.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude (AI dari Anthropic) menjawab berdasarkan panduan AquaTome. Di luar panduan, Claude memakai pengetahuan umum seputar ikan hias."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude (AI Anthropic) menjawab berdasarkan buku panduan AquaTome. Selebihnya, ia menggunakan pengetahuan am tentang ikan hiasan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude (AI ของ Anthropic) ตอบตามคู่มือ AquaTome ส่วนเรื่องที่คู่มือยังไม่ได้พูดถึง จะใช้ความรู้ทั่วไปเรื่องการเลี้ยงปลา"
          }
        }
      }
    },
    "Claude (AI của Anthropic) trả lời theo cẩm nang AquaTome, chỗ nào cẩm nang chưa nói đến thì dùng kiến thức chung về nuôi cá. AquaTome không gửi ảnh của bạn kèm câu hỏi.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude (AI dari Anthropic) menjawab berdasarkan panduan AquaTome. Di luar panduan, Claude memakai pengetahuan umum seputar ikan hias. AquaTome tidak mengirim foto Anda bersama pertanyaan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude (AI Anthropic) menjawab berdasarkan buku panduan AquaTome. Selebihnya, ia menggunakan pengetahuan am tentang ikan hiasan. AquaTome tidak menghantar foto anda bersama soalan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude (AI ของ Anthropic) ตอบตามคู่มือ AquaTome ส่วนเรื่องที่คู่มือยังไม่ได้พูดถึง จะใช้ความรู้ทั่วไปเรื่องการเลี้ยงปลา AquaTome ไม่ได้ส่งรูปของคุณไปพร้อมกับคำถาม"
          }
        }
      }
    },
    "Claude (AI) trả lời theo cẩm nang AquaTome.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude (AI) menjawab berdasarkan panduan AquaTome."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude (AI) menjawab berdasarkan buku panduan AquaTome."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude (AI) ตอบตามคู่มือ AquaTome"
          }
