            "value": "เลือกช่อง"
          }
        }
      }
    },
    "Chọn ổ cắm của đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih colokan lampu"
          }
        },
