    "Khóa Tuya": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci Tuya"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ Tuya"
          }
        }
      }
    },
    "Khóa chỉ được lưu khi đọc được danh sách: trong Keychain của máy này, không đồng bộ sang máy khác, không gửi cho AquaTome.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci hanya disimpan jika daftar berhasil dibaca: di Keychain perangkat ini, tidak disinkronkan ke perangkat lain, tidak dikirim ke AquaTome."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์จะถูกบันทึกเมื่ออ่านรายการได้เท่านั้น เก็บใน Keychain ของเครื่องนี้ ไม่ซิงค์ไปเครื่องอื่น และไม่ส่งให้ AquaTome"
          }
        }
      }
    },
    "Khóa của dự án": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci proyek"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ของโปรเจกต์"
          }
        }
      }
    },
    "Khóa đúng nhưng chưa lưu được trên máy này: thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci benar, tetapi belum bisa disimpan di perangkat ini: coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ถูกต้อง แต่ยังบันทึกในเครื่องนี้ไม่ได้ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Khóa đúng. %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci benar. %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ถูกต้อง %@"
          }
        }
      }
    },
    "Không": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่"
          }
        }
      }
    },
    "Không có loài nào khớp. Thử nới điều kiện lọc.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada spesies yang cocok. Coba longgarkan kriteria filter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบสายพันธุ์ที่ตรงกัน ลองผ่อนเงื่อนไขการกรอง"
          }
        }
      }
    },
    "Không có mạng hoặc Tuya không trả lời: thử lại khi có mạng.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada koneksi internet atau Tuya tidak menjawab: coba lagi saat sudah terhubung."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอินเทอร์เน็ตหรือ Tuya ไม่ตอบกลับ โปรดลองอีกครั้งเมื่อเชื่อมต่อได้"
          }
        }
      }
    },
    "Không có mạng. Kết nối rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada koneksi. Sambungkan lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอินเทอร์เน็ต เชื่อมต่อแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Không có mạng: thử lại khi có mạng.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada koneksi internet: coba lagi saat sudah terhubung."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอินเทอร์เน็ต โปรดลองอีกครั้งเมื่อเชื่อมต่อได้"
          }
        }
      }
    },
    "Không cần châm": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak perlu injeksi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องเติม"
          }
        }
      }
    },
    "Không gửi được báo cáo, vui lòng thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan tidak terkirim, silakan coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งรายงานไม่สำเร็จ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Không gửi được bình luận, vui lòng thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentar gagal dikirim, silakan coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งความคิดเห็นไม่สำเร็จ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Không gửi được lệnh tới đèn. Lại gần đèn rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah tidak terkirim ke lampu. Dekati lampu lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งคำสั่งไปยังโคมไฟไม่ได้ ขยับเข้าใกล้โคมไฟแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Không gửi được ảnh, vui lòng thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto gagal dikirim, silakan coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งรูปไม่สำเร็จ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Không kết nối được. Lại gần đèn, đóng ứng dụng My Chihiros trên các máy khác rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal terhubung. Dekati lampu, tutup aplikasi My Chihiros di perangkat lain, lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อไม่ได้ เข้าใกล้โคมไฟ ปิดแอป My Chihiros บนเครื่องอื่น แล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Không qua được kiểm tra chống spam, vui lòng thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal lolos pemeriksaan antispam, silakan coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ผ่านการตรวจสอบป้องกันสแปม โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Không rõ trạng thái": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status tidak diketahui"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ทราบสถานะ"
          }
        }
      }
    },
    "Không thấy %@ quanh đây. Bật đèn, lại gần rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak ditemukan di sekitar sini. Nyalakan lampu, mendekatlah, lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบ %@ ในบริเวณนี้ เปิดโคมไฟ ขยับเข้าใกล้แล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Không thấy trong dự án Tuya": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada di proyek Tuya"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบในโปรเจกต์ Tuya"
          }
        }
      }
    },
    "Không trải nền": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa substrat"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ปูพื้น"
          }
        }
      }
    },
    "Không tải được cẩm nang. Kiểm tra kết nối mạng rồi kéo xuống để thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panduan tidak dapat dimuat. Periksa koneksi internet, lalu tarik ke bawah untuk mencoba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดคู่มือไม่ได้ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ต แล้วดึงลงเพื่อลองอีกครั้ง"
          }
        }
      }
    },
    "Không tải được trang. Kiểm tra kết nối mạng.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman tidak dapat dimuat. Periksa koneksi internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดหน้านี้ไม่ได้ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ต"
          }
        }
      }
    },
    "Không xóa được khóa khỏi Keychain: thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci tidak bisa dihapus dari Keychain: coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบคีย์ออกจาก Keychain ไม่ได้ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Không đọc được các bể đã lưu trên máy này. Dữ liệu được giữ nguyên.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium yang tersimpan di perangkat ini tidak dapat dibaca. Datanya tetap utuh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านข้อมูลตู้ปลาที่บันทึกไว้ในเครื่องนี้ไม่ได้ ข้อมูลยังอยู่ครบ"
          }
        }
      }
    },
    "Không đọc được ảnh này. Hãy thử một ảnh JPEG hoặc PNG khác.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto ini tidak dapat dibaca. Coba foto JPEG atau PNG lain."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านภาพนี้ไม่ได้ โปรดลองใช้ภาพ JPEG หรือ PNG อื่น"
          }
        }
      }
    },
    "Không đổi được biểu tượng. Thử lại sau.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikon tidak bisa diganti. Coba lagi nanti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนไอคอนไม่ได้ ลองใหม่ภายหลัง"
          }
        }
      }
    },
