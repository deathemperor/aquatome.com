    "Giờ trên điện thoại lệch quá nhiều: chỉnh lại giờ rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam di ponsel terlalu meleset: atur ulang jam lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa pada telefon terlalu jauh berbeza: betulkan masa dan cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาในโทรศัพท์คลาดเคลื่อนมากเกินไป โปรดตั้งเวลาใหม่แล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Giờ tắt": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam mati"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa padam"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาปิด"
          }
        }
      }
    },
    "Giờ tắt phải sau giờ bật, trong cùng một ngày.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam mati harus setelah jam nyala, di hari yang sama."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa padam mesti selepas masa hidup, pada hari yang sama."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาปิดต้องอยู่หลังเวลาเปิด ภายในวันเดียวกัน"
          }
        }
      }
    },
    "Google chưa xác nhận được: thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Google belum bisa mengonfirmasi: coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Google belum dapat mengesahkan: cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Google ยังยืนยันไม่ได้ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Góc ¼ tròn": {
      "localizations": {
