            "value": "ตู้ปลา"
          }
        }
      }
    },
    "Bể cá, không trồng cây": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium ikan, tanpa tanaman"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ปลา ไม่ปลูกไม้น้ำ"
          }
        }
      }
    },
    "Bể của tôi": {
      "localizations": {
