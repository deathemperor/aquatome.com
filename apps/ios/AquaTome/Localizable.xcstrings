            "value": "%@ ลิตร"
          }
        }
      }
    },
    "%@ tiếng": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jam"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ชั่วโมง"
          }
        }
      }
    },
    "%lld bản ghi không hợp lệ nên chưa vào tài khoản.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld data tidak valid sehingga belum masuk ke akun."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มี %lld รายการที่ไม่ถูกต้อง จึงยังไม่ได้เพิ่มเข้าบัญชี"
          }
        }
      }
    },
    "%lld phút": {
      "localizations": {
