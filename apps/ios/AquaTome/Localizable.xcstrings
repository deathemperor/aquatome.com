            "state": "translated",
            "value": "ซิงค์ตอนนี้"
          }
        }
      }
    },
    "Đồng hồ đèn %@ %@: lịch sẽ chạy lệch.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam lampu %1$@ %2$@: jadwal akan bergeser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาของโคมไฟ%1$@ %2$@: ตารางเวลาจะคลาดเคลื่อน"
          }
        }
      }
    },
    "Đồng hồ đèn đúng giờ.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam lampu sudah tepat."
          }
        },
        "th": {
