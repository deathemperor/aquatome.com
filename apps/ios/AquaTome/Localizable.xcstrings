    "Nước thực tế sau khi trải nền, đặt đá lũa: khoảng **%@ lít** (%@ kg nước).": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume air sebenarnya setelah substrat, batu, dan kayu dipasang: sekitar **%@ liter** (%@ kg air)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
