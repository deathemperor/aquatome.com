    "Chữ nhật": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persegi panjang"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Segi empat tepat"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สี่เหลี่ยมผืนผ้า"
          }
