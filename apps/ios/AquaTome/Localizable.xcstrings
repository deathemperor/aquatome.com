            "state": "translated",
            "value": "Padam kunci"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบคีย์"
          }
        }
      }
    },
    "Xóa khóa Tuya trên máy này?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus kunci Tuya di perangkat ini?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam kunci Tuya pada peranti ini?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบคีย์ Tuya ในเครื่องนี้ไหม"
          }
        }
      }
    },
    "Xóa khóa không bật tắt ổ cắm nào: các ổ cắm trên bể vẫn còn, chỉ không bật tắt được cho tới khi nhập lại khóa.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus kunci tidak menyalakan atau mematikan stopkontak mana pun: stopkontak di akuarium tetap ada, hanya tidak bisa dinyalakan atau dimatikan sampai kunci dimasukkan lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadam kunci tidak menghidupkan atau mematikan mana-mana soket: soket pada tangki masih ada, cuma tidak boleh dihidupkan atau dimatikan sehingga kunci dimasukkan semula."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลบคีย์ไม่ได้เปิดหรือปิดปลั๊กไฟใด ๆ ปลั๊กไฟบนตู้ยังอยู่ เพียงแต่เปิดปิดไม่ได้จนกว่าจะใส่คีย์อีกครั้ง"
          }
        }
      }
    },
    "Xóa lọc": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus filter"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan tapisan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างตัวกรอง"
          }
        }
      }
    },
    "Xóa tài khoản": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus akun"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam akaun"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบัญชี"
          }
        }
      }
    },
    "Xóa tài khoản là xóa ngay tài khoản, các cách đăng nhập và mọi bể lưu trong tài khoản. Bể trên máy này vẫn còn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus akun berarti langsung menghapus akun, semua metode masuk, dan semua akuarium yang tersimpan di akun. Akuarium di perangkat ini tetap ada."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadam akaun akan terus memadam akaun, semua cara log masuk dan semua tangki yang disimpan dalam akaun. Tangki pada peranti ini masih kekal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลบบัญชีจะลบบัญชี วิธีเข้าสู่ระบบ และตู้ปลาทั้งหมดที่บันทึกไว้ในบัญชีทันที ส่วนตู้ปลาในอุปกรณ์นี้จะยังคงอยู่"
          }
        }
      }
    },
    "Xóa tài khoản vĩnh viễn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus akun secara permanen"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam akaun secara kekal"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบัญชีถาวร"
          }
        }
      }
    },
    "Xóa tất cả": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus semua"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam semua"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบทั้งหมด"
          }
        }
      }
    },
    "Xóa vĩnh viễn tài khoản và các bể trong tài khoản? Bể trên máy này vẫn còn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus akun dan semua akuarium di dalamnya secara permanen? Akuarium di perangkat ini tetap ada."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam akaun dan tangki di dalamnya secara kekal? Tangki pada peranti ini masih ada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบัญชีและตู้ปลาในบัญชีอย่างถาวรใช่ไหม ตู้ปลาในอุปกรณ์นี้จะยังคงอยู่"
          }
        }
      }
    },
