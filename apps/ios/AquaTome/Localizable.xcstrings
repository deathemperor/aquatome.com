          "stringUnit": {
            "state": "translated",
            "value": "Substrat"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วัสดุปูพื้น"
          }
        }
      }
    },
    "Nền khác": {
