          }
        }
      }
    },
    "Thử quá nhiều lần: đợi một lát rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak percobaan: tunggu sebentar lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองหลายครั้งเกินไป โปรดรอสักครู่แล้วลองใหม่"
          }
        }
      }
    },
    "Trong dự án: Devices → Link App Account → Add App Account. Mở Smart Life, bấm Tôi → biểu tượng quét ở góc trên, rồi quét mã QR trên màn hình.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di proyek: Devices → Link App Account → Add App Account. Buka Smart Life, ketuk Saya → ikon pindai di pojok atas, lalu pindai kode QR di layar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในโปรเจกต์: Devices → Link App Account → Add App Account เปิด Smart Life แตะ ฉัน → ไอคอนสแกนที่มุมบน แล้วสแกนคิวอาร์โค้ดบนหน้าจอ"
          }
        }
      }
    },
    "Trung Quốc (China)": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiongkok (China)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จีน (China)"
          }
        }
      }
    },
    "Trung tâm dữ liệu": {
