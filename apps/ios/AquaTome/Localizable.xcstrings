          "stringUnit": {
            "state": "translated",
            "value": "Mengirim perintah…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังส่งคำสั่ง…"
          }
        }
      }
    },
    "Đang kết nối lại…": {
      "localizations": {
