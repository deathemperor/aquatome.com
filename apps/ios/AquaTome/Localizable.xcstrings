          "stringUnit": {
            "state": "translated",
            "value": "กำลังเชื่อมต่อ…"
          }
        }
      }
    },
    "Đang tìm đèn…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari lampu…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังค้นหาโคมไฟ…"
          }
        }
      }
    },
    "Đang xem bản đã lưu (ngoại tuyến).": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melihat salinan tersimpan (offline)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังดูสำเนาที่บันทึกไว้ (ออฟไลน์)"
          }
        }
      }
    },
    "Đá nham thạch": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batu lava"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หินลาวา"
          }
        }
      }
    },
    "Đã chỉnh giờ đèn: %@.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam lampu sudah disamakan: %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเวลาโคมไฟแล้ว: %@"
          }
        }
      }
    },
    "Đã ghi lịch: bật %@, tắt %@. Đèn chạy theo lịch từ bây giờ.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal tersimpan: nyala %1$@, mati %2$@. Lampu mulai mengikuti jadwal sekarang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกตารางแล้ว: เปิด %1$@ ปิด %2$@ โคมไฟจะทำงานตามตารางตั้งแต่ตอนนี้"
          }
        }
      }
    },
    "Đã kết nối %@ (%@), firmware %lld.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung ke %1$@ (%2$@), firmware %3$lld."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ %1$@ (%2$@) แล้ว firmware %3$lld"
          }
        }
      }
    },
    "Đã kết nối %@ (%@), firmware %lld: bản này chưa hẹn giờ được từ ứng dụng, cập nhật firmware bằng ứng dụng My Chihiros.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung ke %1$@ (%2$@), firmware %3$lld: versi ini belum bisa diatur timernya dari aplikasi, perbarui firmware lewat aplikasi My Chihiros."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ %1$@ (%2$@) แล้ว firmware %3$lld: เวอร์ชันนี้ยังตั้งเวลาจากแอปไม่ได้ ให้อัปเดต firmware ด้วยแอป My Chihiros"
          }
        }
      }
    },
    "Đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟ"
          }
        }
      }
    },
    "Đèn %@ chưa được hỗ trợ.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu %@ belum didukung."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่รองรับโคมไฟ %@"
          }
        }
      }
    },
    "Đèn Chihiros": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu Chihiros"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟ Chihiros"
          }
        }
      }
    },
    "Đèn chưa báo lại lịch mới. Kiểm tra lại sau ít phút.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu belum melaporkan jadwal baru. Periksa lagi beberapa menit lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟยังไม่รายงานตารางใหม่ ตรวจสอบอีกครั้งในอีกสักครู่"
          }
        }
      }
    },
    "Đèn không trả lời. Ngắt kết nối rồi kết nối lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu tidak merespons. Putuskan koneksi lalu hubungkan lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟไม่ตอบสนอง ตัดการเชื่อมต่อแล้วเชื่อมต่อใหม่"
          }
        }
      }
    },
    "Đèn sáng %@ tiếng mỗi ngày.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu menyala %@ jam per hari."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟเปิด %@ ชั่วโมงต่อวัน"
          }
        }
      }
    },
    "Đèn tìm thấy": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu yang ditemukan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟที่พบ"
          }
        }
      }
    },
    "Đèn đã ngắt kết nối.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi lampu terputus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟตัดการเชื่อมต่อแล้ว"
          }
        }
      }
    },
    "Đỏ": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merah"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แดง"
          }
        }
      }
    },
    "Đồng hồ trong đèn chưa được đặt, thường do mất điện. Đèn sẽ bật tắt sai giờ cho tới khi chỉnh lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam di lampu belum diatur, biasanya karena listrik padam. Lampu akan menyala dan mati di jam yang salah sampai jamnya disamakan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาในโคมไฟยังไม่ได้ตั้ง มักเกิดจากไฟดับ โคมไฟจะเปิดปิดผิดเวลาจนกว่าจะตั้งใหม่"
          }
        }
      }
    },
    "Đồng hồ trong đèn lệch %lld phút so với điện thoại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam di lampu selisih %lld menit dari ponsel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาในโคมไฟคลาดจากโทรศัพท์ %lld นาที"
          }
        }
      }
    }
  },
  "version": "1.0"
}
