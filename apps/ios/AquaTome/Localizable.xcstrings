            "value": "Buka blokir %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลิกบล็อก %@"
          }
        }
      }
    },
    "Bỏ lưu": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batal simpan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลิกบันทึก"
          }
        }
      }
    },
    "CO2": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "CO2"
          }
        },
        "th": {
