            "state": "translated",
            "value": "Access Secret"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Access Secret"
          }
        }
      }
    },
    "Apple chưa xác nhận được: thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple belum bisa mengonfirmasi: coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ยังยืนยันไม่ได้ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "AquaTome bật tắt ổ cắm Smart Life (Tuya) bằng dự án đám mây Tuya của chính bạn: ứng dụng gọi thẳng Tuya, không qua máy chủ AquaTome và không cần tài khoản AquaTome.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome menyalakan dan mematikan stopkontak Smart Life (Tuya) dengan proyek cloud Tuya milik Anda sendiri: aplikasi langsung menghubungi Tuya, tidak lewat server AquaTome, dan tidak perlu akun AquaTome."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome เปิดปิดปลั๊กไฟ Smart Life (Tuya) ผ่านโปรเจกต์คลาวด์ Tuya ของคุณเอง แอปเชื่อมต่อกับ Tuya โดยตรง ไม่ผ่านเซิร์ฟเวอร์ของ AquaTome และไม่ต้องมีบัญชี AquaTome"
          }
        }
      }
    },
    "AquaTome chưa được dùng Bluetooth. Bật trong Cài đặt → AquaTome → Bluetooth.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome belum diizinkan memakai Bluetooth. Aktifkan di Pengaturan → AquaTome → Bluetooth."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome ยังไม่ได้รับอนุญาตให้ใช้บลูทูธ เปิดได้ที่ การตั้งค่า → AquaTome → บลูทูธ"
          }
        }
      }
    },
    "AquaTome không liên quan tới hãng Chihiros. Các lệnh Bluetooth theo ghi chép mã nguồn mở [chihiros-led-control](https://github.com/TheMicDiet/chihiros-led-control) (giấy phép MIT).": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome tidak berafiliasi dengan Chihiros. Perintah Bluetooth mengikuti dokumentasi sumber terbuka [chihiros-led-control](https://github.com/TheMicDiet/chihiros-led-control) (lisensi MIT)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome ไม่มีส่วนเกี่ยวข้องกับบริษัท Chihiros คำสั่ง Bluetooth อ้างอิงตามบันทึกโอเพนซอร์ส [chihiros-led-control](https://github.com/TheMicDiet/chihiros-led-control) (สัญญาอนุญาต MIT)"
          }
        }
      }
    },
    "Bluetooth đang tắt. Bật Bluetooth rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth mati. Nyalakan Bluetooth lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บลูทูธปิดอยู่ เปิดบลูทูธแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Bấm vào tên để đổi": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk nama untuk mengubah"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะที่ชื่อเพื่อเปลี่ยน"
          }
        }
      }
    },
    "Bật": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด"
          }
        }
      }
    },
    "Bật Bluetooth, đứng gần đèn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan Bluetooth, berdirilah di dekat lampu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Bluetooth และอยู่ใกล้โคมไฟ"
          }
        }
      }
    },
    "Bật gói dùng thử IoT Core (Cloud → Cloud Services → IoT Core). Gói miễn phí phải gia hạn trong console khoảng mỗi tháng: hết hạn thì AquaTome không bật tắt được, còn hẹn giờ trên ổ cắm vẫn chạy.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan uji coba IoT Core (Cloud → Cloud Services → IoT Core). Paket gratis ini harus diperpanjang di konsol kira-kira setiap bulan: jika habis, AquaTome tidak bisa menyalakan atau mematikan, tetapi timer di stopkontak tetap berjalan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้แพ็กเกจทดลอง IoT Core (Cloud → Cloud Services → IoT Core) แพ็กเกจฟรีนี้ต้องต่ออายุในคอนโซลประมาณทุกเดือน หากหมดอายุ AquaTome จะเปิดปิดไม่ได้ แต่ตัวตั้งเวลาบนปลั๊กไฟยังทำงานอยู่"
          }
        }
      }
    },
    "Bật lúc": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyala pukul"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเวลา"
          }
        }
      }
    },
    "Bật tắt nhanh": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyala/mati cepat"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด/ปิดด่วน"
          }
        }
      }
    },
    "Bật tắt ổ cắm Smart Life ngay trên bể, bằng dự án Tuya của riêng bạn: không cần tài khoản AquaTome.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan dan matikan stopkontak Smart Life langsung dari akuarium, dengan proyek Tuya milik Anda sendiri: tidak perlu akun AquaTome."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดปิดปลั๊กไฟ Smart Life ได้จากหน้าตู้ ด้วยโปรเจกต์ Tuya ของคุณเอง ไม่ต้องมีบัญชี AquaTome"
          }
        }
      }
    },
    "Bật “%@”?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan “%@”?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด “%@” ไหม"
          }
        }
      }
    },
    "Bể": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ปลา"
          }
        }
      }
    },
    "Bể của tôi": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium saya"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ของฉัน"
          }
        }
      }
    },
    "Bể mới": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium baru"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ใหม่"
          }
        }
      }
    },
    "Bể mới trồng": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium baru ditanam"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ไม้น้ำเพิ่งปลูก"
          }
        }
      }
    },
    "Bể này đã bị xóa.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium ini sudah dihapus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้นี้ถูกลบแล้ว"
          }
        }
      }
    },
    "Bể đang bị rêu": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium sedang terkena alga"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ที่มีตะไคร่"
          }
        }
      }
    },
    "Bể đã ổn định": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium sudah stabil"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ที่เซ็ตตัวแล้ว"
          }
        }
      }
    },
    "CO2": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "CO2"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "CO2"
          }
        }
      }
    },
    "Cao": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinggi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูง"
          }
        }
      }
    },
    "Chính sách bảo mật": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebijakan privasi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นโยบายความเป็นส่วนตัว"
          }
        }
      }
    },
    "Chưa chọn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dipilih"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้เลือก"
          }
        }
      }
    },
    "Chưa có bể nào": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada akuarium"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีตู้ปลา"
          }
        }
      }
    },
    "Chưa có kích thước.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada ukuran."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีขนาด"
          }
        }
      }
    },
    "Chưa ghi lịch nào từ AquaTome.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada jadwal yang disimpan dari AquaTome."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้บันทึกตารางเวลาใดจาก AquaTome"
          }
        }
      }
    },
    "Chưa ghi ổ này cắm gì: nếu là sưởi hay CO2, bật tắt nhầm có thể hại cá. Chọn “Cắm gì” trong Sửa để khỏi hỏi lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dicatat colokan ini dipakai untuk apa: kalau untuk pemanas atau CO2, salah menyalakan atau mematikannya bisa membahayakan ikan. Pilih “Dipakai untuk” di Edit agar tidak ditanya lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ระบุว่าช่องนี้ใช้กับอะไร หากเป็นฮีตเตอร์หรือ CO2 การเปิดหรือปิดผิดอาจเป็นอันตรายต่อปลา เลือก “ใช้กับอะไร” ในแก้ไขเพื่อไม่ต้องถามอีก"
          }
        }
      }
    },
    "Chưa gửi lệnh: %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah belum dikirim: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ส่งคำสั่ง: %@"
          }
        }
      }
    },
    "Chưa kết nối được đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum bisa terhubung ke lampu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังเชื่อมต่อโคมไฟไม่ได้"
          }
        }
      }
    },
    "Chưa lưu lịch nào cho đèn này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada jadwal tersimpan untuk lampu ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้บันทึกตารางเวลาสำหรับไฟนี้"
          }
        }
      }
    },
    "Chưa lưu được thay đổi. Thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan belum tersimpan. Coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังบันทึกการเปลี่ยนแปลงไม่สำเร็จ ลองอีกครั้ง"
          }
        }
      }
    },
    "Chưa xác nhận: ổ cắm chưa báo đã đổi.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum terkonfirmasi: stopkontak belum melaporkan perubahan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ยืนยัน: ปลั๊กไฟยังไม่รายงานว่าเปลี่ยนแล้ว"
          }
        }
      }
    },
    "Chưa xóa: cần đăng nhập lại bằng Apple để xác nhận.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dihapus: masuk lagi dengan Apple untuk mengonfirmasi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ลบ ต้องเข้าสู่ระบบด้วย Apple อีกครั้งเพื่อยืนยัน"
          }
        }
      }
    },
    "Chưa đọc được giờ của đèn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam lampu belum bisa dibaca."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังอ่านเวลาของโคมไฟไม่ได้"
          }
        }
      }
    },
    "Chưa đồng bộ được: không có mạng. Các thay đổi vẫn lưu trên máy này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum bisa disinkronkan: tidak ada koneksi internet. Perubahan tetap tersimpan di perangkat ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซิงค์ไม่สำเร็จเนื่องจากไม่มีอินเทอร์เน็ต การเปลี่ยนแปลงยังบันทึกอยู่ในเครื่องนี้"
          }
        }
      }
    },
    "Chỉ dùng cho thiết bị của riêng bạn: gói miễn phí của Tuya không dành cho việc dùng thương mại. Ổ cắm eWeLink (Sonoff) sẽ có sau.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk perangkat milik Anda sendiri: paket gratis Tuya tidak untuk penggunaan komersial. Stopkontak eWeLink (Sonoff) menyusul."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กับอุปกรณ์ของคุณเองเท่านั้น แพ็กเกจฟรีของ Tuya ไม่ได้มีไว้สำหรับใช้เชิงพาณิชย์ ปลั๊กไฟ eWeLink (Sonoff) จะตามมาภายหลัง"
          }
        }
      }
    },
    "Chỉ dùng để nhận ra bạn khi đăng nhập: không lưu tên, email hay số điện thoại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya dipakai untuk mengenali Anda saat masuk: nama, email, atau nomor telepon tidak disimpan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เพื่อระบุตัวคุณเมื่อเข้าสู่ระบบเท่านั้น โดยไม่เก็บชื่อ อีเมล หรือหมายเลขโทรศัพท์"
          }
        }
      }
    },
    "Chỉnh giờ đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur jam lampu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเวลาโคมไฟ"
          }
        }
      }
    },
    "Chỉnh giờ đèn theo máy này": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Samakan jam lampu dengan perangkat ini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเวลาโคมไฟตามเครื่องนี้"
          }
        }
      }
    },
    "Chỉnh tay": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur manual"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับเอง"
          }
        }
      }
    },
    "Chọn lịch và màu": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jadwal dan warna"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกตารางเวลาและสี"
          }
        }
      }
    },
    "Chọn một mẫu hoặc tự nhập. Đèn tự bật tắt theo đồng hồ của nó, không cần điện thoại ở gần.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih templat atau isi sendiri. Lampu akan menyala dan mati sendiri sesuai jam internalnya, tanpa perlu ponsel di dekatnya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกตารางสำเร็จรูปหรือกรอกเอง โคมไฟจะเปิดปิดเองตามนาฬิกาในตัว โดยไม่ต้องมีโทรศัพท์อยู่ใกล้"
          }
        }
      }
    },
    "Cloud → Development → Create Cloud Project: Industry “Smart Home”, Development Method “Smart Home”, Data Center cùng vùng với tài khoản Smart Life của bạn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud → Development → Create Cloud Project: Industry “Smart Home”, Development Method “Smart Home”, Data Center di wilayah yang sama dengan akun Smart Life Anda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud → Development → Create Cloud Project: Industry “Smart Home”, Development Method “Smart Home” และ Data Center ภูมิภาคเดียวกับบัญชี Smart Life ของคุณ"
          }
        }
      }
    },
    "Cài đèn mới": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur lampu baru"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่าโคมไฟใหม่"
          }
        }
      }
    },
    "Cá và tép": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikan dan udang"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลาและกุ้ง"
          }
        }
      }
    },
    "Các bước, làm một lần trên máy tính": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langkah-langkah, sekali saja di komputer"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขั้นตอน ทำครั้งเดียวบนคอมพิวเตอร์"
          }
        }
      }
    },
    "Các bể lưu trên máy này và trong tài khoản của bạn trên máy chủ AquaTome (Cloudflare), để các thiết bị đã đăng nhập cùng thấy.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium disimpan di perangkat ini dan di akun Anda di server AquaTome (Cloudflare), agar terlihat di semua perangkat yang sudah masuk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ปลาจะถูกบันทึกไว้ในอุปกรณ์นี้และในบัญชีของคุณบนเซิร์ฟเวอร์ AquaTome (Cloudflare) เพื่อให้ทุกอุปกรณ์ที่เข้าสู่ระบบเห็นข้อมูลเดียวกัน"
          }
        }
      }
    },
    "Các bể lưu trên máy này, không cần tài khoản.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium tersimpan di perangkat ini, tanpa perlu akun."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ปลาบันทึกไว้ในเครื่องนี้ ไม่ต้องมีบัญชี"
          }
        }
      }
    },
    "Các bể trên máy này được lưu bằng bản ứng dụng mới hơn. Cập nhật AquaTome để xem và sửa.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium di perangkat ini disimpan oleh versi aplikasi yang lebih baru. Perbarui AquaTome untuk melihat dan mengubahnya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ปลาในเครื่องนี้บันทึกด้วยแอปเวอร์ชันที่ใหม่กว่า อัปเดต AquaTome เพื่อดูและแก้ไข"
          }
        }
      }
    },
    "Các ổ cắm trong dự án Tuya của bạn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopkontak di proyek Tuya Anda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลั๊กไฟในโปรเจกต์ Tuya ของคุณ"
          }
        }
      }
    },
    "Cách đăng nhập này đã thuộc một tài khoản khác.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Metode masuk ini sudah terhubung ke akun lain."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิธีเข้าสู่ระบบนี้ผูกกับบัญชีอื่นอยู่แล้ว"
          }
        }
      }
    },
    "Cát": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasir"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทราย"
          }
        }
      }
    },
    "Cây": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanaman"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม้น้ำ"
          }
        }
      }
    },
    "Có lỗi, chưa làm được: thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan, belum berhasil: coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาด ดำเนินการไม่สำเร็จ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Công cụ": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องมือ"
          }
        }
      }
    },
    "Cắm gì": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipakai untuk"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กับอะไร"
          }
        }
      }
    },
    "Cắm điện, bật đèn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Colokkan listrik, nyalakan lampu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียบปลั๊กและเปิดโคมไฟ"
          }
        }
      }
    },
    "Dài": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panjang"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยาว"
          }
        }
      }
    },
    "Dự án Tuya chưa có thiết bị nào: liên kết tài khoản Smart Life bằng mã QR (bước 4 trong phần thiết lập).": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek Tuya belum punya perangkat: tautkan akun Smart Life dengan kode QR (langkah 4 di pengaturan)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรเจกต์ Tuya ยังไม่มีอุปกรณ์ เชื่อมบัญชี Smart Life ด้วยคิวอาร์โค้ด (ขั้นตอนที่ 4 ในการตั้งค่า)"
          }
        }
      }
    },
    "Dự án Tuya có %lld thiết bị nhưng không có ổ cắm nào.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek Tuya punya %lld perangkat, tetapi tidak ada stopkontak."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรเจกต์ Tuya มีอุปกรณ์ %lld เครื่อง แต่ไม่มีปลั๊กไฟ"
          }
        }
      }
    },
    "Dự án chưa bật IoT Core: bật gói dùng thử ở Cloud → Cloud Services → IoT Core.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek belum mengaktifkan IoT Core: aktifkan uji cobanya di Cloud → Cloud Services → IoT Core."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรเจกต์ยังไม่ได้เปิด IoT Core เปิดแพ็กเกจทดลองที่ Cloud → Cloud Services → IoT Core"
          }
        }
      }
    },
    "Dự án đã dùng hết lượt gọi Tuya của gói lúc này: thử lại sau.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek sudah menghabiskan jatah panggilan Tuya untuk saat ini: coba lagi nanti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรเจกต์ใช้โควตาการเรียก Tuya ของแพ็กเกจหมดแล้วในตอนนี้ โปรดลองใหม่ภายหลัง"
          }
        }
      }
    },
    "Firmware của đèn chưa hẹn giờ được từ ứng dụng. Cập nhật firmware bằng ứng dụng My Chihiros.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware lampu ini belum bisa diatur timernya dari aplikasi. Perbarui firmware lewat aplikasi My Chihiros."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฟิร์มแวร์ของโคมไฟนี้ยังตั้งเวลาจากแอปไม่ได้ ให้อัปเดตเฟิร์มแวร์ด้วยแอป My Chihiros"
          }
        }
      }
    },
    "Ghi chú": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมายเหตุ"
          }
        }
      }
    },
    "Ghi lịch": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan jadwal"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกตาราง"
          }
        }
      }
    },
    "Ghi lịch mới sẽ xóa các lịch đang lưu trên đèn, kể cả lịch đặt bằng ứng dụng My Chihiros, và chỉnh giờ đèn theo máy này. Giờ tắt phải trong cùng ngày (muộn nhất 00:00). Cần đèn có firmware từ bản 20.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan jadwal baru akan menghapus jadwal yang tersimpan di lampu, termasuk jadwal yang diatur lewat aplikasi My Chihiros, dan menyamakan jam lampu dengan perangkat ini. Jam mati harus di hari yang sama (paling lambat 00:00). Lampu harus memakai firmware versi 20 ke atas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกตารางใหม่จะลบตารางที่บันทึกไว้ในโคมไฟ รวมถึงตารางที่ตั้งด้วยแอป My Chihiros และจะตั้งเวลาโคมไฟตามเครื่องนี้ เวลาปิดต้องอยู่ในวันเดียวกัน (ช้าสุด 00:00) โคมไฟต้องมี firmware เวอร์ชัน 20 ขึ้นไป"
          }
        }
      }
    },
    "Ghi lịch vào đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan jadwal ke lampu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกตารางลงโคมไฟ"
          }
        }
      }
    },
    "Ghi từ AquaTome ngày %@.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan dari AquaTome pada %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกจาก AquaTome เมื่อ %@"
          }
        }
      }
    },
    "Giờ trên điện thoại lệch quá nhiều: chỉnh lại giờ rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam di ponsel terlalu meleset: atur ulang jam lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาในโทรศัพท์คลาดเคลื่อนมากเกินไป โปรดตั้งเวลาใหม่แล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Giờ tắt phải sau giờ bật, trong cùng một ngày.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam mati harus setelah jam nyala, di hari yang sama."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาปิดต้องอยู่หลังเวลาเปิด ภายในวันเดียวกัน"
          }
        }
      }
    },
    "Gói dùng thử IoT Core của dự án đã hết hạn: gia hạn trong Tuya console (Cloud → Cloud Services → IoT Core) rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Uji coba IoT Core proyek sudah berakhir: perpanjang di konsol Tuya (Cloud → Cloud Services → IoT Core), lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพ็กเกจทดลอง IoT Core ของโปรเจกต์หมดอายุแล้ว ต่ออายุในคอนโซล Tuya (Cloud → Cloud Services → IoT Core) แล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Gỡ khỏi bể": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepas dari akuarium"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำออกจากตู้"
          }
        }
      }
    },
    "Gỡ khỏi bể không bật tắt gì: ổ cắm vẫn chạy như cũ và vẫn ở trong Smart Life.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melepas dari akuarium tidak menyalakan atau mematikan apa pun: stopkontak tetap berjalan seperti biasa dan tetap ada di Smart Life."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนำออกจากตู้ไม่ได้เปิดหรือปิดอะไร ปลั๊กไฟยังทำงานเหมือนเดิมและยังอยู่ใน Smart Life"
          }
        }
      }
    },
    "Gỡ “%@” khỏi bể?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepas “%@” dari akuarium?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำ “%@” ออกจากตู้ไหม"
          }
        }
      }
    },
    "Hoàn tác": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการเปลี่ยนแปลง"
          }
        }
      }
    },
    "Hướng dẫn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panduan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คู่มือ"
          }
        }
      }
    },
    "Hẹn giờ bật tắt mỗi ngày": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer nyala-mati harian"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเวลาเปิดปิดทุกวัน"
          }
        }
      }
    },
    "Hỗ trợ các đèn Bluetooth có tên bắt đầu bằng DY: %@.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mendukung lampu Bluetooth yang namanya diawali DY: %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รองรับโคมไฟบลูทูธที่ชื่อขึ้นต้นด้วย DY: %@"
          }
        }
      }
    },
    "Hủy": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batal"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิก"
          }
        }
      }
    },
    "Khác": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lainnya"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อื่น ๆ"
          }
        }
      }
    },
    "Khóa Tuya": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci Tuya"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ Tuya"
          }
        }
      }
    },
    "Khóa chỉ được lưu khi đọc được danh sách: trong Keychain của máy này, không đồng bộ sang máy khác, không gửi cho AquaTome.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci hanya disimpan jika daftar berhasil dibaca: di Keychain perangkat ini, tidak disinkronkan ke perangkat lain, tidak dikirim ke AquaTome."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์จะถูกบันทึกเมื่ออ่านรายการได้เท่านั้น เก็บใน Keychain ของเครื่องนี้ ไม่ซิงค์ไปเครื่องอื่น และไม่ส่งให้ AquaTome"
          }
        }
      }
    },
    "Khóa của dự án": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci proyek"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ของโปรเจกต์"
          }
        }
      }
    },
    "Khóa đúng nhưng chưa lưu được trên máy này: thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci benar, tetapi belum bisa disimpan di perangkat ini: coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ถูกต้อง แต่ยังบันทึกในเครื่องนี้ไม่ได้ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Khóa đúng. %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci benar. %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ถูกต้อง %@"
          }
        }
      }
    },
    "Không có mạng hoặc Tuya không trả lời: thử lại khi có mạng.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada koneksi internet atau Tuya tidak menjawab: coba lagi saat sudah terhubung."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอินเทอร์เน็ตหรือ Tuya ไม่ตอบกลับ โปรดลองอีกครั้งเมื่อเชื่อมต่อได้"
          }
        }
      }
    },
    "Không có mạng: thử lại khi có mạng.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada koneksi internet: coba lagi saat sudah terhubung."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอินเทอร์เน็ต โปรดลองอีกครั้งเมื่อเชื่อมต่อได้"
          }
        }
      }
    },
    "Không gửi được lệnh tới đèn. Lại gần đèn rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah tidak terkirim ke lampu. Dekati lampu lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งคำสั่งไปยังโคมไฟไม่ได้ ขยับเข้าใกล้โคมไฟแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Không kết nối được. Lại gần đèn, đóng ứng dụng My Chihiros trên các máy khác rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal terhubung. Dekati lampu, tutup aplikasi My Chihiros di perangkat lain, lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อไม่ได้ เข้าใกล้โคมไฟ ปิดแอป My Chihiros บนเครื่องอื่น แล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Không rõ trạng thái": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status tidak diketahui"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ทราบสถานะ"
          }
        }
      }
    },
    "Không thấy %@ quanh đây. Bật đèn, lại gần rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak ditemukan di sekitar sini. Nyalakan lampu, mendekatlah, lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบ %@ ในบริเวณนี้ เปิดโคมไฟ ขยับเข้าใกล้แล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Không thấy trong dự án Tuya": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada di proyek Tuya"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบในโปรเจกต์ Tuya"
          }
        }
      }
    },
    "Không trải nền": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa substrat"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ปูพื้น"
          }
        }
      }
    },
    "Không tải được cẩm nang. Kiểm tra kết nối mạng rồi kéo xuống để thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panduan tidak dapat dimuat. Periksa koneksi internet, lalu tarik ke bawah untuk mencoba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดคู่มือไม่ได้ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ต แล้วดึงลงเพื่อลองอีกครั้ง"
          }
        }
      }
    },
    "Không tải được trang. Kiểm tra kết nối mạng.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman tidak dapat dimuat. Periksa koneksi internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดหน้านี้ไม่ได้ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ต"
          }
        }
      }
    },
    "Không xóa được khóa khỏi Keychain: thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci tidak bisa dihapus dari Keychain: coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบคีย์ออกจาก Keychain ไม่ได้ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Không đọc được các bể đã lưu trên máy này. Dữ liệu được giữ nguyên.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium yang tersimpan di perangkat ini tidak dapat dibaca. Datanya tetap utuh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านข้อมูลตู้ปลาที่บันทึกไว้ในเครื่องนี้ไม่ได้ ข้อมูลยังอยู่ครบ"
          }
        }
      }
    },
    "Kiểm tra": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบ"
          }
        }
      }
    },
    "Kéo để đổi độ sáng ngay. Đèn bỏ qua lịch cho tới khi bấm “Theo lịch” hoặc ghi lịch mới.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser untuk mengubah kecerahan sekarang. Lampu mengabaikan jadwal sampai Anda mengetuk “Sesuai jadwal” atau menyimpan jadwal baru."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากเพื่อเปลี่ยนความสว่างทันที โคมไฟจะไม่ทำงานตามตารางเวลาจนกว่าจะกด “ตามตารางเวลา” หรือบันทึกตารางเวลาใหม่"
          }
        }
      }
    },
    "Kích thước lòng bể (cm)": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran dalam akuarium (cm)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขนาดภายในตู้ (cm)"
          }
        }
      }
    },
    "Kết nối": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ"
          }
        }
      }
    },
    "Kết nối lại": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan ulang"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่ออีกครั้ง"
          }
        }
      }
    },
    "Kết nối đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan lampu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อโคมไฟ"
          }
        }
      }
    },
    "Kết nối đèn của bạn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan lampu Anda"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อโคมไฟของคุณ"
          }
        }
      }
    },
    "Kết nối đèn khác": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan lampu lain"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อโคมไฟอื่น"
          }
        }
      }
    },
    "Kết nối đèn để ghi lịch. Lịch này được nhớ trên máy.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan lampu untuk menyimpan jadwal. Jadwal ini diingat di perangkat ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อโคมไฟเพื่อบันทึกตารางเวลา ตารางเวลานี้จะถูกจำไว้บนเครื่อง"
          }
        }
      }
    },
    "Loài cá": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesies ikan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สายพันธุ์ปลา"
          }
        }
      }
    },
    "Loại": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jenis"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประเภท"
          }
        }
      }
    },
    "Lưu": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึก"
          }
        }
      }
    },
    "Lưu bể": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan akuarium"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกตู้"
          }
        }
      }
    },
    "Lịch %@, sáng dần %lld phút": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal %1$@, terang bertahap %2$lld menit"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเวลา %1$@ ค่อยๆ สว่างขึ้น %2$lld นาที"
          }
        }
      }
    },
    "Lịch thay nước, phân bón, CO₂…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal ganti air, pupuk, CO₂…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเปลี่ยนน้ำ ปุ๋ย CO₂…"
          }
        }
      }
    },
    "Lịch đang lưu trên đèn, kể cả lịch đặt bằng ứng dụng My Chihiros, sẽ bị thay bằng lịch này. Ghi lịch?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal yang tersimpan di lampu, termasuk yang diatur lewat aplikasi My Chihiros, akan diganti dengan jadwal ini. Simpan jadwal?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเวลาที่เก็บอยู่ในโคมไฟ รวมถึงตารางเวลาที่ตั้งด้วยแอป My Chihiros จะถูกแทนที่ด้วยตารางเวลานี้ บันทึกตารางเวลาหรือไม่"
          }
        }
      }
    },
    "Lịch đặt bằng ứng dụng My Chihiros (nếu có) vẫn chạy; đèn không cho đọc lại lịch đó.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal yang diatur lewat aplikasi My Chihiros (jika ada) tetap berjalan; lampu tidak mengizinkan jadwal itu dibaca kembali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเวลาที่ตั้งด้วยแอป My Chihiros (ถ้ามี) ยังทำงานอยู่ แต่โคมไฟไม่อนุญาตให้อ่านตารางเวลานั้น"
          }
        }
      }
    },
    "Lọc": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอง"
          }
        }
      }
    },
    "Muốn xem các bể này trên aquatome.com hoặc trên máy khác? Đăng nhập để đồng bộ. Không bắt buộc: không đăng nhập thì bể vẫn lưu trên máy này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingin melihat akuarium ini di aquatome.com atau di perangkat lain? Masuk untuk menyinkronkan. Tidak wajib: tanpa masuk, akuarium tetap tersimpan di perangkat ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องการดูตู้ปลาเหล่านี้บน aquatome.com หรือบนอุปกรณ์อื่นใช่ไหม เข้าสู่ระบบเพื่อซิงค์ข้อมูล ไม่บังคับ หากไม่เข้าสู่ระบบ ตู้ปลาจะยังคงบันทึกอยู่ในอุปกรณ์นี้"
          }
        }
      }
    },
    "Máy này không có Bluetooth.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini tidak punya Bluetooth."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องนี้ไม่มีบลูทูธ"
          }
        }
      }
    },
    "Mất kết nối": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi terputus"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขาดการเชื่อมต่อ"
          }
        }
      }
    },
    "Mất kết nối với %@": {
      "localizations": {
        "id": {
