      }
    },
    "Chỉnh từng màu": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur tiap warna"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับทีละสี"
          }
        }
      }
    },
    "Chọn kiểu bể để có lịch gợi ý, rồi kéo giờ bật, giờ tắt trên thanh ngày. Đèn tự bật tắt theo đồng hồ của nó, không cần điện thoại ở gần.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jenis akuarium untuk mendapat jadwal yang disarankan, lalu geser jam nyala dan jam mati pada bilah hari. Lampu menyala dan mati sendiri sesuai jam internalnya, tanpa perlu ponsel di dekatnya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกประเภทตู้เพื่อรับตารางเวลาแนะนำ แล้วลากเวลาเปิดและเวลาปิดบนแถบวัน โคมไฟจะเปิดปิดเองตามนาฬิกาในตัว ไม่ต้องมีโทรศัพท์อยู่ใกล้"
          }
        }
      }
    },
    "Chọn lịch và màu": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jadwal dan warna"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกตารางเวลาและสี"
          }
        }
      }
    },
    "Chọn một ảnh trước đã.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih gambar terlebih dahulu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรุณาเลือกภาพก่อน"
          }
        }
      }
    },
    "Cloud → Development → Create Cloud Project: Industry “Smart Home”, Development Method “Smart Home”, Data Center cùng vùng với tài khoản Smart Life của bạn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud → Development → Create Cloud Project: Industry “Smart Home”, Development Method “Smart Home”, Data Center di wilayah yang sama dengan akun Smart Life Anda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud → Development → Create Cloud Project: Industry “Smart Home”, Development Method “Smart Home” และ Data Center ภูมิภาคเดียวกับบัญชี Smart Life ของคุณ"
          }
        }
      }
    },
