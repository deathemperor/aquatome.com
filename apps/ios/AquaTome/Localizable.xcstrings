          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเวลาโคมไฟแล้ว: %@"
          }
        }
      }
    },
    "Đã ghi lại câu hỏi để cẩm nang viết thêm.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertanyaan dicatat agar panduan menambah tulisan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Soalan telah direkodkan supaya buku panduan boleh ditambah."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกคำถามไว้ให้คู่มือเขียนเพิ่มแล้ว"
          }
        }
      }
    },
    "Đã ghi: bật %@, tắt %@. Đèn chạy theo lịch từ bây giờ.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tersimpan: nyala %1$@, mati %2$@. Mulai sekarang lampu mengikuti jadwal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan: hidup %1$@, padam %2$@. Lampu mengikut jadual mulai sekarang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกแล้ว: เปิด %1$@ ปิด %2$@ โคมไฟจะทำงานตามตารางเวลาตั้งแต่นี้"
          }
        }
      }
    },
    "Đã gửi báo cáo. Cảm ơn bạn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan terkirim. Terima kasih."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan dihantar. Terima kasih."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งรายงานแล้ว ขอบคุณ"
          }
        }
      }
    },
    "Đã gửi “%@” lúc %@.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” terkirim pukul %2$@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” dihantar pada %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่ง “%1$@” แล้วเมื่อ %2$@"
          }
        }
      }
    },
    "Đã gửi mã tới %@. Mở email và nhập mã 6 số.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode sudah dikirim ke %@. Buka email dan masukkan kode 6 digit."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod telah dihantar ke %@. Buka e-mel dan masukkan kod 6 digit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งรหัสไปที่ %@ แล้ว เปิดอีเมลและกรอกรหัส 6 หลัก"
          }
        }
      }
    },
    "Đã kiểm tra nuôi chung": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memeriksa kecocokan ikan"
