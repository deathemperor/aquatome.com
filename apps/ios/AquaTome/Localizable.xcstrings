    "Không thấy %@ quanh đây. Bật đèn, lại gần rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak ditemukan di sekitar sini. Nyalakan lampu, mendekatlah, lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak ditemui di sekitar sini. Hidupkan lampu, dekati, kemudian cuba lagi."
