          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วัสดุปูพื้นอื่น"
          }
        }
      }
    },
    "Nội dung không phù hợp": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten tidak pantas"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อหาไม่เหมาะสม"
          }
        }
      }
    },
    "Nội dung này sẽ ẩn trên máy này ngay, và AquaTome xem lại trong vòng 24 giờ.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten ini langsung disembunyikan di perangkat ini, dan AquaTome meninjaunya dalam 24 jam."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อหานี้จะถูกซ่อนบนเครื่องนี้ทันที และ AquaTome จะตรวจสอบภายใน 24 ชั่วโมง"
          }
        }
      }
    },
    "Passkey này không mở được tài khoản nào: đăng nhập cách khác.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey ini tidak terhubung ke akun mana pun: masuk dengan cara lain."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "passkey นี้ไม่ตรงกับบัญชีใด: เข้าสู่ระบบด้วยวิธีอื่น"
          }
        }
      }
    },
    "Phiên đăng nhập đã hết: đăng nhập lại để đồng bộ.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi masuk sudah berakhir: masuk lagi untuk menyinkronkan."
          }
