          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกช่องปลั๊กของโคมไฟ"
          }
        }
      }
    },
    "Chọn ổ để AquaTome xem hẹn giờ của ổ có cắt điện đèn không.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih colokannya agar AquaTome bisa melihat apakah timer colokan itu memutus listrik lampu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih soket supaya AquaTome dapat melihat sama ada pemasa soket itu memutuskan kuasa lampu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกช่องเพื่อให้ AquaTome ดูว่าการตั้งเวลาของช่องนั้นตัดไฟโคมไฟหรือไม่"
          }
        }
      }
    },
    "Chụp hoặc chọn ảnh một con cá, tép, ốc hay cây thủy sinh. Công cụ đoán tên loài và mở hồ sơ của nó trong cẩm nang.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto atau pilih gambar seekor ikan, udang, siput, atau tanaman air. Alat ini menebak spesiesnya dan membuka profilnya di panduan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil atau pilih foto ikan, udang, siput atau tumbuhan akuatik. Alat ini meneka nama spesiesnya dan membuka profilnya dalam buku panduan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายหรือเลือกรูปปลา กุ้ง หอย หรือไม้น้ำ เครื่องมือจะเดาชื่อสายพันธุ์และเปิดหน้าข้อมูลในคู่มือให้"
          }
        }
      }
    },
    "Chụp hoặc chọn ảnh: cá, tép, ốc hay cây": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto atau pilih gambar: ikan, udang, siput, atau tanaman air"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil atau pilih foto: ikan, udang, siput atau tumbuhan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายหรือเลือกรูป: ปลา กุ้ง หอย หรือไม้น้ำ"
          }
        }
      }
    },
    "Chụp ngang thân, thấy rõ vây và đuôi.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dari samping, sirip dan ekor terlihat jelas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil dari sisi badan, sirip dan ekor kelihatan jelas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายด้านข้างลำตัว ให้เห็นครีบและหางชัด"
          }
        }
      }
    },
    "Chụp sao cho dễ nhận": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto yang mudah dikenali"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil foto yang mudah dikenal pasti"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายอย่างไรให้ระบุง่าย"
          }
        }
      }
    },
    "Chụp ảnh": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil foto"
          }
        },
        "ms": {
