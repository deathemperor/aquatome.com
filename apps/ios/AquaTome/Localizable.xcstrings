            "value": "Akuarium baru ditanam"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ไม้น้ำเพิ่งปลูก"
          }
        }
      }
    },
    "Bể này đã bị xóa.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium ini sudah dihapus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้นี้ถูกลบแล้ว"
          }
        }
      }
    },
    "Bể tối thiểu": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium minimum"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ขั้นต่ำ"
          }
        }
      }
    },
    "Bể đang bị rêu": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium sedang terkena alga"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ที่มีตะไคร่"
          }
        }
      }
    },
    "Bể đã ổn định": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium sudah stabil"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ที่เซ็ตตัวแล้ว"
          }
        }
      }
    },
    "Bỏ chặn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka blokir"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลิกบล็อก"
          }
        }
      }
    },
    "Bỏ chặn %@": {
      "localizations": {
        "id": {
          "stringUnit": {
