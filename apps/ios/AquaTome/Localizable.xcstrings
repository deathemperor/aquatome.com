            "state": "translated",
            "value": "เปิดในเบราว์เซอร์"
          }
        }
      }
    },
    "Người đã chặn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang diblokir"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่บล็อกไว้"
          }
        }
      }
    },
    "Ngắt kết nối": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putuskan koneksi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัดการเชื่อมต่อ"
          }
        }
      }
    },
    "Nhiệt độ": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุณหภูมิ"
          }
        }
      }
    },
    "Nhiệt độ (°C)": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhu (°C)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุณหภูมิ (°C)"
          }
        }
      }
    },
    "Nhập đủ dài, rộng, cao (từ 1 đến 1.000 cm), hoặc để trống cả ba.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi panjang, lebar, dan tinggi (1–1.000 cm), atau kosongkan ketiganya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอกความยาว ความกว้าง และความสูงให้ครบ (1–1,000 cm) หรือเว้นว่างทั้งสามช่อง"
          }
        }
      }
    },
    "Những cây này còn thiếu thông tin bạn đang lọc (ánh sáng, CO₂, vị trí hoặc độ khó). Thông tin đã có thì hợp, nhưng chưa đủ để nói chắc.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanaman ini belum punya sebagian informasi yang sedang Anda filter (cahaya, CO₂, posisi, atau tingkat kesulitan). Informasi yang ada sudah cocok, tetapi belum cukup untuk memastikan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้นไม้เหล่านี้ยังขาดข้อมูลบางส่วนที่คุณกำลังกรอง (แสง, CO₂, ตำแหน่งปลูก หรือความยาก) ข้อมูลที่มีอยู่เข้ากันได้ แต่ยังไม่พอจะยืนยัน"
          }
        }
      }
    },
    "Những loài này còn thiếu số liệu bạn đang lọc (nhiệt độ, pH, chiều dài bể hoặc độ khó). Số đã có thì hợp, nhưng chưa đủ để nói chắc.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesies ini belum punya sebagian data yang sedang Anda filter (suhu, pH, panjang akuarium, atau tingkat kesulitan). Data yang ada sudah cocok, tetapi belum cukup untuk memastikan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลาเหล่านี้ยังขาดข้อมูลบางค่าที่คุณใช้กรอง (อุณหภูมิ, ค่า pH, ความยาวตู้ หรือระดับความยาก) ค่าที่มีอยู่ตรงตามเงื่อนไข แต่ยังไม่พอจะยืนยันได้แน่ชัด"
          }
        }
      }
    },
    "Nuôi chung": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teman satu akuarium"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเลี้ยงรวม"
          }
        }
      }
    },
    "Nước trong, mát": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Air jernih, sejuk"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำใส แสงเย็นตา"
          }
        }
      }
    },
    "Nền": {
      "localizations": {
