          }
        }
      }
    },
    "Các bể lưu trên máy này và trong tài khoản của bạn trên máy chủ AquaTome (Cloudflare), để các thiết bị đã đăng nhập cùng thấy.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium disimpan di perangkat ini dan di akun Anda di server AquaTome (Cloudflare), agar terlihat di semua perangkat yang sudah masuk."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangki disimpan pada peranti ini dan dalam akaun anda di pelayan AquaTome (Cloudflare), supaya kelihatan pada semua peranti yang telah log masuk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ปลาจะถูกบันทึกไว้ในอุปกรณ์นี้และในบัญชีของคุณบนเซิร์ฟเวอร์ AquaTome (Cloudflare) เพื่อให้ทุกอุปกรณ์ที่เข้าสู่ระบบเห็นข้อมูลเดียวกัน"
          }
        }
      }
    },
    "Các bể lưu trên máy này, không cần tài khoản.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium tersimpan di perangkat ini, tanpa perlu akun."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangki disimpan pada peranti ini, tanpa perlu akaun."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ปลาบันทึกไว้ในเครื่องนี้ ไม่ต้องมีบัญชี"
          }
        }
      }
    },
    "Các bể trên máy này chưa đồng bộ được.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium di perangkat ini belum bisa disinkronkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangki pada peranti ini belum dapat disegerakkan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ปลาในอุปกรณ์นี้ยังซิงค์ไม่ได้"
          }
        }
      }
    },
    "Các bể trên máy này được lưu bằng bản ứng dụng mới hơn. Cập nhật AquaTome để xem và sửa.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium di perangkat ini disimpan oleh versi aplikasi yang lebih baru. Perbarui AquaTome untuk melihat dan mengubahnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangki pada peranti ini disimpan oleh versi aplikasi yang lebih baharu. Kemas kini AquaTome untuk melihat dan mengeditnya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ปลาในเครื่องนี้บันทึกด้วยแอปเวอร์ชันที่ใหม่กว่า อัปเดต AquaTome เพื่อดูและแก้ไข"
          }
        }
      }
    },
    "Các bể vẫn lưu trên máy này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium tetap tersimpan di perangkat ini."
          }
