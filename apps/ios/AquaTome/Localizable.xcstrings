          "stringUnit": {
            "state": "translated",
            "value": "กำลังเชื่อมต่อใหม่…"
          }
        }
      }
    },
    "Đang kết nối…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghubungkan…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังเชื่อมต่อ…"
          }
        }
