    "Vui lòng xác nhận ảnh do bạn chụp.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harap konfirmasi bahwa foto ini Anda ambil sendiri."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila sahkan bahawa foto ini diambil oleh anda sendiri."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดยืนยันว่าคุณเป็นผู้ถ่ายภาพนี้"
          }
        }
      }
    },
    "Vì an toàn, đăng nhập lại trước khi thêm: chọn một cách tài khoản này đang dùng (%@).": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Demi keamanan, masuk lagi sebelum menambahkan: pilih cara yang sudah dipakai akun ini (%@)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Demi keselamatan, log masuk semula sebelum menambah: pilih cara yang digunakan oleh akaun ini (%@)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อความปลอดภัย โปรดเข้าสู่ระบบอีกครั้งก่อนเพิ่ม: เลือกวิธีที่บัญชีนี้ใช้อยู่ (%@)"
          }
        }
      }
    },
    "Ví dụ: Bể 60 phòng khách": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Contoh: Akuarium 60 ruang tamu"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Contoh: Tangki 60 ruang tamu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น ตู้ 60 ห้องนั่งเล่น"
          }
        }
      }
    },
    "Ví dụ: Rhinogobius duospilus": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Contoh: Rhinogobius duospilus"
          }
        },
