{
  "sourceLanguage": "vi",
  "strings": {
    "%@ lít": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liter"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ลิตร"
          }
        }
      }
    },
    "%@–%@ · %lld%% · sáng dần %lld phút": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@–%2$@ · %3$lld%% · terang bertahap %4$lld menit"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@–%2$@ · %3$lld%% · ค่อย ๆ สว่าง %4$lld นาที"
          }
        }
      }
    },
    "%lld tiếng, %lld%%": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld jam, %2$lld%%"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ชั่วโมง, %2$lld%%"
          }
        }
      }
    },
    "%lld trang": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld halaman"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld หน้า"
          }
        }
      }
    },
    "%lld đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lampu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟ %lld ดวง"
          }
        }
      }
    },
    "AquaTome chưa được dùng Bluetooth. Bật trong Cài đặt → AquaTome → Bluetooth.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome belum diizinkan memakai Bluetooth. Aktifkan di Pengaturan → AquaTome → Bluetooth."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome ยังไม่ได้รับอนุญาตให้ใช้บลูทูธ เปิดได้ที่ การตั้งค่า → AquaTome → บลูทูธ"
          }
        }
      }
    },
    "AquaTome không liên quan tới hãng Chihiros. Các lệnh Bluetooth theo ghi chép mã nguồn mở [chihiros-led-control](https://github.com/TheMicDiet/chihiros-led-control) (giấy phép MIT).": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome tidak berafiliasi dengan Chihiros. Perintah Bluetooth mengikuti dokumentasi sumber terbuka [chihiros-led-control](https://github.com/TheMicDiet/chihiros-led-control) (lisensi MIT)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome ไม่มีส่วนเกี่ยวข้องกับบริษัท Chihiros คำสั่ง Bluetooth อ้างอิงตามบันทึกโอเพนซอร์ส [chihiros-led-control](https://github.com/TheMicDiet/chihiros-led-control) (สัญญาอนุญาต MIT)"
          }
        }
      }
    },
    "Bluetooth đang tắt. Bật Bluetooth rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth mati. Nyalakan Bluetooth lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บลูทูธปิดอยู่ เปิดบลูทูธแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Bật lúc": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyala pukul"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเวลา"
          }
        }
      }
    },
    "Bật đèn, bật Bluetooth và lại gần đèn. Đóng ứng dụng My Chihiros trên các máy khác: mỗi lúc đèn chỉ nhận một kết nối.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan lampu dan Bluetooth, lalu dekati lampu. Tutup aplikasi My Chihiros di perangkat lain: lampu hanya menerima satu koneksi dalam satu waktu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดโคมไฟและบลูทูธ แล้วเข้าใกล้โคมไฟ ปิดแอป My Chihiros บนเครื่องอื่น เพราะโคมไฟรับการเชื่อมต่อได้ครั้งละหนึ่งเครื่องเท่านั้น"
          }
        }
      }
    },
    "Bể của tôi": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium saya"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ของฉัน"
          }
        }
      }
    },
    "Bể mới trồng": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium baru ditanam"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ไม้น้ำเพิ่งปลูก"
          }
        }
      }
    },
    "Bể này đã bị xóa.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium ini sudah dihapus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้นี้ถูกลบแล้ว"
          }
        }
      }
    },
    "Bể đang bị rêu": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium sedang terkena alga"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ที่มีตะไคร่"
          }
        }
      }
    },
    "Bể đã ổn định": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium sudah stabil"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ที่เซ็ตตัวแล้ว"
          }
        }
      }
    },
    "Cao": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinggi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูง"
          }
        }
      }
    },
    "Chưa chọn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dipilih"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้เลือก"
          }
        }
      }
    },
    "Chưa có bể nào": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada akuarium"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีตู้ปลา"
          }
        }
      }
    },
    "Chưa có kích thước.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada ukuran."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีขนาด"
          }
        }
      }
    },
    "Chưa có lịch": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada jadwal"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีตาราง"
          }
        }
      }
    },
    "Chưa lưu lịch nào cho đèn này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada jadwal tersimpan untuk lampu ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้บันทึกตารางเวลาสำหรับไฟนี้"
          }
        }
      }
    },
    "Chưa lưu được thay đổi. Thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan belum tersimpan. Coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังบันทึกการเปลี่ยนแปลงไม่สำเร็จ ลองอีกครั้ง"
          }
        }
      }
    },
    "Chỉnh giờ đèn theo máy này": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Samakan jam lampu dengan perangkat ini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเวลาโคมไฟตามเครื่องนี้"
          }
        }
      }
    },
    "Chỉnh tay": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur manual"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับเอง"
          }
        }
      }
    },
    "Chọn một mẫu hoặc tự nhập. Đèn tự bật tắt theo đồng hồ của nó, không cần điện thoại ở gần.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih templat atau isi sendiri. Lampu akan menyala dan mati sendiri sesuai jam internalnya, tanpa perlu ponsel di dekatnya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกตารางสำเร็จรูปหรือกรอกเอง โคมไฟจะเปิดปิดเองตามนาฬิกาในตัว โดยไม่ต้องมีโทรศัพท์อยู่ใกล้"
          }
        }
      }
    },
    "Các bể lưu trên máy này, không cần tài khoản.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium tersimpan di perangkat ini, tanpa perlu akun."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ปลาบันทึกไว้ในเครื่องนี้ ไม่ต้องมีบัญชี"
          }
        }
      }
    },
    "Các bể trên máy này được lưu bằng bản ứng dụng mới hơn. Cập nhật AquaTome để xem và sửa.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium di perangkat ini disimpan oleh versi aplikasi yang lebih baru. Perbarui AquaTome untuk melihat dan mengubahnya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้ปลาในเครื่องนี้บันทึกด้วยแอปเวอร์ชันที่ใหม่กว่า อัปเดต AquaTome เพื่อดูและแก้ไข"
          }
        }
      }
    },
    "Cát": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasir"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทราย"
          }
        }
      }
    },
    "Cây": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanaman"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม้น้ำ"
          }
        }
      }
    },
    "Công cụ": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องมือ"
          }
        }
      }
    },
    "Dài": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panjang"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยาว"
          }
        }
      }
    },
    "Firmware của đèn chưa hẹn giờ được từ ứng dụng. Cập nhật firmware bằng ứng dụng My Chihiros.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware lampu ini belum bisa diatur timernya dari aplikasi. Perbarui firmware lewat aplikasi My Chihiros."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฟิร์มแวร์ของโคมไฟนี้ยังตั้งเวลาจากแอปไม่ได้ ให้อัปเดตเฟิร์มแวร์ด้วยแอป My Chihiros"
          }
        }
      }
    },
    "Ghi chú": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมายเหตุ"
          }
        }
      }
    },
    "Ghi lịch": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan jadwal"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกตาราง"
          }
        }
      }
    },
    "Ghi lịch mới sẽ xóa các lịch đang lưu trên đèn, kể cả lịch đặt bằng ứng dụng My Chihiros, và chỉnh giờ đèn theo máy này. Giờ tắt phải trong cùng ngày (muộn nhất 00:00). Cần đèn có firmware từ bản 20.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan jadwal baru akan menghapus jadwal yang tersimpan di lampu, termasuk jadwal yang diatur lewat aplikasi My Chihiros, dan menyamakan jam lampu dengan perangkat ini. Jam mati harus di hari yang sama (paling lambat 00:00). Lampu harus memakai firmware versi 20 ke atas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกตารางใหม่จะลบตารางที่บันทึกไว้ในโคมไฟ รวมถึงตารางที่ตั้งด้วยแอป My Chihiros และจะตั้งเวลาโคมไฟตามเครื่องนี้ เวลาปิดต้องอยู่ในวันเดียวกัน (ช้าสุด 00:00) โคมไฟต้องมี firmware เวอร์ชัน 20 ขึ้นไป"
          }
        }
      }
    },
    "Ghi lịch vào đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan jadwal ke lampu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกตารางลงโคมไฟ"
          }
        }
      }
    },
    "Giờ của đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam lampu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาของโคมไฟ"
          }
        }
      }
    },
    "Giờ tắt phải sau giờ bật, trong cùng một ngày.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam mati harus setelah jam nyala, di hari yang sama."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาปิดต้องอยู่หลังเวลาเปิด ภายในวันเดียวกัน"
          }
        }
      }
    },
    "Hướng dẫn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panduan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คู่มือ"
          }
        }
      }
    },
    "Hẹn giờ bật tắt mỗi ngày": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer nyala-mati harian"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเวลาเปิดปิดทุกวัน"
          }
        }
      }
    },
    "Hẹn giờ bật tắt, chỉnh độ sáng từng màu và chỉnh giờ cho đèn Chihiros qua Bluetooth.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur timer nyala-mati, kecerahan tiap warna, dan jam lampu Chihiros lewat Bluetooth."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเวลาเปิดปิด ปรับความสว่างแต่ละสี และตั้งเวลาให้โคมไฟ Chihiros ผ่านบลูทูธ"
          }
        }
      }
    },
    "Hỗ trợ các đèn Bluetooth có tên bắt đầu bằng DY: %@.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mendukung lampu Bluetooth yang namanya diawali DY: %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รองรับโคมไฟบลูทูธที่ชื่อขึ้นต้นด้วย DY: %@"
          }
        }
      }
    },
    "Hủy": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batal"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิก"
          }
        }
      }
    },
    "Khôi phục lịch trước: %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan jadwal sebelumnya: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนค่าตารางก่อนหน้า: %@"
          }
        }
      }
    },
    "Không gửi được lệnh tới đèn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal mengirim perintah ke lampu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งคำสั่งไปยังโคมไฟไม่ได้"
          }
        }
      }
    },
    "Không kết nối được. Lại gần đèn, đóng ứng dụng My Chihiros trên các máy khác rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal terhubung. Dekati lampu, tutup aplikasi My Chihiros di perangkat lain, lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อไม่ได้ เข้าใกล้โคมไฟ ปิดแอป My Chihiros บนเครื่องอื่น แล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Không trải nền": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa substrat"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ปูพื้น"
          }
        }
      }
    },
    "Không tải được cẩm nang. Kiểm tra kết nối mạng rồi kéo xuống để thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panduan tidak dapat dimuat. Periksa koneksi internet, lalu tarik ke bawah untuk mencoba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดคู่มือไม่ได้ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ต แล้วดึงลงเพื่อลองอีกครั้ง"
          }
        }
      }
    },
    "Không tải được trang. Kiểm tra kết nối mạng.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman tidak dapat dimuat. Periksa koneksi internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดหน้านี้ไม่ได้ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ต"
          }
        }
      }
    },
    "Không đọc được các bể đã lưu trên máy này. Dữ liệu được giữ nguyên.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium yang tersimpan di perangkat ini tidak dapat dibaca. Datanya tetap utuh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านข้อมูลตู้ปลาที่บันทึกไว้ในเครื่องนี้ไม่ได้ ข้อมูลยังอยู่ครบ"
          }
        }
      }
    },
    "Kéo để đổi độ sáng ngay. Đèn chuyển sang chỉnh tay và bỏ qua lịch hẹn giờ cho tới khi bạn ghi lịch lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser untuk langsung mengubah kecerahan. Lampu beralih ke mode manual dan mengabaikan jadwal timer sampai Anda menyimpan jadwal lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากเพื่อเปลี่ยนความสว่างทันที โคมไฟจะเปลี่ยนเป็นโหมดปรับเองและไม่ทำตามตารางเวลา จนกว่าจะบันทึกตารางใหม่"
          }
        }
      }
    },
    "Kích thước lòng bể (cm)": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran dalam akuarium (cm)"
