            "state": "translated",
            "value": "ซิงค์ระหว่างอุปกรณ์"
          }
        }
      }
    },
    "Đồng bộ ngay": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronkan sekarang"
          }
        },
        "th": {
