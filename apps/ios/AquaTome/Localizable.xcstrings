    "Bật Bluetooth để gửi lệnh tới đèn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan Bluetooth untuk mengirim perintah ke lampu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Bluetooth untuk menghantar arahan ke lampu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดบลูทูธเพื่อส่งคำสั่งไปยังไฟ"
          }
        }
      }
    },
    "Bật Bluetooth, đứng gần đèn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan Bluetooth, berdirilah di dekat lampu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Bluetooth, berdiri dekat lampu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Bluetooth และอยู่ใกล้โคมไฟ"
          }
        }
      }
    },
    "Bật gói dùng thử IoT Core (Cloud → Cloud Services → IoT Core). Gói miễn phí phải gia hạn trong console khoảng mỗi tháng: hết hạn thì AquaTome không bật tắt được, còn hẹn giờ trên ổ cắm vẫn chạy.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan uji coba IoT Core (Cloud → Cloud Services → IoT Core). Paket gratis ini harus diperpanjang di konsol kira-kira setiap bulan: jika habis, AquaTome tidak bisa menyalakan atau mematikan, tetapi timer di stopkontak tetap berjalan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan percubaan IoT Core (Cloud → Cloud Services → IoT Core). Pelan percuma ini perlu dilanjutkan dalam konsol lebih kurang setiap bulan: jika tamat tempoh, AquaTome tidak dapat menghidupkan atau mematikan soket, tetapi pemasa pada soket tetap berjalan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้แพ็กเกจทดลอง IoT Core (Cloud → Cloud Services → IoT Core) แพ็กเกจฟรีนี้ต้องต่ออายุในคอนโซลประมาณทุกเดือน หากหมดอายุ AquaTome จะเปิดปิดไม่ได้ แต่ตัวตั้งเวลาบนปลั๊กไฟยังทำงานอยู่"
          }
        }
      }
    },
    "Bật lúc": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyala pukul"
          }
        },
        "ms": {
