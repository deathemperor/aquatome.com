    },
    "Xóa bể": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus akuarium"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบตู้"
          }
        }
      }
    },
    "Xóa bể “%@” cùng %lld đèn đã lưu trên bể?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus akuarium “%1$@” beserta %2$lld lampu yang tersimpan di dalamnya?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบตู้ “%1$@” พร้อมไฟ %2$lld ดวงที่บันทึกไว้ในตู้นี้หรือไม่"
          }
        }
      }
    },
    "Xóa bể “%@”?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus akuarium “%@”?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบตู้ “%@” หรือไม่"
          }
        }
      }
    },
    "Xóa khóa": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus kunci"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบคีย์"
          }
        }
      }
    },
    "Xóa khóa Tuya trên máy này?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus kunci Tuya di perangkat ini?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบคีย์ Tuya ในเครื่องนี้ไหม"
          }
        }
      }
    },
    "Xóa khóa không bật tắt ổ cắm nào: các ổ cắm trên bể vẫn còn, chỉ không bật tắt được cho tới khi nhập lại khóa.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus kunci tidak menyalakan atau mematikan stopkontak mana pun: stopkontak di akuarium tetap ada, hanya tidak bisa dinyalakan atau dimatikan sampai kunci dimasukkan lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลบคีย์ไม่ได้เปิดหรือปิดปลั๊กไฟใด ๆ ปลั๊กไฟบนตู้ยังอยู่ เพียงแต่เปิดปิดไม่ได้จนกว่าจะใส่คีย์อีกครั้ง"
          }
        }
      }
    },
    "Xóa tài khoản": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus akun"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบัญชี"
          }
        }
      }
    },
    "Xóa tài khoản là xóa ngay tài khoản, các cách đăng nhập và mọi bể lưu trong tài khoản. Bể trên máy này vẫn còn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus akun berarti langsung menghapus akun, semua metode masuk, dan semua akuarium yang tersimpan di akun. Akuarium di perangkat ini tetap ada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลบบัญชีจะลบบัญชี วิธีเข้าสู่ระบบ และตู้ปลาทั้งหมดที่บันทึกไว้ในบัญชีทันที ส่วนตู้ปลาในอุปกรณ์นี้จะยังคงอยู่"
          }
        }
      }
    },
    "Xóa tài khoản vĩnh viễn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus akun secara permanen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบัญชีถาวร"
          }
        }
      }
    },
    "Xóa vĩnh viễn tài khoản và các bể trong tài khoản? Bể trên máy này vẫn còn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus akun dan semua akuarium di dalamnya secara permanen? Akuarium di perangkat ini tetap ada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบัญชีและตู้ปลาในบัญชีอย่างถาวรใช่ไหม ตู้ปลาในอุปกรณ์นี้จะยังคงอยู่"
          }
        }
      }
    },
