    "Lịch thay nước, phân bón, CO₂…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal ganti air, pupuk, CO₂…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเปลี่ยนน้ำ ปุ๋ย CO₂…"
          }
        }
      }
    },
    "Lịch đang lưu trên đèn sẽ bị xóa và thay bằng lịch này. Ghi lịch?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal yang tersimpan di lampu akan dihapus dan diganti dengan jadwal ini. Simpan jadwal?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางที่บันทึกไว้ในโคมไฟจะถูกลบและแทนที่ด้วยตารางนี้ บันทึกตารางหรือไม่?"
          }
