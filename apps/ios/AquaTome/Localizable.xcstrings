    },
    "Độ khó tối đa": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingkat kesulitan maksimum"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความยากสูงสุด"
          }
        }
      }
    },
    "Độ sáng": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecerahan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความสว่าง"
          }
        }
      }
    },
    "Đủ để ngắm cá, ít rêu.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cukup untuk menikmati ikan, lumut sedikit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สว่างพอสำหรับชมปลา ตะไคร่ขึ้นน้อย"
          }
        }
      }
    },
    "đèn tắt": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "lampu mati"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟปิด"
          }
        }
      }
    },
    "Ảnh": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพ"
          }
        }
      }
    },
    "Ảnh %lld trên %lld": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto %lld dari %lld"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปที่ %lld จาก %lld"
          }
        }
      }
    },
    "Ảnh bạn đọc": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto pembaca"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพจากผู้อ่าน"
          }
        }
      }
    },
    "Ảnh của %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพโดย %@"
          }
        }
      }
    },
    "Ảnh do tôi chụp. Tôi đồng ý để AquaTome đăng ảnh này kèm tên tôi.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto ini saya ambil sendiri. Saya setuju AquaTome menerbitkan foto ini beserta nama saya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันเป็นผู้ถ่ายรูปนี้เอง และยินยอมให้ AquaTome เผยแพร่รูปนี้พร้อมชื่อของฉัน"
          }
        }
      }
    },
    "Ảnh quá lớn (tối đa 8 MB).": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto terlalu besar (maksimum 8 MB)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพมีขนาดใหญ่เกินไป (สูงสุด 8 MB)"
          }
        }
      }
    },
    "Ảnh trong bài cũng được tải, có thể tới vài chục MB.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dalam artikel ikut diunduh, bisa sampai puluhan MB."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปในบทความจะถูกดาวน์โหลดด้วย อาจใช้หลายสิบ MB"
          }
        }
      }
    },
    "Ảnh được kiểm duyệt trước khi hiện: ảnh có người, không đúng loài hoặc không phù hợp sẽ bị loại. Vị trí GPS và thông tin máy trong ảnh được xóa trước khi gửi.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dimoderasi sebelum ditampilkan: foto yang memuat orang, bukan spesies yang sesuai, atau tidak pantas akan ditolak. Lokasi GPS dan informasi perangkat dalam foto dihapus sebelum dikirim."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพจะผ่านการตรวจสอบก่อนแสดง รูปที่มีคน ไม่ตรงสายพันธุ์ หรือไม่เหมาะสมจะถูกตัดออก ตำแหน่ง GPS และข้อมูลกล้องในรูปจะถูกลบก่อนส่ง"
          }
        }
      }
    },
    "Ấm, dịu mắt": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangat, nyaman di mata"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทนอุ่น สบายตา"
          }
        }
      }
    },
    "Ấn Độ (India)": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "India"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อินเดีย (India)"
          }
        }
      }
    },
    "Ổ %lld": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Colokan %lld"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่อง %lld"
          }
        }
      }
    },
    "Ổ %lld · %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Colokan %1$lld · %2$@"
          }
        },
        "th": {
