          }
        }
      }
    },
    "Ảnh chưa rõ lắm, đây chỉ là phỏng đoán. Ảnh rõ hơn sẽ cho kết quả chắc hơn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotonya kurang jelas, ini hanya tebakan. Foto yang lebih jelas memberi hasil yang lebih pasti."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto kurang jelas, ini hanya tekaan. Foto yang lebih jelas akan memberi hasil yang lebih tepat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพยังไม่ค่อยชัด นี่เป็นเพียงการเดา ภาพที่ชัดกว่าจะให้ผลที่แน่นอนกว่า"
          }
        }
      }
    },
    "Ảnh của %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto oleh %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพโดย %@"
          }
        }
      }
    },
    "Ảnh do tôi chụp. Tôi đồng ý để AquaTome đăng ảnh này kèm tên tôi.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto ini saya ambil sendiri. Saya setuju AquaTome menerbitkan foto ini beserta nama saya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto ini saya ambil sendiri. Saya bersetuju AquaTome menerbitkan foto ini bersama nama saya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันเป็นผู้ถ่ายรูปนี้เอง และยินยอมให้ AquaTome เผยแพร่รูปนี้พร้อมชื่อของฉัน"
          }
        }
      }
    },
    "Ảnh không được lưu lại: ảnh được gửi tới Claude, mô hình AI của Anthropic, để nhận diện rồi bỏ đi.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto tidak disimpan: foto dikirim ke Claude, model AI dari Anthropic, untuk dikenali lalu dibuang."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto tidak disimpan: foto dihantar kepada Claude, model AI Anthropic, untuk dikenal pasti dan kemudian dibuang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราไม่เก็บรูปของคุณ: รูปจะถูกส่งให้ Claude โมเดล AI ของ Anthropic ระบุชนิดแล้วทิ้งไป"
          }
        }
      }
    },
    "Ảnh này có vẻ không có cá, tép, ốc hay cây thủy sinh nào. Thử một ảnh khác nhé.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepertinya tidak ada ikan, udang, siput, atau tanaman air di foto ini. Coba foto lain, ya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto ini nampaknya tiada ikan, udang, siput atau tumbuhan akuatik. Cuba foto lain."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูเหมือนว่าในรูปนี้ไม่มีปลา กุ้ง หอย หรือไม้น้ำ ลองรูปอื่นนะ"
          }
        }
      }
    },
    "Ảnh quá lớn (tối đa 8 MB).": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto terlalu besar (maksimum 8 MB)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto terlalu besar (maksimum 8 MB)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพมีขนาดใหญ่เกินไป (สูงสุด 8 MB)"
          }
        }
      }
    },
    "Ảnh quá lớn. Chọn ảnh khác nhé.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotonya terlalu besar. Pilih foto lain, ya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto terlalu besar. Sila pilih foto lain."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปใหญ่เกินไป เลือกรูปอื่นนะ"
          }
        }
      }
    },
    "Ảnh trong bài cũng được tải, có thể tới vài chục MB.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dalam artikel ikut diunduh, bisa sampai puluhan MB."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dalam artikel turut dimuat turun, mungkin sehingga puluhan MB."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปในบทความจะถูกดาวน์โหลดด้วย อาจใช้หลายสิบ MB"
          }
        }
      }
    },
    "Ảnh và giấy phép": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dan lisensi"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dan lesen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพและสัญญาอนุญาต"
          }
        }
      }
    },
    "Ảnh được kiểm duyệt trước khi hiện: ảnh có người, không đúng loài hoặc không phù hợp sẽ bị loại. Vị trí GPS và thông tin máy trong ảnh được xóa trước khi gửi.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dimoderasi sebelum ditampilkan: foto yang memuat orang, bukan spesies yang sesuai, atau tidak pantas akan ditolak. Lokasi GPS dan informasi perangkat dalam foto dihapus sebelum dikirim."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto disemak sebelum dipaparkan: foto yang ada orang, bukan spesies yang betul atau tidak sesuai akan ditolak. Lokasi GPS dan maklumat peranti dalam foto dipadam sebelum dihantar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพจะผ่านการตรวจสอบก่อนแสดง รูปที่มีคน ไม่ตรงสายพันธุ์ หรือไม่เหมาะสมจะถูกตัดออก ตำแหน่ง GPS และข้อมูลกล้องในรูปจะถูกลบก่อนส่ง"
          }
        }
      }
    },
    "Ảnh đại diện": {
      "localizations": {
        "id": {
          "stringUnit": {
