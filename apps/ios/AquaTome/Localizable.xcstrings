            "value": "CO₂"
          }
        }
      }
    },
    "Cao": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinggi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูง"
          }
        }
      }
    },
    "Chính sách bảo mật": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebijakan privasi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นโยบายความเป็นส่วนตัว"
          }
        }
      }
    },
    "Chưa chạy được bước kiểm tra chống spam: bấm để thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan antispam belum berjalan: ketuk untuk mencoba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังตรวจสอบป้องกันสแปมไม่ได้ แตะเพื่อลองอีกครั้ง"
          }
        }
      }
    },
    "Chưa chọn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dipilih"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้เลือก"
          }
        }
      }
    },
    "Chưa có bình luận. Hãy là người đầu tiên chia sẻ kinh nghiệm.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada komentar. Jadilah yang pertama berbagi pengalaman."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีความคิดเห็น มาเป็นคนแรกที่แบ่งปันประสบการณ์"
          }
        }
      }
    },
    "Chưa có bể nào": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada akuarium"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีตู้ปลา"
          }
        }
      }
    },
    "Chưa có kích thước.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada ukuran."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีขนาด"
          }
        }
      }
    },
    "Chưa có ảnh nào. Bạn nuôi %@? Gửi một tấm ảnh cho mọi người cùng xem.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada foto. Anda memelihara %@? Kirim fotonya agar semua bisa ikut melihat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีรูปภาพ คุณเลี้ยง %@ อยู่หรือเปล่า ส่งรูปมาให้ทุกคนได้ดูกัน"
          }
        }
      }
    },
    "Chưa ghi lịch nào từ AquaTome.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada jadwal yang disimpan dari AquaTome."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้บันทึกตารางเวลาใดจาก AquaTome"
          }
        }
      }
    },
    "Chưa ghi ổ này cắm gì: nếu là sưởi hay CO2, bật tắt nhầm có thể hại cá. Chọn “Cắm gì” trong Sửa để khỏi hỏi lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dicatat colokan ini dipakai untuk apa: kalau untuk pemanas atau CO2, salah menyalakan atau mematikannya bisa membahayakan ikan. Pilih “Dipakai untuk” di Edit agar tidak ditanya lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ระบุว่าช่องนี้ใช้กับอะไร หากเป็นฮีตเตอร์หรือ CO2 การเปิดหรือปิดผิดอาจเป็นอันตรายต่อปลา เลือก “ใช้กับอะไร” ในแก้ไขเพื่อไม่ต้องถามอีก"
          }
        }
      }
    },
    "Chưa gửi lệnh: %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah belum dikirim: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ส่งคำสั่ง: %@"
          }
        }
      }
    },
    "Chưa gửi được email: thử lại sau.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Email belum terkirim: coba lagi nanti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งอีเมลไม่สำเร็จ โปรดลองใหม่ภายหลัง"
          }
        }
      }
    },
    "Chưa kết nối được đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum bisa terhubung ke lampu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังเชื่อมต่อโคมไฟไม่ได้"
          }
        }
      }
    },
    "Chưa lưu lịch nào cho đèn này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada jadwal tersimpan untuk lampu ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้บันทึกตารางเวลาสำหรับไฟนี้"
          }
        }
      }
    },
    "Chưa lưu được thay đổi. Thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan belum tersimpan. Coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังบันทึกการเปลี่ยนแปลงไม่สำเร็จ ลองอีกครั้ง"
          }
        }
      }
    },
    "Chưa thêm được passkey: thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey belum berhasil ditambahkan: coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังเพิ่ม passkey ไม่สำเร็จ: ลองอีกครั้ง"
          }
        }
      }
    },
    "Chưa xác nhận: ổ cắm chưa báo đã đổi.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum terkonfirmasi: stopkontak belum melaporkan perubahan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ยืนยัน: ปลั๊กไฟยังไม่รายงานว่าเปลี่ยนแล้ว"
          }
        }
      }
    },
    "Chưa xóa: cần đăng nhập lại bằng Apple để xác nhận.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dihapus: masuk lagi dengan Apple untuk mengonfirmasi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ลบ ต้องเข้าสู่ระบบด้วย Apple อีกครั้งเพื่อยืนยัน"
          }
        }
      }
    },
    "Chưa đọc được giờ của đèn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam lampu belum bisa dibaca."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังอ่านเวลาของโคมไฟไม่ได้"
          }
        }
      }
    },
    "Chưa đồng bộ được: không có mạng. Các thay đổi vẫn lưu trên máy này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum bisa disinkronkan: tidak ada koneksi internet. Perubahan tetap tersimpan di perangkat ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซิงค์ไม่สำเร็จเนื่องจากไม่มีอินเทอร์เน็ต การเปลี่ยนแปลงยังบันทึกอยู่ในเครื่องนี้"
          }
        }
      }
    },
    "Chưa đủ dữ liệu để chắc (%lld)": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data belum cukup untuk memastikan (%lld)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลยังไม่พอจะยืนยัน (%lld)"
          }
        }
      }
    },
    "Chặn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokir"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บล็อก"
          }
        }
      }
    },
    "Chặn %@?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokir %@?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บล็อก %@ ไหม?"
          }
        }
      }
    },
    "Chặn người này": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokir orang ini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บล็อกคนนี้"
          }
        }
      }
    },
    "Chỉ dùng cho thiết bị của riêng bạn: gói miễn phí của Tuya không dành cho việc dùng thương mại. Ổ cắm eWeLink (Sonoff) sẽ có sau.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk perangkat milik Anda sendiri: paket gratis Tuya tidak untuk penggunaan komersial. Stopkontak eWeLink (Sonoff) menyusul."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กับอุปกรณ์ของคุณเองเท่านั้น แพ็กเกจฟรีของ Tuya ไม่ได้มีไว้สำหรับใช้เชิงพาณิชย์ ปลั๊กไฟ eWeLink (Sonoff) จะตามมาภายหลัง"
          }
        }
      }
    },
    "Chỉ dùng để nhận ra bạn khi đăng nhập: không lưu tên, số điện thoại, và địa chỉ email chỉ lưu ở dạng mã hóa một chiều.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya dipakai untuk mengenali Anda saat masuk: nama dan nomor telepon tidak disimpan, dan alamat email hanya disimpan dalam bentuk hash satu arah."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เพื่อระบุตัวคุณเมื่อเข้าสู่ระบบเท่านั้น ไม่เก็บชื่อและเบอร์โทรศัพท์ ส่วนอีเมลจะเก็บในรูปแบบเข้ารหัสทางเดียวเท่านั้น"
          }
        }
      }
    },
    "Chỉ nhận ảnh JPEG, PNG hoặc WebP.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya menerima gambar JPEG, PNG, atau WebP."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รองรับเฉพาะภาพ JPEG, PNG หรือ WebP"
          }
        }
      }
    },
    "Chỉnh giờ đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur jam lampu"
          }
        },
        "th": {
