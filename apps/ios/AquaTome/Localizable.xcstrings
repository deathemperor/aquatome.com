            "state": "translated",
            "value": "Lampu %@ belum disokong."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่รองรับโคมไฟ %@"
          }
        }
      }
    },
    "Đèn Love Ecology": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu Love Ecology"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu Love Ecology"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟ Love Ecology"
          }
        }
      }
    },
    "Đèn Chihiros": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu Chihiros"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu Chihiros"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟ Chihiros"
          }
        }
      }
    },
    "Đèn chưa báo lại lịch mới. Kiểm tra lại sau ít phút.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu belum melaporkan jadwal baru. Periksa lagi beberapa menit lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu belum melaporkan jadual baharu. Semak semula dalam beberapa minit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟยังไม่รายงานตารางใหม่ ตรวจสอบอีกครั้งในอีกสักครู่"
          }
        }
      }
    },
    "Đèn chạy lại theo lịch.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu kembali mengikuti jadwal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu kembali mengikut jadual."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟกลับมาทำงานตามตารางเวลา"
          }
        }
      }
    },
    "Đèn cắm vào ổ nào?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu dicolokkan ke colokan mana?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu dipasang pada soket yang mana?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟเสียบอยู่ที่ช่องไหน"
          }
        }
      }
    },
    "Đèn hiện đúng màu đang chỉnh. Tắt thử thì đèn chạy lại theo lịch.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu menampilkan warna yang sedang diatur. Hentikan uji, lampu kembali mengikuti jadwal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu memaparkan warna yang sedang dilaraskan. Matikan ujian dan lampu akan kembali mengikut jadual."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟแสดงสีตามที่กำลังปรับ เมื่อปิดการทดสอบ โคมไฟจะกลับไปทำงานตามตารางเวลา"
          }
        }
      }
    },
    "Đèn không cắm ổ cắm Smart Life": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu tidak dicolokkan ke stopkontak Smart Life"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu tidak dipasang pada soket Smart Life"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟไม่ได้เสียบปลั๊กไฟ Smart Life"
          }
        }
      }
    },
    "Đèn không trả lời. Ngắt kết nối rồi kết nối lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu tidak merespons. Putuskan koneksi lalu hubungkan lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu tidak bertindak balas. Putuskan sambungan, kemudian sambung semula."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟไม่ตอบสนอง ตัดการเชื่อมต่อแล้วเชื่อมต่อใหม่"
          }
        }
      }
    },
    "Đèn mất giờ, có thể do mất điện: lịch sẽ chạy sai giờ.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam lampu hilang, mungkin karena listrik padam: jadwal akan berjalan di jam yang salah."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam lampu hilang, mungkin kerana bekalan elektrik terputus: jadual akan berjalan pada waktu yang salah."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาในโคมไฟหายไป อาจเกิดจากไฟดับ: ตารางเวลาจะทำงานผิดเวลา"
          }
        }
      }
    },
    "Đèn này chỉ giữ một lịch cho mọi ngày, nên không bật riêng hôm nay được.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu ini hanya menyimpan satu jadwal untuk semua hari, jadi tidak bisa dinyalakan khusus untuk hari ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu ini hanya menyimpan satu jadual untuk semua hari, jadi tidak boleh dihidupkan khas untuk hari ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟรุ่นนี้เก็บตารางเวลาได้ชุดเดียวสำหรับทุกวัน จึงเปิดเฉพาะวันนี้ไม่ได้"
          }
        }
      }
    },
    "Đèn sáng %@ tiếng mỗi ngày": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu menyala %@ jam per hari"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu menyala %@ jam sehari"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไฟวันละ %@ ชั่วโมง"
          }
        }
      }
    },
    "Đèn sáng hết. Đèn bỏ qua lịch cho tới khi bấm “Theo lịch”.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu menyala penuh. Lampu mengabaikan jadwal sampai Anda mengetuk “Sesuai jadwal”."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu menyala sepenuhnya. Lampu tidak mengikut jadual sehingga “Ikut jadual” diketik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไฟสว่างเต็มที่แล้ว โคมไฟจะไม่ทำงานตามตารางเวลาจนกว่าจะกด “ตามตารางเวลา”"
          }
        }
      }
    },
    "Đèn sáng từ bây giờ tới %@ (giờ tắt của lịch), %@ giờ.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu menyala dari sekarang sampai %1$@ (jam mati jadwal), %2$@ jam."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu menyala dari sekarang hingga %@ (waktu padam dalam jadual), %@ jam."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟจะสว่างตั้งแต่ตอนนี้ถึง %1$@ (เวลาปิดตามตารางเวลา) รวม %2$@ ชั่วโมง"
          }
        }
      }
    },
    "Đèn sáng với màu của lịch tới %@, rồi tự chạy lại theo lịch.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu menyala dengan warna jadwal sampai %@, lalu kembali mengikuti jadwal dengan sendirinya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu menyala dengan warna jadual hingga %@, kemudian kembali mengikut jadual secara automatik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟสว่างด้วยสีตามตารางเวลาถึง %@ แล้วจะกลับมาทำงานตามตารางเวลาเอง"
          }
        }
      }
    },
    "Đèn tìm thấy": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu yang ditemukan"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu yang ditemui"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟที่พบ"
          }
        }
      }
    },
    "Đèn tắt": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu mati"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu padam"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟปิดอยู่"
          }
        }
      }
    },
    "Đèn đang chỉnh tay (%lld%%), không chạy theo lịch.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu sedang diatur manual (%lld%%), tidak mengikuti jadwal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu sedang dilaraskan secara manual (%lld%%), tidak mengikut jadual."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟกำลังปรับด้วยตนเอง (%lld%%) ไม่ได้ทำงานตามตารางเวลา"
          }
        }
      }
    },
    "Đèn đang dùng lịch này": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu sedang memakai jadwal ini"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu sedang menggunakan jadual ini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟกำลังใช้ตารางเวลานี้"
          }
        }
      }
    },
    "Đèn đang hiện màu thử.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu sedang menampilkan warna uji."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu sedang memaparkan warna ujian."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟกำลังแสดงสีทดสอบ"
          }
        }
      }
    },
    "Đèn đang sáng theo lịch rồi.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu sudah menyala sesuai jadwal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu sudah menyala mengikut jadual."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟกำลังเปิดตามตารางเวลาอยู่แล้ว"
          }
        }
      }
    },
    "Đèn đang tắt bằng tay, không chạy theo lịch.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu dimatikan manual, tidak mengikuti jadwal."
          }
        },
        "ms": {
          "stringUnit": {
