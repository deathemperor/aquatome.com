    "Đứng gần đèn và giữ ứng dụng mở khi bấm. Đèn không báo lại trạng thái. Hẹn giờ của đèn vẫn đặt trong ứng dụng Fish lamp.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdirilah di dekat lampu dan biarkan aplikasi terbuka saat menekan. Lampu tidak melaporkan statusnya. Pengatur waktu lampu tetap diatur di aplikasi Fish lamp."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdiri dekat lampu dan biarkan aplikasi terbuka semasa menekan. Lampu tidak melaporkan keadaannya. Pemasa lampu masih ditetapkan dalam aplikasi Fish lamp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนใกล้ไฟและเปิดแอปไว้ขณะกด ไฟไม่รายงานสถานะกลับมา ตั้งเวลาของไฟยังตั้งในแอป Fish lamp"
          }
        }
      }
    },
    "Áp máy sát kính sạch cho bớt lóa và vết bẩn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempelkan ponsel ke kaca yang bersih agar silau dan noda berkurang."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapatkan kamera pada kaca yang bersih untuk mengurangkan silau dan kesan kotoran."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนบกล้องชิดกระจกที่สะอาดเพื่อลดแสงสะท้อนและคราบ"
          }
        }
      }
    },
