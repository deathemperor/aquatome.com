    "Ổ cắm": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopkontak"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Soket"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลั๊กไฟ"
          }
        }
      }
    },
    "Ổ cắm này đã được gỡ khỏi bể.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopkontak ini sudah dilepas dari akuarium."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Soket ini telah dikeluarkan dari tangki."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลั๊กไฟนี้ถูกนำออกจากตู้แล้ว"
          }
        }
      }
    },
    "Ổ cắm thông minh": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopkontak pintar"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Palam pintar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลั๊กไฟอัจฉริยะ"
          }
        }
      }
    },
    "Ổ này cấp điện cho CO2. Bật nhầm, nhất là ban đêm, có thể làm cá ngạt.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Colokan ini mengalirkan listrik ke CO2. Salah menyalakannya, apalagi malam hari, bisa membuat ikan sesak napas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Soket ini membekalkan kuasa kepada CO2. Jika tersilap dihidupkan, terutamanya pada waktu malam, ikan boleh lemas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่องนี้จ่ายไฟให้ CO2 หากเปิดผิด โดยเฉพาะตอนกลางคืน ปลาอาจขาดอากาศหายใจ"
          }
        }
      }
    },
    "Ổ này cấp điện cho sưởi. Bật tắt nhầm có thể làm nước quá lạnh hoặc quá nóng.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Colokan ini mengalirkan listrik ke pemanas. Salah menyalakan atau mematikannya bisa membuat air terlalu dingin atau terlalu panas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Soket ini membekalkan kuasa kepada pemanas. Jika tersilap dihidupkan atau dimatikan, air boleh menjadi terlalu sejuk atau terlalu panas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่องนี้จ่ายไฟให้ฮีตเตอร์ หากเปิดหรือปิดผิด น้ำอาจเย็นหรือร้อนเกินไป"
          }
        }
      }
    },
    "Ổ “%@” tự tắt lúc %@. Mất điện là đèn mất giờ nên không tự bật theo lịch của nó. Tắt hẹn giờ của ổ trong Smart Life để đèn tự chạy lịch.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Colokan “%1$@” mati sendiri pukul %2$@. Saat listrik padam, jam lampu hilang sehingga lampu tidak menyala sendiri sesuai jadwalnya. Matikan timer colokan di Smart Life agar lampu menjalankan jadwalnya sendiri."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Soket “%1$@” dimatikan secara automatik pada %2$@. Apabila bekalan elektrik terputus, jam lampu akan hilang, jadi lampu tidak menyala sendiri mengikut jadualnya. Matikan pemasa soket dalam Smart Life supaya lampu menjalankan jadualnya sendiri."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่อง “%1$@” ปิดเองเวลา %2$@ เมื่อไฟดับ เวลาในโคมไฟจะหายไป โคมไฟจึงไม่เปิดเองตามตารางเวลาของมัน ปิดการตั้งเวลาของช่องนี้ใน Smart Life เพื่อให้โคมไฟทำงานตามตารางเวลาของตัวเอง"
          }
        }
      }
    },
    "Ở trang Overview của dự án, sao chép Access ID và Access Secret vào ô dưới đây.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di halaman Overview proyek, salin Access ID dan Access Secret ke kolom di bawah."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Di halaman Overview projek, salin Access ID dan Access Secret ke dalam ruangan di bawah."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่หน้า Overview ของโปรเจกต์ คัดลอก Access ID และ Access Secret มาใส่ช่องด้านล่าง"
          }
        }
      }
    },
    "“%@” có kết quả trong %@.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” punya hasil di %2$@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ada hasil dalam %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” มีผลลัพธ์ใน %2$@"
          }
        }
