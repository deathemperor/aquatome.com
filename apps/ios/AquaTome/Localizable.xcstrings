    "Đã 23:59: hôm nay không còn giờ để bật thêm.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah pukul 23:59: hari ini tidak ada waktu lagi untuk menyalakan lampu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah pukul 23:59: tiada masa lagi untuk menghidupkan lampu hari ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ 23:59 แล้ว วันนี้ไม่มีเวลาเหลือให้เปิดไฟเพิ่ม"
          }
        }
      }
    },
    "Đã chỉnh giờ đèn: %@.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam lampu sudah disamakan: %@."
          }
        },
        "ms": {
          "stringUnit": {
