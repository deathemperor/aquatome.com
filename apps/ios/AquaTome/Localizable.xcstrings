    "Đang dùng bản đã lưu trên máy (%lld trang).": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memakai salinan yang tersimpan di ponsel (%lld halaman)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังใช้สำเนาที่บันทึกไว้ในเครื่อง (%lld หน้า)"
          }
        }
      }
    },
    "Đang ghi…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang menulis…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังบันทึก…"
          }
        }
      }
    },
    "Đang gửi lệnh…": {
      "localizations": {
