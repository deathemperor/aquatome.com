    "Apple chưa xác nhận được: thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple belum bisa mengonfirmasi: coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple belum dapat mengesahkan: cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ยังยืนยันไม่ได้ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "AquaTome": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome"
          }
        }
      }
    },
    "AquaTome bật tắt ổ cắm Smart Life (Tuya) bằng dự án đám mây Tuya của chính bạn: ứng dụng gọi thẳng Tuya, không qua máy chủ AquaTome và không cần tài khoản AquaTome.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome menyalakan dan mematikan stopkontak Smart Life (Tuya) dengan proyek cloud Tuya milik Anda sendiri: aplikasi langsung menghubungi Tuya, tidak lewat server AquaTome, dan tidak perlu akun AquaTome."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome menghidupkan dan mematikan palam pintar Smart Life (Tuya) melalui projek awan Tuya anda sendiri: aplikasi menghubungi Tuya terus, tanpa melalui pelayan AquaTome dan tanpa memerlukan akaun AquaTome."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome เปิดปิดปลั๊กไฟ Smart Life (Tuya) ผ่านโปรเจกต์คลาวด์ Tuya ของคุณเอง แอปเชื่อมต่อกับ Tuya โดยตรง ไม่ผ่านเซิร์ฟเวอร์ของ AquaTome และไม่ต้องมีบัญชี AquaTome"
          }
        }
      }
    },
    "AquaTome chưa được dùng Bluetooth. Bật trong Cài đặt → AquaTome → Bluetooth.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome belum diizinkan memakai Bluetooth. Aktifkan di Pengaturan → AquaTome → Bluetooth."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome belum dibenarkan menggunakan Bluetooth. Hidupkan dalam Seting → AquaTome → Bluetooth."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome ยังไม่ได้รับอนุญาตให้ใช้บลูทูธ เปิดได้ที่ การตั้งค่า → AquaTome → บลูทูธ"
          }
        }
      }
    },
    "AquaTome gửi câu hỏi tới Claude và lưu đến khi bạn xóa tài khoản.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome mengirim pertanyaan ke Claude dan menyimpannya sampai Anda menghapus akun."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome menghantar soalan kepada Claude dan menyimpannya sehingga anda memadam akaun."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome ส่งคำถามไปยัง Claude และเก็บไว้จนกว่าคุณจะลบบัญชี"
          }
        }
      }
    },
    "AquaTome không liên quan tới hãng Chihiros. Các lệnh Bluetooth theo ghi chép mã nguồn mở [chihiros-led-control](https://github.com/TheMicDiet/chihiros-led-control) (giấy phép MIT).": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome tidak berafiliasi dengan Chihiros. Perintah Bluetooth mengikuti dokumentasi sumber terbuka [chihiros-led-control](https://github.com/TheMicDiet/chihiros-led-control) (lisensi MIT)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome tiada kaitan dengan syarikat Chihiros. Arahan Bluetooth adalah berdasarkan dokumentasi sumber terbuka [chihiros-led-control](https://github.com/TheMicDiet/chihiros-led-control) (lesen MIT)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome ไม่มีส่วนเกี่ยวข้องกับบริษัท Chihiros คำสั่ง Bluetooth อ้างอิงตามบันทึกโอเพนซอร์ส [chihiros-led-control](https://github.com/TheMicDiet/chihiros-led-control) (สัญญาอนุญาต MIT)"
          }
        }
      }
    },
    "AquaTome đã hết lượt hỏi Claude hôm nay": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatah pertanyaan AquaTome ke Claude hari ini habis"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Had soalan AquaTome kepada Claude hari ini telah habis"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้ AquaTome ใช้โควตาถาม Claude หมดแล้ว"
          }
        }
      }
    },
