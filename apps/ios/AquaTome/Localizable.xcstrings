    "Bluetooth đang tắt. Bật Bluetooth rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth mati. Nyalakan Bluetooth lalu coba lagi."
