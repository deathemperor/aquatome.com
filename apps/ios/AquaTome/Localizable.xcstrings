          }
        }
      }
    },
    "Vẫn lập lịch được ở dưới: ứng dụng nhớ lịch trên máy này để ghi vào đèn sau.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal tetap bisa dibuat di bawah: aplikasi menyimpannya di perangkat ini untuk ditulis ke lampu nanti."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadual masih boleh ditetapkan di bawah: aplikasi menyimpan jadual pada peranti ini untuk ditulis ke lampu kemudian."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังตั้งตารางเวลาด้านล่างได้: แอปจะจำตารางเวลาไว้ในเครื่องนี้เพื่อบันทึกลงโคมไฟภายหลัง"
          }
        }
      }
    },
    "Vẫn đang nhận diện… có thể mất đến một phút.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih mengenali… bisa sampai satu menit."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih mengecam… mungkin mengambil masa sehingga seminit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังระบุชนิดอยู่… อาจใช้เวลาถึงหนึ่งนาที"
          }
        }
      }
    },
