    "Thêm bể đầu tiên để ghi lại kích thước, nền và ghi chú.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan akuarium pertama untuk mencatat ukuran, substrat, dan catatan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มตู้แรกเพื่อบันทึกขนาด วัสดุปูพื้น และบันทึก"
          }
        }
      }
    },
    "Thêm cá hoặc cây": {
