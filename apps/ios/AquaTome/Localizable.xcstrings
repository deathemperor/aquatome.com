            "state": "translated",
            "value": "Online"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออนไลน์"
          }
        }
      }
    },
    "Tuya không cho dự án xem thiết bị: liên kết tài khoản Smart Life bằng mã QR (bước 4 trong phần thiết lập) và kiểm tra trung tâm dữ liệu.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuya tidak mengizinkan proyek melihat perangkatnya: tautkan akun Smart Life dengan kode QR (langkah 4 di pengaturan) dan periksa pusat datanya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuya ไม่อนุญาตให้โปรเจกต์เห็นอุปกรณ์ เชื่อมบัญชี Smart Life ด้วยคิวอาร์โค้ด (ขั้นตอนที่ 4 ในการตั้งค่า) และตรวจสอบศูนย์ข้อมูล"
          }
        }
      }
    },
    "Tuya không nhận khóa này: kiểm tra Access ID, Access Secret và trung tâm dữ liệu.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuya tidak menerima kunci ini: periksa Access ID, Access Secret, dan pusat datanya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuya ไม่รับคีย์นี้ โปรดตรวจสอบ Access ID, Access Secret และศูนย์ข้อมูล"
          }
        }
      }
    },
    "Tuya trả lời không như mong đợi: thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban Tuya tidak seperti yang diharapkan: coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuya ตอบกลับไม่ตรงตามที่คาดไว้ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Tuya từ chối (mã %lld).": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuya menolak (kode %lld)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuya ปฏิเสธ (รหัส %lld)"
          }
        }
      }
    },
    "Tuya đang bận: thử lại sau một lát.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuya sedang sibuk: coba lagi sebentar lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuya ไม่ว่างอยู่ โปรดลองใหม่อีกสักครู่"
          }
        }
      }
    },
    "Tuổi thọ": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Umur hidup"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อายุขัย"
          }
        }
      }
    },
    "Tài khoản có dữ liệu từ bản ứng dụng mới hơn: cập nhật AquaTome để đồng bộ.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun berisi data dari versi aplikasi yang lebih baru: perbarui AquaTome untuk menyinkronkan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีนี้มีข้อมูลจากแอปเวอร์ชันที่ใหม่กว่า โปรดอัปเดต AquaTome เพื่อซิงค์ข้อมูล"
          }
        }
      }
    },
    "Tài khoản đã đủ chỗ (200 bể, 400 đèn): xóa bớt rồi đồng bộ lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun sudah penuh (200 akuarium, 400 lampu): hapus sebagian lalu sinkronkan lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีเต็มแล้ว (200 ตู้, 400 โคม) โปรดลบบางรายการออกแล้วซิงค์ใหม่"
          }
        }
      }
    },
