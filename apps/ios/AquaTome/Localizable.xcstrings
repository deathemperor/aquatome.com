      }
    },
    "Chính sách bảo mật": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebijakan privasi"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasar privasi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นโยบายความเป็นส่วนตัว"
          }
        }
      }
    },
    "Chưa chạy được bước kiểm tra chống spam: bấm để thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan antispam belum berjalan: ketuk untuk mencoba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakan antispam belum dapat dijalankan: ketik untuk cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังตรวจสอบป้องกันสแปมไม่ได้ แตะเพื่อลองอีกครั้ง"
          }
        }
      }
    },
    "Chưa chọn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dipilih"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dipilih"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้เลือก"
          }
        }
      }
    },
    "Chưa có bình luận. Hãy là người đầu tiên chia sẻ kinh nghiệm.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada komentar. Jadilah yang pertama berbagi pengalaman."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada komen. Jadilah yang pertama berkongsi pengalaman."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีความคิดเห็น มาเป็นคนแรกที่แบ่งปันประสบการณ์"
          }
        }
      }
    },
    "Chưa có bể nào": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada akuarium"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada tangki"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีตู้ปลา"
          }
        }
      }
    },
    "Chưa có khóa Tuya: thiết lập ở mục “Ổ cắm thông minh” trong Bể của tôi.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada kunci Tuya: atur di bagian “Stopkontak pintar” di Akuarium saya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada kunci Tuya: sediakan di bahagian “Palam pintar” dalam Tangki saya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีคีย์ Tuya: ตั้งค่าได้ที่หัวข้อ “ปลั๊กไฟอัจฉริยะ” ใน ตู้ของฉัน"
          }
        }
      }
    },
    "Chưa có kích thước.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada ukuran."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada saiz."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีขนาด"
          }
        }
      }
    },
    "Chưa có mạng": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada koneksi"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada sambungan internet"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอินเทอร์เน็ต"
          }
        }
      }
    },
    "Chưa có trong cẩm nang.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada di panduan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada dalam buku panduan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีในคู่มือ"
          }
        }
      }
    },
    "Chưa có ảnh nào. Bạn nuôi %@? Gửi một tấm ảnh cho mọi người cùng xem.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada foto. Anda memelihara %@? Kirim fotonya agar semua bisa ikut melihat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada foto. Anda membela %@? Hantar sekeping foto untuk dilihat semua."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีรูปภาพ คุณเลี้ยง %@ อยู่หรือเปล่า ส่งรูปมาให้ทุกคนได้ดูกัน"
          }
        }
      }
    },
    "Chưa ghi lịch nào từ AquaTome.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada jadwal yang disimpan dari AquaTome."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada jadual yang direkodkan daripada AquaTome."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้บันทึกตารางเวลาใดจาก AquaTome"
          }
        }
      }
    },
    "Chưa ghi ổ này cắm gì: nếu là sưởi hay CO2, bật tắt nhầm có thể hại cá. Chọn “Cắm gì” trong Sửa để khỏi hỏi lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dicatat colokan ini dipakai untuk apa: kalau untuk pemanas atau CO2, salah menyalakan atau mematikannya bisa membahayakan ikan. Pilih “Dipakai untuk” di Edit agar tidak ditanya lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum direkodkan soket ini digunakan untuk apa: jika untuk pemanas atau CO2, tersalah hidupkan atau matikan boleh membahayakan ikan. Pilih “Digunakan untuk” dalam Edit supaya tidak ditanya lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ระบุว่าช่องนี้ใช้กับอะไร หากเป็นฮีตเตอร์หรือ CO2 การเปิดหรือปิดผิดอาจเป็นอันตรายต่อปลา เลือก “ใช้กับอะไร” ในแก้ไขเพื่อไม่ต้องถามอีก"
          }
        }
      }
    },
    "Chưa gửi lệnh: %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah belum dikirim: %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahan belum dihantar: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ส่งคำสั่ง: %@"
          }
        }
      }
    },
    "Chưa gửi được email: thử lại sau.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Email belum terkirim: coba lagi nanti."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mel belum dapat dihantar: cuba lagi nanti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งอีเมลไม่สำเร็จ โปรดลองใหม่ภายหลัง"
          }
        }
      }
    },
    "Chưa kết nối đèn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu belum terhubung."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu belum disambungkan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้เชื่อมต่อโคมไฟ"
          }
        }
      }
    },
    "Chưa kết nối được aquatome.com.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum bisa terhubung ke aquatome.com."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dapat menyambung ke aquatome.com."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังเชื่อมต่อ aquatome.com ไม่ได้"
          }
        }
      }
    },
    "Chưa kết nối được đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum bisa terhubung ke lampu"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dapat menyambung ke lampu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังเชื่อมต่อโคมไฟไม่ได้"
          }
        }
      }
    },
    "Chưa kết nối được với Claude. Câu này không bị tính.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum bisa terhubung ke Claude. Pertanyaan ini tidak dihitung."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dapat menyambung ke Claude. Soalan ini tidak dikira."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังเชื่อมต่อกับ Claude ไม่ได้ คำถามนี้ไม่นับ"
          }
        }
      }
    },
    "Chưa lưu lịch nào cho đèn này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada jadwal tersimpan untuk lampu ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada jadual disimpan untuk lampu ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้บันทึกตารางเวลาสำหรับไฟนี้"
          }
        }
      }
    },
    "Chưa lưu được thay đổi. Thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan belum tersimpan. Coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan belum dapat disimpan. Cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังบันทึกการเปลี่ยนแปลงไม่สำเร็จ ลองอีกครั้ง"
          }
        }
      }
    },
    "Chưa nhìn rõ để nhận diện. Thử chụp ngang thân, gần hơn, qua kính sạch và không bật flash.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum cukup jelas untuk dikenali. Coba foto dari samping, lebih dekat, lewat kaca yang bersih, tanpa flash."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum cukup jelas untuk dikenal pasti. Cuba ambil dari sisi badan, lebih dekat, melalui kaca yang bersih dan tanpa denyar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพยังไม่ชัดพอจะระบุได้ ลองถ่ายด้านข้าง เข้าใกล้ขึ้น ผ่านกระจกที่สะอาด และไม่เปิดแฟลช"
          }
        }
      }
    },
    "Chưa nhận diện được lúc này. Thử lại sau ít phút nhé.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum bisa mengenali saat ini. Coba lagi beberapa menit lagi, ya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dapat mengenal pasti buat masa ini. Cuba lagi dalam beberapa minit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ยังระบุไม่ได้ ลองใหม่อีกสักครู่นะ"
          }
        }
      }
    },
    "Chưa thêm được passkey: thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey belum berhasil ditambahkan: coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey belum dapat ditambah: cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังเพิ่ม passkey ไม่สำเร็จ: ลองอีกครั้ง"
          }
        }
      }
    },
    "Chưa trả lời được câu này": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertanyaan ini belum bisa dijawab"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Soalan ini belum dapat dijawab"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังตอบคำถามนี้ไม่ได้"
          }
        }
      }
    },
    "Chưa xác nhận: ổ cắm chưa báo đã đổi.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum terkonfirmasi: stopkontak belum melaporkan perubahan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum disahkan: soket belum melaporkan perubahan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ยืนยัน: ปลั๊กไฟยังไม่รายงานว่าเปลี่ยนแล้ว"
          }
        }
      }
    },
    "Chưa xóa: cần đăng nhập lại bằng Apple để xác nhận.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dihapus: masuk lagi dengan Apple untuk mengonfirmasi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dipadam: perlu log masuk semula dengan Apple untuk mengesahkan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ลบ ต้องเข้าสู่ระบบด้วย Apple อีกครั้งเพื่อยืนยัน"
          }
        }
      }
    },
    "Chưa đọc được giờ của đèn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam lampu belum bisa dibaca."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dapat membaca waktu lampu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังอ่านเวลาของโคมไฟไม่ได้"
          }
        }
      }
    },
    "Chưa đọc được hẹn giờ của ổ: %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum bisa membaca timer colokan: %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dapat membaca pemasa soket: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังอ่านการตั้งเวลาของช่องไม่ได้: %@"
          }
        }
      }
    },
    "Chưa đồng bộ": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum disinkronkan"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum disegerakkan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ซิงค์"
          }
        }
      }
    },
    "Chưa đồng bộ được": {
      "localizations": {
