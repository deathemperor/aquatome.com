        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกไว้อ่านทีหลัง"
          }
        }
      }
    },
    "Lịch %@, sáng dần %lld phút": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal %1$@, terang bertahap %2$lld menit"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเวลา %1$@ ค่อยๆ สว่างขึ้น %2$lld นาที"
          }
        }
      }
    },
    "Lịch mẫu": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat jadwal"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางสำเร็จรูป"
          }
        }
      }
    },
    "Lịch mỗi ngày": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal harian"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเวลาประจำวัน"
          }
        }
      }
    },
    "Lịch thay nước, phân bón, CO₂…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal ganti air, pupuk, CO₂…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเปลี่ยนน้ำ ปุ๋ย CO₂…"
          }
        }
      }
    },
    "Lịch đang lưu trên đèn, kể cả lịch đặt bằng ứng dụng My Chihiros, sẽ bị thay bằng lịch này. Ghi lịch?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal yang tersimpan di lampu, termasuk yang diatur lewat aplikasi My Chihiros, akan diganti dengan jadwal ini. Simpan jadwal?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเวลาที่เก็บอยู่ในโคมไฟ รวมถึงตารางเวลาที่ตั้งด้วยแอป My Chihiros จะถูกแทนที่ด้วยตารางเวลานี้ บันทึกตารางเวลาหรือไม่"
          }
        }
      }
    },
    "Lịch đã ghi cho đèn này": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal yang sudah disimpan untuk lampu ini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเวลาที่บันทึกให้โคมไฟนี้"
          }
        }
      }
    },
    "Lịch đặt bằng ứng dụng My Chihiros (nếu có) vẫn chạy; đèn không cho đọc lại lịch đó.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal yang diatur lewat aplikasi My Chihiros (jika ada) tetap berjalan; lampu tidak mengizinkan jadwal itu dibaca kembali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางเวลาที่ตั้งด้วยแอป My Chihiros (ถ้ามี) ยังทำงานอยู่ แต่โคมไฟไม่อนุญาตให้อ่านตารางเวลานั้น"
          }
        }
      }
    },
    "Lọc": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอง"
          }
        }
      }
    },
    "Lọc kết quả": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saring hasil"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรองผลการค้นหา"
          }
        }
      }
    },
    "Lọc theo bể của bạn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter sesuai akuarium Anda"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรองตามตู้ของคุณ"
          }
        }
      }
    },
    "Lọc theo bể và nước": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter berdasarkan akuarium dan air"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรองตามตู้และค่าน้ำ"
          }
        }
      }
    },
    "Muốn gỡ ảnh sau này? Lưu link riêng này (chỉ hiện một lần):": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingin menghapus foto nanti? Simpan tautan pribadi ini (hanya ditampilkan sekali):"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องการลบรูปภายหลัง? บันทึกลิงก์ส่วนตัวนี้ไว้ (แสดงเพียงครั้งเดียว):"
          }
        }
      }
    },
    "Muốn xem các bể này trên aquatome.com hoặc trên máy khác? Đăng nhập để đồng bộ. Không bắt buộc: không đăng nhập thì bể vẫn lưu trên máy này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingin melihat akuarium ini di aquatome.com atau di perangkat lain? Masuk untuk menyinkronkan. Tidak wajib: tanpa masuk, akuarium tetap tersimpan di perangkat ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องการดูตู้ปลาเหล่านี้บน aquatome.com หรือบนอุปกรณ์อื่นใช่ไหม เข้าสู่ระบบเพื่อซิงค์ข้อมูล ไม่บังคับ หากไม่เข้าสู่ระบบ ตู้ปลาจะยังคงบันทึกอยู่ในอุปกรณ์นี้"
          }
        }
      }
    },
    "Màu trên màn hình chỉ gần đúng.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna di layar hanya perkiraan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีบนหน้าจอเป็นเพียงค่าโดยประมาณ"
          }
        }
      }
    },
    "Màu và độ sáng": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna dan kecerahan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีและความสว่าง"
          }
        }
      }
    },
    "Máy còn ít chỗ trống. Hãy giải phóng bớt dung lượng rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang penyimpanan hampir penuh. Kosongkan sebagian lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่เก็บข้อมูลเหลือน้อย ลบข้อมูลบางส่วนแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Máy này không có Bluetooth.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini tidak punya Bluetooth."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องนี้ไม่มีบลูทูธ"
          }
        }
      }
    },
    "Máy này đã có passkey của tài khoản này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini sudah memiliki passkey untuk akun ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้มี passkey ของบัญชีนี้อยู่แล้ว"
          }
        }
      }
    },
    "Mã 6 số trong email": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode 6 digit di email"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัส 6 หลักในอีเมล"
          }
        }
      }
    },
    "Mã không đúng hoặc đã hết hạn: kiểm tra lại, hoặc gửi mã mới.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode salah atau sudah kedaluwarsa: periksa lagi, atau kirim kode baru."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสไม่ถูกต้องหรือหมดอายุแล้ว โปรดตรวจสอบอีกครั้งหรือขอรหัสใหม่"
          }
        }
      }
    },
    "Mùa hè": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Musim panas"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฤดูร้อน"
          }
        }
      }
    },
    "Mất kết nối": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi terputus"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขาดการเชื่อมต่อ"
          }
        }
      }
    },
    "Mất kết nối với %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi ke %@ terputus"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขาดการเชื่อมต่อกับ %@"
          }
        }
      }
    },
    "Mất kết nối với đèn. Lại gần đèn rồi bấm “Kết nối lại”.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi ke lampu terputus. Dekati lampu lalu ketuk “Hubungkan ulang”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขาดการเชื่อมต่อกับโคมไฟ ขยับเข้าใกล้โคมไฟแล้วแตะ “เชื่อมต่ออีกครั้ง”"
          }
        }
      }
    },
    "Mặc định": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawaan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าเริ่มต้น"
          }
        }
      }
    },
    "Mọi ổ cắm trong dự án Tuya đã ở trên một bể.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua stopkontak di proyek Tuya sudah dipasang di akuarium."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลั๊กไฟทุกตัวในโปรเจกต์ Tuya อยู่บนตู้แล้ว"
          }
        }
      }
    },
    "Mở Cài đặt": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Pengaturan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการตั้งค่า"
          }
        }
      }
    },
    "Mở platform.tuya.com": {
      "localizations": {
        "id": {
          "stringUnit": {
