            "state": "translated",
            "value": "เปิดเวลา %@"
          }
        }
      }
    },
    "Bật ngay với màu của lịch tới %@, rồi chạy lại theo lịch.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan sekarang dengan warna jadwal sampai %@, lalu kembali mengikuti jadwal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan sekarang dengan warna jadual hingga %@, kemudian kembali mengikut jadual."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไฟทันทีด้วยสีตามตารางเวลาถึง %@ แล้วกลับมาทำงานตามตารางเวลา"
          }
        }
      }
    },
    "Bật tắt nhanh": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyala/mati cepat"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidup/mati pantas"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด/ปิดด่วน"
          }
        }
      }
    },
    "Bật tắt ổ cắm Smart Life ngay trên bể, bằng dự án Tuya của riêng bạn: không cần tài khoản AquaTome.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan dan matikan stopkontak Smart Life langsung dari akuarium, dengan proyek Tuya milik Anda sendiri: tidak perlu akun AquaTome."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan dan matikan palam pintar Smart Life terus dari tangki, melalui projek Tuya anda sendiri: tidak perlu akaun AquaTome."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดปิดปลั๊กไฟ Smart Life ได้จากหน้าตู้ ด้วยโปรเจกต์ Tuya ของคุณเอง ไม่ต้องมีบัญชี AquaTome"
          }
        }
      }
    },
    "Bật với màu của lịch": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan dengan warna jadwal"
