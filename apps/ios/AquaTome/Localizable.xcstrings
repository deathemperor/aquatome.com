{
  "sourceLanguage": "vi",
  "strings": {
    "%@ chưa có trang trong cẩm nang. Vẫn thêm vào bể được: khi có trang, bể sẽ hiện trang đó.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belum punya halaman di panduan. Tetap bisa ditambahkan ke akuarium: begitu halamannya ada, akuarium akan menampilkannya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ยังไม่มีหน้าในคู่มือ แต่ยังเพิ่มลงตู้ได้ เมื่อมีหน้าแล้ว ตู้จะแสดงหน้านั้นเอง"
          }
        }
      }
    },
    "%@ lít": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liter"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ลิตร"
          }
        }
      }
    },
    "%@ tiếng": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jam"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ชั่วโมง"
          }
        }
      }
    },
    "%@, ảnh %lld": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, foto %lld"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ภาพที่ %lld"
          }
        }
      }
    },
    "%lld bản ghi không hợp lệ nên chưa vào tài khoản.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld data tidak valid sehingga belum masuk ke akun."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มี %lld รายการที่ไม่ถูกต้อง จึงยังไม่ได้เพิ่มเข้าบัญชี"
          }
        }
      }
    },
    "%lld con": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ekor"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ตัว"
          }
        }
      }
    },
    "%lld loài phù hợp": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld spesies cocok"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ชนิดที่เหมาะสม"
          }
        }
      }
    },
    "%lld loài phù hợp · %lld loài chưa đủ dữ liệu để chắc": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld spesies cocok · %2$lld spesies datanya belum cukup untuk memastikan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหมาะสม %1$lld ชนิด · ข้อมูลยังไม่พอจะยืนยัน %2$lld ชนิด"
          }
        }
      }
    },
    "%lld phút": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld menit"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld นาที"
          }
        }
      }
    },
    "%lld trang": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld halaman"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld หน้า"
          }
        }
      }
    },
    "%lld đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lampu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟ %lld ดวง"
          }
        }
      }
    },
    "%lld ảnh": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld foto"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ภาพ"
          }
        }
      }
    },
    "%lld ổ": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld colokan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ช่อง"
          }
        }
      }
    },
    "%lld ổ · Mất kết nối": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld colokan · Koneksi terputus"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ช่อง · ขาดการเชื่อมต่อ"
          }
        }
      }
    },
    "(xong)": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "(selesai)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "(เสร็จแล้ว)"
          }
        }
      }
    },
    ", sáng hẳn %@ tiếng": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ", terang penuh %@ jam"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ", สว่างเต็มที่ %@ ชั่วโมง"
          }
        }
      }
    },
    "1–2 tuần, kèm thay nước, vệ sinh.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1–2 minggu, disertai ganti air dan pembersihan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1–2 สัปดาห์ ควบคู่กับการเปลี่ยนน้ำและทำความสะอาด"
          }
        }
      }
    },
    "2–4 tuần đầu: ít giờ, đèn nhẹ để rêu khó bám.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "2–4 minggu pertama: jam nyala singkat, lampu redup agar lumut sulit tumbuh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "2–4 สัปดาห์แรก: เปิดไฟน้อยชั่วโมงและแสงอ่อน เพื่อไม่ให้ตะไคร่เกาะง่าย"
          }
        }
      }
    },
    "6–8 tiếng là vừa cho bể thủy sinh.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "6–8 jam sudah pas untuk akuarium tanaman air."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "6–8 ชั่วโมงกำลังพอดีสำหรับตู้ไม้น้ำ"
          }
        }
      }
    },
    "AT dưới nước": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AT di bawah air"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AT ใต้น้ำ"
          }
        }
      }
    },
    "Access ID": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Access ID"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Access ID"
          }
        }
      }
    },
    "Access Secret": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Access Secret"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Access Secret"
          }
        }
      }
    },
    "Apple chưa xác nhận được: thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple belum bisa mengonfirmasi: coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ยังยืนยันไม่ได้ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "AquaTome": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome"
          }
        }
      }
    },
    "AquaTome bật tắt ổ cắm Smart Life (Tuya) bằng dự án đám mây Tuya của chính bạn: ứng dụng gọi thẳng Tuya, không qua máy chủ AquaTome và không cần tài khoản AquaTome.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome menyalakan dan mematikan stopkontak Smart Life (Tuya) dengan proyek cloud Tuya milik Anda sendiri: aplikasi langsung menghubungi Tuya, tidak lewat server AquaTome, dan tidak perlu akun AquaTome."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome เปิดปิดปลั๊กไฟ Smart Life (Tuya) ผ่านโปรเจกต์คลาวด์ Tuya ของคุณเอง แอปเชื่อมต่อกับ Tuya โดยตรง ไม่ผ่านเซิร์ฟเวอร์ของ AquaTome และไม่ต้องมีบัญชี AquaTome"
          }
        }
      }
    },
    "AquaTome chưa được dùng Bluetooth. Bật trong Cài đặt → AquaTome → Bluetooth.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome belum diizinkan memakai Bluetooth. Aktifkan di Pengaturan → AquaTome → Bluetooth."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome ยังไม่ได้รับอนุญาตให้ใช้บลูทูธ เปิดได้ที่ การตั้งค่า → AquaTome → บลูทูธ"
          }
        }
      }
    },
    "AquaTome không liên quan tới hãng Chihiros. Các lệnh Bluetooth theo ghi chép mã nguồn mở [chihiros-led-control](https://github.com/TheMicDiet/chihiros-led-control) (giấy phép MIT).": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome tidak berafiliasi dengan Chihiros. Perintah Bluetooth mengikuti dokumentasi sumber terbuka [chihiros-led-control](https://github.com/TheMicDiet/chihiros-led-control) (lisensi MIT)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AquaTome ไม่มีส่วนเกี่ยวข้องกับบริษัท Chihiros คำสั่ง Bluetooth อ้างอิงตามบันทึกโอเพนซอร์ส [chihiros-led-control](https://github.com/TheMicDiet/chihiros-led-control) (สัญญาอนุญาต MIT)"
          }
        }
      }
    },
    "Biểu tượng ứng dụng": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikon aplikasi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอนแอป"
          }
        }
      }
    },
    "Bluetooth đang tắt. Bật Bluetooth rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth mati. Nyalakan Bluetooth lalu coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บลูทูธปิดอยู่ เปิดบลูทูธแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Bài viết nhắc đến các loài trong bể": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Artikel yang menyebut spesies di akuarium ini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บทความที่กล่าวถึงสายพันธุ์ในตู้นี้"
          }
        }
      }
    },
    "Báo cáo": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporkan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงาน"
          }
        }
      }
    },
    "Báo cáo bình luận này?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporkan komentar ini?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงานความคิดเห็นนี้ไหม?"
          }
        }
      }
    },
    "Báo cáo ảnh này?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporkan foto ini?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงานรูปนี้ไหม?"
          }
        }
      }
    },
    "Bây giờ": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้"
          }
        }
      }
    },
    "Bây giờ %@: đèn sáng %lld%%.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang %@: lampu menyala %lld%%."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ %@: ไฟสว่าง %lld%%"
          }
        }
      }
    },
    "Bây giờ %@: đèn tắt, bật lại lúc %@.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang %@: lampu mati, menyala lagi pukul %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ %@: ไฟปิดอยู่ จะเปิดอีกครั้งเวลา %@"
          }
        }
      }
    },
    "Bây giờ %@: đèn đang %@, %lld%%.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang %@: lampu sedang %@, %lld%%."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ %@: ไฟกำลัง%@ %lld%%"
          }
        }
      }
    },
    "Bình luận": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคิดเห็น"
          }
        }
      }
    },
    "Bình luận cần xác minh người dùng theo quy định; tính năng này sẽ sớm mở.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuai ketentuan, komentar memerlukan verifikasi pengguna; fitur ini akan segera tersedia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแสดงความคิดเห็นต้องยืนยันตัวตนผู้ใช้ตามข้อกำหนด ฟีเจอร์นี้จะเปิดให้ใช้งานเร็ว ๆ นี้"
          }
        }
      }
    },
    "Bình luận và ảnh của người này sẽ ẩn trên máy này. Bỏ chặn trong Bể của tôi, mục Người đã chặn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentar dan foto orang ini akan disembunyikan di perangkat ini. Buka blokir di Akuarium Saya, bagian Orang yang diblokir."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคิดเห็นและรูปของคนนี้จะถูกซ่อนบนเครื่องนี้ เลิกบล็อกได้ที่ ตู้ปลาของฉัน หัวข้อ คนที่บล็อกไว้"
          }
        }
      }
    },
    "Bình luận và ảnh của những người này đang ẩn trên máy này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentar dan foto orang-orang ini disembunyikan di perangkat ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคิดเห็นและรูปของคนเหล่านี้ถูกซ่อนอยู่บนเครื่องนี้"
          }
        }
      }
    },
    "Bình luận đang chờ duyệt.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentar sedang menunggu moderasi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคิดเห็นกำลังรอการอนุมัติ"
          }
        }
      }
    },
    "Bình luận được kiểm duyệt; quảng cáo và thông tin cá nhân sẽ bị gỡ.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentar dimoderasi; iklan dan informasi pribadi akan dihapus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคิดเห็นทุกรายการจะผ่านการตรวจสอบ โฆษณาและข้อมูลส่วนบุคคลจะถูกลบออก"
          }
        }
      }
    },
    "Bạn đã gửi đủ 5 ảnh hôm nay. Hãy quay lại ngày mai.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah mengirim 5 foto hari ini. Silakan kembali besok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้คุณส่งรูปครบ 5 รูปแล้ว โปรดกลับมาใหม่พรุ่งนี้"
          }
        }
      }
    },
    "Bấm vào tên để đổi": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk nama untuk mengubah"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะที่ชื่อเพื่อเปลี่ยน"
          }
        }
      }
    },
    "Bất kỳ": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa saja"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งหมด"
          }
        }
      }
    },
    "Bật": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด"
          }
        }
      }
    },
    "Bật Bluetooth, đứng gần đèn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan Bluetooth, berdirilah di dekat lampu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Bluetooth และอยู่ใกล้โคมไฟ"
          }
        }
      }
    },
    "Bật gói dùng thử IoT Core (Cloud → Cloud Services → IoT Core). Gói miễn phí phải gia hạn trong console khoảng mỗi tháng: hết hạn thì AquaTome không bật tắt được, còn hẹn giờ trên ổ cắm vẫn chạy.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan uji coba IoT Core (Cloud → Cloud Services → IoT Core). Paket gratis ini harus diperpanjang di konsol kira-kira setiap bulan: jika habis, AquaTome tidak bisa menyalakan atau mematikan, tetapi timer di stopkontak tetap berjalan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้แพ็กเกจทดลอง IoT Core (Cloud → Cloud Services → IoT Core) แพ็กเกจฟรีนี้ต้องต่ออายุในคอนโซลประมาณทุกเดือน หากหมดอายุ AquaTome จะเปิดปิดไม่ได้ แต่ตัวตั้งเวลาบนปลั๊กไฟยังทำงานอยู่"
          }
        }
      }
    },
    "Bật lúc": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyala pukul"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเวลา"
          }
        }
      }
    },
    "Bật lúc %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyala pukul %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเวลา %@"
          }
        }
      }
    },
    "Bật tắt nhanh": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyala/mati cepat"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด/ปิดด่วน"
          }
        }
      }
    },
    "Bật tắt ổ cắm Smart Life ngay trên bể, bằng dự án Tuya của riêng bạn: không cần tài khoản AquaTome.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan dan matikan stopkontak Smart Life langsung dari akuarium, dengan proyek Tuya milik Anda sendiri: tidak perlu akun AquaTome."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดปิดปลั๊กไฟ Smart Life ได้จากหน้าตู้ ด้วยโปรเจกต์ Tuya ของคุณเอง ไม่ต้องมีบัญชี AquaTome"
          }
        }
      }
    },
    "Bật “%@”?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan “%@”?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด “%@” ไหม"
          }
        }
      }
    },
    "Bắt đầu từ đây": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dari sini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มต้นที่นี่"
          }
        }
      }
    },
