        }
      }
    },
    "Chặn người này": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokir orang ini"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekat orang ini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บล็อกคนนี้"
          }
        }
      }
    },
    "Chỉ dùng cho thiết bị của riêng bạn: gói miễn phí của Tuya không dành cho việc dùng thương mại. Ổ cắm eWeLink (Sonoff) sẽ có sau.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk perangkat milik Anda sendiri: paket gratis Tuya tidak untuk penggunaan komersial. Stopkontak eWeLink (Sonoff) menyusul."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk peranti anda sendiri: pelan percuma Tuya bukan untuk kegunaan komersial. Palam eWeLink (Sonoff) akan menyusul."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กับอุปกรณ์ของคุณเองเท่านั้น แพ็กเกจฟรีของ Tuya ไม่ได้มีไว้สำหรับใช้เชิงพาณิชย์ ปลั๊กไฟ eWeLink (Sonoff) จะตามมาภายหลัง"
          }
        }
      }
    },
    "Chỉ dùng để nhận ra bạn khi đăng nhập: không lưu tên, số điện thoại, và địa chỉ email chỉ lưu ở dạng mã hóa một chiều.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya dipakai untuk mengenali Anda saat masuk: nama dan nomor telepon tidak disimpan, dan alamat email hanya disimpan dalam bentuk hash satu arah."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya digunakan untuk mengenali anda semasa log masuk: nama dan nombor telefon tidak disimpan, dan alamat e-mel hanya disimpan dalam bentuk cincangan sehala."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เพื่อระบุตัวคุณเมื่อเข้าสู่ระบบเท่านั้น ไม่เก็บชื่อและเบอร์โทรศัพท์ ส่วนอีเมลจะเก็บในรูปแบบเข้ารหัสทางเดียวเท่านั้น"
          }
        }
      }
    },
    "Chỉ nhận ảnh JPEG, PNG hoặc WebP.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya menerima gambar JPEG, PNG, atau WebP."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya foto JPEG, PNG atau WebP diterima."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รองรับเฉพาะภาพ JPEG, PNG หรือ WebP"
          }
        }
      }
    },
    "Chỉnh giờ đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur jam lampu"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan masa lampu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเวลาโคมไฟ"
          }
        }
      }
    },
    "Chỉnh giờ đèn theo máy này": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Samakan jam lampu dengan perangkat ini"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selaraskan masa lampu dengan peranti ini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเวลาโคมไฟตามเครื่องนี้"
          }
        }
      }
    },
    "Chỉnh từng màu": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur tiap warna"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laras setiap warna"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับทีละสี"
          }
        }
      }
    },
    "Chọn kiểu bể để có lịch gợi ý, rồi kéo giờ bật, giờ tắt trên thanh ngày. Đèn tự bật tắt theo đồng hồ của nó, không cần điện thoại ở gần.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jenis akuarium untuk mendapat jadwal yang disarankan, lalu geser jam nyala dan jam mati pada bilah hari. Lampu menyala dan mati sendiri sesuai jam internalnya, tanpa perlu ponsel di dekatnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jenis tangki untuk mendapatkan jadual cadangan, kemudian seret masa hidup dan masa padam pada bar hari. Lampu akan hidup dan padam sendiri mengikut jam dalamannya, tanpa perlu telefon berdekatan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกประเภทตู้เพื่อรับตารางเวลาแนะนำ แล้วลากเวลาเปิดและเวลาปิดบนแถบวัน โคมไฟจะเปิดปิดเองตามนาฬิกาในตัว ไม่ต้องมีโทรศัพท์อยู่ใกล้"
          }
        }
      }
    },
    "Chọn lịch và màu": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jadwal dan warna"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jadual dan warna"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกตารางเวลาและสี"
          }
        }
      }
    },
    "Chọn một bể của bạn để kiểm tra cùng cá đang có trong bể.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih salah satu akuarium Anda untuk memeriksanya bersama ikan yang sudah ada di dalamnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih salah satu tangki anda untuk menyemak bersama ikan yang sedia ada di dalamnya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกตู้ของคุณเพื่อตรวจร่วมกับปลาที่อยู่ในตู้แล้ว"
          }
        }
      }
    },
    "Chọn một ảnh trước đã.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih gambar terlebih dahulu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto dahulu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรุณาเลือกภาพก่อน"
          }
        }
      }
    },
    "Chọn ảnh có sẵn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto sedia ada"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรูปที่มีอยู่"
          }
        }
      }
    },
    "Chọn ổ": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih colokan"
          }
        },
        "ms": {
