            "value": "นี่คือ"
          }
        }
      }
    },
    "Đã chỉnh giờ đèn: %@.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam lampu sudah disamakan: %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเวลาโคมไฟแล้ว: %@"
          }
        }
      }
    },
    "Đã ghi: bật %@, tắt %@. Đèn chạy theo lịch từ bây giờ.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tersimpan: nyala %1$@, mati %2$@. Mulai sekarang lampu mengikuti jadwal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกแล้ว: เปิด %1$@ ปิด %2$@ โคมไฟจะทำงานตามตารางเวลาตั้งแต่นี้"
          }
        }
      }
    },
    "Đã gửi báo cáo. Cảm ơn bạn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan terkirim. Terima kasih."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งรายงานแล้ว ขอบคุณ"
          }
        }
      }
    },
    "Đã gửi mã tới %@. Mở email và nhập mã 6 số.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode sudah dikirim ke %@. Buka email dan masukkan kode 6 digit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งรหัสไปที่ %@ แล้ว เปิดอีเมลและกรอกรหัส 6 หลัก"
          }
        }
      }
    },
    "Đã kết nối %@, firmware %lld: bản này chưa hẹn giờ được từ ứng dụng, cập nhật firmware bằng ứng dụng My Chihiros.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung ke %1$@, firmware %2$lld: versi ini belum bisa diatur timernya dari aplikasi, perbarui firmware lewat aplikasi My Chihiros."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ %1$@ แล้ว firmware %2$lld: เวอร์ชันนี้ยังตั้งเวลาจากแอปไม่ได้ ให้อัปเดต firmware ด้วยแอป My Chihiros"
          }
        }
      }
    },
    "Đã kết nối %@.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terhubung."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ %@ แล้ว"
          }
        }
      }
    },
    "Đã kết nối %@. Đèn mới: làm theo các bước trong khung này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terhubung. Lampu baru: ikuti langkah-langkah di kotak ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ %@ แล้ว หากเป็นโคมไฟใหม่ ให้ทำตามขั้นตอนในกรอบนี้"
          }
        }
      }
    },
    "Đã kết nối: %lld ổ cắm.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung: %lld stopkontak."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อแล้ว: ปลั๊กไฟ %lld ตัว"
          }
        }
      }
    },
    "Đã lưu bể trên aquatome.com hoặc máy khác? Đăng nhập để lấy về.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah menyimpan akuarium di aquatome.com atau perangkat lain? Masuk untuk mengambilnya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคยบันทึกตู้ปลาไว้บน aquatome.com หรืออุปกรณ์อื่นใช่ไหม เข้าสู่ระบบเพื่อดึงข้อมูลกลับมา"
          }
        }
      }
    },
    "Đã lưu khóa của một dự án ở %@.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci proyek di %@ sudah disimpan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกคีย์ของโปรเจกต์ที่ %@ แล้ว"
          }
        }
      }
    },
    "Đã lưu vào “%@”.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tersimpan di “%@”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกไว้ใน “%@” แล้ว"
          }
        }
      }
    },
    "Đã lưu để đọc sau": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan untuk dibaca nanti"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่บันทึกไว้อ่านทีหลัง"
          }
        }
      }
    },
    "Đã mở lịch %@. Bấm “Ghi lịch vào đèn” để dùng.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal %@ dibuka. Ketuk “Simpan jadwal ke lampu” untuk memakainya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดตารางเวลา %@ แล้ว กด “บันทึกตารางลงโคมไฟ” เพื่อใช้งาน"
          }
        }
      }
    },
    "Đã nhận ảnh, cảm ơn bạn! Ảnh sẽ hiện ở đây sau khi được duyệt, thường trong vòng một ngày.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto sudah diterima, terima kasih! Foto akan muncul di sini setelah disetujui, biasanya dalam satu hari."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ได้รับภาพแล้ว ขอบคุณ! ภาพจะแสดงที่นี่หลังผ่านการตรวจสอบ โดยปกติภายในหนึ่งวัน"
          }
        }
      }
    },
    "Đã quên đèn trên máy này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu sudah dihapus dari perangkat ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบโคมไฟออกจากเครื่องนี้แล้ว"
          }
        }
      }
    },
    "Đã thêm %lld bể từ tài khoản.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld akuarium ditambahkan dari akun."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มตู้ปลา %lld ตู้จากบัญชีแล้ว"
          }
        }
      }
    },
    "Đã thêm passkey. Lần sau bấm “Đăng nhập bằng passkey” rồi mở khóa bằng Face ID, vân tay hoặc mã PIN của máy.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey sudah ditambahkan. Lain kali, ketuk “Masuk dengan passkey”, lalu buka kunci dengan Face ID, sidik jari, atau PIN perangkat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม passkey แล้ว ครั้งต่อไปให้กด “เข้าสู่ระบบด้วย passkey” แล้วปลดล็อกด้วย Face ID ลายนิ้วมือ หรือรหัส PIN ของอุปกรณ์"
          }
        }
      }
    },
    "Đã tải về đọc offline": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah diunduh untuk dibaca offline"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดไว้อ่านออฟไลน์แล้ว"
          }
        }
      }
    },
    "Đã tải để đọc offline": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diunduh untuk dibaca offline"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่ดาวน์โหลดไว้อ่านออฟไลน์"
          }
        }
      }
    },
    "Đã tắt đèn. Đèn bỏ qua lịch cho tới khi bấm “Theo lịch”.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu dimatikan. Lampu mengabaikan jadwal sampai Anda mengetuk “Sesuai jadwal”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดไฟแล้ว โคมไฟจะไม่ทำงานตามตารางเวลาจนกว่าจะกด “ตามตารางเวลา”"
          }
        }
      }
    },
    "Đã xác nhận": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terkonfirmasi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันแล้ว"
          }
        }
      }
    },
    "Đã xóa tài khoản. Các bể vẫn còn trên máy này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun telah dihapus. Akuarium masih ada di perangkat ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบัญชีแล้ว ตู้ปลายังคงอยู่ในอุปกรณ์นี้"
          }
        }
      }
    },
    "Đã đăng bình luận.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentar sudah diposting."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์ความคิดเห็นแล้ว"
          }
        }
      }
    },
    "Đã đăng nhập bằng %@.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบด้วย %@ แล้ว"
          }
        }
      }
    },
    "Đã đăng nhập bằng %@. Đồng bộ lúc %@.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan %1$@. Disinkronkan pukul %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบด้วย %1$@ แล้ว ซิงค์ล่าสุดเมื่อ %2$@"
          }
        }
      }
    },
    "Đã đăng xuất. Các bể vẫn còn trên máy này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah keluar. Akuarium masih ada di perangkat ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกจากระบบแล้ว ตู้ปลายังคงอยู่ในอุปกรณ์นี้"
          }
        }
      }
    },
    "Đã đổi tên đèn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama lampu sudah diganti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนชื่อโคมไฟแล้ว"
          }
        }
      }
    },
    "Đã đủ %lld loài chưa có trang trên bể này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuarium ini sudah punya %lld jenis tanpa halaman."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้นี้มีชนิดที่ยังไม่มีหน้าครบ %lld ชนิดแล้ว"
          }
        }
      }
    },
    "Đèn": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟ"
          }
        }
      }
    },
    "Đèn %@ chưa được hỗ trợ.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu %@ belum didukung."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่รองรับโคมไฟ %@"
          }
        }
      }
    },
    "Đèn Chihiros": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu Chihiros"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟ Chihiros"
          }
        }
      }
    },
    "Đèn chưa báo lại lịch mới. Kiểm tra lại sau ít phút.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu belum melaporkan jadwal baru. Periksa lagi beberapa menit lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟยังไม่รายงานตารางใหม่ ตรวจสอบอีกครั้งในอีกสักครู่"
          }
        }
      }
    },
    "Đèn chạy lại theo lịch.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu kembali mengikuti jadwal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟกลับมาทำงานตามตารางเวลา"
          }
        }
      }
    },
    "Đèn hiện đúng màu đang chỉnh. Tắt thử thì đèn chạy lại theo lịch.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu menampilkan warna yang sedang diatur. Hentikan uji, lampu kembali mengikuti jadwal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟแสดงสีตามที่กำลังปรับ เมื่อปิดการทดสอบ โคมไฟจะกลับไปทำงานตามตารางเวลา"
          }
        }
      }
    },
    "Đèn không trả lời. Ngắt kết nối rồi kết nối lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu tidak merespons. Putuskan koneksi lalu hubungkan lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟไม่ตอบสนอง ตัดการเชื่อมต่อแล้วเชื่อมต่อใหม่"
          }
        }
      }
    },
    "Đèn mất giờ, có thể do mất điện: lịch sẽ chạy sai giờ.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam lampu hilang, mungkin karena listrik padam: jadwal akan berjalan di jam yang salah."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาในโคมไฟหายไป อาจเกิดจากไฟดับ: ตารางเวลาจะทำงานผิดเวลา"
          }
        }
      }
    },
    "Đèn sáng %@ tiếng mỗi ngày": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu menyala %@ jam per hari"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไฟวันละ %@ ชั่วโมง"
          }
        }
      }
    },
    "Đèn sáng hết. Đèn bỏ qua lịch cho tới khi bấm “Theo lịch”.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu menyala penuh. Lampu mengabaikan jadwal sampai Anda mengetuk “Sesuai jadwal”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไฟสว่างเต็มที่แล้ว โคมไฟจะไม่ทำงานตามตารางเวลาจนกว่าจะกด “ตามตารางเวลา”"
          }
        }
      }
    },
    "Đèn tìm thấy": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu yang ditemukan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟที่พบ"
          }
        }
      }
    },
    "Đèn tắt": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu mati"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟปิดอยู่"
          }
        }
      }
    },
    "Đèn đang chỉnh tay (%lld%%), không chạy theo lịch.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu sedang diatur manual (%lld%%), tidak mengikuti jadwal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟกำลังปรับด้วยตนเอง (%lld%%) ไม่ได้ทำงานตามตารางเวลา"
          }
        }
      }
    },
    "Đèn đang dùng lịch này": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu sedang memakai jadwal ini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟกำลังใช้ตารางเวลานี้"
          }
        }
      }
    },
    "Đèn đang hiện màu thử.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu sedang menampilkan warna uji."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟกำลังแสดงสีทดสอบ"
          }
        }
      }
    },
    "Đèn đang tắt bằng tay, không chạy theo lịch.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu dimatikan manual, tidak mengikuti jadwal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟถูกปิดด้วยตนเอง ไม่ได้ทำงานตามตารางเวลา"
          }
        }
      }
    },
    "Đèn đã lưu trên máy này": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu yang tersimpan di perangkat ini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โคมไฟที่บันทึกไว้ในเครื่องนี้"
          }
        }
      }
    },
    "Đó là một Apple ID khác: đăng nhập bằng Apple ID của tài khoản này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu Apple ID yang berbeda: masuk dengan Apple ID milik akun ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่เป็น Apple ID อื่น โปรดเข้าสู่ระบบด้วย Apple ID ของบัญชีนี้"
          }
        }
      }
    },
    "Đóng": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิด"
          }
        }
      }
    },
    "Đóng ứng dụng My Chihiros trên các điện thoại khác: đèn chỉ nhận một kết nối.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup aplikasi My Chihiros di ponsel lain: lampu hanya menerima satu koneksi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดแอป My Chihiros ในโทรศัพท์เครื่องอื่น: โคมไฟรับการเชื่อมต่อได้ครั้งละหนึ่งเครื่องเท่านั้น"
          }
        }
      }
    },
    "Đông Mỹ (Eastern America)": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Amerika Timur (Eastern America)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อเมริกาตะวันออก (Eastern America)"
          }
        }
      }
    },
    "Đăng nhập": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบ"
          }
        }
      }
    },
    "Đăng nhập bằng email": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan email"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบด้วยอีเมล"
          }
        }
      }
    },
    "Đăng nhập bằng passkey": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan passkey"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบด้วย passkey"
          }
        }
      }
    },
    "Đăng nhập tài khoản aquatome.com để bình luận và gửi ảnh.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk ke akun aquatome.com untuk berkomentar dan mengirim foto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบบัญชี aquatome.com เพื่อแสดงความคิดเห็นและส่งภาพ"
          }
        }
      }
    },
    "Đăng xuất": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกจากระบบ"
          }
        }
      }
    },
    "Địa chỉ chỉ dùng để gửi mã. Tài khoản chỉ giữ nó ở dạng mã hóa một chiều.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat hanya dipakai untuk mengirim kode. Akun hanya menyimpannya dalam bentuk hash satu arah."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้อีเมลเพื่อส่งรหัสเท่านั้น บัญชีจะเก็บไว้ในรูปแบบเข้ารหัสทางเดียวเท่านั้น"
          }
        }
      }
    },
    "Địa chỉ email": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat email"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่อยู่อีเมล"
          }
        }
      }
    },
    "Địa chỉ email chưa đúng.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat email tidak valid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีเมลไม่ถูกต้อง"
          }
        }
      }
    },
    "Đọc gần đây": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baru dibaca"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านล่าสุด"
          }
        }
      }
    },
    "Đỏ": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merah"
          }
        },
        "th": {
          "stringUnit": {
