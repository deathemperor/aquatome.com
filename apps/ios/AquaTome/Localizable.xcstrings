    },
    "Không có kết quả trong “%@”": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada hasil di “%@”"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada hasil dalam “%@”"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีผลลัพธ์ใน “%@”"
          }
        }
      }
    },
    "Không có loài nào khớp. Thử nới điều kiện lọc.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada spesies yang cocok. Coba longgarkan kriteria filter."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada spesies yang sepadan. Cuba longgarkan syarat tapisan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบสายพันธุ์ที่ตรงกัน ลองผ่อนเงื่อนไขการกรอง"
          }
        }
      }
    },
    "Không có mạng hoặc Tuya không trả lời: thử lại khi có mạng.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada koneksi internet atau Tuya tidak menjawab: coba lagi saat sudah terhubung."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada internet atau Tuya tidak menjawab: cuba lagi apabila ada internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอินเทอร์เน็ตหรือ Tuya ไม่ตอบกลับ โปรดลองอีกครั้งเมื่อเชื่อมต่อได้"
          }
        }
      }
    },
    "Không có mạng. Kết nối rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada koneksi. Sambungkan lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada internet. Sambung, kemudian cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอินเทอร์เน็ต เชื่อมต่อแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Không có mạng: thử lại khi có mạng.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada koneksi internet: coba lagi saat sudah terhubung."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada internet: cuba lagi apabila ada internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอินเทอร์เน็ต โปรดลองอีกครั้งเมื่อเชื่อมต่อได้"
          }
        }
      }
    },
    "Không cần châm": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak perlu injeksi"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak perlu suntikan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องเติม"
          }
        }
      }
    },
    "Không gửi được báo cáo, vui lòng thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan tidak terkirim, silakan coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan tidak dapat dihantar, sila cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งรายงานไม่สำเร็จ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Không gửi được bình luận, vui lòng thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentar gagal dikirim, silakan coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Komen tidak dapat dihantar, sila cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งความคิดเห็นไม่สำเร็จ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Không gửi được lệnh tới đèn. Lại gần đèn rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah tidak terkirim ke lampu. Dekati lampu lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahan tidak dapat dihantar ke lampu. Dekati lampu, kemudian cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งคำสั่งไปยังโคมไฟไม่ได้ ขยับเข้าใกล้โคมไฟแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Không gửi được lệnh tới đèn. Thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah tidak terkirim ke lampu. Coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahan tidak dapat dihantar ke lampu. Cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งคำสั่งไปยังไฟไม่สำเร็จ ลองอีกครั้ง"
          }
        }
      }
    },
    "Không gửi được ảnh, vui lòng thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto gagal dikirim, silakan coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto tidak dapat dihantar, sila cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งรูปไม่สำเร็จ โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Không kết nối được. Lại gần đèn, đóng ứng dụng My Chihiros trên các máy khác rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal terhubung. Dekati lampu, tutup aplikasi My Chihiros di perangkat lain, lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat bersambung. Dekati lampu, tutup aplikasi My Chihiros pada peranti lain, kemudian cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อไม่ได้ เข้าใกล้โคมไฟ ปิดแอป My Chihiros บนเครื่องอื่น แล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Không lấy lại được câu trả lời này": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban ini tidak bisa diambil lagi"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawapan ini tidak dapat diperoleh semula"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียกคำตอบนี้กลับมาไม่ได้"
          }
        }
      }
    },
    "Không mở được video. Kiểm tra mạng rồi thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video tidak bisa dibuka. Periksa koneksi internet, lalu coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Video tidak dapat dibuka. Semak sambungan internet, kemudian cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดวิดีโอไม่ได้ ตรวจสอบอินเทอร์เน็ตแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Không phải? %lld loài %@ khác trong cẩm nang": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukan? %lld spesies %@ lain di panduan"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukan? %lld spesies %@ lain dalam buku panduan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ใช่? สกุล %2$@ อีก %1$lld ชนิดในคู่มือ"
          }
        }
      }
    },
    "Không qua được kiểm tra chống spam, vui lòng thử lại.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal lolos pemeriksaan antispam, silakan coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal melepasi semakan antispam, sila cuba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ผ่านการตรวจสอบป้องกันสแปม โปรดลองอีกครั้ง"
          }
        }
      }
    },
    "Không rõ trạng thái": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status tidak diketahui"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Status tidak diketahui"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ทราบสถานะ"
          }
