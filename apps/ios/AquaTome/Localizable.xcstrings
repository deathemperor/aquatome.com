    "Công cụ": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alatan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องมือ"
          }
        }
      }
    },
    "Công cụ chỉ đoán từ ảnh và có thể nhầm giữa các loài giống nhau. Đọc hồ sơ để đối chiếu màu, vây và kích thước trước khi mua hay thả chung.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat ini hanya menebak dari foto dan bisa keliru di antara spesies yang mirip. Baca profilnya untuk mencocokkan warna, sirip, dan ukuran sebelum membeli atau menggabungkannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat ini hanya meneka daripada foto dan mungkin tersilap antara spesies yang serupa. Baca profilnya untuk membandingkan warna, sirip dan saiz sebelum membeli atau mencampurkannya dalam satu tangki."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องมือนี้เดาจากภาพเท่านั้นและอาจสับสนระหว่างสายพันธุ์ที่คล้ายกัน อ่านหน้าข้อมูลเพื่อเทียบสี ครีบ และขนาดก่อนซื้อหรือปล่อยเลี้ยงรวมกัน"
          }
        }
      }
    },
    "Công cụ nhận diện tạm thời chưa dùng được. Bạn tìm cá theo tên trong danh sách cá nhé.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat identifikasi untuk sementara belum bisa dipakai. Cari ikan berdasarkan namanya di daftar ikan, ya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat pengecaman tidak dapat digunakan buat sementara. Cari ikan mengikut nama dalam senarai ikan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องมือระบุชนิดยังใช้ไม่ได้ชั่วคราว ลองค้นหาปลาตามชื่อในรายชื่อปลานะ"
          }
        }
      }
    },
    "Công cụ đang tạm nghỉ. Bạn quay lại sau vài giờ nhé.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat ini sedang istirahat. Kembali lagi beberapa jam lagi, ya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat ini sedang berehat sebentar. Kembali semula dalam beberapa jam lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องมือกำลังพักชั่วคราว กลับมาใหม่อีกสักสองสามชั่วโมงนะ"
          }
        }
      }
    },
