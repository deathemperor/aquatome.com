    },
    "Bình luận": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentar"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Komen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคิดเห็น"
          }
        }
      }
    },
    "Bình luận cần xác minh người dùng theo quy định; tính năng này sẽ sớm mở.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuai ketentuan, komentar memerlukan verifikasi pengguna; fitur ini akan segera tersedia."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Komen memerlukan pengesahan pengguna mengikut peraturan; ciri ini akan dibuka tidak lama lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแสดงความคิดเห็นต้องยืนยันตัวตนผู้ใช้ตามข้อกำหนด ฟีเจอร์นี้จะเปิดให้ใช้งานเร็ว ๆ นี้"
          }
        }
      }
    },
    "Bình luận và ảnh của mọi người đều hiện trên máy này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentar dan foto semua orang ditampilkan di perangkat ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Komen dan foto semua orang dipaparkan pada peranti ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคิดเห็นและรูปของทุกคนแสดงอยู่บนเครื่องนี้"
          }
        }
      }
    },
    "Bình luận và ảnh của người này sẽ ẩn trên máy này. Bỏ chặn trong Tài khoản, mục Người đã chặn.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentar dan foto orang ini akan disembunyikan di perangkat ini. Buka blokir di Akun, bagian Orang yang diblokir."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Komen dan foto orang ini akan disembunyikan pada peranti ini. Nyahsekat dalam Akaun, bahagian Orang yang disekat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคิดเห็นและรูปของคนนี้จะถูกซ่อนบนเครื่องนี้ เลิกบล็อกได้ที่ บัญชี หัวข้อ คนที่บล็อกไว้"
          }
        }
      }
    },
    "Bình luận và ảnh của những người này đang ẩn trên máy này.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentar dan foto orang-orang ini disembunyikan di perangkat ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Komen dan foto orang-orang ini sedang disembunyikan pada peranti ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคิดเห็นและรูปของคนเหล่านี้ถูกซ่อนอยู่บนเครื่องนี้"
          }
        }
      }
    },
    "Bình luận đang chờ duyệt.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentar sedang menunggu moderasi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Komen sedang menunggu kelulusan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคิดเห็นกำลังรอการอนุมัติ"
          }
        }
      }
    },
    "Bình luận được kiểm duyệt; quảng cáo và thông tin cá nhân sẽ bị gỡ.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentar dimoderasi; iklan dan informasi pribadi akan dihapus."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Komen akan disemak; iklan dan maklumat peribadi akan dibuang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคิดเห็นทุกรายการจะผ่านการตรวจสอบ โฆษณาและข้อมูลส่วนบุคคลจะถูกลบออก"
          }
        }
      }
    },
    "Bạn chưa chặn ai": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum memblokir siapa pun"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum menyekat sesiapa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังไม่ได้บล็อกใคร"
          }
        }
      }
    },
    "Bạn hỏi: %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda bertanya: %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Soalan anda: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณถาม: %@"
          }
        }
      }
    },
    "Bạn đã dùng hết %lld lượt nhận diện hôm nay. Quay lại ngày mai nhé.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah memakai %lld kesempatan identifikasi hari ini. Kembali lagi besok, ya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah menggunakan kesemua %lld kali pengecaman hari ini. Sila kembali esok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้คุณใช้ครบ %lld ครั้งแล้ว กลับมาใหม่พรุ่งนี้นะ"
          }
        }
      }
    },
    "Bạn đã gửi đủ 5 ảnh hôm nay. Hãy quay lại ngày mai.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah mengirim 5 foto hari ini. Silakan kembali besok."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah menghantar 5 foto hari ini. Sila kembali esok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้คุณส่งรูปครบ 5 รูปแล้ว โปรดกลับมาใหม่พรุ่งนี้"
          }
        }
      }
    },
    "Bảng điều khiển": {
      "localizations": {
        "id": {
          "stringUnit": {
