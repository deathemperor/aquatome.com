{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/markdown.ts",
    "preview": "astro preview",
    "test": "CONTENT_ROOT=$PWD/test/fixture-content pnpm build && CONTENT_ROOT=$PWD/test/fixture-content vitest run",
    "typecheck": "astro check && tsc -p worker",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@aq/schema": "workspace:*",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "astro": "^7.4.2",
    "jose": "^6.2.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@playwright/test": "~1.64.1",
    "@types/node": "^24.19.2",
    "@types/turndown": "^5.0.6",
    "lighthouse": "12.8.2",
    "node-html-parser": "^9.0.5",
    "pagefind": "^1.5.2",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
