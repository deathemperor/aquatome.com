---
import '@fontsource-variable/fraunces/full.css'
import '@fontsource-variable/fraunces/full-italic.css'
import '@fontsource/be-vietnam-pro/400.css'
import '@fontsource/be-vietnam-pro/500.css'
import '@fontsource/be-vietnam-pro/600.css'
import '@fontsource-variable/newsreader/index.css'
import '@fontsource-variable/newsreader/opsz-italic.css'
import '@fontsource-variable/bricolage-grotesque/index.css'
import '../styles/global.css'
import '../styles/skins/a.css'
import '../styles/skins/b.css'
import '../styles/skins/c.css'
import Footer from '../components/Footer.astro'
import { isStaging } from '../lib/seo'
import { jsonForScript } from '../lib/json'
import { ADSENSE_CLIENT } from '../lib/site'
import { OWNER_SCRIPT } from '../../worker/owner'
import type { Credit } from '../lib/credits'

interface Props {
  title: string
  description?: string
  noindex?: boolean
  jsonld?: object[]
  credits?: Credit[]
  /** Share preview image (absolute URL). */
  image?: string
}
const { title, description, noindex = false, jsonld = [], credits, image } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).href
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Skin preview without the A/B Worker: ?skin=a|b|c|mix (sticky via cookie), ?skin=reset. The Worker sets data-skin server-side. */}
    <script is:inline data-skin-preview>(()=>{try{var d=document.documentElement,q=new URLSearchParams(location.search).get('skin'),ok=/^(mix|a|b|c)$/;if(q==='reset')document.cookie='skin=;path=/;max-age=0';else if(q&&ok.test(q))document.cookie='skin='+q+';path=/;max-age=7776000;samesite=lax';var c=(document.cookie.match(/(?:^|; )skin=([a-z]+)/)||[])[1],s=q&&ok.test(q)?q:c;if(!d.dataset.skin&&s&&s!=='mix'&&ok.test(s))d.dataset.skin=s}catch(e){}})()</script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {(noindex || isStaging()) && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="AquaTome" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={image ?? new URL('/logo.png', Astro.site).href} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="alternate" hreflang="vi" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {jsonld.map(j => <script type="application/ld+json" set:html={jsonForScript(j)} />)}
    <slot name="head" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {/* AdSense (and Google's consent message for EEA/UK/CH visitors) — production only. */}
    {!isStaging() && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}
    {!isStaging() && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>}
  </head>
  <body>
    <slot name="header" />
    <main data-pagefind-body><slot /></main>
    <Footer credits={credits} />
    {/* A/B beacon: view, scroll 50/90%, time 30/60/180 s, affiliate clicks → /_e (Worker → Analytics Engine). No PII. */}
    <script is:inline data-beacon>(()=>{try{var d=document.documentElement,s=d.dataset.skin||'mix',k='ts_sid',i=sessionStorage.getItem(k);if(!i){i=(Math.random().toString(36).slice(2)+'000000000000').slice(0,12);sessionStorage.setItem(k,i)}var p=location.pathname.slice(0,200),f=function(t,v){navigator.sendBeacon&&navigator.sendBeacon('/_e',JSON.stringify({s:s,p:p,t:t,v:v,sid:i}))},seen={};f('view',1);addEventListener('scroll',function(){var r=100*(scrollY+innerHeight)/d.scrollHeight;[50,90].forEach(function(m){if(r>=m&&!seen[m]){seen[m]=1;f('scroll',m)}})},{passive:true});[30,60,180].forEach(function(t){setTimeout(function(){document.visibilityState==='visible'&&f('time',t)},t*1e3)});document.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('a[rel~=sponsored]');a&&f('aff',1)},true)}catch(e){}})()</script>
    {/* Owner only (flag cookie): hide this page — see worker/owner.ts. */}
    {!Astro.url.pathname.startsWith('/404') && <script is:inline data-owner set:html={OWNER_SCRIPT} />}
  </body>
</html>
