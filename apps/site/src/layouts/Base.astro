---
import '@fontsource/be-vietnam-pro/400.css'
import '@fontsource/be-vietnam-pro/500.css'
import '@fontsource/be-vietnam-pro/600.css'
import '@fontsource-variable/newsreader/index.css'
import '@fontsource-variable/newsreader/wght-italic.css'
import '../styles/fonts-vi.css'
import '../styles/global.css'
import '../styles/handbook.css'
import Footer from '../components/Footer.astro'
import { isStaging } from '../lib/seo'
import { jsonForScript } from '../lib/json'
import { ADSENSE_CLIENT } from '../lib/site'
import { OWNER_SCRIPT } from '../../worker/owner'
import type { Credit } from '../lib/credits'
import { i18n, LANGS, localizePath, OG_LOCALE, served, toVi, type Lang } from '../lib/i18n'
import CLIENT from '../i18n/client.json'

interface Props {
  title: string
  description?: string
  noindex?: boolean
  jsonld?: object[]
  credits?: Credit[]
  /** Share preview image (absolute URL). */
  image?: string
  /** This page in other languages (paths), for hreflang; the Vietnamese one is also x-default. */
  alternates?: Partial<Record<Lang, string>>
}
const { title, description, noindex = false, jsonld = [], credits, image, alternates = {} } = Astro.props
const { lang, t } = i18n(Astro.url)
const canonical = new URL(Astro.url.pathname, Astro.site).href
// A page without address parameters is the same page in every language that has it; others pass their alternates.
const viPath = toVi(Astro.url.pathname)
const auto = (l: Lang) => (Object.keys(Astro.params).length === 0 && served(l, viPath) ? localizePath(l, viPath) : undefined)
const langs = LANGS.flatMap(l => {
  const p = l === lang ? Astro.url.pathname : alternates[l] ?? auto(l)
  return p ? [[l, new URL(p, Astro.site).href] as const] : []
})
const xDefault = langs.find(([l]) => l === 'vi')?.[1] ?? canonical
// For the language menu in the header (Nav renders inside the header slot, after this runs).
Astro.locals.langs = langs
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {/* The reader's light/dark choice (ThemeToggle) before first paint, so a chosen theme never flashes the other. */}
    {/* Again when a preloaded page is shown: the reader may have toggled since. */}
    <script is:inline>(function(){var a=function(){try{var t=localStorage.getItem('aq_theme'),d=document.documentElement;t==='dark'||t==='light'?d.setAttribute('data-theme',t):d.removeAttribute('data-theme')}catch(e){}};a();document.prerendering&&document.addEventListener('prerenderingchange',a,{once:true})})()</script>
    {/* Hovering (or touching) a link loads that page in the background (Chrome, Edge, Samsung Internet), so the click is instant. Its HTML is fetched sooner still (10 ms hover; on phones, a link in view), since a page's first request can take ~0.5 s. Site pages only; never affiliate, outbound or admin links. */}
    <script is:inline type="speculationrules">{"prefetch":[{"where":{"and":[{"href_matches":"/vi/*"},{"not":{"selector_matches":"[rel~=nofollow],[rel~=sponsored],[target=_blank],[download]"}}]},"eagerness":"eager"}],"prerender":[{"where":{"and":[{"href_matches":"/vi/*"},{"not":{"selector_matches":"[rel~=nofollow],[rel~=sponsored],[target=_blank],[download]"}}]},"eagerness":"moderate"}]}</script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {(noindex || isStaging()) && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="AquaTome" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={image ?? new URL('/logo.png', Astro.site).href} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {langs.map(([l, href]) => <link rel="alternate" hreflang={l} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    {jsonld.map(j => <script type="application/ld+json" set:html={jsonForScript(j)} />)}
    <slot name="head" />
    {/* Other languages: the translations of the UI text browser scripts write (src/scripts/ct.ts). */}
    {lang !== 'vi' && <script type="application/json" id="aq-i18n" set:html={jsonForScript(Object.fromEntries(CLIENT.map(s => [s, t(s)])))} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {/* AdSense (and Google's consent message for EEA/UK/CH visitors) — production only. Loaded on the reader's first scroll of the page (not captured: a strip that snaps itself while loading doesn't count), tap or key, not with the page: Google's test cookie is a third-party cookie (Lighthouse Best Practices), and the page's own text and pictures get the connection first. */}
    {!isStaging() && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}
    {!isStaging() && <script is:inline data-ads set:html={`(function(){var ev=['scroll','pointerdown','keydown','touchstart'],o=function(e){return{capture:e!=='scroll',passive:true}},go=function(){ev.forEach(function(e){removeEventListener(e,go,o(e))});var s=document.createElement('script');s.async=true;s.crossOrigin='anonymous';s.src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}';document.head.appendChild(s)};ev.forEach(function(e){addEventListener(e,go,o(e))})})()`} />}
  </head>
  <body>
    <slot name="header" />
    <main data-pagefind-body><slot /></main>
    <Footer credits={credits} langs={langs} />
    {/* Beacon (starts when the page is shown, not while it's only preloaded): view (+ referring site), scroll 50/90%, time 30/60/180 s, affiliate clicks → /_e (Worker → Analytics Engine). No PII; the owner's visits are dropped. */}
    <script is:inline data-beacon>(()=>{var go=function(){try{var d=document.documentElement,k='ts_sid',i=sessionStorage.getItem(k);if(!i){i=(Math.random().toString(36).slice(2)+'000000000000').slice(0,12);sessionStorage.setItem(k,i)}var p=location.pathname.slice(0,200),r='';try{var h=document.referrer&&new URL(document.referrer).hostname;if(h&&h!==location.hostname)r=h.slice(0,100)}catch(e){}var f=function(t,v){navigator.sendBeacon&&navigator.sendBeacon('/_e',JSON.stringify({p:p,t:t,v:v,sid:i,r:t==='view'?r:''}))},seen={};f('view',1);addEventListener('scroll',function(){var r=100*(scrollY+innerHeight)/d.scrollHeight;[50,90].forEach(function(m){if(r>=m&&!seen[m]){seen[m]=1;f('scroll',m)}})},{passive:true});[30,60,180].forEach(function(t){setTimeout(function(){document.visibilityState==='visible'&&f('time',t)},t*1e3)});document.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('a[rel~=sponsored]');a&&f('aff',1)},true)}catch(e){}};document.prerendering?document.addEventListener('prerenderingchange',go,{once:true}):go()})()</script>
    {/* Cloudflare Web Analytics (cookieless; the token is public). Added by hand: Cloudflare doesn't inject it into Worker-served pages. Loaded once the page is shown. */}
    {!isStaging() && <script is:inline>(function(){var a=function(){var s=document.createElement('script');s.type='module';s.src='https://static.cloudflareinsights.com/beacon.min.js';s.setAttribute('data-cf-beacon','{"token": "5560cb3fcc76468ebd02e068406ce6e0"}');document.body.appendChild(s)};document.prerendering?document.addEventListener('prerenderingchange',a,{once:true}):a()})()</script>}
    {/* Owner only (flag cookie): hide this page — see worker/owner.ts. */}
    {!Astro.url.pathname.startsWith('/404') && <script is:inline data-owner set:html={OWNER_SCRIPT} />}
  </body>
</html>
