---
import '@fontsource/be-vietnam-pro/400.css'
import '@fontsource/be-vietnam-pro/500.css'
import '@fontsource/be-vietnam-pro/600.css'
import '@fontsource-variable/newsreader/index.css'
import '@fontsource-variable/newsreader/wght-italic.css'
import '../styles/fonts-vi.css'
import '../styles/global.css'
import '../styles/handbook.css'
import Footer from '../components/Footer.astro'
import { isStaging } from '../lib/seo'
import { jsonForScript } from '../lib/json'
import { ADSENSE_CLIENT } from '../lib/site'
import { APP_STATE, APP_STORE_ID } from '../lib/app'
import { OWNER_SCRIPT } from '../../worker/owner'
import type { Credit } from '../lib/credits'
import { i18n, LANG, LANGS, localizePath, served, toVi, type Lang } from '../lib/i18n'
import { VI_SECTIONS } from '../../worker/paths'
import { beaconScript, nocountGuard } from '../lib/beacon'
import CLIENT from '../i18n/client.json'

interface Props {
  title: string
  description?: string
  noindex?: boolean
  jsonld?: object[]
  credits?: Credit[]
  /** The page's script shows more photos after it loads, and adds their credits (scripts/photo-credits.ts). */
  creditsLater?: boolean
  /** Share preview image (absolute URL). */
  image?: string
  /** This page in other languages (paths), for hreflang; the Vietnamese one is also x-default. */
  alternates?: Partial<Record<Lang, string>>
  /** In the site search (Pagefind indexes only pages whose <main> carries data-pagefind-body). */
  search?: boolean
  /** Ads: off on a screen with nothing to read (AdSense's rules), such as the sign-in page. */
  ads?: boolean
}
const { title, description, noindex = false, jsonld = [], credits, creditsLater, image, alternates = {}, search = true, ads = true } = Astro.props
const { lang, t } = i18n(Astro.url)
const canonical = new URL(Astro.url.pathname, Astro.site).href
// A page without address parameters is the same page in every language that has it; others pass their alternates.
const viPath = toVi(Astro.url.pathname)
const auto = (l: Lang) => (Object.keys(Astro.params).length === 0 && served(l, viPath) ? localizePath(l, viPath) : undefined)
const langs = LANGS.flatMap(l => {
  const p = l === lang ? Astro.url.pathname : alternates[l] ?? auto(l)
  return p ? [[l, new URL(p, Astro.site).href] as const] : []
})
const xDefault = langs.find(([l]) => l === 'vi')?.[1] ?? canonical
// For the language menu in the header (Nav renders inside the header slot, after this runs).
Astro.locals.langs = langs
// The pages of this page's language: Vietnamese ones are the home page and its sections, the others under /id/, /th/.
const own = { href_matches: lang === 'vi' ? ['/', ...VI_SECTIONS.map(s => `/${s}/*`)] : `${LANG[lang].prefix}/*` }
const where = { and: [own, { not: { selector_matches: '[rel~=nofollow],[rel~=sponsored],[target=_blank],[download]' } }] }
const speculation = JSON.stringify({ prefetch: [{ where, eagerness: 'eager' }], prerender: [{ where, eagerness: 'moderate' }] })
---
<!doctype html>
<html lang={LANG[lang].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {/* The reader's light/dark choice (ThemeToggle) before first paint, so a chosen theme never flashes the other. */}
    {/* Again when a preloaded page is shown: the reader may have toggled since. */}
    <script is:inline>(function(){var a=function(){try{var t=localStorage.getItem('aq_theme'),d=document.documentElement;t==='dark'||t==='light'?d.setAttribute('data-theme',t):d.removeAttribute('data-theme')}catch(e){}};a();document.prerendering&&document.addEventListener('prerenderingchange',a,{once:true})})()</script>
    {/* Hovering (or touching) a link loads that page in the background (Chrome, Edge, Samsung Internet), so the click is instant. Its HTML is fetched sooner still (10 ms hover; on phones, a link in view), since a page's first request can take ~0.5 s. Site pages only; never affiliate, outbound or admin links. */}
    <script is:inline type="speculationrules" set:html={speculation} />
    <title>{title}</title>
    {description && <meta name="description" content={description} data-pagefind-meta="description[content]" />}
    {(noindex || isStaging()) && <meta name="robots" content="noindex, follow" />}
    {/* Safari's own Smart App Banner, no script of ours (lib/app.ts). Not before the launch: Safari shows none until the store has the app. */}
    {APP_STATE === 'on' && <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}, app-argument=${canonical}`} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="AquaTome" />
    <meta property="og:locale" content={LANG[lang].og} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={image ?? new URL('/logo.png', Astro.site).href} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {langs.map(([l, href]) => <link rel="alternate" hreflang={LANG[l].html} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    {jsonld.map(j => <script type="application/ld+json" set:html={jsonForScript(j)} />)}
    <slot name="head" />
    {/* Other languages: the translations of the UI text browser scripts write (src/scripts/ct.ts). */}
    {lang !== 'vi' && <script type="application/json" id="aq-i18n" set:html={jsonForScript(Object.fromEntries(CLIENT.map(s => [s, t(s)])))} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* AdSense (and Google's consent message for EEA/UK/CH visitors) — production only. Loaded on the reader's first scroll of the page (not captured: a strip that snaps itself while loading doesn't count), tap or key, not with the page: Google's test cookie is a third-party cookie (Lighthouse Best Practices), and the page's own text and pictures get the connection first. */}
    {ads && !isStaging() && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}
    {ads && !isStaging() && <script is:inline data-ads set:html={`(function(){var ev=['scroll','pointerdown','keydown','touchstart'],o=function(e){return{capture:e!=='scroll',passive:true}},go=function(){ev.forEach(function(e){removeEventListener(e,go,o(e))});var s=document.createElement('script');s.async=true;s.crossOrigin='anonymous';s.src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}';document.head.appendChild(s)};ev.forEach(function(e){addEventListener(e,go,o(e))})})()`} />}
  </head>
  <body>
    <slot name="header" />
    <main data-pagefind-body={search ? '' : undefined}><slot /></main>
    <Footer credits={credits} later={creditsLater} langs={langs} />
    {/* Beacon (lib/beacon.ts): view (+ referring site), scroll, time, shop clicks → /_e (Worker → Analytics Engine), from when the page is shown. No PII; our own visits are marked (worker/us.ts). */}
    <script is:inline data-beacon set:html={beaconScript()} />
    {/* Cloudflare Web Analytics (cookieless; the token is public). Added by hand: Cloudflare doesn't inject it into Worker-served pages. Loaded once the page is shown. */}
    {!isStaging() && <script is:inline set:html={`(function(){var a=function(){${nocountGuard()}var s=document.createElement('script');s.type='module';s.src='https://static.cloudflareinsights.com/beacon.min.js';s.setAttribute('data-cf-beacon','{"token": "5560cb3fcc76468ebd02e068406ce6e0"}');document.body.appendChild(s)};document.prerendering?document.addEventListener('prerenderingchange',a,{once:true}):a()})()`} />}
    {/* Owner only (flag cookie): hide this page — see worker/owner.ts. */}
    {!Astro.url.pathname.startsWith('/404') && <script is:inline data-owner set:html={OWNER_SCRIPT} />}
  </body>
</html>
