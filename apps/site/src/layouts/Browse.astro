---
import Base from './Base.astro'
import Nav from '../components/Nav.astro'
interface Props { title: string; heading: string; intro?: string; crumbs?: [string, string][]; noindex?: boolean }
const { title, heading, intro, crumbs = [], noindex } = Astro.props
---
<Base title={`${title} — thủy·sinh`} description={intro} noindex={noindex}>
  <Nav slot="header" />
  <div class="wrap page">
    {crumbs.length > 0 && <nav class="crumb" aria-label="Đường dẫn">{crumbs.map(([href, label], i) => <>{i > 0 && ' / '}<a href={href}>{label}</a></>)}</nav>}
    <h1><slot name="heading">{heading}</slot></h1>
    {intro && <p class="intro">{intro}</p>}
    <slot />
  </div>
</Base>
<style>
  .page { padding-block: var(--space-5) var(--space-6); }
  .crumb { font-size: 0.85rem; color: var(--c-ink-faint); margin-bottom: var(--space-3); }
  .crumb a { color: var(--c-ink-soft); }
  h1 { font-size: var(--step-4); letter-spacing: -0.015em; padding-bottom: var(--space-3); border-bottom: 2px solid var(--c-ink); margin-bottom: var(--space-5); }
  .intro { max-width: var(--measure); color: var(--c-ink-soft); margin: calc(-1 * var(--space-3)) 0 var(--space-5); }
</style>
