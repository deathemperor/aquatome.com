---
import { linkTerms, type Section, type Translation } from '@aq/schema'
import GlossaryTip from './GlossaryTip.astro'
import { getContent } from '../lib/content'
import { mentionIndex } from '../lib/mentions'
import { figureHtml, type Figure } from '../lib/figures'
import { DISPLAY_ORDER, QUESTION_LABELS } from '../lib/sections'
import { i18n } from '../lib/i18n'
import { citeMark, withCite } from '../lib/cite'
interface Props { sections: Section[]; t: Translation; self?: string; selfNames?: string[]; figures?: Figure[] }
const { sections, t, self, selfNames = [], figures = [] } = Astro.props
// `t` is the entity's translation (a prop): the translator is `tr` here.
const { t: tr, lang } = i18n(Astro.url)
const c = await getContent(lang)
const targets = mentionIndex(c).targets
// Other species, plants, taxa, groups, places, glossary terms and equipment: first mention on the page, never the page's own names.
const linked = new Set<string>(self ? [self] : [])
const own = new Set(selfNames.map(n => n.toLowerCase()))
// Each source is numbered by where it first appears; every block ends with its source's mark (lib/cite.ts), and the
// numbered list closes the page's text.
const refs: { name: string; url: string }[] = []
const refNo = (name: string, url: string) => { const i = refs.findIndex(r => r.url === url); return i >= 0 ? i + 1 : refs.push({ name, url }) }
const groups = DISPLAY_ORDER.map(key => ({
  key,
  blocks: sections.filter(x => x.key === key).flatMap(x => {
    const html = t.sections[`${key}:${x.source}`]
    if (!html) return []
    const name = c.sources[x.source]?.name ?? x.source
    return [{ ...x, vi: withCite(linkTerms(html, targets, 'ml', linked, own).html, citeMark(lang, refNo(name, x.sourceUrl), name, x.sourceUrl)) }]
  }),
})).filter(x => x.blocks.length > 0)
// Extra photos go between sections, spread evenly (never after the last one).
const figAfter = new Map(figures.slice(0, Math.max(0, groups.length - 1)).map((f, k, all) => [Math.floor(((k + 1) * groups.length) / (all.length + 1)) - 1, f] as const))
---
<div class="wrap body">
  {groups.map((sec, i) => (<>
    <section data-section={sec.key} id={`muc-${sec.key}`} data-pagefind-ignore={sec.key === 'references' ? 'index' : undefined}>
      <h2>{tr(QUESTION_LABELS[sec.key])}</h2>
      {sec.blocks.map(b => (
        <div class="prose" data-source={b.source} set:html={b.vi} />
      ))}
    </section>
    {figAfter.has(i) && <Fragment set:html={figureHtml(lang, figAfter.get(i)!)} />}
  </>
  ))}
  {refs.length > 0 && (
    <section class="refs" id="nguon" aria-labelledby="nguon-h" data-pagefind-ignore>
      <h2 id="nguon-h">{tr('Nguồn')}</h2>
      <ol>{refs.map((r, i) => <li id={`nguon-${i + 1}`}><a href={r.url} rel="noopener">{r.name}</a> <span class="host">{new URL(r.url).hostname.replace(/^www\./, '')}</span></li>)}</ol>
      <p class="note">{tr('Các phần trên dịch từ những nguồn này, với sự cho phép của họ. Mỗi đoạn ghi số nguồn của nó.')}</p>
    </section>
  )}
  <GlossaryTip />
</div>
<style>
  .body section { display: grid; grid-template-columns: minmax(0, var(--measure)) 1fr; column-gap: var(--space-6); padding-block: var(--space-5); border-top: 1px solid var(--c-rule); }
  .body h2 { font-size: var(--step-2); grid-column: 1; margin-bottom: var(--space-3); }
  .prose { grid-column: 1; }
  .prose + .prose { margin-top: var(--space-2); }
  .prose :global(p) { margin: 0 0 var(--space-3); line-height: 1.7; }
  .prose :global(.ml) { color: inherit; text-decoration-color: var(--c-moss); text-decoration-thickness: 1.5px; }
  .prose :global(.gl) { color: inherit; text-decoration: underline dotted var(--c-moss); text-decoration-thickness: 1.5px; }
  /* The source list: numbers set like the marks in the text, so a reader matches them at a glance. */
  .refs ol { grid-column: 1; list-style: none; margin: 0; padding: 0; counter-reset: ref; font-size: var(--step--1); }
  .refs li { counter-increment: ref; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 var(--space-2); padding-block: var(--space-2); border-top: 1px dotted var(--c-rule); }
  .refs li::before { content: counter(ref); flex: none; min-width: 1.5rem; height: 1.5rem; display: inline-grid; place-items: center; border-radius: 999px; font: 600 0.75rem/1 var(--f-body); font-variant-numeric: tabular-nums; color: var(--c-moss); background: color-mix(in srgb, var(--c-moss) 12%, transparent); }
  .refs li:target::before { color: var(--c-paper); background: var(--c-moss); }
  .refs a { color: var(--c-ink); font-weight: 600; }
  .refs .host { color: var(--c-ink-faint); }
  .refs .note { grid-column: 1; margin: var(--space-3) 0 0; font-size: var(--step--1); color: var(--c-ink-faint); max-width: var(--measure); }
  @media (max-width: 860px) {
    .body section { grid-template-columns: 1fr; }
  }
</style>
