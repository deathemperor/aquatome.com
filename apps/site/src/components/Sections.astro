---
import type { Range, SectionKey } from '@aq/schema'
import GlossaryTip from './GlossaryTip.astro'
import RangeBlock from './RangeBlock.astro'
import PhoneFold from './PhoneFold.astro'
import { getContent } from '../lib/content'
import { figureHtml } from '../lib/figures'
import { DISPLAY_ORDER, QUESTION_LABELS } from '../lib/sections'
import { OFF_LABELS, sectionParts, type SectionProps } from '../lib/section-parts'
import { fmt, isRange } from '../lib/format'
import { i18n } from '../lib/i18n'
/** `card`: a species' data card. Its figures are the page's own: a quick-facts list drops what the card already gives, and a
 * block that states a figure the card shows otherwise says which source it follows (@aq/schema card-facts). The text is
 * put together in lib/section-parts.ts, which the app's copy of the page reads too.
 * A slot named after a section (a species' tank mates under "behaviour", Vietnam's climate under "waterConditions") goes
 * at the end of that section, or where it would be when the page has none. The sources' own reference lists ("Tài liệu
 * tham khảo") go in the source list, which is one closed block after the text.
 * `fold`: sections whose text a phone folds under their heading (PhoneFold.astro). */
type Props = SectionProps & { fold?: SectionKey[] }
const { fold = [] } = Astro.props
// `t` is the entity's translation (a prop): the translator is `tr` here.
const { t: tr, lang } = i18n(Astro.url)
const { range } = fmt(lang)
const pair = (v: Range | number) => (isRange(v) ? `${v.min},${v.max}` : `${v},${v}`)
const { groups, refs, figAfter, wild, wildAt } = sectionParts(lang, await getContent(lang), Astro.props)
const biblio = groups.find(g => g.key === 'references')
// Each slot's place: inside its own section, else before the first section after where it would be (or the end).
const SLOTS = (['waterConditions', 'behaviour'] as SectionKey[]).filter(k => Astro.slots.has(k))
const at = (k: SectionKey) => { const i = groups.findIndex(g => g.key !== 'references' && DISPLAY_ORDER.indexOf(g.key) >= DISPLAY_ORDER.indexOf(k)); return i < 0 ? groups.length : i }
const before = (i: number) => SLOTS.filter(k => at(k) === i && groups[i]?.key !== k)
---
<div class="wrap body">
  {groups.map((sec, i) => (<>
    {before(i).map(k => <div class="slotted"><slot name={k} /></div>)}
    {wild && i === wildAt && <section data-section="range" id="muc-range"><h2>{wild.title}</h2><RangeBlock part={wild} /></section>}
    {sec !== biblio && (
      <section data-section={sec.key} id={`muc-${sec.key}`}>
        <PhoneFold on={fold.includes(sec.key)}>
        <h2 slot="head">{tr(QUESTION_LABELS[sec.key])}</h2>
        {sec.blocks.map(b => (<>
          {b.off.length > 0 && (
            <p class="off" data-source={b.source} data-pagefind-ignore>
              <span class="mark" aria-hidden="true" />
              {tr('{source} ghi khác bảng dữ liệu:', { source: b.name })}{' '}
              {b.off.map((o, i) => {
                const fig = (v: Range | number) => (o.field === 'tempC' ? <span data-c={pair(v)}>{range(v)}°C</span>
                  : o.field === 'sizeCm' || o.field === 'tankCm' || o.field === 'tankL' ? <span data-cm={pair(v)}>{range(v)} cm</span>
                  : o.field === 'gh' ? `${range(v)} dGH` : range(v))
                return <span data-off={o.field}>{i > 0 && ', '}{tr(OFF_LABELS[o.field]!)} <span class="theirs">{o.field === 'tankL' ? `${range(o.own)} ${tr('lít')}` : fig(o.own)}</span> ({tr('bảng:')} <span class="ours">{fig(o.card)}</span>)</span>
              })}.
            </p>
          )}
          <div class="prose" data-source={b.source} set:html={b.vi} />
        </>))}
        </PhoneFold>
        {SLOTS.includes(sec.key) && <div class="slotted"><slot name={sec.key} /></div>}
      </section>
    )}
    {figAfter.has(i) && <Fragment set:html={figureHtml(lang, figAfter.get(i)!)} />}
  </>
  ))}
  {before(groups.length).map(k => <div class="slotted"><slot name={k} /></div>)}
  {wild && wildAt === groups.length && <section data-section="range" id="muc-range"><h2>{wild.title}</h2><RangeBlock part={wild} /></section>}
  {refs.length > 0 && (
    <section class="refs" id="nguon" data-pagefind-ignore>
      <details>
        <summary><h2 id="nguon-h">{tr('Nguồn')}</h2> <span class="n">{biblio ? tr('{n} nguồn và tài liệu tham khảo', { n: refs.length }) : tr('{n} nguồn', { n: refs.length })}</span><svg class="chev" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
        <ol>{refs.map((r, i) => <li id={`nguon-${i + 1}`}><a href={r.url} rel="noopener">{r.name}</a> <span class="host">{new URL(r.url).hostname.replace(/^www\./, '')}</span></li>)}</ol>
        <p class="note">{tr('Các phần trên dịch từ những nguồn này. Mỗi đoạn ghi số nguồn của nó.')}</p>
        {biblio && (
          <section class="biblio" data-section="references" id="muc-references">
            <h3>{tr(QUESTION_LABELS.references)}</h3>
            {biblio.blocks.map(b => <div class="prose" data-source={b.source} set:html={b.vi} />)}
          </section>
        )}
      </details>
    </section>
  )}
  <GlossaryTip />
</div>
<style>
  .body section { display: grid; grid-template-columns: minmax(0, var(--measure)) 1fr; column-gap: var(--space-6); padding-block: var(--space-5); border-top: 1px solid var(--c-rule); }
  .body h2 { font-size: var(--step-2); grid-column: 1; margin-bottom: var(--space-3); }
  .prose { grid-column: 1; }
  /* A block that follows a source the data card didn't: said once, quietly, above it, with the card's dot. */
  .off { grid-column: 1; margin: 0 0 var(--space-2); font-size: var(--step--1); line-height: 1.5; color: var(--c-ink-soft); }
  .off .mark { display: inline-block; width: 0.45rem; height: 0.45rem; margin-right: 0.4rem; border-radius: 50%; background: var(--c-cardinal); vertical-align: 0.08em; }
  .off span[data-c], .off span[data-cm] { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .prose + .off { margin-top: var(--space-3); }
  .prose + .prose { margin-top: var(--space-2); }
  .prose :global(p) { margin: 0 0 var(--space-3); line-height: 1.7; }
  .prose :global(.ml) { color: inherit; text-decoration-color: var(--c-moss); text-decoration-thickness: 1.5px; }
  .prose :global(.gl) { color: inherit; text-decoration: underline dotted var(--c-moss); text-decoration-thickness: 1.5px; }
  /* Tank mates and Vietnam's climate, at the end of the section they answer. */
  .slotted { grid-column: 1; }
  /* The source list, closed: one row after the text, its count beside the heading; open, the numbered sources, then the
     sources' own reference lists. */
  .refs details { grid-column: 1; }
  .refs summary { position: relative; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 var(--space-3); min-height: 2.75rem; padding-right: 2.75rem; cursor: pointer; list-style: none; }
  .refs summary::-webkit-details-marker { display: none; }
  .refs summary h2 { margin: 0; }
  .refs summary .n { font-size: var(--step--1); color: var(--c-ink-soft); text-decoration: underline dotted var(--c-rule); text-underline-offset: 4px; }
  .refs summary:hover .n { color: var(--c-ink); }
  .refs .chev { position: absolute; right: var(--space-2); top: calc(50% - 8px); color: var(--c-ink-soft); transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1); }
  .refs details[open] .chev { transform: rotate(180deg); }
  .refs details[open] > summary { margin-bottom: var(--space-3); padding-bottom: var(--space-2); border-bottom: 1px solid var(--c-rule); }
  /* The row's rule is the summary's, the width of the column, open only (handbook.css rules the heading, hence its weight). */
  :global(:root:not(#_)) .refs summary h2 { border-bottom: 0; padding-bottom: 0; }
  .body .biblio { display: block; margin-top: var(--space-4); padding-bottom: 0; font-size: var(--step--1); color: var(--c-ink-soft); }
  .biblio h3 { font-size: var(--step-1); margin-bottom: var(--space-2); color: var(--c-ink); }
  .biblio .prose :global(p) { line-height: 1.6; overflow-wrap: anywhere; }
  /* The source list: numbers set like the marks in the text, so a reader matches them at a glance. */
  .refs ol { grid-column: 1; list-style: none; margin: 0; padding: 0; counter-reset: ref; font-size: var(--step--1); }
  .refs li { counter-increment: ref; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 var(--space-2); padding-block: var(--space-2); border-top: 1px dotted var(--c-rule); }
  .refs li::before { content: counter(ref); flex: none; min-width: 1.5rem; height: 1.5rem; display: inline-grid; place-items: center; border-radius: 999px; font: 600 0.75rem/1 var(--f-body); font-variant-numeric: tabular-nums; color: var(--c-moss); background: color-mix(in srgb, var(--c-moss) 12%, transparent); }
  .refs li:target::before { color: var(--c-paper); background: var(--c-moss); }
  .refs a { color: var(--c-ink); font-weight: 600; }
  .refs .host { color: var(--c-ink-faint); }
  .refs .note { grid-column: 1; margin: var(--space-3) 0 0; font-size: var(--step--1); color: var(--c-ink-faint); max-width: var(--measure); }
  @media (max-width: 860px) {
    .body section { grid-template-columns: 1fr; }
  }
</style>
