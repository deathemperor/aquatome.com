---
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props
const links = [
  ['/vi/ca/', 'Loài cá'], ['/vi/cay/', 'Cây'], ['/vi/huong-dan/', 'Hướng dẫn'], ['/vi/thiet-bi/', 'Thiết bị'], ['/vi/kham-pha/', 'Khám phá'],
]
const path = Astro.url.pathname
---
<header class:list={['nav', { overlay }]}>
  <div class="wrap row">
    <a class="logo" href="/vi/">thủy<span>·</span>sinh</a>
    <nav aria-label="Chính">
      <ul>
        {links.map(([href, label]) => <li><a href={href} aria-current={path.startsWith(href!) ? 'page' : undefined}>{label}</a></li>)}
      </ul>
    </nav>
    <slot />
  </div>
</header>
<style>
  .nav { background: var(--c-blackwater); color: var(--c-on-dark); }
  .nav.overlay { position: absolute; inset: 0 0 auto; background: none; z-index: 3; }
  .row { display: flex; align-items: center; gap: var(--space-5); min-height: 64px; flex-wrap: wrap; }
  .logo { font: 600 1.35rem var(--f-display); color: #fff; text-decoration: none; margin-right: auto; letter-spacing: -0.01em; }
  .logo span { color: var(--c-neon); }
  ul { display: flex; gap: var(--space-5); list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  ul a { color: var(--c-on-dark); text-decoration: none; font-size: 0.9rem; padding-block: var(--space-2); }
  ul a:hover, ul a[aria-current] { color: #fff; box-shadow: inset 0 -2px var(--c-neon); }
  @media (max-width: 640px) { ul { gap: var(--space-4); overflow-x: auto; flex-wrap: nowrap; width: 100%; padding-bottom: var(--space-2); } }
</style>
