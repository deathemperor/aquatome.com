---
import UnitsToggle from './UnitsToggle.astro'
import ThemeToggle from './ThemeToggle.astro'
import { i18n } from '../lib/i18n'
/** current: the section to mark when the URL doesn't say (video guides live under /vi/huong-dan/). */
interface Props { overlay?: boolean; current?: string }
const { overlay = false, current } = Astro.props
const { t } = i18n(Astro.url)
const links = [
  ['/vi/ca/', t('Loài cá')], ['/vi/cay/', t('Cây')], ['/vi/huong-dan/', t('Hướng dẫn')], ['/vi/video/', t('Video')], ['/vi/thiet-bi/', t('Thiết bị')], ['/vi/kham-pha/', t('Khám phá')], ['/vi/cong-cu/', t('Công cụ')],
]
const path = current ?? Astro.url.pathname
---
<header class:list={['nav', { overlay }]}>
  <div class="wrap row">
    <a class="logo" href="/vi/">Aqua<span>Tome</span> <small>{t('Cẩm nang cá cảnh & thủy sinh')}</small></a>
    <nav aria-label={t('Chính')}>
      <ul>
        {links.map(([href, label]) => <li><a href={href} aria-current={path.startsWith(href!) ? 'page' : undefined}>{label}</a></li>)}
      </ul>
    </nav>
    <a class="find" href="/vi/tim-kiem/">{t('Tìm')}</a>
    <UnitsToggle />
    <ThemeToggle />
    <slot />
  </div>
</header>
<style>
  .nav { background: var(--c-blackwater); color: var(--c-on-dark); }
  .nav.overlay { position: absolute; inset: 0 0 auto; background: none; z-index: 3; }
  .row { display: flex; align-items: center; gap: var(--space-5); min-height: 64px; flex-wrap: wrap; }
  .logo { font: 600 1.35rem var(--f-display); color: #fff; text-decoration: none; margin-right: auto; letter-spacing: -0.01em; }
  .find { color: var(--c-on-dark); font-size: 0.9rem; text-decoration: none; padding-block: 10px; }
  .find:hover { color: #fff; }
  .logo span { color: var(--c-neon); }
  .logo small { display: block; font: 500 0.7rem var(--f-body); color: var(--c-on-dark-soft); letter-spacing: 0.02em; margin-top: 1px; }
  ul { display: flex; gap: var(--space-5); list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  ul a { display: inline-block; color: var(--c-on-dark); text-decoration: none; font-size: 0.9rem; padding-block: 10px; white-space: nowrap; }
  ul a:hover, ul a[aria-current] { color: #fff; box-shadow: inset 0 -2px var(--c-neon); }
  @media (max-width: 640px) {
    .row { gap: var(--space-2) var(--space-4); padding-block: var(--space-2); }
    nav { order: 3; width: 100%; }
    .logo small { max-width: 7.5rem; } /* tagline on two lines: logo, Tìm, units and theme fit one row at 360px */
    ul { gap: 0 var(--space-4); } /* wraps to two rows: every section visible, nothing scrolled out of sight */
    ul a { font-size: 0.95rem; }
  }
</style>
