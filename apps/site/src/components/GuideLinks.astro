---
import type { GuideEntity, Localized } from '@aq/schema'
import { GUIDE_KIND_LABELS } from '../lib/format'
import { i18n } from '../lib/i18n'
interface Props { guides: Localized<GuideEntity>[]; heading?: string; max?: number }
const { t } = i18n(Astro.url)
const { guides, heading = t('Bài viết nhắc đến'), max = 8 } = Astro.props
---
{guides.length > 0 && (
  <section class="wrap guides" aria-label={heading} data-pagefind-ignore>
    <h2>{heading}</h2>
    <ul>{guides.slice(0, max).map(g => <li><a href={`/vi/huong-dan/${g.t.slug}/`}>{g.t.name}</a> <span>{t(GUIDE_KIND_LABELS[g.kind])}</span></li>)}</ul>
  </section>
)}
<style>
  .guides { padding-block: var(--space-5); }
  h2 { font-size: var(--step-2); border-bottom: 2px solid var(--c-ink); padding-bottom: var(--space-2); margin-bottom: var(--space-4); }
  ul { list-style: none; padding: 0; margin: 0; display: grid; }
  /* A row a finger can take (44 px), the rows as close as before. */
  li { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-2); min-height: 44px; }
  li a { display: inline-flex; align-items: center; min-height: 44px; }
  li span { color: var(--c-ink-faint); font-size: 0.85rem; }
</style>
