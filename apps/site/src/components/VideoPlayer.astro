---
import type { GuideEntity } from '@aq/schema'
import { clock, videoPhoto, watchUrl } from '../lib/video'
import { i18n } from '../lib/i18n'
interface Props { video: NonNullable<GuideEntity['video']>; chapters?: string[]; cover?: string }
const { video: v, chapters = [], cover } = Astro.props
const { t } = i18n(Astro.url)
const thumb = videoPhoto(v)
// Vietnamese chapter titles when the writer gave one per chapter, else the creator's own.
const marks = v.chapters.map((c, i) => ({ start: c.start, title: chapters.length === v.chapters.length ? chapters[i]! : c.title }))
---
<figure class="vp" data-vp={v.youtubeId}>
  <div class="frame">
    <button type="button" class="facade" data-t="0" aria-label={v.transcribed ? t('Phát video “{title}”', { title: v.title }) : t('Phát video “{title}”, phụ đề tiếng Việt', { title: v.title })}>
      {/* Phones get the 640 px thumbnail (a third of the 1280 px one's bytes); every video with a 1280 px one has it. */}
      <picture>{thumb.width >= 1280 && <source media="(max-width: 480px)" srcset={`https://i.ytimg.com/vi/${v.youtubeId}/sddefault.jpg`} />}<img src={thumb.url} width={thumb.width} height={thumb.height} alt="" fetchpriority="high" /></picture>
      <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg></span>
      {cover && <span class="cover" aria-hidden="true">{cover}</span>}
      {!v.transcribed && <span class="cc" aria-hidden="true">{t('Phụ đề tiếng Việt')}</span>}
    </button>
  </div>
  <figcaption>
    {t('Video gốc:')} <a href={watchUrl(v.youtubeId)} rel="noopener">{v.title}</a>{t(', kênh')} <a href={v.channelUrl} rel="noopener">{v.channel}</a> · {clock(v.durationSec)}
  </figcaption>
</figure>
{marks.length > 1 && (
  <details class="chapters" open={marks.length <= 12}>
    <summary>{t('Các đoạn trong video ({n})', { n: marks.length })}</summary>
    <ol>
      {marks.map(m => <li><button type="button" data-t={m.start} data-vp-for={v.youtubeId}><span class="t">{clock(m.start)}</span> {m.title}</button></li>)}
    </ol>
  </details>
)}
<script>
  // No imports: a script with none is inlined into the page. Each language's own name, as in lib/i18n LANG_NAME.
  const LANG_NAME: Record<string, string> = { vi: 'Tiếng Việt', id: 'Bahasa Indonesia', th: 'ภาษาไทย' }
  type Player = {
    seekTo(s: number, allow: boolean): void; playVideo(): void
    getOption(m: string, k: string): unknown; setOption(m: string, k: string, v: unknown): void
  }
  type YTApi = { Player: new (el: HTMLElement, o: object) => Player; PlayerState: { PLAYING: number } }
  const w = window as unknown as { YT?: YTApi; onYouTubeIframeAPIReady?: () => void }
  const lang = document.documentElement.lang

  let api: Promise<YTApi> | undefined
  const loadApi = () => (api ??= new Promise<YTApi>((resolve, reject) => {
    if (w.YT?.Player) return resolve(w.YT)
    const prev = w.onYouTubeIframeAPIReady
    w.onYouTubeIframeAPIReady = () => { prev?.(); resolve(w.YT!) }
    const s = document.createElement('script')
    s.src = 'https://www.youtube.com/iframe_api'
    s.onerror = () => { api = undefined; s.remove(); reject(new Error('iframe_api')) }
    document.head.append(s)
  }))

  /** Captions in the page's language (Vietnamese on /vi/): the creator's own track in it if there is one, else YouTube's translation of the original track. */
  function vietnamese(p: Player) {
    const list = (p.getOption('captions', 'tracklist') as { languageCode?: string }[] | undefined) ?? []
    if (list.some(t => t.languageCode === lang)) return p.setOption('captions', 'track', { languageCode: lang })
    const base = list.find(t => t.languageCode?.startsWith('en')) ?? list[0] ?? (p.getOption('captions', 'track') as { languageCode?: string } | undefined)
    p.setOption('captions', 'track', { languageCode: base?.languageCode || 'en', translationLanguage: { languageCode: lang, languageName: LANG_NAME[lang] } })
  }

  /** One player per video, stored as soon as it is being made, so a second click waits for it instead of making another. */
  const players = new Map<string, Promise<Player | null>>()
  function create(fig: HTMLElement, id: string, t: number): Promise<Player | null> {
    const slot = document.createElement('div')
    const frame = fig.querySelector('.frame')!
    return loadApi().then(YT => new Promise<Player>(resolve => {
      frame.replaceChildren(slot)
      let captioned = false
      new YT.Player(slot, {
        host: 'https://www.youtube-nocookie.com', videoId: id,
        playerVars: { autoplay: 1, start: t, rel: 0, playsinline: 1, cc_load_policy: 1, cc_lang_pref: lang, hl: lang },
        events: {
          onReady: (e: { target: Player }) => { e.target.playVideo(); resolve(e.target) },
          onStateChange: (e: { target: Player; data: number }) => {
            if (e.data !== YT.PlayerState.PLAYING || captioned) return
            captioned = true
            try { vietnamese(e.target) } catch { /* captions stay as YouTube chose */ }
          },
        },
      })
    }), () => {
      // The control script was blocked (ad blocker, offline): a plain embed still plays, with captions on.
      const f = document.createElement('iframe')
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&start=${t}&rel=0&cc_load_policy=1&cc_lang_pref=${lang}&hl=${lang}`
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'
      f.title = fig.querySelector('.facade')?.getAttribute('aria-label') ?? 'Video'
      frame.replaceChildren(f)
      return null
    })
  }
  async function play(fig: HTMLElement, t: number) {
    const id = fig.dataset.vp!
    const made = players.get(id)
    if (!made) { players.set(id, create(fig, id, t)); return }
    const p = await made
    if (p) { p.seekTo(t, true); p.playVideo(); return }
    const f = fig.querySelector('iframe') // plain embed: reload at the chapter
    if (f) f.src = f.src.replace(/start=\d+/, `start=${t}`)
  }

  document.addEventListener('click', e => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-t]')
    if (!b) return
    const fig = b.closest<HTMLElement>('[data-vp]') ?? document.querySelector<HTMLElement>(`[data-vp="${b.dataset.vpFor}"]`)
    if (!fig) return
    if (!b.closest('[data-vp]')) fig.scrollIntoView({ behavior: 'smooth', block: 'center' })
    void play(fig, Number(b.dataset.t) || 0)
  })
</script>
<style>
  .vp { margin: var(--space-5) 0 var(--space-3); }
  .frame { position: relative; aspect-ratio: 16 / 9; background: #000; }
  .frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .facade { position: absolute; inset: 0; padding: 0; border: 0; background: none; cursor: pointer; display: grid; place-items: center; }
  .facade img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .play { position: relative; width: 68px; height: 68px; border-radius: 50%; background: var(--c-cardinal); color: #fff; display: grid; place-items: center; box-shadow: 0 2px 12px rgb(0 0 0 / 0.35); transition: transform 0.15s ease-out; }
  .facade:hover .play, .facade:focus-visible .play { transform: scale(1.06); }
  .cover { position: absolute; left: 0; top: var(--space-4); max-width: 75%; background: var(--c-paper); color: var(--c-ink); font: 600 clamp(1.1rem, 3.2vw, 1.7rem)/1.15 var(--f-display); padding: 8px 14px 8px var(--space-4); border-left: 4px solid var(--c-cardinal); text-align: left; box-shadow: 0 2px 10px rgb(0 0 0 / 0.3); }
  .cc { position: absolute; left: var(--space-3); bottom: var(--space-3); background: rgb(0 0 0 / 0.75); color: #fff; font-size: 0.8rem; font-weight: 600; padding: 4px 8px; }
  figcaption { font-size: var(--step--1); color: var(--c-ink-faint); margin-top: var(--space-2); }
  figcaption a { color: var(--c-ink-soft); }
  .chapters { margin: 0 0 var(--space-5); border-top: 1px solid var(--c-rule); border-bottom: 1px solid var(--c-rule); }
  .chapters summary { cursor: pointer; padding: var(--space-3) 0; font-weight: 600; font-size: 0.95rem; min-height: 44px; box-sizing: border-box; }
  .chapters ol { list-style: none; margin: 0 0 var(--space-3); padding: 0; columns: 2 16rem; column-gap: var(--space-5); }
  .chapters li { break-inside: avoid; }
  .chapters button { display: flex; gap: var(--space-3); width: 100%; text-align: left; background: none; border: 0; padding: 8px 0; font: inherit; font-size: 0.95rem; color: var(--c-ink); cursor: pointer; min-height: 44px; align-items: baseline; }
  .chapters button:hover { color: var(--c-cardinal); }
  .t { font-variant-numeric: tabular-nums; color: var(--c-ink-soft); min-width: 3.2em; }
</style>
