---
import type { Localized, PlantEntity } from '@aq/schema'
import { PLANT_LABELS } from '../lib/format'
import { smallSrc } from '../lib/img'
interface Props { p: Localized<PlantEntity> }
const { p } = Astro.props
const ph = p.photos[0]
---
<article class="pc">
  <a href={`/vi/cay/${p.t.slug}/`}>
    <div class="plate">{ph && <img src={smallSrc(ph)} width={ph.width} height={ph.height} alt="" loading="lazy" />}</div>
    <h3>{p.t.name}</h3>
    <p class="sci">{p.scientificName}</p>
  </a>
  <p class="meta">Ánh sáng {PLANT_LABELS.light[p.light]?.toLowerCase()}, CO₂ {PLANT_LABELS.co2[p.co2]?.toLowerCase()}</p>
</article>
<style>
  .pc a { text-decoration: none; color: inherit; display: block; }
  .plate { background: var(--c-plate); padding: 5px; border-radius: var(--radius-plate); box-shadow: 0 1px 0 var(--c-rule); }
  .plate img { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  h3 { font-size: var(--step-1); margin-top: var(--space-3); }
  .pc a:hover h3 { color: var(--c-moss); }
  .sci { margin: 0; font-size: 0.9rem; color: var(--c-ink-soft); }
  .meta { margin: var(--space-2) 0 0; padding-top: var(--space-2); border-top: 1px dotted var(--c-rule); font-size: 0.8rem; color: var(--c-ink-soft); }
</style>
