---
import type { SourceId, SourceInfo } from '@aq/schema'
interface Props { source: SourceId; url: string; sources: Partial<Record<SourceId, SourceInfo>> }
const { source, url, sources } = Astro.props
const name = sources[source]?.name ?? source
---
<p class="credit">Theo <a href={url} rel="noopener">{name}</a></p>
<style>
  .credit { font-size: var(--step--1); color: var(--c-ink-faint); margin: 0; }
  .credit a { color: var(--c-ink-soft); }
</style>
