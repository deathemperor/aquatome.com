---
import { goLink } from '../lib/format'
import type { GearRow } from '../lib/gear'
import { clock } from '../lib/video'
interface Props { rows: GearRow[]; youtubeId?: string; heading: string; entity?: string }
const { rows, youtubeId, heading, entity } = Astro.props
---
{rows.length > 0 && (
  <section class="wrap gear" aria-labelledby="gear-h">
    <h2 id="gear-h">{heading}</h2>
    <ul>
      {rows.map(r => (
        <li>
          <span class="cat">{r.page ? <a href={r.page}>{r.label}</a> : r.label}</span>
          <span class="name">{r.name}</span>
          {r.t !== undefined && youtubeId ? <button type="button" class="seek" data-t={r.t} data-vp-for={youtubeId} aria-label={`Xem đoạn ${clock(r.t)} trong video`}>{clock(r.t)}</button> : <span />}
          <span class="shops">
            <a href={goLink('shopee', r.keyword, r.category, entity)} rel="sponsored nofollow noopener" target="_blank">Shopee</a>
            <a href={goLink('lazada', r.keyword, r.category, entity)} rel="sponsored nofollow noopener" target="_blank">Lazada</a>
            <a href={goLink('tiki', r.keyword, r.category, entity)} rel="sponsored nofollow noopener" target="_blank">Tiki</a>
          </span>
        </li>
      ))}
    </ul>
    <p class="note">Tên và mốc thời gian lấy từ video. Liên kết tiếp thị: trang có thể nhận hoa hồng khi bạn mua qua liên kết.</p>
  </section>
)}
<style>
  .gear { padding-bottom: var(--space-6); }
  h2 { font-size: var(--step-2); border-bottom: 2px solid var(--c-ink); padding-bottom: var(--space-2); margin-bottom: var(--space-3); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 7rem 1fr 4rem auto; gap: var(--space-3); align-items: baseline; padding-block: var(--space-3); border-bottom: 1px dotted var(--c-rule); }
  .cat { font-size: var(--step--1); color: var(--c-ink-faint); }
  .name { font-weight: 500; }
  .seek { font: inherit; font-size: 0.85rem; font-variant-numeric: tabular-nums; background: none; border: 1px solid var(--c-rule); border-radius: 999px; padding: 2px 10px; min-height: 32px; color: var(--c-ink); cursor: pointer; }
  .seek:hover { border-color: var(--c-ink); }
  .shops { display: flex; gap: var(--space-3); font-size: 0.9rem; }
  .note { font-size: 0.75rem; color: var(--c-ink-faint); margin-top: var(--space-2); }
  @media (max-width: 560px) { li { grid-template-columns: 1fr auto; gap: var(--space-1) var(--space-3); } .cat { grid-column: 1 / -1; } .shops { grid-column: 1 / -1; } }
</style>
