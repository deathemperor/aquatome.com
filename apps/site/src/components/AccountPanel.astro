---
import { i18n } from '../lib/i18n'
import AppInvite from './AppInvite.astro'

/**
 * The site's sign-in (scripts/account-panel.ts initAccount): on "Bể của tôi", where it syncs the tanks, and alone on
 * the sign-in page (/vi/dang-nhap/, which the dashboard shows in its place). Hidden until the server offers accounts.
 * `alone`: the page's only section, under its title (no rule above, and the sign-in button stands out). `lead`: '' for none.
 * The `signed-in` slot shows with the signed-in account, above its name.
 */
interface Props { heading?: string; lead?: string; open?: string; alone?: boolean }
const { t } = i18n(Astro.url)
const {
  alone = false,
  heading = t('Đồng bộ giữa các thiết bị'),
  lead = t('Muốn xem các bể này trên máy khác hoặc trong ứng dụng AquaTome trên iPhone? Đăng nhập để đồng bộ. Không bắt buộc: không đăng nhập thì bể vẫn lưu trên trình duyệt này.'),
  open = t('Đăng nhập để đồng bộ'),
} = Astro.props
---
<section id="tai-khoan" class:list={['account', { alone }]} aria-labelledby="acc-h" hidden>
  <h2 id="acc-h">{heading}</h2>
  <div id="acc-out">
    {lead && <p>{lead}</p>}
    <p><button id="acc-open" type="button" class={alone ? 'primary' : 'quiet'} aria-expanded="false" aria-controls="acc-ways">{open}</button></p>
  </div>
  <div id="acc-in" hidden>
    <slot name="signed-in" />
    <p id="acc-status" aria-live="polite"></p>
    <p class="row">
      <button id="acc-sync" type="button" class="quiet">{t('Đồng bộ ngay')}</button>
      <button id="acc-add" type="button" class="quiet" aria-expanded="false" aria-controls="acc-ways">{t('Thêm cách đăng nhập')}</button>
      <button id="acc-passkey-add" type="button" class="quiet" hidden>{t('Thêm passkey')}</button>
      <a id="acc-export" href="/api/v1/account/export" download>{t('Tải dữ liệu tài khoản')}</a>
      <button id="acc-switch" type="button" class="primary" hidden>{t('Đổi tài khoản')}</button>
      <button id="acc-signout" type="button" class="quiet">{t('Đăng xuất')}</button>
    </p>
  </div>
  <div id="acc-ways" class="ways" hidden>
    <p id="acc-ways-reauth" hidden></p>
    <p id="acc-ways-add" hidden>{t('Thêm một cách đăng nhập nữa cho tài khoản này: lần sau đăng nhập bằng cách nào cũng vào cùng tài khoản, cùng các bể.')}</p>
    <div id="acc-google" class="way"></div>
    <button id="acc-apple" type="button" class="apple way" hidden>
      <svg viewBox="0 0 17 20" aria-hidden="true"><path d="M14.2 10.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.7-1-2.7-4.1zM11.7 3c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3.1-1.5z" /></svg>
      {t('Đăng nhập bằng Apple')}
    </button>
    <button id="acc-passkey" type="button" class="quiet way" hidden>{t('Đăng nhập bằng passkey')}</button>
    <form id="acc-email" class="email" hidden novalidate>
      <label>{t('Hoặc nhận mã đăng nhập qua email')} <input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
      <div data-turnstile></div>
      <button type="submit" class="quiet">{t('Gửi mã')}</button>
    </form>
    <form id="acc-code" class="email" hidden novalidate>
      <label>{t('Mã 6 số trong email')} <input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required /></label>
      <button type="submit" class="primary">{t('Đăng nhập')}</button>
    </form>
    <p class="fine">{t('Chỉ dùng để nhận ra bạn khi đăng nhập: không lưu tên, số điện thoại, và địa chỉ email chỉ lưu ở dạng mã hóa một chiều.')} <a href="/vi/chinh-sach-bao-mat/#tai-khoan">{t('Chính sách bảo mật')}</a></p>
  </div>
  {lead && <AppInvite ct="site-tanks" text={t('Chưa có ứng dụng AquaTome? Tải về cho iPhone, iPad.')} />}
  <details id="acc-leave" class="leave" hidden>
    <summary>{t('Xóa tài khoản')}</summary>
    <p>{t('Xóa ngay tài khoản, các cách đăng nhập và mọi bể lưu trong tài khoản. Không khôi phục được. Bể trên trình duyệt này vẫn còn.')}</p>
    <p><button id="acc-delete" type="button" class="quiet danger">{t('Xóa tài khoản vĩnh viễn')}</button></p>
  </details>
  <p id="acc-msg" class="msg" role="status" hidden></p>
</section>

<style>
  .account { max-width: var(--measure); margin: var(--space-8) 0 0; padding-top: var(--space-4); border-top: 1px solid var(--c-rule); }
  .account.alone { margin-top: 0; padding-top: 0; border-top: 0; }
  .account h2 { font-size: var(--step-1); margin: 0 0 var(--space-3); }
  .account p { margin: 0 0 var(--space-3); }
  .ways { display: grid; gap: var(--space-3); margin-top: var(--space-4); max-width: 22rem; }
  .ways[hidden] { display: none; }
  .way { min-height: 44px; }
  :global(.account button) { font: 500 1rem var(--f-body); padding: 0.6rem 1.15rem; border-radius: 8px; cursor: pointer; border: 1px solid transparent; min-height: 44px; transition: background-color 0.15s, border-color 0.15s, color 0.15s; }
  :global(.account button.primary) { background: var(--c-ink); color: var(--c-paper); }
  :global(.account button.primary:hover) { background: var(--c-moss); }
  :global(.account button.quiet) { background: none; color: var(--c-ink); border-color: var(--c-rule); }
  :global(.account button.quiet:hover) { border-color: var(--c-ink); }
  :global(.account button.danger:hover) { color: var(--c-cardinal); border-color: var(--c-cardinal); }
  :global(.account :is(button, input, a, summary):focus-visible) { outline: 2px solid var(--c-focus); outline-offset: 2px; }
  :global(.account button:disabled) { opacity: 0.55; cursor: progress; }
  .apple { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; background: #000; color: #fff; border-radius: 4px; }
  .apple[hidden] { display: none; }
  .apple svg { width: 1rem; height: 1.15rem; fill: currentColor; }
  .email { display: grid; gap: var(--space-2); }
  .email[hidden] { display: none; }
  .email label { display: grid; gap: var(--space-1); font-size: 0.85rem; color: var(--c-ink-soft); }
  .email input { box-sizing: border-box; width: 100%; font: inherit; font-size: 1rem; color: var(--c-ink); padding: 0.5rem 0.65rem; border: 1px solid var(--c-rule); border-radius: 8px; background: var(--c-mat); min-height: 44px; }
  .email input[name=code] { font-variant-numeric: tabular-nums; letter-spacing: 0.2em; max-width: 10rem; }
  .fine { font-size: var(--step--1); color: var(--c-ink-faint); }
  .account .row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .leave { margin-top: var(--space-5); }
  .leave summary { cursor: pointer; color: var(--c-ink-soft); }
  .msg { font-size: var(--step--1); color: var(--c-ink-soft); }
  .msg.bad { color: var(--c-cardinal); }
</style>
