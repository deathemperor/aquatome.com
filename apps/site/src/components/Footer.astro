---
import { groupCredits, type Credit } from '../lib/credits'
import { i18n, LANG_NAME, licenceLabel, served, type Lang } from '../lib/i18n'
/** langs: this page in each language that has it (absolute URLs), for the language links. */
interface Props { credits?: Credit[]; langs?: (readonly [Lang, string])[] }
const { credits = [], langs = [] } = Astro.props
const { t, lang } = i18n(Astro.url)
const links = ([['/vi/gioi-thieu/', t('Giới thiệu')], ['/vi/chinh-sach-bao-mat/', t('Chính sách bảo mật')], ['/vi/lien-he/', t('Liên hệ')], ['/vi/moi-cap-nhat/', t('Mới cập nhật')]] as const).filter(([href]) => served(lang, href))
const groups = groupCredits(credits)
---
<footer class="foot">
  <div class="wrap">
    <p>{t('Nội dung dịch từ các nguồn được cấp phép, hoặc AquaTome tự viết dựa trên video YouTube (video phát bằng trình phát của YouTube); mỗi trang ghi rõ nguồn và liên kết tới bản gốc. Ảnh thuộc về tác giả, dùng theo giấy phép ghi kèm.')}</p>
    <nav class="links" aria-label={t('Thông tin')}>
      {links.map(([href, label], i) => <>{i > 0 && ' · '}<a href={href}>{label}</a></>)}
      {credits.length > 0 && <> · <button type="button" class="credits-btn" popovertarget="photo-credits">{t('Nguồn ảnh ({n})', { n: credits.length })}</button></>}
    </nav>
    {langs.length > 1 && (
      <nav class="langs" aria-label={t('Ngôn ngữ')}>
        {langs.map(([l, href], i) => <>{i > 0 && ' · '}{l === lang ? <span aria-current="page">{LANG_NAME[l]}</span> : <a href={href} hreflang={l} lang={l}>{LANG_NAME[l]}</a>}</>)}
      </nav>
    )}
  </div>
  {credits.length > 0 && (
    <div id="photo-credits" class="credits" popover aria-labelledby="photo-credits-h">
      <div class="head">
        <h2 id="photo-credits-h">{t('Nguồn ảnh trên trang này')}</h2>
        <button type="button" popovertarget="photo-credits" popovertargetaction="hide" aria-label={t('Đóng')}>×</button>
      </div>
      <ul>
        {groups.map(g => (
          <li>
            {g.urls.length === 1 ? <a href={g.urls[0]} rel="noopener">{g.author}</a> : <strong>{g.author}</strong>}
            <span class="lic"> · {licenceLabel(t, g.licence)}{g.urls.length > 1 && ` · ${t('{n} ảnh', { n: g.urls.length })}`}</span>
            {g.urls.length > 1 && <span class="nums">{g.urls.map((u, i) => <a href={u} rel="noopener" aria-label={t('{author}, ảnh {n}', { author: g.author, n: i + 1 })}>{i + 1}</a>)}</span>}
          </li>
        ))}
      </ul>
    </div>
  )}
</footer>
<style>
  .foot { background: var(--c-blackwater); color: var(--c-on-dark-soft); font-size: var(--step--1); padding-block: var(--space-6); border-top: 1px solid rgb(255 255 255 / 0.08); }
  .foot p { max-width: var(--measure); margin: 0 0 var(--space-2); }
  .foot a { color: var(--c-on-dark); }
  .links a, .links .credits-btn { display: inline-block; padding-block: 10px; }
  .links { margin-bottom: var(--space-2); }
  .langs { margin-bottom: var(--space-2); }
  .langs a, .langs span { display: inline-block; padding-block: 10px; }
  .langs span { color: var(--c-on-dark); font-weight: 600; }
  .credits-btn { font: inherit; color: var(--c-on-dark); background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; }
  .credits { width: min(36rem, calc(100vw - 2rem)); max-height: min(70vh, 40rem); overflow: auto; padding: var(--space-5); border: 1px solid var(--c-rule); border-radius: 12px; background: var(--c-plate); color: var(--c-ink); font-size: var(--step--1); }
  .credits::backdrop { background: rgb(10 26 29 / 0.5); }
  .credits .head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); margin-bottom: var(--space-3); }
  .credits h2 { font-size: var(--step-1); }
  .credits .head button { font-size: 1.5rem; line-height: 1; background: none; border: 0; color: var(--c-ink-soft); cursor: pointer; padding: 0 var(--space-1); }
  .credits ul { list-style: none; margin: 0; padding: 0; }
  .credits li { padding-block: var(--space-2); border-top: 1px dotted var(--c-rule); }
  .credits a { color: var(--c-ink); }
  .lic { color: var(--c-ink-soft); }
  .nums { display: flex; flex-wrap: wrap; gap: 0.15rem 0.6rem; margin-top: var(--space-1); }
  .nums a { color: var(--c-ink-soft); }
</style>
