---
import type { Photo } from '@aq/schema'
import AiPhotoLabel from './AiPhotoLabel.astro'
import { albumJson, albumPhotos } from '../lib/album'
import { GALLERY_STRIP, seeAll } from '../lib/gallery'
import { smallSrc } from '../lib/img'
import { i18n } from '../lib/i18n'
/**
 * `photos`: the whole album (lib/photo-page.ts albumOf). A thumb opens its photo in the viewer over the page, which steps
 * through all of them (scripts/album.ts), and so does "Xem tất cả … ảnh", from the first: the album has no page of its
 * own (the owner, 17 Nov 2026: "opening a new page for it is unnecessary"). Without scripts a thumb opens its photo.
 * `shown`: of the first photos, those the page doesn't show already (lib/pictures.ts), null for the others: each thumb
 * keeps its place, so it still opens its own photo.
 * `column`: in the photo column of a fish's page, under its photo (pages/ca/[slug].astro): inside the page's margins,
 * and beside the facts (above 860 px) headed like their parts.
 * `more`: the album's next photos, after `shown` and placed like them (lib/pictures.ts morePhotos), for the column on
 * a tall computer screen, which they fill in whole rows; elsewhere they don't show.
 * On a phone the column is a single row under the photo, a thumbnail high: `shown`, which swipes sideways, and the
 * album's link beside it. It had gone after the care text, to keep the first care question within three screens;
 * one row keeps it there, and the owner asked twice (4 and 8 November) why the gallery was at the bottom.
 */
interface Props { photos: Photo[]; name: string; shown?: (Photo | null)[]; column?: boolean; more?: (Photo | null)[] }
const { t } = i18n(Astro.url)
const { photos, name, column, more = [] } = Astro.props
const shown = Astro.props.shown ?? photos.slice(0, GALLERY_STRIP)
// "Xem tất cả": a button opening the viewer on the first photo, with no arrow (it said "to another page"), and none when
// the strip shows every photo (the Design Lead, 18 Nov; lib/gallery.ts seeAll).
const { all, phone, fit } = seeAll(photos.length, shown, more, !!column)
// A strip outside the photo column is the same thumbnail row on a phone, its heading kept (the strip's reader, 20 Nov:
// in a grid of three a phone showed six of eight thumbnails and hid the rest).
const count = shown.filter(Boolean).length
const row = !column
const measure = (column || row) && (all || count > 1)
const see = t('Xem tất cả {n} ảnh', { n: photos.length })
const data = albumJson({ name, ai: t('Ảnh do AI tạo'), altered: t('Ảnh đã chỉnh sửa'), photos: albumPhotos(photos) })
---
<section class:list={count ? ['strip', column ? 'column' : 'wrap', row && 'row'] : []} hidden={!count} aria-labelledby={count ? 'gal-h' : undefined} data-album data-fit={fit ?? (measure ? shown.flatMap((p, i) => p ? [] : [i]).join(' ') : undefined)}>
  {count > 0 && <>
  <div class="head"><h2 id="gal-h">{t('Ảnh {name}', { name })}</h2>{(all || measure) && <button type="button" class:list={['see', phone && 'phone']} data-all data-fits={!all ? '' : undefined} aria-haspopup="dialog">{see}</button>}</div>
  <ul style={column ? `--rows: ${Math.ceil(count / 4)}` : undefined}>
    {[...shown, ...more].map((p, i) => p && (
      <li class={i >= shown.length ? 'more' : undefined}><a href={p.url} data-i={i}><img src={smallSrc(p)} alt={p.caption ?? name} width={p.width} height={p.height} loading="lazy" decoding="async" /><AiPhotoLabel photo={p} /></a></li>
    ))}
  </ul>
  {column && measure && <button type="button" class="all" data-all data-fits={!all ? '' : undefined} aria-haspopup="dialog">{see}</button>}
  </>}
  {/* A thumb or "Xem tất cả" tapped before the album's script has run (a slow phone): its photo's address, #aN, which
      that script opens once it runs, in place of the bare photo; a second tap takes the first one's entry, so one Back
      still closes it. What was tapped is marked with its address (data-tapped), for focus to go back to, until the
      address moves on (Back). Once the script runs (data-ready), its own handler takes the taps. */}
  <script is:inline>document.currentScript.parentElement.addEventListener('click',function(e){var a=e.target.closest('a[data-i],[data-all]');if(!a||this.hasAttribute('data-ready')||a.tagName=='A'&&(e.metaKey||e.ctrlKey||e.shiftKey||e.altKey))return;e.preventDefault();var h='#a'+(+(a.dataset.i||0)+1),o=this.querySelector('[data-tapped]');if(o)o.removeAttribute('data-tapped');a.setAttribute('data-tapped',h);if(/^#a\d+$/.test(location.hash))location.replace(h);else location.hash=h});addEventListener('hashchange',function(){var t=document.querySelector('[data-album] [data-tapped]');if(t&&t.getAttribute('data-tapped')!=location.hash)t.removeAttribute('data-tapped')})</script>
  <script type="application/json" set:html={data}></script>
  <script>
    import '../scripts/album'
  </script>
</section>
<style>
  .strip { padding-block: var(--space-5); }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--space-1) var(--space-4); border-bottom: 2px solid var(--c-ink); padding-bottom: var(--space-2); margin-bottom: var(--space-4); }
  h2 { font-size: var(--step-2); }
  /* "Xem tất cả": a button with a link's look (global.css), as it opens the viewer over the page. */
  :where(button[data-all]) { font: inherit; color: var(--c-moss); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 0.18em; }
  :where(button[data-all]):hover { color: var(--c-ink); }
  /* On one line beside the heading or under it; wrapped only where it can't fit on one (a phone 320 px wide). */
  .see { text-wrap: balance; font-size: 0.95rem; display: inline-block; padding-block: 10px; margin-block: -10px; text-align: start; }
  .see.phone, .strip [data-all][data-fits] { display: none; }
  @media (max-width: 640px) { .see.phone { display: inline-block; } }
  /* Each column its share (minmax(0, 1fr)), never its content's width: a photo that doesn't load shows its alt text in its
     place, and a long word in it widened the row past a phone's edge (13 November). */
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-2); }
  li a { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--c-plate); }
  img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  li a:hover img { transform: scale(1.04); }
  .column { padding-bottom: 0; }
  .more, .all { display: none; }
  @media (min-width: 861px) {
    .column h2 { font-size: var(--step-1); }
    .column .head { margin-bottom: var(--space-3); }
  }
  /* In the photo column on a tall screen, the list takes the height the column leaves it (pages/ca/[slug].astro) and
     fills it in whole rows of the same thumbnails, 4 across, as many as fit: a row is a quarter of the width less the
     gaps, at 4:3 (--row). Its height is the room it's given, never what it holds (height 0, then flex-grow: Safari sized
     the column, and the page's top, by every thumbnail with contain: size instead), and never less than the strip's own
     rows (--rows). A thumbnail past the last whole row goes to the foot of a row far below the list, which clips it:
     never cut, never seen, and never downloaded (loading="lazy" loads only what the clip lets through). */
  @media (min-width: 861px) and (min-height: 50rem) {
    .column { display: flex; flex-direction: column; container-type: inline-size; }
    .column ul {
      --row: calc((100cqi - 3 * var(--space-2)) * 3 / 16);
      flex-grow: 1; height: 0; overflow: clip;
      min-height: calc(var(--rows) * var(--row) + (var(--rows) - 1) * var(--space-2));
      grid-template-rows: repeat(auto-fill, var(--row)); grid-auto-rows: calc(4 * var(--row));
    }
    .column li { align-self: end; }
    .column .more { display: block; }
  }
  /* The fish page's row on a phone: thumbnails 4.5rem high, cut at the screen's edge so it shows they go on, and the
     gallery's link at the row's end, never taller than they are (contain: size), its longest words (Malay's "Lihat
     kesemua 145 foto →") in four lines at most. Its heading is for screen readers. */
  @media (max-width: 860px) {
    .column { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2); padding-top: var(--space-2); }
    .column .head { position: absolute; width: 1px; height: 1px; margin: 0; padding: 0; border: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .column .see { display: none; }
    .column ul, .row ul {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 6rem;
      overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x proximity; scrollbar-width: none;
    }
    .column ul::-webkit-scrollbar, .row ul::-webkit-scrollbar { display: none; }
    .column li, .row li { scroll-snap-align: start; }
    .column li a, .row li a { height: 4.5rem; }
    .column .all { display: flex; align-items: center; justify-content: center; width: 5.5rem; contain: size; padding: 0 var(--space-2); border: 1px solid var(--c-rule); font-size: 0.8rem; line-height: 1.2; text-align: center; text-wrap: balance; }
  }
</style>
