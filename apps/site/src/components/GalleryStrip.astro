---
import type { Photo } from '@aq/schema'
import AiPhotoLabel from './AiPhotoLabel.astro'
import { GALLERY_STRIP } from '../lib/gallery'
import { smallSrc } from '../lib/img'
import { i18n, served } from '../lib/i18n'
/**
 * `href`: the gallery page; without one (too few photos for a page, or none in this language) each thumb opens its photo.
 * `shown`: of the first photos, those the page doesn't show already (lib/pictures.ts), null for the others: each thumb
 * keeps its place, so it still opens its own photo on the gallery page.
 * `column`: in the photo column of a fish's page, under its photo (pages/ca/[slug].astro): inside the page's margins,
 * and beside the facts (above 860 px) headed like their parts.
 * `more`: the gallery's next photos, after `shown` and placed like them (lib/pictures.ts morePhotos), for the column on
 * a tall computer screen, which they fill in whole rows; elsewhere they don't show.
 * `readers`: the gallery page has readers' photos under its own (a species'), and the link says so.
 * On a phone the column is a single row under the photo, a thumbnail high: `shown`, which swipes sideways, and the
 * gallery page's link beside it. It had gone after the care text, to keep the first care question within three screens;
 * one row keeps it there, and the owner asked twice (4 and 8 November) why the gallery was at the bottom.
 */
interface Props { photos: Photo[]; href?: string; name: string; shown?: (Photo | null)[]; column?: boolean; more?: (Photo | null)[]; readers?: boolean }
const { t, lang } = i18n(Astro.url)
const href = Astro.props.href && served(lang, Astro.props.href) ? Astro.props.href : undefined
const { photos, name, column, more = [], readers } = Astro.props
const shown = Astro.props.shown ?? photos.slice(0, GALLERY_STRIP)
---
<section class:list={['strip', column ? 'column' : 'wrap']} aria-labelledby="gal-h">
  <div class="head"><h2 id="gal-h">{t('Ảnh {name}', { name })}</h2>{href && <a href={href}>{readers ? t('Xem tất cả {n} ảnh và ảnh bạn đọc →', { n: photos.length }) : t('Xem tất cả {n} ảnh →', { n: photos.length })}</a>}</div>
  <ul style={column ? `--rows: ${Math.ceil(shown.filter(Boolean).length / 4)}` : undefined}>
    {[...shown, ...more].map((p, i) => p && (
      <li class={i >= shown.length ? 'more' : undefined}><a href={href ? `${href}#a${i + 1}` : p.url}><img src={smallSrc(p)} alt={p.caption ?? name} width={p.width} height={p.height} loading="lazy" decoding="async" /><AiPhotoLabel photo={p} /></a></li>
    ))}
  </ul>
  {column && href && <a class="all" href={href}>{t('Xem tất cả {n} ảnh →', { n: photos.length })}</a>}
</section>
<style>
  .strip { padding-block: var(--space-5); }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--space-1) var(--space-4); border-bottom: 2px solid var(--c-ink); padding-bottom: var(--space-2); margin-bottom: var(--space-4); }
  h2 { font-size: var(--step-2); }
  /* On one line beside the heading or under it; wrapped only where it can't fit on one (a phone 320 px wide). */
  .head a { text-wrap: balance; font-size: 0.95rem; display: inline-block; padding-block: 10px; margin-block: -10px; }
  /* Each column its share (minmax(0, 1fr)), never its content's width: a photo that doesn't load shows its alt text in its
     place, and a long word in it widened the row past a phone's edge (13 November). */
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-2); }
  li a { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--c-plate); }
  img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  li a:hover img { transform: scale(1.04); }
  .column { padding-bottom: 0; }
  .more, .all { display: none; }
  @media (min-width: 861px) {
    .column h2 { font-size: var(--step-1); }
    .column .head { margin-bottom: var(--space-3); }
  }
  /* In the photo column on a tall screen, the list takes the height the column leaves it (pages/ca/[slug].astro) and
     fills it in whole rows of the same thumbnails, 4 across, as many as fit: a row is a quarter of the width less the
     gaps, at 4:3 (--row). Its height is the room it's given, never what it holds (height 0, then flex-grow: Safari sized
     the column, and the page's top, by every thumbnail with contain: size instead), and never less than the strip's own
     rows (--rows). A thumbnail past the last whole row goes to the foot of a row far below the list, which clips it:
     never cut, never seen, and never downloaded (loading="lazy" loads only what the clip lets through). */
  @media (min-width: 861px) and (min-height: 50rem) {
    .column { display: flex; flex-direction: column; container-type: inline-size; }
    .column ul {
      --row: calc((100cqi - 3 * var(--space-2)) * 3 / 16);
      flex-grow: 1; height: 0; overflow: clip;
      min-height: calc(var(--rows) * var(--row) + (var(--rows) - 1) * var(--space-2));
      grid-template-rows: repeat(auto-fill, var(--row)); grid-auto-rows: calc(4 * var(--row));
    }
    .column li { align-self: end; }
    .column .more { display: block; }
  }
  @media (max-width: 640px) { .wrap ul { grid-template-columns: repeat(3, minmax(0, 1fr)); } .wrap li:nth-child(n + 7) { display: none; } }
  /* The fish page's row on a phone: thumbnails 4.5rem high, cut at the screen's edge so it shows they go on, and the
     gallery's link at the row's end, never taller than they are (contain: size), its longest words (Malay's "Lihat
     kesemua 145 foto →") in four lines at most. Its heading is for screen readers. */
  @media (max-width: 860px) {
    .column { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2); padding-top: var(--space-2); }
    .column .head { position: absolute; width: 1px; height: 1px; margin: 0; padding: 0; border: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .column .head a { display: none; }
    .column ul {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 6rem;
      overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x proximity; scrollbar-width: none;
    }
    .column ul::-webkit-scrollbar { display: none; }
    .column li { scroll-snap-align: start; }
    .column li a { height: 4.5rem; }
    .column .all { display: flex; align-items: center; justify-content: center; width: 5.5rem; contain: size; padding: 0 var(--space-2); border: 1px solid var(--c-rule); font-size: 0.8rem; line-height: 1.2; text-align: center; text-wrap: balance; }
  }
</style>
