---
import type { Photo } from '@aq/schema'
import { GALLERY_STRIP } from '../lib/gallery'
import { smallSrc } from '../lib/img'
import { i18n, served } from '../lib/i18n'
/**
 * `href`: the gallery page; without one (too few photos for a page, or none in this language) each thumb opens its photo.
 * `shown`: of the first photos, those the page doesn't show already (lib/pictures.ts), null for the others: each thumb
 * keeps its place, so it still opens its own photo on the gallery page.
 */
interface Props { photos: Photo[]; href?: string; name: string; shown?: (Photo | null)[] }
const { t, lang } = i18n(Astro.url)
const href = Astro.props.href && served(lang, Astro.props.href) ? Astro.props.href : undefined
const { photos, name } = Astro.props
const shown = Astro.props.shown ?? photos.slice(0, GALLERY_STRIP)
---
<section class="wrap strip" aria-labelledby="gal-h">
  <div class="head"><h2 id="gal-h">{t('Ảnh {name}', { name })}</h2>{href && <a href={href}>{t('Xem tất cả {n} ảnh →', { n: photos.length })}</a>}</div>
  <ul>
    {shown.map((p, i) => p && (
      <li><a href={href ? `${href}#a${i + 1}` : p.url}><img src={smallSrc(p)} alt={p.caption ?? name} width={p.width} height={p.height} loading="lazy" decoding="async" /></a></li>
    ))}
  </ul>
</section>
<style>
  .strip { padding-block: var(--space-5); }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); border-bottom: 2px solid var(--c-ink); padding-bottom: var(--space-2); margin-bottom: var(--space-4); }
  h2 { font-size: var(--step-2); }
  .head a { white-space: nowrap; font-size: 0.95rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-2); }
  li a { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--c-plate); }
  img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  li a:hover img { transform: scale(1.04); }
  @media (max-width: 640px) { ul { grid-template-columns: repeat(3, 1fr); } li:nth-child(n + 7) { display: none; } }
</style>
