---
// The card a glossary term in the text shows on hover or tap (scripts/glossary-tip.ts). Once per page: Astro bundles it once.
---
<script>
  import { initGlossaryTips } from '../scripts/glossary-tip'
  initGlossaryTips()
</script>
<style is:global>
  .gl-tip { position: absolute; z-index: 60; width: max-content; max-width: min(22rem, calc(100vw - 16px)); box-sizing: border-box; padding: var(--space-2) var(--space-3); background: var(--c-paper); color: var(--c-ink); border: 1px solid var(--c-rule); border-radius: 8px; box-shadow: 0 6px 24px rgb(0 0 0 / 0.14); font-size: var(--step--1); line-height: 1.5; pointer-events: none; }
  .gl-tip.tapped { pointer-events: auto; }
  .gl-tip strong { display: block; margin-bottom: 2px; }
  .gl-tip p { margin: 0; color: var(--c-ink-soft); }
  .gl-tip a { display: inline-block; margin-top: var(--space-2); min-height: 44px; line-height: 44px; font-weight: 600; color: var(--c-ink); }
</style>
