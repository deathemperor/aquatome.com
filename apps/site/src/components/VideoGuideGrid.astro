---
import type { GuideEntity, Localized } from '@aq/schema'
import GuideCard from './GuideCard.astro'
interface Props { guides: Localized<GuideEntity>[]; heading: string; max?: number }
const { guides, heading, max = 6 } = Astro.props
---
{guides.length > 0 && (
  <section class="wrap vg" aria-label={heading} data-pagefind-ignore>
    <h2>{heading}</h2>
    <div class="grid">{guides.slice(0, max).map(g => <GuideCard g={g} />)}</div>
  </section>
)}
<style>
  .vg { padding-block: var(--space-5) var(--space-6); }
  h2 { font-size: var(--step-2); border-bottom: 2px solid var(--c-ink); padding-bottom: var(--space-2); margin-bottom: var(--space-5); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: var(--space-6) var(--space-5); }
</style>
