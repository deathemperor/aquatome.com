---
import type { GuideEntity, Localized, Photo } from '@aq/schema'
import { getContent } from '../lib/content'
import { smallSrc } from '../lib/img'
import { guideImage } from '../lib/mentions'
import { guideWords } from '../lib/list-data'
import { clock } from '../lib/video'
import { i18n } from '../lib/i18n'
/**
 * `row`: on a phone, a compact row (a small picture beside the text) rather than a full-width card.
 * `template`: with a picture slot and stand-in words (a video's length too), for a list's script to fill in
 * (scripts/guide-card.ts). `photo`: the picture its page chose (a page never shows one twice, lib/pictures.ts); null: none.
 */
interface Props { g: Localized<GuideEntity>; row?: boolean; template?: boolean; photo?: Photo | null }
const { g, row = false, template = false, photo } = Astro.props
const { t, lang } = i18n(Astro.url)
const c = await getContent(lang)
const ph = photo !== undefined ? photo : guideImage(c, g)
const { label, src } = guideWords(t, c, g)
---
<a class:list={["gc", { row }]} href={`/vi/huong-dan/${g.t.slug}/`} data-kind={g.kind}>
  <div class:list={['img', { video: g.video }]}>{template ? <img src="" width="0" height="0" alt="" loading="lazy" /> : ph && <img src={smallSrc(ph)} width={ph.width} height={ph.height} alt="" loading="lazy" />}{g.video && <span class="dur">▶ {clock(g.video.durationSec)}</span>}</div>
  <p class="kind">{label}</p>
  <h3>{g.t.name}</h3>
  <p class="src">{src}</p>
</a>
<style>
  .gc { display: block; text-decoration: none; color: inherit; }
  .img { position: relative; }
  /* A guide with no picture keeps the picture's slot at every width, so the titles of a row of cards stay in line. */
  .img:not(:has(img)) { aspect-ratio: 16 / 10; background: var(--c-plate); border-radius: var(--radius-media); }
  .img.video:not(:has(img)) { aspect-ratio: 16 / 9; }
  .img.video img { aspect-ratio: 16 / 9; }
  .dur { position: absolute; right: var(--space-2); bottom: var(--space-2); background: rgb(0 0 0 / 0.78); color: #fff; font-size: 0.75rem; font-weight: 600; padding: 2px 6px; font-variant-numeric: tabular-nums; }
  .img img { aspect-ratio: 16 / 10; object-fit: cover; width: 100%; border-radius: var(--radius-media); }
  .kind { font-size: 0.8rem; color: var(--c-moss); margin: var(--space-3) 0 0; }
  h3 { font-size: var(--step-1); }
  .gc:hover h3 { color: var(--c-moss); }
  .src { font-size: 0.8rem; color: var(--c-ink-faint); margin: var(--space-1) 0 0; }
  /* The picture keeps its slot (plate colour) when a guide has none, so the rows stay aligned. */
  @media (max-width: 520px) {
    .row { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); grid-template-rows: auto auto 1fr; column-gap: var(--space-3); align-items: start; }
    .row .img { grid-row: 1 / -1; aspect-ratio: 16 / 10; background: var(--c-plate); }
    .row .kind { margin: 0; }
    .row h3 { font-size: 1.05rem; line-height: 1.3; }
  }
</style>
