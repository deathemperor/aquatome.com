---
import type { GuideEntity, Localized } from '@aq/schema'
import { GUIDE_KIND_LABELS } from '../lib/format'
import { getContent } from '../lib/content'
import { smallSrc } from '../lib/img'
import { guideImage } from '../lib/mentions'
import { clock } from '../lib/video'
import { i18n } from '../lib/i18n'
interface Props { g: Localized<GuideEntity> }
const { g } = Astro.props
const { t, lang } = i18n(Astro.url)
const c = await getContent(lang)
const ph = guideImage(c, g)
---
<a class="gc" href={`/vi/huong-dan/${g.t.slug}/`}>
  <div class:list={['img', { video: g.video }]}>{ph && <img src={smallSrc(ph)} width={ph.width} height={ph.height} alt="" loading="lazy" />}{g.video && g.t.cover && <span class="cover" lang={lang}>{g.t.cover}</span>}{g.video && <span class="dur">▶ {clock(g.video.durationSec)}</span>}</div>
  <p class="kind">{t(GUIDE_KIND_LABELS[g.kind])}</p>
  <h3>{g.t.name}</h3>
  <p class="src">{g.video ? t('Theo video của {name}', { name: g.video.channel }) : t('Dịch từ {name}', { name: c.sources[g.source]?.name ?? g.source })}</p>
</a>
<style>
  .gc { display: block; text-decoration: none; color: inherit; }
  .img { position: relative; }
  .img.video img { aspect-ratio: 16 / 9; }
  /* Our Vietnamese label over the creator's thumbnail (the image itself is untouched). */
  .cover { position: absolute; left: 0; top: var(--space-3); max-width: 82%; background: var(--c-paper); color: var(--c-ink); font: 600 1.05rem/1.2 var(--f-display); padding: 6px 10px 6px var(--space-3); border-left: 3px solid var(--c-cardinal); box-shadow: 0 2px 8px rgb(0 0 0 / 0.25); }
  .dur { position: absolute; right: var(--space-2); bottom: var(--space-2); background: rgb(0 0 0 / 0.78); color: #fff; font-size: 0.75rem; font-weight: 600; padding: 2px 6px; font-variant-numeric: tabular-nums; }
  .img img { aspect-ratio: 16 / 10; object-fit: cover; width: 100%; border-radius: var(--radius-media); }
  .kind { font-size: 0.8rem; color: var(--c-moss); margin: var(--space-3) 0 0; }
  h3 { font-size: var(--step-1); }
  .gc:hover h3 { color: var(--c-moss); }
  .src { font-size: 0.8rem; color: var(--c-ink-faint); margin: var(--space-1) 0 0; }
</style>
