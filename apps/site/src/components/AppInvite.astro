---
import type { AppPlacement } from '../lib/app'
import { APP_STATE, inviteCheck, openInApp } from '../lib/app'
import { i18n } from '../lib/i18n'
import AppStoreBadge from './AppStoreBadge.astro'

/**
 * A quiet line offering the app, hidden until the check after it (lib/app.ts inviteCheck) finds an iPhone or iPad: the
 * owner's only, with "Mở trong ứng dụng" for the app they have, while the switch is 'owner'. Rules, not a card: it also
 * sits inside the light tool's card. Its style and script are written here, not bundled, so that a build with the
 * switch off has neither. Not in the site's search, nor its badge as a result's picture: it's for one kind of device,
 * not the page's content.
 */
interface Props { ct: AppPlacement; text: string }
const { ct, text } = Astro.props
const { t } = i18n(Astro.url)
---
{APP_STATE !== 'off' && (
  <>
    <style is:inline>
      .app-invite { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-4); max-width: var(--measure); margin-block: var(--space-4); padding-block: var(--space-3); border-block: 1px solid var(--c-rule); }
      .app-invite[hidden] { display: none; }
      .app-invite p { flex: 1 1 14rem; margin: 0; }
      .app-invite .acts { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
      .app-invite .app-store-badge { display: block; flex: none; border-radius: 7px; }
      .app-invite .open-app { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.15rem; border: 1px solid var(--c-rule); border-radius: 8px; color: var(--c-ink); font: 500 1rem var(--f-body); text-decoration: none; transition: border-color 0.15s; }
      .app-invite .open-app:hover { border-color: var(--c-ink); }
    </style>
    <div class="app-invite" hidden data-pagefind-ignore="all">
      <p>{text}</p>
      <div class="acts">
        <AppStoreBadge ct={ct} />
        {APP_STATE === 'owner' && <a class="open-app" href={openInApp(Astro.url.pathname)}>{t('Mở trong ứng dụng')}</a>}
      </div>
    </div>
    <script is:inline set:html={inviteCheck()} />
  </>
)}
