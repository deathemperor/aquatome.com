---
import type { ProductSlot } from '@aq/schema'
import { categoryLabel, goLink } from '../lib/format'
import { i18n } from '../lib/i18n'
interface Props { slots: ProductSlot[]; heading?: string; entity?: string }
const { t } = i18n(Astro.url)
const { slots, heading = t('Thiết bị phù hợp'), entity } = Astro.props
---
{slots.length > 0 && (
  <section class="products" aria-labelledby="products-h">
    <h2 id="products-h">{heading}</h2>
    <ul>
      {slots.flatMap(s => s.keywords.map(k => (
        <li>
          <span class="cat">{t(categoryLabel(s.category))}</span>
          <span class="kw">{k}</span>
          <span class="shops">
            <a href={goLink('shopee', k, s.category, entity)} rel="sponsored nofollow noopener" target="_blank">Shopee</a>
            <a href={goLink('lazada', k, s.category, entity)} rel="sponsored nofollow noopener" target="_blank">Lazada</a>
            <a href={goLink('tiki', k, s.category, entity)} rel="sponsored nofollow noopener" target="_blank">Tiki</a>
          </span>
        </li>
      )))}
    </ul>
    <p class="note">{t('Liên kết tiếp thị — trang có thể nhận hoa hồng khi bạn mua qua liên kết.')}</p>
  </section>
)}
<style>
  h2 { font-size: var(--step-2); padding-bottom: var(--space-2); border-bottom: 2px solid var(--c-ink); margin-bottom: var(--space-2); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 6.5rem 1fr auto; gap: var(--space-3); align-items: baseline; padding-block: var(--space-3); border-bottom: 1px dotted var(--c-rule); }
  .cat { font-size: var(--step--1); color: var(--c-ink-faint); }
  .kw { font-weight: 500; }
  .shops { display: flex; gap: var(--space-3); font-size: 0.9rem; }
  .note { font-size: 0.75rem; color: var(--c-ink-faint); margin-top: var(--space-2); }
  @media (max-width: 480px) { li { grid-template-columns: 1fr; gap: var(--space-1); } }
</style>
