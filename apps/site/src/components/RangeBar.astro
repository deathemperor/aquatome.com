---
/**
 * A species' tolerated range on a fixed scale, coloured like a water-test card (pH: yellow → green → blue; temperature:
 * cool → warm). The track is faint; the range itself shows the scale's colours at full strength. Colour encodes value only.
 */
interface Props { kind: 'ph' | 'temp'; min: number; max: number }
const { kind, min, max } = Astro.props
const [lo, hi] = kind === 'ph' ? [4, 9] : [10, 35]
const pct = (x: number) => Math.min(100, Math.max(0, ((x - lo) / (hi - lo)) * 100))
const left = pct(min)
const width = Math.max(pct(max) - left, 2)
// Show the track's gradient inside the range: scale it to the track's width and shift it to the range's start.
const size = (100 / width) * 100
const pos = width >= 100 ? 0 : (left / (100 - width)) * 100
---
<span class:list={['rb', kind]} aria-hidden="true"><i style={`left:${left}%;width:${width}%;background-size:${size}% 100%;background-position:${pos}% 0`} /></span>
<style>
  .rb { position: relative; display: block; height: 6px; background: var(--grad); }
  .rb::before { content: ''; position: absolute; inset: 0; background: var(--c-paper); opacity: 0.72; }
  .rb i { position: absolute; top: -1px; bottom: -1px; background-image: var(--grad); background-repeat: no-repeat; box-shadow: 0 0 0 1px var(--c-ink); }
  .ph { --grad: linear-gradient(90deg, #d39a2c 0%, #c9b23a 35%, #7da043 55%, #3f8a7a 72%, #46609c 100%); }
  .temp { --grad: linear-gradient(90deg, #4f7fa8 0%, #5f9a8a 35%, #8aa54a 55%, #d39a2c 75%, #b5532d 100%); }
</style>
