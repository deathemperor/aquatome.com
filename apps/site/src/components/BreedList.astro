---
import type { Breed } from '../lib/breeds'
import SpeciesCard from './SpeciesCard.astro'
/**
 * Breeds as the species list's cards, in its grid. Its pictures must be in the page's credits (each breed's first photo).
 * `bare`: inside a container that already has margins. `eager`: cards that load at once (the list leads the page).
 */
interface Props { breeds: Breed[]; heading: string; bare?: boolean; eager?: number }
const { breeds, heading, bare, eager = 0 } = Astro.props
---
{breeds.length > 0 && (
  <section class:list={["breeds", { wrap: !bare }]} aria-labelledby="breeds-h">
    <h2 id="breeds-h">{heading}</h2>
    <ul>
      {breeds.map((x, i) => <li><SpeciesCard breed={x} eager={i < eager} /></li>)}
    </ul>
  </section>
)}
<style>
  .breeds { padding-block: var(--space-5); }
  h2 { font-size: var(--step-2); margin: 0 0 var(--space-3); }
  /* SpeciesGrid's grid, so the two lists' cards are one size. */
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: var(--space-6) var(--space-5); }
  @media (max-width: 520px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) var(--space-3); } }
</style>
