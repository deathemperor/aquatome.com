---
import { i18n } from '../lib/i18n'
/**
 * A sticky row of links to a long page's main parts, in page order; the part being read is marked as the reader scrolls.
 * At most `max` (five fit a phone's row, or nearly): past that, the parts in `drop` are left out first, in its order.
 */
interface Props { items: { href: string; label: string }[]; max?: number; drop?: string[] }
const { max = 5, drop = [] } = Astro.props
const out = new Set<string>()
for (const href of drop) if (Astro.props.items.length - out.size > max && Astro.props.items.some(i => i.href === href)) out.add(href)
const items = Astro.props.items.filter(i => !out.has(i.href)).slice(0, max)
const { t } = i18n(Astro.url)
---
{items.length >= 2 && (
  <nav class="jump" aria-label={t('Các mục trong trang')} data-jump data-pagefind-ignore>
    <ul class="wrap">{items.map(i => <li><a href={i.href}>{i.label}</a></li>)}</ul>
  </nav>
)}
<script>
  const nav = document.querySelector<HTMLElement>('[data-jump]')
  if (nav) {
    const row = nav.querySelector('ul')!
    const links = [...row.querySelectorAll('a')]
    // Each part as the block it heads: a heading's own section (the photos' strip, the shop), else the target itself.
    const parts = links.map(a => { const el = document.getElementById(a.hash.slice(1)); return el && (el.closest('section') ?? el) })
    const calm = matchMedia('(prefers-reduced-motion: reduce)')
    let current = -2
    const update = () => {
      // The part being read: the one that spans the line just under the row once the row has reached the top (above it,
      // the reader hasn't come to its parts); none between two parts.
      const box = nav.getBoundingClientRect(), line = box.bottom + 24
      const i = box.top > parseFloat(getComputedStyle(nav).top) + 1 ? -1 : parts.findIndex(el => { if (!el) return false; const r = el.getBoundingClientRect(); return r.height > 0 && r.top <= line && r.bottom > line })
      if (i === current) return
      current = i
      links.forEach((a, k) => (k === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')))
      // Keep the marked chip in view in the row: the row scrolls sideways only, never the page.
      const a = links[i]
      if (a) row.scrollTo({ left: a.offsetLeft - (row.clientWidth - a.offsetWidth) / 2, behavior: calm.matches ? 'auto' : 'smooth' })
    }
    // A row wider than the screen fades out at the side that has more, so it reads as one to scroll.
    const edges = () => {
      const start = row.scrollLeft > 1, end = row.scrollLeft + row.clientWidth < row.scrollWidth - 1
      row.dataset.more = start && end ? 'both' : start ? 'start' : end ? 'end' : ''
    }
    let frame = 0
    addEventListener('scroll', () => { frame ||= requestAnimationFrame(() => { frame = 0; update() }) }, { passive: true })
    row.addEventListener('scroll', edges, { passive: true })
    addEventListener('resize', edges)
    update()
    edges()
  }
</script>
<style>
  /* --sticky-top: the height of a header that stays on screen, if the page has one (none today). */
  :global(html) { scroll-padding-top: calc(var(--sticky-top, 0px) + 4.5rem); scroll-behavior: smooth; }
  .jump { position: sticky; top: var(--sticky-top, 0px); z-index: 2; background: var(--c-paper); border-block: 1px solid var(--c-rule); }
  ul { position: relative; list-style: none; margin-block: 0; display: flex; gap: var(--space-2); padding-block: var(--space-2); overflow-x: auto; scrollbar-width: none; }
  ul::-webkit-scrollbar { display: none; }
  ul[data-more='end'] { mask-image: linear-gradient(to right, #000 calc(100% - 3.5rem), transparent); }
  ul[data-more='start'] { mask-image: linear-gradient(to left, #000 calc(100% - 3.5rem), transparent); }
  ul[data-more='both'] { mask-image: linear-gradient(to right, transparent, #000 3.5rem, #000 calc(100% - 3.5rem), transparent); }
  li { flex: none; }
  a { display: flex; align-items: center; min-height: 2.75rem; padding: 0 1rem; border: 1px solid var(--c-rule); border-radius: 999px; background: var(--c-plate); color: var(--c-ink-soft); font: 500 0.9rem/1 var(--f-body); text-decoration: none; white-space: nowrap; transition: background-color 0.2s ease-out, color 0.2s ease-out, border-color 0.2s ease-out; }
  a:hover { color: var(--c-ink); border-color: var(--c-ink-soft); }
  a[aria-current] { background: var(--c-ink); border-color: var(--c-ink); color: var(--c-paper); }
  /* A phone's row: tighter chips, so five short ones nearly fit at 390 px. */
  @media (max-width: 480px) { ul { gap: 6px; } a { padding: 0 0.8rem; } }
</style>
