---
/**
 * The site's languages, for every reader: this page in each language that has it, else that language's nearest page
 * (lib/i18n switchTo). The choice is remembered (cookie aq_lang) so aquatome.com/ opens in it next time (worker/index.ts).
 */
import { i18n, LANG_NAME, LANGS, switchTo, toVi } from '../lib/i18n'
const { lang, t } = i18n(Astro.url)
const here = new Map((Astro.locals.langs ?? []).map(([l, href]) => [l, new URL(href).pathname]))
const viPath = toVi(Astro.url.pathname)
const hasParams = Object.keys(Astro.params).length > 0
---
<details class="lang" data-lang-menu>
  <summary aria-label={t('Ngôn ngữ')}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
    <span>{lang.toUpperCase()}</span>
  </summary>
  <ul>
    {LANGS.map(l => <li><a href={switchTo(l, viPath, here.get(l), hasParams)} hreflang={l} lang={l} data-lang={l} aria-current={l === lang ? 'true' : undefined}>{LANG_NAME[l]}</a></li>)}
  </ul>
</details>
<script>
  document.addEventListener('click', e => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('[data-lang-menu] a[data-lang]')
    if (a) document.cookie = `aq_lang=${a.dataset.lang}; path=/; max-age=31536000; samesite=lax; secure`
    // A click anywhere else closes an open menu.
    document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu][open]').forEach(d => { if (!d.contains(e.target as Node)) d.open = false })
  })
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return
    document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu][open]').forEach(d => { d.open = false; d.querySelector('summary')?.focus() })
  })
</script>
<style>
  .lang { position: relative; }
  summary { display: flex; align-items: center; gap: 0.35rem; list-style: none; cursor: pointer; border: 1px solid rgb(255 255 255 / 0.3); color: var(--c-on-dark); border-radius: 999px; font: 500 0.8rem var(--f-body); padding: 0.25rem 0.7rem; }
  summary::-webkit-details-marker { display: none; }
  summary:hover, .lang[open] summary { border-color: var(--c-neon); }
  summary:focus-visible, a:focus-visible { outline: 3px solid var(--c-focus); outline-offset: 2px; }
  ul { position: absolute; right: 0; top: calc(100% + 6px); z-index: 10; margin: 0; padding: var(--space-1) 0; list-style: none; min-width: 11rem; background: var(--c-blackwater); border: 1px solid rgb(255 255 255 / 0.15); border-radius: var(--radius-plate); box-shadow: 0 8px 24px rgb(0 0 0 / 0.35); }
  a { display: block; padding: 0.6rem var(--space-3); color: var(--c-on-dark); text-decoration: none; font-size: 0.9rem; white-space: nowrap; }
  a:hover { color: #fff; background: rgb(255 255 255 / 0.06); }
  a[aria-current] { color: #fff; font-weight: 600; box-shadow: inset 3px 0 var(--c-neon); }
</style>
