---
/**
 * The site's languages, for every reader: this page in each language that has it, else that language's nearest page
 * (lib/i18n switchTo). The choice is remembered (cookie aq_lang) so aquatome.com/ opens in it next time (worker/index.ts).
 */
import { i18n, LANG_NAME, LANGS, switchTo, toVi } from '../lib/i18n'
/** list: the languages as a row of links, no dropdown (the menu sheet, which has its own "Ngôn ngữ" label). */
interface Props { list?: boolean }
const { list = false } = Astro.props
const { lang, t } = i18n(Astro.url)
const here = new Map((Astro.locals.langs ?? []).map(([l, href]) => [l, new URL(href).pathname]))
const viPath = toVi(Astro.url.pathname)
const hasParams = Object.keys(Astro.params).length > 0
const links = LANGS.map(l => ({ l, href: switchTo(l, viPath, here.get(l), hasParams) }))
---
{list ? (
  <div class="list" data-lang-menu>
    {links.map(({ l, href }) => <a href={href} hreflang={l} lang={l} data-lang={l} aria-current={l === lang ? 'true' : undefined}>{LANG_NAME[l]}</a>)}
  </div>
) : (
  <details class="lang" data-lang-menu>
    <summary aria-label={t('Ngôn ngữ')}>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      <span>{lang.toUpperCase()}</span>
    </summary>
    <div class="menu">
      {links.map(({ l, href }) => <a href={href} hreflang={l} lang={l} data-lang={l} aria-current={l === lang ? 'true' : undefined}>{LANG_NAME[l]}</a>)}
    </div>
  </details>
)}
<script>
  document.addEventListener('click', e => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('[data-lang-menu] a[data-lang]')
    if (a) document.cookie = `aq_lang=${a.dataset.lang}; path=/; max-age=31536000; samesite=lax; secure`
    // A click anywhere else closes an open menu.
    document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu][open]').forEach(d => { if (!d.contains(e.target as Node)) d.open = false })
  })
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return
    document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu][open]').forEach(d => { d.open = false; d.querySelector('summary')?.focus() })
  })
</script>
<style>
  /* Plain links in a div, not ul > a: the header's link styles (handbook.css .nav ul a) would apply. */
  .lang { position: relative; }
  /* A 44px target around the smaller pill drawn by ::before. */
  summary { position: relative; display: flex; align-items: center; gap: 0.35rem; min-height: 44px; list-style: none; cursor: pointer; color: var(--c-ink-soft); font: 500 0.8rem var(--f-body); padding: 0 0.7rem; }
  summary::before { content: ''; position: absolute; inset: 8px 0; border: 1px solid var(--c-rule); border-radius: 999px; }
  summary::-webkit-details-marker { display: none; }
  summary:hover, .lang[open] summary { color: var(--c-ink); }
  summary:hover::before, .lang[open] summary::before { border-color: var(--c-ink-soft); }
  summary:focus-visible, a:focus-visible { outline: 3px solid var(--c-focus); outline-offset: 2px; }
  .menu { position: absolute; right: 0; top: calc(100% + 6px); z-index: 10; display: grid; min-width: 11rem; padding: var(--space-1) 0; background: var(--c-paper); border: 1px solid var(--c-rule); border-radius: var(--radius-plate); box-shadow: 0 8px 24px rgb(0 0 0 / 0.12); }
  a { display: flex; align-items: center; min-height: 44px; padding: 0 var(--space-3); color: var(--c-ink-soft); text-decoration: none; font-size: 0.9rem; white-space: nowrap; }
  a:hover { color: var(--c-ink); background: var(--c-plate); }
  a[aria-current] { color: var(--c-ink); font-weight: 600; box-shadow: inset 3px 0 var(--c-moss); }
  .list { display: flex; flex-wrap: wrap; gap: 0 var(--space-4); }
  .list a { display: inline-flex; padding: 0; }
  .list a:hover { background: none; }
  .list a[aria-current] { box-shadow: none; text-decoration: underline 1px; text-underline-offset: 0.3em; }
</style>
