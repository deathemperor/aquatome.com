---
import { careNeeds, type DataCardField, type NeedInput, type Range } from '@aq/schema'
import Difficulty from './Difficulty.astro'
import RangeBar from './RangeBar.astro'
import { cardRows } from '../lib/card-rows'
import { CONFLICT_ANCHOR, FIELD_ANCHORS, FIELD_TIPS, guideLink, LEVEL_WORDS, NEED_LABELS, NEEDS_ANCHOR, TEMPERAMENT_WORDS, WHY_WORDS } from '../lib/card-guide'
import { FIELD_LABELS, fmt, isRange } from '../lib/format'
import { i18n, isVietnamese } from '../lib/i18n'
import { asNum, asRange } from '../lib/species-index'
/**
 * Species cite source ids (sources.json); breeds cite their own sources by position. `traits`: the species' behaviour
 * (content/traits), for the temperament and social needs of "Vì sao độ khó này"; a breed has none.
 */
interface Props { card: Partial<Record<DataCardField, { source: string; value: Range | number }[]>>; sources: Partial<Record<string, { name: string }>>; traits?: Pick<NeedInput, 'temperament' | 'finNipper' | 'schoolMin'> }
const { card, sources, traits } = Astro.props
const { t, lang } = i18n(Astro.url)
const { num, range } = fmt(lang)
// Sources that disagree: the range they all accept; each source's own figure in "Nguồn và độ tin cậy". The dot only where
// they disagree by enough to matter (cardRows `marked`).
const rows = cardRows(card)
const marked = rows.some(r => r.marked)
const nameOf = (id: string) => sources[id]?.name ?? id
const unitAttrs = (field: string, v: number | { min: number; max: number }) => {
  const [a, b] = isRange(v) ? [v.min, v.max] : [v, v]
  if (field === 'tempC') return { 'data-c': `${a},${b}` }
  if (field === 'sizeCm' || field === 'tankCm') return { 'data-cm': `${a},${b}` }
  return {}
}
const unit = (field: string) => (field === 'tempC' ? '°C' : field === 'sizeCm' || field === 'tankCm' ? ' cm' : field === 'lifeYears' ? ` ${t('năm')}` : '')
// What makes this fish easy or hard, need by need, from the card's own values and its traits (careNeeds), as the app
// index would give them (lib/species-index.ts).
const value = (f: DataCardField) => rows.find(r => r.field === f)?.value
const needs = careNeeds({ tempC: asRange(value('tempC')), ph: asRange(value('ph')), gh: asRange(value('gh')), sizeCm: asNum(value('sizeCm')), tankCm: asNum(value('tankCm')), ...traits })
/** "bể từ {cm}" → the words around the figure, which the page puts in a span the units toggle converts. */
const around = (s: string) => s.split(/\{\w+\}/) as [string, string]
---
{rows.length > 0 && (
  <div class="datacard">
    <dl class="card">
      {rows.map(r => (
        <div data-field={r.field} data-conflict={r.conflict ? 'true' : undefined}>
          <dt><a class="gl" href={guideLink(FIELD_ANCHORS[r.field])} data-term={t(FIELD_LABELS[r.field])} data-tip={t(FIELD_TIPS[r.field])}>{t(FIELD_LABELS[r.field])}</a>{r.marked && <span class="mark" title={t('Các nguồn ghi khác nhau')}><span class="visually-hidden">{t('Các nguồn ghi khác nhau')}</span></span>}</dt>
          <dd>
            {r.field === 'difficulty' && typeof r.value === 'number'
              ? needs.length > 0
                ? (
                  <details class="why">
                    <summary><Difficulty value={r.value} /> <span class="n">{r.value}/8</span> <span class="q">{t('Vì sao?')}</span><svg class="chev" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
                    <div class="needs" data-pagefind-ignore>
                      <p class="lead">{t('Điều làm loài này dễ hay khó nuôi, đọc từ bảng:')}</p>
                      <ul>
                        {needs.map(n => (
                          <li data-need={n.key} data-level={n.level}>
                            <span class="nm">{t(NEED_LABELS[n.key])}</span>
                            <span class:list={['lv', n.level]}>{t(LEVEL_WORDS[n.level])}</span>
                            <span class="fx">
                              {n.key === 'space' && <>
                                {n.tankCm !== undefined && <>{around(t('bể từ {cm}'))[0]}<span data-cm={`${n.tankCm},${n.tankCm}`}>{num(n.tankCm)} cm</span>{around(t('bể từ {cm}'))[1]}</>}
                                {n.tankCm !== undefined && n.sizeCm !== undefined && ', '}
                                {n.sizeCm !== undefined && <>{around(t('cá dài {cm}'))[0]}<span data-cm={`${n.sizeCm},${n.sizeCm}`}>{num(n.sizeCm)} cm</span>{around(t('cá dài {cm}'))[1]}</>}
                              </>}
                              {n.key === 'water' && <>
                                {n.why.map(w => t(WHY_WORDS[w])).join(', ')}{n.why.length > 0 && ' · '}
                                {n.ph && <span>pH {range(n.ph)}</span>}{n.ph && n.gh && ', '}{n.gh && <span>{range(n.gh)} dGH</span>}
                              </>}
                              {n.key === 'temperature' && <>
                                {n.why.map(w => t(WHY_WORDS[w])).join(', ')}{n.why.length > 0 && ' · '}
                                <span data-c={`${n.tempC.min},${n.tempC.max}`}>{range(n.tempC)}°C</span>
                              </>}
                              {n.key === 'temperament' && [n.temperament && t(TEMPERAMENT_WORDS[n.temperament]).toLocaleLowerCase(lang), n.finNipper && t('hay cắn vây')].filter(Boolean).join(', ')}
                              {n.key === 'social' && t('đàn từ {n} con', { n: n.schoolMin })}
                            </span>
                          </li>
                        ))}
                      </ul>
                      <p class="note">{t('Độ khó {n}/8 là mức nguồn chấm. Nguồn có thể tính cả điều bảng không ghi, như thức ăn.', { n: r.value })} <a href={guideLink(NEEDS_ANCHOR)}>{t('Cách tính các mức')}</a></p>
                    </div>
                  </details>
                )
                : <><Difficulty value={r.value} /> <span class="n">{r.value}/8</span></>
              : <span class="v" {...unitAttrs(r.field, r.value)}>{range(r.value)}{unit(r.field)}</span>}
            {(r.field === 'tempC' || r.field === 'ph') && isRange(r.value) && <span class="bar"><RangeBar kind={r.field === 'ph' ? 'ph' : 'temp'} min={r.value.min} max={r.value.max} /></span>}
          </dd>
        </div>
      ))}
    </dl>
    <details class="trust" data-pagefind-ignore>
      <summary>
        <span class="label">{t('Nguồn và độ tin cậy')}</span>
        {marked && <span class="legend" aria-hidden="true"><span class="mark" />{t('Các nguồn ghi khác nhau')}</span>}
        <svg class="chev" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </summary>
      <dl class="by">
        {rows.map(r => (
          <div data-src-field={r.field} data-conflict={r.conflict ? 'true' : undefined}>
            <dt>{t(FIELD_LABELS[r.field])}{r.marked && <span class="mark" aria-hidden="true" />}</dt>
            <dd>
              {r.conflict && <p>{r.agreed ? t('Mức mọi nguồn cùng khuyên') : t('Mỗi nguồn ghi một mức')}</p>}
              <ul>
                {(r.conflict ? r.vals : r.vals.slice(0, 1)).map(v => {
                  const names = r.conflict ? [v.source] : r.sources
                  return (
                    <li>
                      {names.map((id, i) => <>{i > 0 && ', '}{isVietnamese(nameOf(id)) ? <><span lang="vi">{nameOf(id)}</span>{lang !== 'vi' && <> ({t('tiếng Việt')})</>}</> : nameOf(id)}</>)}
                      {r.conflict ? <>: <span {...unitAttrs(r.field, v.value)}>{range(v.value)}{unit(r.field)}</span></> : names.length > 1 && <span class="same"> · {t('cùng một mức')}</span>}
                    </li>
                  )
                })}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
      <p class="how"><a href={guideLink(CONFLICT_ANCHOR)}>{t('Bảng chọn một số thế nào khi các nguồn ghi khác nhau')}</a></p>
    </details>
  </div>
)}
<style>
  .card { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; border: 1px solid var(--c-rule); background: var(--c-plate); }
  .card > div { padding: var(--space-3); border-right: 1px solid var(--c-rule); border-bottom: 1px solid var(--c-rule); }
  .card > div:nth-child(3n) { border-right: 0; }
  /* The last cell takes what its row leaves (seven fields: Độ khó alone): no blank cell beside it. */
  .card > div:last-child:nth-child(3n+1) { grid-column: 1 / -1; border-right: 0; }
  .card > div:last-child:nth-child(3n+2) { grid-column: span 2; border-right: 0; }
  dt { font-size: 0.75rem; color: var(--c-ink-faint); }
  /* A label's card (GlossaryTip) says what the figure is, with a link to its section of the explainer page; a tap shows
     the card and never leaves the page. Its ::before is the 44 px a finger needs, without moving the card's lines. */
  dt .gl { position: relative; display: inline-block; padding-block: 4px; margin-block: -4px; color: inherit; text-decoration: underline dotted var(--c-moss); text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
  dt .gl::before { content: ''; position: absolute; left: 50%; top: 50%; width: max(100%, 44px); height: 44px; transform: translate(-50%, -50%); }
  dd { margin: 0; font: 400 var(--step-1)/1.3 var(--f-display); }
  .bar { display: block; margin-top: var(--space-2); }
  .n { font: 500 var(--step--1) var(--f-body); color: var(--c-ink-soft); }
  /* Sources disagree on this value: one quiet dot, explained in the toggle below the card. */
  .mark { display: inline-block; width: 0.45rem; height: 0.45rem; margin-left: 0.4rem; border-radius: 50%; background: var(--c-cardinal); vertical-align: 0.08em; }
  /* One toggle per card, joined to its lower edge. */
  .trust { border: 1px solid var(--c-ink); border-top: 0; background: var(--c-plate); font: 400 0.875rem/1.45 var(--f-body); }
  .trust summary { position: relative; display: flex; align-items: center; flex-wrap: wrap; gap: 0 var(--space-3); min-height: 2.75rem; padding: var(--space-2) 2.75rem var(--space-2) var(--space-3); cursor: pointer; list-style: none; color: var(--c-ink-soft); transition: color 0.15s ease-out; }
  .trust summary::-webkit-details-marker { display: none; }
  .trust summary:hover { color: var(--c-ink); }
  .trust .label { font-weight: 500; text-decoration: underline dotted var(--c-rule); text-underline-offset: 4px; }
  .trust .legend { font-size: 0.8125rem; color: var(--c-ink-faint); }
  .trust .legend .mark { margin: 0 0.35rem 0 0; }
  .chev { position: absolute; right: var(--space-3); top: calc(50% - 8px); transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1); }
  .trust[open] .chev { transform: rotate(180deg); }
  .by { margin: 0; padding: 0 var(--space-3) var(--space-3); }
  .by > div { display: grid; grid-template-columns: minmax(7.5rem, 34%) 1fr; gap: var(--space-3); padding-block: var(--space-2); border-top: 1px dotted var(--c-rule); }
  .by dt { font-size: 0.8125rem; color: var(--c-ink-soft); }
  .by dd { font: inherit; color: var(--c-ink); }
  .by p { margin: 0 0 2px; color: var(--c-ink-soft); }
  .by ul { list-style: none; margin: 0; padding: 0; }
  .by li span[data-c], .by li span[data-cm] { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .by .same { color: var(--c-ink-faint); }
  .how { margin: 0; padding: 0 var(--space-3) var(--space-1); }
  .how a { display: inline-block; min-height: 44px; line-height: 44px; color: var(--c-ink-soft); }
  /* "Vì sao?": the difficulty cell opens to the needs behind it, across the card's width. */
  .why summary { display: flex; align-items: center; flex-wrap: wrap; gap: 0 var(--space-2); min-height: 44px; cursor: pointer; list-style: none; }
  .why summary::-webkit-details-marker { display: none; }
  .why .q { font: 500 0.8125rem var(--f-body); color: var(--c-ink-soft); text-decoration: underline dotted var(--c-rule); text-underline-offset: 4px; }
  .why .chev { position: static; color: var(--c-ink-soft); }
  .why[open] .chev { transform: rotate(180deg); }
  .card > div:has(> dd > .why[open]) { grid-column: 1 / -1; border-right: 0; }
  /* The cell the opened panel leaves alone on its row takes the rest of that row: no blank cell beside it. */
  .card > div:nth-child(3n+1):has(+ div > dd > .why[open]) { grid-column: 1 / -1; border-right: 0; }
  .card > div:nth-child(3n+2):has(+ div > dd > .why[open]) { grid-column: span 2; border-right: 0; }
  .needs { font: 400 0.875rem/1.45 var(--f-body); color: var(--c-ink); }
  .needs p { margin: var(--space-2) 0; color: var(--c-ink-soft); }
  /* One row per need, its name, level and figures in columns shared by every row (subgrid). */
  .needs ul { display: grid; grid-template-columns: auto auto minmax(0, 1fr); column-gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
  .needs li { grid-column: 1 / -1; display: grid; grid-template-columns: 6.5rem auto minmax(0, 1fr); grid-template-columns: subgrid; align-items: baseline; padding-block: var(--space-2); border-top: 1px dotted var(--c-rule); }
  .needs .nm { color: var(--c-ink-soft); }
  .needs .lv { justify-self: start; padding: 0 0.45em; border: 1px solid currentColor; font: 600 0.75rem var(--f-body); line-height: 1.5; }
  .needs .lv.easy { color: var(--c-moss); }
  .needs .lv.mid { color: var(--c-ink-soft); }
  .needs .lv.hard { color: var(--c-cardinal); }
  .needs .fx span { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .needs .note a { display: inline-block; min-height: 44px; line-height: 44px; color: var(--c-ink); font-weight: 500; }
  @media (max-width: 480px) { .card { grid-template-columns: repeat(2, 1fr); } .card > div:nth-child(3n) { border-right: 1px solid var(--c-rule); } .card > div:nth-child(2n) { border-right: 0; } .card > div:nth-child(n):has(+ div > dd > .why[open]), .card > div:last-child:nth-child(n) { grid-column: auto; } .card > div:nth-child(odd):has(+ div > dd > .why[open]), .card > div:last-child:nth-child(odd) { grid-column: 1 / -1; border-right: 0; } }
</style>
