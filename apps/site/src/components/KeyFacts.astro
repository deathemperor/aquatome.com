---
import { resolveDataCard, type SpeciesEntity } from '@aq/schema'
import Difficulty from './Difficulty.astro'
import { FIELD_LABELS, fmt, isRange } from '../lib/format'
import { i18n } from '../lib/i18n'
/** The four facts a reader decides by, under the name on a phone: the data card's own resolved values (resolveDataCard). */
interface Props { card: SpeciesEntity['dataCard'] }
const { t, lang } = i18n(Astro.url)
const { range } = fmt(lang)
const facts = (['tempC', 'ph', 'tankCm', 'difficulty'] as const).map(field => ({ field, value: resolveDataCard(Astro.props.card[field] ?? [])?.value }))
const pair = (v: number | { min: number; max: number }) => (isRange(v) ? `${v.min},${v.max}` : `${v},${v}`)
---
{facts.some(f => f.value !== undefined) && (
  <dl class="keyfacts" data-pagefind-ignore>
    {facts.map(({ field, value }) => (
      <div data-field={field}>
        <dt>{t(FIELD_LABELS[field])}</dt>
        <dd>
          {value === undefined ? <span class="none">{t('chưa có')}</span>
            : field === 'difficulty' && typeof value === 'number' ? <Difficulty value={value} />
            : field === 'tempC' ? <span data-c={pair(value)}>{range(value)}°C</span>
            : field === 'tankCm' ? <span data-cm={pair(value)}>{range(value)} cm</span>
            : range(value)}
        </dd>
      </div>
    ))}
  </dl>
)}
<style>
  /* Temperature is the widest value (73,4–80,6°F): its column is wider. Any value may break after its dash rather than
     run into the next column. */
  .keyfacts { display: grid; grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr)); margin: var(--space-4) 0 0; border-block: 1px solid var(--c-ink); }
  .keyfacts > div { padding: var(--space-2) var(--space-2) var(--space-2) 0; min-width: 0; }
  .keyfacts > div + div { padding-left: var(--space-2); border-left: 1px solid var(--c-rule); }
  dt { font-size: 0.75rem; line-height: 1.3; color: var(--c-ink-faint); }
  dd { margin: 2px 0 0; font: 450 clamp(1rem, 0.6rem + 1.9vw, var(--step-1))/1.25 var(--f-display); }
  .none { font: 400 0.8125rem var(--f-body); color: var(--c-ink-faint); }
  /* A computer shows the full data card beside the photo, on the first screen already. */
  @media (min-width: 861px) { .keyfacts { display: none; } }
</style>
