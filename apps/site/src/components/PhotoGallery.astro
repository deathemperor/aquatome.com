---
import type { Photo } from '@aq/schema'
import { i18n, licenceLabel } from '../lib/i18n'
interface Props { photos: Photo[]; alt: string }
const { photos, alt } = Astro.props
const [main] = photos // the rest are placed between sections (Sections.astro)
const { t } = i18n(Astro.url)
---
{main && (
  <figure class="gallery">
    <div class="plate"><img src={main.url} width={main.width} height={main.height} alt={alt} fetchpriority="high" /></div>
    <figcaption>{t('Ảnh:')} <a href={main.sourceUrl} rel="noopener">{main.author}</a>, {licenceLabel(t, main.licence)}</figcaption>
  </figure>
)}
<style>
  .gallery { margin: 0; }
  .plate { background: var(--c-plate); padding: 8px; border-radius: var(--radius-plate); box-shadow: 0 1px 0 var(--c-rule); }
  .plate img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  figcaption { font-size: 0.75rem; color: var(--c-ink-faint); margin-top: var(--space-2); }
  figcaption a { color: inherit; }
</style>
