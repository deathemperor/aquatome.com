---
import type { Localized, SpeciesEntity } from '@aq/schema'
import Browse from '../../layouts/Browse.astro'
import PagedSpecies from '../../components/PagedSpecies.astro'
import { getContent } from '../../lib/content'
import { creditsFor } from '../../lib/credits'
import { gridPhotos } from '../../lib/pictures'
import { speciesLists } from '../../lib/list-data'
import { PAGE } from '../../scripts/filter-list'
import { i18n, langOf } from '../../lib/i18n'
import { alternatesWhere } from '../../lib/alternates'
import { RANKS, TAXON_INTRO, taxonRanks } from '../../lib/taxa-places'

/** `level`: the rank in RANKS (1 order, 2 family, 3 genus), not the depth: a family whose species have no order sits at depth 1. */
type Node = { path: string[]; name: string; level: number; species: Localized<SpeciesEntity>[] }
export async function getStaticPaths({ routePattern }: { routePattern: string }) {
  const lang = langOf(routePattern)
  const c = await getContent(lang)
  const lists = speciesLists(lang, c)
  // The index always exists (a language with no species yet still has the page its menus link to). Each taxon's
  // species are its list's (lib/list-data.ts), in the fish list's order.
  const nodes = new Map<string, Node>([['', { path: [], name: 'Phân loại', level: 0, species: [] }]])
  for (const s of c.species) {
    const ranks = taxonRanks(s)
    const path = ranks.map(r => r.slug)
    for (let i = 1; i <= ranks.length; i++) {
      const k = path.slice(0, i).join('/')
      if (!nodes.has(k)) nodes.set(k, { path: path.slice(0, i), name: ranks[i - 1]!.name, level: ranks[i - 1]!.level, species: lists.get(`phan-loai/${k}`)! })
    }
  }
  // The ranks under a taxon: most species first, then A–Z by name in plain character order (Latin, ASCII), a rule the
  // app applies to its index too, so its shelves list them in the same order.
  const byName = (a: Node, b: Node) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0)
  const children = (n: Node) => [...nodes.values()].filter(m => m.path.length === n.path.length + 1 && m.path.slice(0, -1).join('/') === n.path.join('/'))
    .sort((a, b) => b.species.length - a.species.length || byName(a, b))
  return [...nodes.values()].map(n => ({ params: { path: n.path.join('/') || undefined }, props: { node: n, kids: children(n) } }))
}
const { node, kids } = Astro.props as { node: Node; kids: Node[] }
const { t, lang } = i18n(Astro.url)
const c = await getContent(lang)
// The same taxon in another language: some species of it has a page there.
const alternates = await alternatesWhere(Astro.url.pathname, c => c.species.some(s => node.path.every((x, i) => x === taxonRanks(s)[i]?.slug)))
const level = t(RANKS[node.level]!)
const first = node.species[0]
const crumbNames = first ? taxonRanks(first).map(r => r.name) : []
const crumbs: [string, string][] = node.path.length
  ? [['/vi/phan-loai/', t(RANKS[0])], ...node.path.slice(0, -1).map((_, i): [string, string] => [`/vi/phan-loai/${node.path.slice(0, i + 1).join('/')}/`, crumbNames[i]!])]
  : []
---
<Browse title={node.path.length ? `${level} ${node.name}` : t(RANKS[0])} heading={node.path.length ? node.name : t(RANKS[0])} crumbs={crumbs} credits={creditsFor(gridPhotos(c, node.species.slice(0, PAGE)).map(p => p ?? undefined))} creditsLater={node.species.length > PAGE} intro={node.path.length ? t(TAXON_INTRO, { level, name: node.name, n: node.species.length }) : t('Duyệt loài theo bộ, họ và chi.')} alternates={alternates}>
  {/* Always fill the slot: a conditional one leaves the h1 empty when false. A genus is italic, higher ranks are not. */}
  <span slot="heading" class:list={{ sci: node.level === 3 }}>{node.path.length ? node.name : t(RANKS[0])}</span>
  {kids.length > 0 && (
    <ul class="kids">
      {kids.map(k => <li><a href={`/vi/phan-loai/${k.path.join('/')}/`} class:list={{ sci: k.level === 3 }}>{k.level > node.level + 1 ? `${t(RANKS[k.level]!)} ${k.name}` : k.name}</a> <span>{t('{n} loài', { n: k.species.length })}</span></li>)}
    </ul>
  )}
  {node.path.length > 0 && <PagedSpecies species={node.species} list={`phan-loai/${node.path.join('/')}`} heading={t('Danh sách loài')} />}
</Browse>
<style>
  .kids { list-style: none; padding: 0; margin: 0 0 var(--space-6); columns: 3 14rem; }
  .kids li { padding-block: var(--space-2); border-bottom: 1px dotted var(--c-rule); break-inside: avoid; }
  .kids a { font: 400 var(--step-1) var(--f-display); }
  .kids span { font-size: 0.8rem; color: var(--c-ink-faint); }
</style>
