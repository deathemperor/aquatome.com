---
import type { BreedEntity, Localized, Photo, SpeciesEntity } from '@aq/schema'
import GalleryPage from '../../../components/GalleryPage.astro'
import ReaderPhotos from '../../../components/ReaderPhotos.astro'
import { getContent } from '../../../lib/content'
import { albumOf, hasPhotoPage } from '../../../lib/photo-page'
import { i18n, langOf, localizePath, toVi, type Lang } from '../../../lib/i18n'
import { alternatesOf } from '../../../lib/alternates'
export async function getStaticPaths({ routePattern }: { routePattern: string }) {
  const c = await getContent(langOf(routePattern))
  // Species and man-made fish (breeds) alike; a breed has no scientific name.
  return [...c.species.map(s => ({ s, photos: albumOf(c, 'species', s) })), ...c.breeds.map(s => ({ s, photos: albumOf(c, 'breeds', s) }))]
    .filter(x => hasPhotoPage(x.photos)).map(({ s, photos }) => ({ params: { slug: s.t.slug }, props: { s, photos } }))
}
const { s, photos } = Astro.props as { s: Localized<SpeciesEntity> | Localized<BreedEntity>; photos: Photo[] }
const { t } = i18n(Astro.url)
const sci = 'scientificName' in s ? s.scientificName : undefined
const page = `/vi/ca/${s.t.slug}/`
// The same photos in every language: the gallery is there wherever its fish's page is.
const alternates = Object.fromEntries(Object.entries(await alternatesOf(sci ? 'species' : 'breeds', s.id)).map(([l, p]) => [l, localizePath(l as Lang, `${toVi(p)}anh/`)]))
---
<GalleryPage name={s.t.name} sci={sci} photos={photos} page={page} back={t('Cách nuôi {name} →', { name: s.t.name })} crumbs={[['/vi/ca/', t('Loài cá')], [page, s.t.name]]} indexable={s.t.quality.indexable} alternates={alternates} readers={!!sci}>
  {/* A species' readers' photos, as on its page (a breed's: later). */}
  {sci && <ReaderPhotos entity={`species:${s.id}`} name={s.t.name} gallery />}
</GalleryPage>
