---
import type { Localized, PlantEntity } from '@aq/schema'
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'
import PhotoGallery from '../../components/PhotoGallery.astro'
import GalleryStrip from '../../components/GalleryStrip.astro'
import Sections from '../../components/Sections.astro'
import GuideLinks from '../../components/GuideLinks.astro'
import VideoGuideGrid from '../../components/VideoGuideGrid.astro'
import ProductSlots from '../../components/ProductSlots.astro'
import Comments from '../../components/Comments.astro'
import { plantTitle, withSci } from '../../lib/meta'
import { nameAndSci, sciBeside } from '../../lib/sci'
import { getContent } from '../../lib/content'
import { searchAliases } from '../../lib/search'
import { PLANT_LABELS } from '../../lib/format'
import { creditsFor } from '../../lib/credits'
import { plantParts } from '../../lib/plant-page'
import { i18n, langOf } from '../../lib/i18n'
import { alternatesOf } from '../../lib/alternates'

export async function getStaticPaths({ routePattern }: { routePattern: string }) {
  const c = await getContent(langOf(routePattern))
  return c.plants.map(p => ({ params: { slug: p.t.slug }, props: { p } }))
}
const { p } = Astro.props as { p: Localized<PlantEntity> }
const { t, lang } = i18n(Astro.url)
const c = await getContent(lang)
// What the page shows, chosen in page order (lib/plant-page.ts, which the app's copy reads too).
const { gallery, galleryPath, strip, figures, guides, videoGuides, videoPhotos } = plantParts(lang, c, p)
// The plant itself is always a shopping item (sold on Shopee/Lazada), even when the engine proposed none.
const slots = p.productSlots.some(s => s.category === 'cay-thuy-sinh') ? p.productSlots : [{ category: 'cay-thuy-sinh', keywords: [p.t.name, p.scientificName] }, ...p.productSlots]
const facts: [string, string][] = [
  [t('Độ khó'), t(PLANT_LABELS.difficulty[p.difficulty]!)],
  [t('Ánh sáng'), t(PLANT_LABELS.light[p.light]!)],
  ['CO₂', t(PLANT_LABELS.co2[p.co2]!)],
  [t('Tốc độ mọc'), t(PLANT_LABELS.growth[p.growth]!)],
  [t('Vị trí'), p.placement.map(x => t(PLANT_LABELS.placement[x]!)).join(', ')],
]
import RedirectNote from '../../components/RedirectNote.astro'
import BackToTop from '../../components/BackToTop.astro'
const alternates = await alternatesOf('plants', p.id)
---
<Base title={plantTitle(lang, p.t.name, p.scientificName)} description={`${withSci(p.t.name, p.scientificName)}: ${facts.map(([k, v]) => `${k.toLowerCase()} ${v.toLowerCase()}`).join(', ')}. ${t('Cách trồng và chăm sóc.')}`} image={p.photos[0]?.url} noindex={!p.t.quality.indexable} alternates={alternates} credits={creditsFor([...figures, ...strip].map(x => x ?? undefined))}>
  <Nav slot="header" />
  <nav class="wrap crumb" aria-label={t('Đường dẫn')}><a href="/vi/cay/">{t('Cây thủy sinh')}</a></nav>
  <header class="wrap top">
    <PhotoGallery photos={p.photos} alt={nameAndSci(p.t.name, p.scientificName)} />
    <div>
      <h1 data-pagefind-meta="aka[data-aka]" data-aka={searchAliases(p.t, p.scientificName, p.synonyms)}>{p.t.name}</h1>
      <RedirectNote from={p.t.redirectFrom} />
      {sciBeside(p.t.name, p.scientificName) && <p class="sci binomial">{p.scientificName}</p>}
      {p.t.altNames.length > 0 && <p class="alt" data-pagefind-ignore>{t('Tên khác: {names}', { names: p.t.altNames.join(', ') })}</p>}
      <dl class="facts">{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    </div>
  </header>
  {strip.some(Boolean) && <GalleryStrip photos={gallery} shown={strip} href={galleryPath} name={p.t.name} />}
  <Sections sections={p.sections} t={p.t} self={`plant:${p.id}`} selfNames={[p.scientificName, p.t.name, ...p.t.altNames]} figures={figures.map(photo => ({ photo }))} co2={p.co2} refs={p.refs} />
  {/* The guides that say more about it, then the shops (Vietnam's, Shopee/Lazada links: Vietnamese pages only). */}
  <GuideLinks guides={guides} heading={t('Bài viết nhắc đến cây này')} />
  <VideoGuideGrid guides={videoGuides} photos={videoPhotos} heading={t('Có trong video hướng dẫn')} />
  {lang === 'vi' && <div class="wrap"><ProductSlots slots={slots} heading={t('Mua cây này')} entity={`plant:${p.id}`} /></div>}
  <div class="wrap"><Comments entity={`plant:${p.id}`} /></div>
  <BackToTop />
</Base>
<style>
  .crumb { font-size: 0.85rem; padding-top: var(--space-4); }
  .crumb a { color: var(--c-ink-soft); }
  .top { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-6); padding-block: var(--space-4) var(--space-6); align-items: start; }
  h1 { font-size: var(--step-4); letter-spacing: -0.015em; }
  .binomial { font-size: var(--step-1); color: var(--c-ink-soft); margin: var(--space-1) 0 var(--space-4); }
  .binomial:has(+ .alt) { margin-bottom: var(--space-2); }
  .alt { font-size: 0.85rem; color: var(--c-ink-faint); margin: 0 0 var(--space-4); }
  .facts { display: grid; grid-template-columns: 1fr 1fr; margin: 0; border: 1px solid var(--c-rule); background: var(--c-plate); }
  .facts div { padding: var(--space-3); border-bottom: 1px solid var(--c-rule); }
  .facts div:nth-child(odd) { border-right: 1px solid var(--c-rule); }
  /* An odd last fact takes its whole row: no blank cell beside it. */
  .facts div:last-child:nth-child(odd) { grid-column: 1 / -1; border-right: 0; }
  dt { font-size: 0.75rem; color: var(--c-ink-faint); }
  dd { margin: 0; font: 400 var(--step-1) var(--f-display); }
  @media (max-width: 860px) { .top { grid-template-columns: 1fr; } }
</style>
