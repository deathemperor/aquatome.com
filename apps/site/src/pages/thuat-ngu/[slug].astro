---
import type { GlossaryEntity, Localized } from '@aq/schema'
import Browse from '../../layouts/Browse.astro'
import GlossaryTip from '../../components/GlossaryTip.astro'
import { getContent } from '../../lib/content'
import { glossaryTitle } from '../../lib/meta'
import { sciBeside } from '../../lib/sci'
import { i18n, langOf } from '../../lib/i18n'
import { alternatesOf } from '../../lib/alternates'
import { figureHtml } from '../../lib/figures'
import { fmt } from '../../lib/format'
import { glossaryParts, termTitle, USED_IN_SHOWN } from '../../lib/glossary-page'
export async function getStaticPaths({ routePattern }: { routePattern: string }) {
  const c = await getContent(langOf(routePattern))
  return c.glossary.map(g => ({ params: { slug: g.t.slug }, props: { g } }))
}
const { g } = Astro.props as { g: Localized<GlossaryEntity> }
const { t, lang } = i18n(Astro.url)
const { num } = fmt(lang)
const alternates = await alternatesOf('glossary', g.id)
const p = glossaryParts(lang, await getContent(lang), g)
// The pages that link this term, each kind under its own heading with its count: the first few of each, as links, and a
// search for every page that names it when there are more.
const used = [
  { label: t('Hướng dẫn'), all: p.guides.length, links: p.guides.slice(0, USED_IN_SHOWN.guides).map(x => ({ href: `/vi/huong-dan/${x.t.slug}/`, name: x.t.name })) },
  { label: t('Loài cá'), all: p.fish.length, links: p.fish.slice(0, USED_IN_SHOWN.fish) },
  { label: t('Cây thủy sinh'), all: p.plants.length, links: p.plants.slice(0, USED_IN_SHOWN.plants) },
].filter(x => x.all > 0)
---
<Browse title={glossaryTitle(lang, termTitle(g))} heading={g.t.name} description={g.t.definition} crumbs={[['/vi/thuat-ngu/', t('Thuật ngữ')]]} noindex={!g.t.quality.indexable} alternates={alternates}>
  {p.otherNames.length > 0 && <p class="aka">{t('Tên khác: {names}', { names: p.otherNames.join(', ') })}</p>}
  <p class="en">{t('Tiếng Anh:')} <span lang="en">{g.en}</span>{g.latin && sciBeside(g.en ?? '', g.latin) && <>, <span class="sci">{g.latin}</span></>}</p>
  {p.definition && <p class="def" set:html={p.definition} />}
  {p.material && <p class="material-link"><a href={p.material.href}>{p.material.text}</a></p>}
  {p.photo && <Fragment set:html={figureHtml(lang, { photo: p.photo, label: p.photo.caption })} />}
  {p.body && <div class="body" set:html={p.body} />}
  {p.related.length > 0 && (
    <section class="related" aria-labelledby="xem-them">
      <h2 id="xem-them">{t('Xem thêm')}</h2>
      <ul>{p.related.map(r => <li><a href={`/vi/thuat-ngu/${r.t.slug}/`}>{r.t.name}</a>{r.t.definition && <>: {r.t.definition}</>}</li>)}</ul>
    </section>
  )}
  {used.length > 0 && (
    <section class="used" aria-labelledby="dung-trong">
      <h2 id="dung-trong">{t('Dùng trong {n} trang', { n: num(p.total) })}</h2>
      {used.map(u => (
        <>
          <h3>{u.label} ({num(u.all)})</h3>
          <ul>{u.links.map(l => <li><a href={l.href}>{l.name}</a></li>)}</ul>
        </>
      ))}
      {p.more && <p class="more"><a href={`/vi/tim-kiem/?q=${encodeURIComponent(g.t.name)}`}>{t('Tìm mọi trang nhắc đến {name} →', { name: g.t.name })}</a></p>}
    </section>
  )}
  {p.refs.length > 0 && (
    <section class="refs" id="nguon" aria-labelledby="ref-h" data-pagefind-ignore>
      <h2 id="ref-h">{t('Nguồn tham khảo')}</h2>
      <ol>{p.refs.map(r => <li><a href={r.url} rel="nofollow noopener" target="_blank" data-ev="src">{r.title}</a></li>)}</ol>
    </section>
  )}
  <GlossaryTip />
</Browse>
<style>
  .aka, .en { color: var(--c-ink-soft); }
  .aka { margin-bottom: 0; }
  .def { font-size: var(--step-1); max-width: var(--measure); line-height: 1.6; }
  .body { max-width: var(--measure); line-height: 1.6; }
  .body :global(h2), .related h2 { font-size: var(--step-1); margin-top: var(--space-5); }
  .related { margin-top: var(--space-6); max-width: var(--measure); }
  .related ul { padding-left: 1.2em; }
  .related li { padding-block: var(--space-1); }
  .related a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
  .refs { margin-top: var(--space-6); max-width: var(--measure); font-size: 0.9rem; color: var(--c-ink-soft); }
  .refs h2 { font: 600 0.8rem var(--f-body); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: var(--space-2); }
  .refs ol { padding-left: 1.4em; margin: 0; }
  .refs li { padding-block: 2px; overflow-wrap: anywhere; }
  .refs a { display: inline-flex; align-items: center; min-height: 44px; }
  .used { margin-top: var(--space-6); max-width: var(--measure); }
  .used h2 { font-size: var(--step-1); }
  .used h3 { font-size: var(--step-0); margin: var(--space-4) 0 var(--space-2); }
  .used ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); padding: 0; margin: 0; list-style: none; }
  .used a { display: inline-flex; align-items: center; min-height: 44px; }
  .used .more { margin-top: var(--space-4); }
</style>
