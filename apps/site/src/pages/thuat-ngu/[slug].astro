---
import { slugify, type GlossaryEntity, type Localized, type Photo } from '@aq/schema'
import Browse from '../../layouts/Browse.astro'
import GlossaryTip from '../../components/GlossaryTip.astro'
import JumpChips from '../../components/JumpChips.astro'
import { getContent } from '../../lib/content'
import { glossaryTitle } from '../../lib/meta'
import { sciBeside } from '../../lib/sci'
import { i18n, langOf } from '../../lib/i18n'
import { alternatesOf } from '../../lib/alternates'
import { figureHtml } from '../../lib/figures'
import { creditsFor } from '../../lib/credits'
import { fmt } from '../../lib/format'
import { smallSrc, tileFrame } from '../../lib/img'
import { guideImages } from '../../lib/mentions'
import { kindAiLabel, kindLargeFallback } from '../../lib/glossary-kind-image'
import { bodySections, glossaryParts, kindCaption, kindCardImage, kindCredit, termTitle, tipLine, usedPictures, usedRows } from '../../lib/glossary-page'
export async function getStaticPaths({ routePattern }: { routePattern: string }) {
  const c = await getContent(langOf(routePattern))
  return c.glossary.map(g => ({ params: { slug: g.t.slug }, props: { g } }))
}
const { g } = Astro.props as { g: Localized<GlossaryEntity> }
const { t, lang } = i18n(Astro.url)
const { num } = fmt(lang)
const alternates = await alternatesOf('glossary', g.id)
const c = await getContent(lang)
const p = glossaryParts(lang, c, g)
// The pages that link this term, each kind under its own heading with its count, as rows with their picture: three of
// each, or all of them where they come to six or fewer; past that a search for every page that names it.
type Row = { href: string; name: string; photo?: Photo; sci?: string; kind?: string; fish?: boolean }
const rows = usedRows(p)
// The kinds as cards (the Design Lead's board, 16 Nov 2026): those with a photo, then those in words; each opens large.
const kinds = p.kinds
const cards = kinds?.items.filter(k => k.photo).map(k => ({ ...k, cardImage: kindCardImage(k.photo!, k.cardCrop) })) ?? []
const words = kinds?.items.filter(k => !k.photo) ?? []
const kindsId = kinds ? slugify(kinds.title) || 'cac-loai' : ''
const kindPhotos = cards.map(k => k.photo!)
// No picture twice on the page: the kinds' photos, the term's (glossaryParts), then each row the first of its pictures
// not shown yet, else none.
const pics = usedPictures(c, [p.photo, ...p.others, ...kindPhotos], rows, x => guideImages(c, x))
const photo = (x: Photo | null | undefined) => (x ? { photo: x } : {})
const used: { label: string; all: number; rows: Row[] }[] = [
  { label: t('Hướng dẫn'), all: p.guides.length, rows: rows.guides.map((x, i) => ({ href: `/vi/huong-dan/${x.t.slug}/`, name: x.t.name, ...photo(pics.guides[i]), kind: x.video ? t('Video hướng dẫn') : t('Hướng dẫn') })) },
  { label: t('Loài cá'), all: p.fish.length, rows: rows.fish.map(({ photo: _, ...x }, i) => ({ ...x, ...photo(pics.fish[i]), fish: true })) },
  { label: t('Cây thủy sinh'), all: p.plants.length, rows: rows.plants.map(({ photo: _, ...x }, i) => ({ ...x, ...photo(pics.plants[i]) })) },
].filter(x => x.all > 0)
// A fish's picture framed on the fish (its tile's rule at 3:2); a guide's or a plant's cropped to the middle.
const frame = (r: Row) => (r.photo && r.fish ? tileFrame(r.photo, 3 / 2) : {})
// A long term's parts, as the fish page's jump row, its kinds first, with "Dùng trong" at its end; a term of a meaning
// alone has none.
const body = bodySections(p.pageBody)
const parts = [...(kinds ? [{ href: `#${kindsId}`, label: kinds.title }] : []), ...body.parts]
const jumps = parts.length >= 2 ? [...parts, ...(p.total ? [{ href: '#dung-trong', label: t('Dùng trong {n}', { n: num(p.total) }), end: true }] : [])] : []
// "9 loại", "2 dạng": the kinds heading's own word.
const kindWord = kinds?.title.split(/\s+/)[1]?.toLocaleLowerCase('vi') ?? ''
const n = kinds?.items.length ?? 0
const viewId = (id: string) => `loai-${id}`
// Sources: the first five, the rest folded.
const REFS_SHOWN = 5
---
<Browse title={glossaryTitle(lang, termTitle(g))} heading={g.t.name} description={g.t.definition} crumbs={[['/vi/thuat-ngu/', t('Thuật ngữ')]]} noindex={!g.t.quality.indexable} alternates={alternates} credits={creditsFor([p.photo, ...p.others, ...kindPhotos, ...used.flatMap(u => u.rows.map(r => r.photo))])}>
  {p.otherNames.length > 0 && <p class="aka">{t('Tên khác: {names}', { names: p.otherNames.join(', ') })}</p>}
  <p class="en">{t('Tiếng Anh:')} <span lang="en">{g.en}</span>{g.latin && sciBeside(g.en ?? '', g.latin) && <>, <span class="sci">{g.latin}</span></>}</p>
  {/* The picture before the explanation (the Design Lead's board, 16 Nov 2026): the term's photo under its names, its other photos two across under it. */}
  {p.photo && <Fragment set:html={figureHtml(lang, { photo: p.photo, label: p.photo.caption })} />}
  {p.others.length > 0 && <div class:list={['others', { one: p.others.length === 1 }]}>{p.others.map(o => <Fragment set:html={figureHtml(lang, { photo: o, label: o.caption }, true)} />)}</div>}
  {p.definition && <p class="def" set:html={p.definition} />}
  {p.material && <p class="material-link"><a href={p.material.href}>{p.material.text}</a></p>}
  {p.treat && <p class="treat"><a href={p.treat.href}>{p.treat.text}</a></p>}
  {jumps.length > 0 && <JumpChips items={jumps} />}
  {(kinds || body.html) && (
    <div class="body">
      {kinds && (
        <section class="kinds" aria-labelledby={kindsId} data-kinds>
          <div class="k-head"><h2 id={kindsId}>{kinds.title}</h2><span class="k-count">{num(n)} {kindWord}</span></div>
          {kinds.intro && <Fragment set:html={kinds.intro} />}
          {cards.length > 0 && (
            <ul class="k-cards">{cards.map(k => (
              <li><a class="k-card" href={`#${viewId(k.id)}`} data-view={viewId(k.id)}>
                <span class="k-pic"><img src={k.cardImage.src} width={k.photo!.width} height={k.photo!.height} alt={k.photo!.caption ?? k.name} style={k.cardImage.style} loading="lazy" decoding="async" /><Fragment set:html={kindAiLabel(lang, k.photo!, 'card', k.aiLabelCorner)} /></span>
                <span class="k-name">{k.name}</span>{k.aka && <span class="k-aka">{k.aka}</span>}<span class="k-line">{k.line}</span>
              </a></li>
            ))}</ul>
          )}
          {words.length > 0 && (
            <ul class="k-words">{words.map(k => (
              <li><a class="k-card" href={`#${viewId(k.id)}`} data-view={viewId(k.id)}>
                <span class="k-name">{k.name}</span>{k.aka && <span class="k-aka">{k.aka}</span>}<span class="k-line">{k.line}</span>
              </a></li>
            ))}</ul>
          )}
          {/* Each kind large, in card order: its photo (drawn by the script when it opens, so the page holds each picture
              once), its caption and credit, its whole text, and the kinds either side by name. Without a script a card's
              link shows its view in place (:target), with its credit and text. */}
          {kinds.items.map((k, i) => {
            // The kinds either side, wrapping from three kinds on; of two, each names the other once, on its side (the
            // Design Lead's parity, 16 Nov 2026).
            const prev = n > 2 || i > 0 ? kinds.items[(i - 1 + n) % n] : undefined, next = n > 2 || i < n - 1 ? kinds.items[(i + 1) % n] : undefined
            const caption = k.photo ? kindCaption(lang, k.name, k.photo.caption) : ''
            return (
              <dialog class="k-view" id={viewId(k.id)} aria-labelledby={`${viewId(k.id)}-h`} data-full={k.photo?.url} data-w={k.photo?.width} data-h={k.photo?.height} data-alt={k.photo ? k.photo.caption ?? k.name : undefined}>
                <div class="kv-bar"><span class="kv-n">{num(i + 1)} / {num(n)}</span><a class="kv-x" href={`#${kindsId}`} aria-label={t('Đóng')}><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></a></div>
                <div class="kv-body">
                  {k.photo && <div class="kv-pic" style={`aspect-ratio: ${k.photo.width} / ${k.photo.height}`}>
                    <Fragment set:html={kindAiLabel(lang, k.photo, 'large', k.aiLabelCorner) + kindLargeFallback(k.photo, k.name)} />
                  </div>}
                  {k.photo && <p class="kv-by">{caption && <>{caption} </>}<Fragment set:html={kindCredit(lang, k.photo).html} /></p>}
                  <h3 id={`${viewId(k.id)}-h`}>{k.name}</h3>
                  {k.aka && <p class="kv-aka">{k.aka}</p>}
                  <div class="kv-text" set:html={k.html} />
                </div>
                {n > 1 && (
                  <nav class="kv-step" aria-label={kinds.title}>
                    {prev && <a href={`#${viewId(prev.id)}`} data-view={viewId(prev.id)} rel="prev">‹ {prev.name}</a>}
                    {next && <a href={`#${viewId(next.id)}`} data-view={viewId(next.id)} rel="next">{next.name} ›</a>}
                  </nav>
                )}
              </dialog>
            )
          })}
        </section>
      )}
      {body.html && <Fragment set:html={body.html} />}
    </div>
  )}
  {p.related.length > 0 && (
    <section class="related" aria-labelledby="xem-them">
      <h2 id="xem-them">{t('Xem thêm')}</h2>
      <ul>{p.related.map(r => <li><a href={`/vi/thuat-ngu/${r.t.slug}/`}>{r.t.name}</a>{r.t.definition && <>: {tipLine(r.t.definition, r.t.name)}</>}</li>)}</ul>
    </section>
  )}
  {used.length > 0 && (
    <section class="used" aria-labelledby="dung-trong">
      <h2 id="dung-trong">{t('Dùng trong {n} trang', { n: num(p.total) })}</h2>
      {used.map(u => (
        <>
          <h3>{u.label} ({num(u.all)})</h3>
          <ul class="rows">{u.rows.map(r => {
            const f = frame(r)
            return (
              <li><a href={r.href}>
                <span class:list={['pic', { whole: f.whole }]}>{r.photo && <img src={smallSrc(r.photo)} width={r.photo.width} height={r.photo.height} alt="" loading="lazy" style={f.pos && `object-position: ${f.pos}`} />}</span>
                <span class="words"><span class="name">{r.name}</span>{r.sci ? <span class="sub sci">{r.sci}</span> : r.kind && <span class="sub">{r.kind}</span>}</span>
              </a></li>
            )
          })}</ul>
        </>
      ))}
      {rows.more && <p class="more"><a href={`/vi/tim-kiem/?q=${encodeURIComponent(g.t.name)}`}>{t('Tìm mọi trang nhắc đến {name} →', { name: g.t.name })}</a></p>}
    </section>
  )}
  {p.refs.length > 0 && (
    <section class="refs" id="nguon" aria-labelledby="ref-h" data-pagefind-ignore>
      <h2 id="ref-h">{t('Nguồn tham khảo')}</h2>
      <ol>{p.refs.slice(0, REFS_SHOWN).map(r => <li><a href={r.url} rel="nofollow noopener" target="_blank" data-ev="src">{r.title}</a></li>)}</ol>
      {p.refs.length > REFS_SHOWN && (
        <details>
          <summary>{t('Xem cả {n} nguồn', { n: num(p.refs.length) })}</summary>
          <ol start={REFS_SHOWN + 1}>{p.refs.slice(REFS_SHOWN).map(r => <li><a href={r.url} rel="nofollow noopener" target="_blank" data-ev="src">{r.title}</a></li>)}</ol>
        </details>
      )}
    </section>
  )}
  <GlossaryTip />
</Browse>
<script>
  // A kind's card opens its view as a modal dialog: the page behind it inert, Esc or ✕ closes it, focus goes back to the
  // card; the kinds either side open in its place. Its photo is drawn when it opens, so the page holds each picture once
  // (the site's rule). Without this script a card's link shows its view in place (:target).
  // On a phone the view fills the screen and reads as a page, so it has a history entry of its own: Back closes it and the
  // page stays where it was; ✕, Esc or a tap outside close it and drop that entry; the kinds either side take its place in
  // it (the Design Lead, 16 Nov 2026).
  const section = document.querySelector<HTMLElement>('[data-kinds]')
  if (section) {
    section.classList.add('live')
    let from: HTMLElement | undefined
    // A close that isn't the reader's (the next kind taking this one's place, or Back) is marked on the dialog itself: its
    // close event comes a moment after close(), so a flag set around the call is gone by then (the fresh reader, 16 Nov).
    const shut = (o: HTMLDialogElement) => { o.dataset.quiet = '1'; o.close() }
    // Our own step back under way (a view the reader closed leaves its entry), and a card opened before it lands: its
    // entry is added once the step back is done, so a quick tap after Esc isn't closed by it.
    let leaving = false
    let waiting: string | undefined
    const draw = (d: HTMLDialogElement) => {
      const box = d.querySelector<HTMLElement>('.kv-pic')
      if (!box || box.querySelector('img') || !d.dataset.full) return
      const img = document.createElement('img')
      img.src = d.dataset.full
      img.alt = d.dataset.alt ?? ''
      img.width = Number(d.dataset.w)
      img.height = Number(d.dataset.h)
      img.decoding = 'async'
      box.append(img)
    }
    const page = () => location.pathname + location.search
    const open = (id: string, entry: 'push' | 'replace' | 'none', opener?: HTMLElement) => {
      const d = document.getElementById(id)
      if (!(d instanceof HTMLDialogElement)) return false
      for (const o of section.querySelectorAll<HTMLDialogElement>('dialog[open]')) if (o !== d) shut(o)
      if (opener) from = opener
      draw(d)
      if (!d.open) d.showModal()
      if (entry === 'push') { if (leaving) waiting = id; else history.pushState({ kind: id }, '', `${page()}#${id}`) }
      else if (entry === 'replace') { if (leaving) waiting = id; else history.replaceState({ kind: id }, '', `${page()}#${id}`) }
      d.querySelector<HTMLElement>('.kv-x')?.focus()
      return true
    }
    section.addEventListener('click', e => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a')
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return
      if (a.dataset.view) {
        const card = a.classList.contains('k-card')
        if (open(a.dataset.view, card ? 'push' : 'replace', card ? a : undefined)) e.preventDefault()
      } else if (a.classList.contains('kv-x')) { e.preventDefault(); a.closest('dialog')?.close() }
    })
    for (const d of section.querySelectorAll('dialog')) {
      d.addEventListener('close', () => {
        const quiet = d.dataset.quiet === '1'
        delete d.dataset.quiet
        // Closed by the reader (✕, Esc, a tap outside): its history entry goes too, so Back then leaves nothing open.
        if (!quiet && !leaving && history.state?.kind) { leaving = true; history.back() }
        else if (!quiet && location.hash === `#${d.id}`) history.replaceState(history.state, '', page())
        if (!section.querySelector('dialog[open]')) from?.focus()
      })
      // A tap outside the panel closes it, as the menu sheet: one on the backdrop, whose target is the dialog itself. A link
      // inside it worked by the keyboard gives a click at 0, 0, which is no tap outside.
      d.addEventListener('click', e => {
        if (e.target !== d) return
        const r = d.getBoundingClientRect()
        if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) d.close()
      })
    }
    // Back (or Forward) to an entry: the kind it names open, or none.
    addEventListener('popstate', e => {
      if (leaving) {
        leaving = false
        if (waiting) { history.pushState({ kind: waiting }, '', `${page()}#${waiting}`); waiting = undefined }
        return
      }
      const id = (e.state as { kind?: string } | null)?.kind
      if (id) { open(id, 'none'); return }
      for (const o of section.querySelectorAll<HTMLDialogElement>('dialog[open]')) shut(o)
    })
    // An address that names a kind (a link someone shared) opens it, over the page's own entry, so Back closes it too.
    const hash = decodeURIComponent(location.hash.slice(1))
    if (hash.startsWith('loai-') && document.getElementById(hash) instanceof HTMLDialogElement) {
      history.replaceState(null, '', page())
      open(hash, 'push', section.querySelector<HTMLElement>(`.k-card[data-view="${CSS.escape(hash)}"]`) ?? undefined)
    }
  }
</script>
<style>
  .aka, .en { color: var(--c-ink-soft); }
  .aka { margin-bottom: 0; }
  .def { font-size: var(--step-1); max-width: var(--measure); line-height: 1.6; }
  .body { max-width: var(--measure); line-height: 1.6; }
  .body :global(h2), .related h2 { font-size: var(--step-1); margin-top: var(--space-5); }
  .related { margin-top: var(--space-6); max-width: var(--measure); }
  .related ul { padding-left: 1.2em; }
  .related li { padding-block: var(--space-1); }
  .related a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
  .refs { margin-top: var(--space-6); max-width: var(--measure); font-size: 0.9rem; color: var(--c-ink-soft); }
  .refs h2 { font: 600 0.8rem var(--f-body); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: var(--space-2); }
  .refs ol { padding-left: 1.4em; margin: 0; }
  .refs li { padding-block: 2px; overflow-wrap: anywhere; }
  .refs a { display: inline-flex; align-items: center; min-height: 44px; }
  /* A term's other photos, two across under its first (the Design Lead's board, 16 Nov 2026: Lá bàng). */
  .others { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); max-width: var(--measure); margin-top: var(--space-3); }
  .others :global(figure) { margin: 0; }
  .others :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  /* One other photo: its caption in the half beside it, not a narrow column under it (the Design Lead, 16 Nov 2026). */
  .others.one { grid-template-columns: 1fr; }
  .others.one :global(figure) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-3); align-items: start; }
  .others.one :global(figcaption) { margin-top: 0; }
  /* The kinds as cards (the Design Lead's board, 16 Nov 2026): two across on a phone, three on a computer; a photo at 4:3,
     the name, the bracketed name, the one line. Those without a photo after, in words between hairlines. */
  .kinds { margin-top: var(--space-5); }
  .k-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); }
  .body .k-head h2 { margin-top: 0; }
  .k-count { font: 400 var(--step--1)/1.4 var(--f-body); color: var(--c-ink-faint); white-space: nowrap; }
  .k-cards, .k-words { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) var(--space-3); }
  .k-words { margin-top: var(--space-5); row-gap: 0; border-top: 1px solid var(--c-rule); }
  .k-words li { border-bottom: 1px solid var(--c-rule); }
  .k-words .k-card { padding-block: var(--space-3); }
  @media (min-width: 60rem) {
    .k-cards, .k-words { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-4); }
    .k-cards { row-gap: var(--space-6); }
  }
  .k-card { display: flex; flex-direction: column; min-height: 44px; color: var(--c-ink); text-decoration: none; }
  .k-card:hover .k-name { text-decoration: underline; }
  .k-pic { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--c-blackwater); border-radius: var(--radius-media); margin-bottom: var(--space-2); }
  .k-pic img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .k-pic :global(.k-ai), .kv-pic :global(.k-ai) { position: absolute; z-index: 1; padding: 3px 6px; border: 1px solid var(--c-rule); border-radius: var(--radius-media); background: var(--c-paper); color: var(--c-ink); font: 600 0.75rem/1.35 var(--f-body); }
  .k-name { font: 600 0.9375rem/1.35 var(--f-body); overflow-wrap: anywhere; }
  .k-aka { font: 400 var(--step--1)/1.4 var(--f-body); color: var(--c-ink-faint); overflow-wrap: anywhere; }
  .k-line { font: 400 0.875rem/1.45 var(--f-body); color: var(--c-ink-soft); margin-top: 2px; }
  /* A kind large: full screen on a phone, a panel on a computer; its count and ✕ on top, the kinds either side at its foot. */
  .k-view { padding: 0; border: 0; margin: 0; width: 100%; height: 100%; max-width: none; max-height: none; background: var(--c-paper); color: var(--c-ink); }
  /* Without the script, a card's link shows its view in place (:target). With it, the address's kind opens as a dialog and
     a closed one never shows: the page's address can still name it (:target doesn't follow history's entries). */
  .k-view[open], .kinds:not(.live) .k-view:target { display: flex; flex-direction: column; }
  .kinds:not(.live) .k-view:target:not([open]) { position: fixed; inset: 0; z-index: 60; }
  .k-view::backdrop { background: rgb(0 0 0 / 0.6); }
  @media (min-width: 60rem) {
    /* fit-content, as a modal's own: `auto` between its top and bottom stretches it to the whole height. */
    .k-view { width: min(760px, 100vw - 2 * var(--space-4)); height: fit-content; max-height: calc(100vh - 64px); margin: auto; box-shadow: 0 20px 60px rgb(0 0 0 / 0.35); }
    .kinds:not(.live) .k-view:target:not([open]) { inset: 32px 0 auto; margin: 0 auto; box-shadow: 0 0 0 100vmax rgb(0 0 0 / 0.6); }
    .kv-pic { max-height: 56vh; }
  }
  .kv-bar { flex: none; display: flex; align-items: center; justify-content: space-between; height: 52px; padding: 0 var(--space-2) 0 var(--space-4); }
  .kv-n { font: 400 var(--step--1)/1 var(--f-body); color: var(--c-ink-faint); }
  .kv-x { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: var(--c-ink); }
  .kv-body { flex: 1 1 auto; overflow: auto; }
  .kv-pic { position: relative; width: 100%; max-height: 62vh; background: var(--c-blackwater); }
  .kv-pic :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .kv-by { margin: 0; padding: var(--space-2) var(--space-4) 0; font: 400 var(--step--1)/1.5 var(--f-body); color: var(--c-ink-faint); }
  .kv-by :global(a) { color: var(--c-moss); }
  .k-view h3 { font: 450 var(--step-2)/1.2 var(--f-display); margin: var(--space-4) var(--space-4) 0; }
