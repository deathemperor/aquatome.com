---
import Browse from '../../layouts/Browse.astro'
import { getContent } from '../../lib/content'
import { fmt } from '../../lib/format'
import { i18n } from '../../lib/i18n'
import { alphabet, letterOf, termListing } from '../../lib/glossary-page'
const { t, lang } = i18n(Astro.url)
const { num } = fmt(lang)
const c = await getContent(lang)
const terms = [...c.glossary].sort((a, b) => a.t.name.localeCompare(b.t.name, lang))
// The Design Lead's board (14 Nov 2026): a search over the terms, an A to Z with each letter's count, a heading per
// letter, each meaning cut at two lines and how many pages use the term under it.
const letters = alphabet(lang, terms.map(g => g.t.name))
const groups = letters.filter(l => l.count).map(l => ({ ...l, terms: terms.filter(g => letterOf(lang, g.t.name) === l.letter) }))
const anchor = (letter: string) => `chu-${letter.toLocaleLowerCase(lang)}`
// What the search matches: the name, other names and English, without accents.
const fold = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').replace(/đ/gi, 'd').toLowerCase()
---
<Browse title={t('Thuật ngữ')} heading={t('Thuật ngữ')} intro={t('Giải thích các thuật ngữ thủy sinh, kèm tên tiếng Anh.')}>
  <div class="find">
    <input type="search" id="tm-find" placeholder={t('Tìm trong {n} thuật ngữ', { n: num(terms.length) })} aria-label={t('Tìm trong {n} thuật ngữ', { n: num(terms.length) })} autocomplete="off" />
  </div>
  <nav class="az" aria-label={t('Theo chữ cái')}>
    {letters.map(l => (l.count ? <a href={`#${anchor(l.letter)}`} lang={lang}>{l.letter}<small>{num(l.count)}</small></a> : <span class="no" aria-hidden="true">{l.letter}</span>))}
  </nav>
  <p class="none" hidden>{t('Không thấy thuật ngữ nào.')}</p>
  {groups.map(gr => (
    <section class="letter" aria-labelledby={anchor(gr.letter)}>
      <h2 id={anchor(gr.letter)}><span lang={lang}>{gr.letter}</span> <span class="n">· {num(gr.count)}</span></h2>
      <dl class="terms">
        {gr.terms.map(g => {
          const uses = termListing(lang, c, g).uses
          return (
            <div data-find={fold([g.t.name, ...g.t.altNames, g.en].join(' '))}>
              <dt><a href={`/vi/thuat-ngu/${g.t.slug}/`}>{g.t.name}</a> <span lang="en">{g.en}</span></dt>
              {g.t.definition && <dd>{g.t.definition}</dd>}
              {uses && <dd class="uses">{t('Dùng trong {n} trang', { n: num(uses) })}</dd>}
            </div>
          )
        })}
      </dl>
    </section>
  ))}
</Browse>
<script>
  // The search hides the terms that don't match, and a letter left with none; accents don't count.
  const input = document.querySelector<HTMLInputElement>('#tm-find')
  if (input) {
    const fold = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').replace(/đ/gi, 'd').toLowerCase().trim()
    const rows = [...document.querySelectorAll<HTMLElement>('[data-find]')]
    const sections = [...document.querySelectorAll<HTMLElement>('section.letter')]
    const none = document.querySelector<HTMLElement>('.none')!
    const run = () => {
      const q = fold(input.value)
      for (const r of rows) r.hidden = !!q && !r.dataset.find!.includes(q)
      for (const s of sections) s.hidden = !s.querySelector('[data-find]:not([hidden])')
      none.hidden = !q || rows.some(r => !r.hidden)
    }
    input.addEventListener('input', run)
    run()
  }
</script>
<style>
  .find input { box-sizing: border-box; width: 100%; max-width: var(--measure); height: 44px; padding: 0 12px; border: 1px solid var(--c-rule); border-radius: 0; background: var(--c-plate); color: var(--c-ink); font: 1rem var(--f-body); }
  .az { display: grid; grid-template-columns: repeat(auto-fill, 44px); gap: 6px; max-width: var(--measure); margin: var(--space-4) 0 var(--space-5); }
  .az a, .az span { position: relative; display: grid; place-items: center; height: 44px; border: 1px solid var(--c-rule); background: var(--c-plate); color: var(--c-ink); font: 500 1.15rem var(--f-display); text-decoration: none; }
  .az small { position: absolute; top: 2px; right: 4px; font: 0.62rem var(--f-body); color: var(--c-ink-faint); }
  .az .no { border-style: dashed; background: none; color: var(--c-ink-faint); opacity: 0.5; }
  .letter h2 { max-width: var(--measure); font: 500 var(--step-1) var(--f-display); margin: var(--space-5) 0 0; padding-bottom: var(--space-1); border-bottom: 2px solid var(--c-ink); }
  .letter h2 .n { font: 0.9rem var(--f-body); color: var(--c-ink-faint); }
  .terms { max-width: var(--measure); margin: 0; }
  .terms div { padding-block: var(--space-3); border-bottom: 1px dotted var(--c-rule); }
  dt a { font: 400 var(--step-1) var(--f-display); }
  dt span { font-size: 0.85rem; color: var(--c-ink-faint); margin-left: var(--space-2); }
  dd { margin: var(--space-1) 0 0; color: var(--c-ink-soft); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  dd.uses { display: block; font-size: 0.82rem; color: var(--c-ink-faint); }
  [hidden] { display: none !important; }
</style>
