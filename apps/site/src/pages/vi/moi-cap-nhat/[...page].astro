---
import Browse from '../../../layouts/Browse.astro'
import PageNav from '../../../components/PageNav.astro'
import { changelogEntries, KIND, PER } from '../../../lib/changelog'
import { getContent } from '../../../lib/content'
import { i18n, langOf } from '../../../lib/i18n'

export async function getStaticPaths({ routePattern }: { routePattern: string }) {
  const pages = Math.ceil(changelogEntries(await getContent(langOf(routePattern))).length / PER)
  return [{ params: { page: undefined } }, ...Array.from({ length: Math.max(pages - 1, 0) }, (_, i) => ({ params: { page: `trang/${i + 2}` } }))]
}
const { t, lang } = i18n(Astro.url)
const c = await getContent(lang)
const all = changelogEntries(c)
const n = Number(Astro.params.page?.split('/')[1] ?? 1)
const entries = all.slice((n - 1) * PER, n * PER)
const at = (k: number) => (k === 1 ? '/vi/moi-cap-nhat/' : `/vi/moi-cap-nhat/trang/${k}/`)
const fmt = (d: string) => d.split('-').reverse().join('/')
const title = n === 1 ? t('Mới cập nhật') : t('{name}, trang {n}', { name: t('Mới cập nhật'), n })
---
<Browse title={title} heading={title} crumbs={n === 1 ? [] : [['/vi/moi-cap-nhat/', t('Mới cập nhật')]]} intro={n === 1 ? t('Các trang vừa được thêm hoặc cập nhật theo nguồn gốc.') : undefined}>
  {entries.length === 0 ? <p>{t('Chưa có cập nhật nào.')}</p> : (
    <ol class="log" data-changelog>
      {entries.map(e => (
        <li>
          <time datetime={e.date}>{fmt(e.date)}</time>
          <span class="kind">{t(KIND[e.kind][1])}</span>
          <a href={e.href}>{e.name}</a>
          <span class="act">{e.action === 'new' ? t('Mới') : t('Cập nhật')} · {c.sources[e.source]?.name ?? e.source}</span>
        </li>
      ))}
    </ol>
  )}
  {all.length > PER && <PageNav prev={n > 1 ? at(n - 1) : undefined} next={n * PER < all.length ? at(n + 1) : undefined} />}
</Browse>
<style>
  .log { list-style: none; padding: 0; margin: 0; max-width: var(--measure); }
  .log li { display: grid; grid-template-columns: 6.5rem 6rem 1fr; gap: var(--space-1) var(--space-4); padding-block: var(--space-3); border-bottom: 1px solid var(--c-rule); align-items: baseline; }
  time, .kind, .act { font-size: var(--step--1); color: var(--c-ink-faint); }
  .act { grid-column: 3; }
  @media (max-width: 560px) { .log li { grid-template-columns: 1fr; } .act { grid-column: 1; } }
</style>
