---
import Browse from '../../../../layouts/Browse.astro'
import GuideCard from '../../../../components/GuideCard.astro'
import MoreList from '../../../../components/MoreList.astro'
import { getContent } from '../../../../lib/content'
import { creditsFor } from '../../../../lib/credits'
import { guideImages } from '../../../../lib/mentions'
import { pagePictures, takeEach } from '../../../../lib/pictures'
import { PAGE } from '../../../../scripts/filter-list'
import { seriesGuides, videoChannels, type Channel } from '../../../../lib/video'
import { i18n, langOf } from '../../../../lib/i18n'

export async function getStaticPaths({ routePattern }: { routePattern: string }) {
  const c = await getContent(langOf(routePattern))
  return videoChannels(c).map(ch => ({ params: { slug: ch.slug }, props: { ch } }))
}
const { ch } = Astro.props as { ch: Channel }
const { t, lang } = i18n(Astro.url)
const c = await getContent(lang)
// The channel's guides a page at a time (lib/list-data.ts guideLists: its guides, newest first), the rest from their data
// file and on numbered pages (/vi/video/kenh/<slug>/trang/2/…).
const first = ch.guides.slice(0, PAGE)
// Every picture once (lib/pictures.ts).
const covers = takeEach(pagePictures(c), ch.guides.length > PAGE ? first : ch.guides, g => guideImages(c, g))
const base = `/vi/video/kenh/${ch.slug}/`
---
<Browse title={t('Video của {name}', { name: ch.name })} heading={t('Video của {name}', { name: ch.name })} crumbs={[['/vi/video/', t('Video')]]}
  intro={t('Bài hướng dẫn AquaTome viết từ video của kênh {name}, kèm video gốc.', { name: ch.name })}
  noindex={!ch.guides.some(g => g.t.quality.indexable)} credits={creditsFor(covers.map(p => p ?? undefined))} creditsLater={ch.guides.length > PAGE}>
  <p class="meta"><a href={ch.url} rel="noopener">{t('Kênh {name} trên YouTube', { name: ch.name })}</a></p>
  {ch.series.length > 0 && (
    <section aria-labelledby="s-h">
      <h2 id="s-h">{t('Loạt bài')}</h2>
      <ul class="series">{ch.series.map(s => <li><a href={`/vi/video/${s.vi.slug}/`}>{s.vi.name}</a> <span>{t('{n} bài', { n: seriesGuides(c, s).length })}</span></li>)}</ul>
    </section>
  )}
  <section aria-labelledby="all-h">
    <h2 id="all-h">{t('Tất cả bài ({n})', { n: ch.guides.length })}</h2>
    {ch.guides.length > PAGE
      ? <MoreList kind="guides" src={`/data/${lang}/guides/video/kenh/${ch.slug}.json`} total={ch.guides.length} next={`${base}trang/2/`}><div class="grid">{first.map((g, i) => <GuideCard g={g} photo={covers[i]} />)}<template id="guide-card"><GuideCard g={ch.guides[0]!} template /></template></div></MoreList>
      : <div class="grid">{ch.guides.map((g, i) => <GuideCard g={g} photo={covers[i]} />)}</div>}
  </section>
</Browse>
<style>
  .meta { margin: 0 0 var(--space-5); font-size: 0.9rem; }
  section { margin-bottom: var(--space-7); }
  h2 { font-size: var(--step-2); border-bottom: 2px solid var(--c-ink); padding-bottom: var(--space-2); margin-bottom: var(--space-4); }
  .series { list-style: none; margin: 0; padding: 0; }
  .series li { padding-block: 6px; }
  .series span { color: var(--c-ink-faint); font-size: 0.85rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-6) var(--space-5); }
</style>
