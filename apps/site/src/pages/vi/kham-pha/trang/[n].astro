---
import Browse from '../../../../layouts/Browse.astro'
import GuideCard from '../../../../components/GuideCard.astro'
import PageNav from '../../../../components/PageNav.astro'
import { getContent } from '../../../../lib/content'
import { creditsFor } from '../../../../lib/credits'
import { guideListCovers, guideLists } from '../../../../lib/list-data'
import { PAGE } from '../../../../scripts/filter-list'
import { i18n, langOf } from '../../../../lib/i18n'

/**
 * The discovery notes' later pages, a page each (2, 3, …): what "Xem thêm" on /vi/kham-pha/ links to. That page adds
 * notes in place instead; these are for crawlers and readers without its script, so every note has a link to it.
 */
export async function getStaticPaths({ routePattern }: { routePattern: string }) {
  const pages = Math.ceil(guideLists(await getContent(langOf(routePattern))).get('kham-pha')!.length / PAGE)
  return Array.from({ length: Math.max(pages - 1, 0) }, (_, i) => ({ params: { n: String(i + 2) } }))
}
const n = Number(Astro.params.n)
const { t, lang } = i18n(Astro.url)
const c = await getContent(lang)
const all = guideLists(c).get('kham-pha')!
const pages = Math.ceil(all.length / PAGE)
const here = all.slice((n - 1) * PAGE, n * PAGE)
const name = t('Khám phá')
// The covers the list's cards show wherever they are built (lib/list-data.ts), none twice.
const covers = guideListCovers(c, 'kham-pha', all).slice((n - 1) * PAGE, n * PAGE)
---
<Browse title={t('{name}, trang {n}', { name, n })} heading={t('{name}, trang {n}', { name, n })} crumbs={[['/vi/kham-pha/', name]]} credits={creditsFor(covers.map(p => p ?? undefined))}>
  <div class="grid">{here.map((g, i) => <GuideCard g={g} photo={covers[i]} />)}</div>
  <PageNav prev={n === 2 ? '/vi/kham-pha/' : `/vi/kham-pha/trang/${n - 1}/`} next={n < pages ? `/vi/kham-pha/trang/${n + 1}/` : undefined} />
</Browse>
<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-6) var(--space-5); }
</style>
