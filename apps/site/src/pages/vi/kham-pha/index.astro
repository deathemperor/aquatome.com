---
import { guideImages } from '../../../lib/mentions'
import { gridPhotos, pagePictures, takeEach } from '../../../lib/pictures'
import Browse from '../../../layouts/Browse.astro'
import GuideCard from '../../../components/GuideCard.astro'
import MoreList from '../../../components/MoreList.astro'
import SpeciesGrid from '../../../components/SpeciesGrid.astro'
import { getContent } from '../../../lib/content'
import { creditsFor } from '../../../lib/credits'
import { guideLists } from '../../../lib/list-data'
import { PAGE } from '../../../scripts/filter-list'
import { i18n } from '../../../lib/i18n'
const { t, lang } = i18n(Astro.url)
const c = await getContent(lang)
// The discovery notes a page at a time: the rest from their data file, and on numbered pages (/vi/kham-pha/trang/2/…).
const discovery = guideLists(c).get('kham-pha')!
const first = discovery.slice(0, PAGE)
const recent = [...c.species].sort((a, b) => b.updatedAt.localeCompare(a.updatedAt)).slice(0, 8)
// Every picture once, in page order (lib/pictures.ts): the notes' covers, then the new fish.
const pics = pagePictures(c)
const shownNotes = discovery.length > PAGE ? first : discovery
const covers = takeEach(pics, shownNotes, g => guideImages(c, g))
const recentPhotos = gridPhotos(c, recent, pics)
---
<Browse title={t('Khám phá')} heading={t('Khám phá')} intro={t('Loài mới nhập, bể đẹp và những điều thú vị dưới mặt nước.')} credits={creditsFor([...covers, ...recentPhotos].map(p => p ?? undefined))} creditsLater={discovery.length > PAGE}>
  {discovery.length > PAGE
    ? <MoreList kind="guides" src={`/data/${lang}/guides/kham-pha.json`} total={discovery.length} next="/vi/kham-pha/trang/2/"><div class="grid">{first.map((g, i) => <GuideCard g={g} photo={covers[i]} />)}<template id="guide-card"><GuideCard g={discovery[0]!} template /></template></div></MoreList>
    : discovery.length > 0 && <div class="grid">{discovery.map((g, i) => <GuideCard g={g} photo={covers[i]} />)}</div>}
  <h2 class="h">{t('Mới cập nhật')}</h2>
  <SpeciesGrid species={recent} photos={recentPhotos} />
</Browse>
<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-6) var(--space-5); margin-bottom: var(--space-6); }
  .h { font-size: var(--step-2); border-bottom: 2px solid var(--c-ink); padding-bottom: var(--space-2); margin-bottom: var(--space-5); }
</style>
