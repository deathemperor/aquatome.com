---
import Browse from '../../../layouts/Browse.astro'
import { getContent } from '../../../lib/content'
import { toIndexItem } from '../../../lib/species-index'
import { jsonForScript } from '../../../lib/json'
import { VN_WATER } from '../../../lib/climate'
import { getTraits } from '../../../lib/traits'
import { SUBSTRATES } from '../../../scripts/calc'
import { EI_WEEK, SALTS } from '../../../scripts/ferts'
import { fmt } from '../../../lib/format'
import { i18n } from '../../../lib/i18n'

const { lang, t } = i18n(Astro.url)
const c = await getContent(lang)
const traits = await getTraits()
const index = c.species.map(s => toIndexItem(s, traits.get(s.id))).sort((a, b) => a.name.localeCompare(b.name, lang))
// The heater's default room temperature: unheated tank water in a northern Vietnamese winter; elsewhere a neutral 20 °C to change.
const room = lang === 'vi' ? VN_WATER.northWinter : 20
---
<Browse title={t('Công cụ')} heading={t('Công cụ')} intro={t('Kiểm tra cá nuôi chung, thả bao nhiêu con là vừa, tính thể tích bể, lượng nền cần mua, công suất sưởi và liều phân nước.')}>
  <section class="tool" id="nuoi-chung" aria-labelledby="tm-h">
    <h2 id="tm-h">{t('Nuôi chung được không? Thả bao nhiêu con?')}</h2>
    <p class="lead">{t('Chọn 1–6 loài và số con. Công cụ so nhiệt độ, pH, độ cứng, kích thước và tính cách, rồi ước mật độ cá theo kích thước bể ở mục dưới. Tính cách lấy từ nội dung hồ sơ; đọc thêm mục “Nuôi chung với con gì?” trong từng hồ sơ trước khi thả chung.')}</p>
    <form id="tm-form" class="row">
      <label class="grow">{t('Thêm loài')}
        <input id="tm-input" list="tm-list" placeholder={t('Gõ tên Việt hoặc tên khoa học')} autocomplete="off" />
      </label>
      <button type="submit">{t('Thêm')}</button>
    </form>
    <datalist id="tm-list">{index.map(i => <option value={i.name}>{i.scientificName}</option>)}</datalist>
    <ul id="tm-chosen" class="chips" aria-live="polite"></ul>
    <div id="tm-out" aria-live="polite"></div>
    <div id="st-out" aria-live="polite"></div>
  </section>

  <section class="tool" id="the-tich" aria-labelledby="vol-h">
    <h2 id="vol-h">{t('Bể bao nhiêu lít?')}</h2>
    <form id="vol-form" class="row">
      <label>{t('Dài (cm)')} <input name="l" type="number" inputmode="numeric" min="10" max="400" value="60" /></label>
      <label>{t('Rộng (cm)')} <input name="w" type="number" inputmode="numeric" min="10" max="200" value="30" /></label>
      <label>{t('Cao (cm)')} <input name="h" type="number" inputmode="numeric" min="10" max="200" value="36" /></label>
      <label>{t('Lọc (lít/giờ, không bắt buộc)')} <input name="flow" type="number" inputmode="numeric" min="0" max="20000" placeholder={t('vd. 600')} /></label>
    </form>
    <p id="vol-out" class="out" aria-live="polite"></p>
    <p class="note">{t('Bể lục giác, trụ tròn, bể góc, chữ L, hoặc cần biết kính dày bao nhiêu:')} <a href="/vi/cong-cu/the-tich-be/">{t('tính theo 12 kiểu bể →')}</a></p>
  </section>

  <section class="tool" id="nen" aria-labelledby="sub-h">
    <h2 id="sub-h">{t('Cần bao nhiêu nền?')}</h2>
    <p class="lead">{t('Dùng dài và rộng bể ở trên. Nền dốc từ trước ra sau trông sâu hơn và giữ rễ cây tốt hơn.')}</p>
    <form id="sub-form" class="row">
      <label>{t('Loại nền')}
        <select name="kind">{Object.entries(SUBSTRATES).map(([k, s]) => <option value={k}>{t(s.name)}</option>)}</select>
      </label>
      <label>{t('Dày phía trước (cm)')} <input name="front" type="number" inputmode="decimal" min="0" max="30" step="0.5" value="4" /></label>
      <label>{t('Dày phía sau (cm)')} <input name="back" type="number" inputmode="decimal" min="0" max="40" step="0.5" value="8" /></label>
    </form>
    <p id="sub-out" class="out" aria-live="polite"></p>
    <p class="note">{t('Bể thủy sinh: phân nền 4–5 cm phía trước, 7–10 cm phía sau; có thể lót 1–2 cm đá nham thạch bên dưới cho thoáng rễ (chọn “Đá nham thạch” để tính riêng lớp lót). Cát cho cá chuột, cá đáy: 3–5 cm là đủ.')}</p>
  </section>

  <section class="tool" id="suoi" aria-labelledby="heat-h">
    <h2 id="heat-h">{t('Cần sưởi bao nhiêu W?')}</h2>
    <p class="lead">{lang === 'vi' ? t('Dùng kích thước bể ở trên. Nhiệt độ phòng mặc định là nước bể mùa đông miền Bắc (khoảng {c}°C).', { c: room }) : t('Dùng kích thước bể ở trên. Nhập nhiệt độ nước bể lúc lạnh nhất ở chỗ bạn (mặc định {c}°C).', { c: room })}</p>
    <form id="heat-form" class="row">
      <label>{t('Nhiệt độ cần (°C)')} <input name="target" type="number" inputmode="numeric" min="15" max="35" value="26" /></label>
      <label>{t('Nhiệt độ phòng (°C)')} <input name="room" type="number" inputmode="numeric" min="0" max="40" value={room} /></label>
    </form>
    <p id="heat-out" class="out" aria-live="polite"></p>
    <p class="note">{t('Ước tính cho bể kính có nắp. Bể không nắp, đặt gần cửa sổ hoặc trong phòng có gió cần sưởi lớn hơn; bể dài trên 120 cm nên chia hai sưởi ở hai đầu.')}</p>
  </section>

  <section class="tool" id="phan-bon" aria-labelledby="fert-h">
    <h2 id="fert-h">{t('Châm phân nước: bao nhiêu ppm?')}</h2>
    <p class="lead">{t('Dùng thể tích nước của bể ở trên. Chọn muối phân và số gam mỗi lần châm; nếu pha thành dung dịch, nhập thêm lượng nước pha và số ml mỗi lần châm.')}</p>
    <form id="fert-form" class="row">
      <label class="grow">{t('Muối phân')}
        <select name="salt">{Object.entries(SALTS).map(([k, x]) => <option value={k}>{t(x.name)}</option>)}</select>
      </label>
      <label>{t('Số gam')} <input name="g" type="number" inputmode="decimal" min="0" max="1000" step="0.01" value="1" /></label>
      <label>{t('Pha với (ml nước, không bắt buộc)')} <input name="sol" type="number" inputmode="numeric" min="0" max="5000" placeholder={t('vd. 500')} /></label>
      <label>{t('Mỗi lần châm (ml)')} <input name="dose" type="number" inputmode="decimal" min="0" max="500" step="0.5" placeholder={t('vd. 10')} /></label>
    </form>
    <div id="fert-out" aria-live="polite"></div>
    <p class="note">{t('Mức EI (Estimative Index) mỗi tuần: NO₃ {no3} ppm, PO₄ {po4} ppm, K {k} ppm, Mg {mg} ppm, Fe {fe} ppm, chia 3 lần châm, thay 50% nước mỗi tuần. Đó là mức cho bể nhiều cây, đèn mạnh, có CO₂; bể ít cây, không CO₂ cần ít hơn nhiều. Châm phân đa lượng và vi lượng khác ngày.', { no3: EI_WEEK.NO3!, po4: EI_WEEK.PO4!, k: EI_WEEK.K!, mg: EI_WEEK.Mg!, fe: fmt(lang).num(EI_WEEK.Fe!) })}</p>
  </section>

  <section class="tool" id="den" aria-labelledby="light-h">
    <h2 id="light-h">{t('Đèn Chihiros: hẹn giờ, độ sáng')}</h2>
    <p class="lead">{t('Kết nối đèn Chihiros qua Bluetooth ngay trên trình duyệt: đặt lịch bật tắt mỗi ngày, chỉnh độ sáng từng màu, chỉnh giờ cho đèn.')} <a href="/vi/cong-cu/den-chihiros/">{t('Mở trang điều khiển đèn →')}</a></p>
  </section>

  <script type="application/json" id="species-index" set:html={jsonForScript(index)} />
</Browse>
<script>
  import type { SpeciesIndexItem } from '../../../scripts/filter'
  import { checkTankmates, TEMPERAMENT_LABELS } from '../../../scripts/tankmates'
  import { heaterWatts, substrate, tankVolume, type SubstrateKind } from '../../../scripts/calc'
  import { stocking } from '../../../scripts/stocking'
  import { EI_DOSES, EI_WEEK, gramsFor, MAIN, ppm, SALTS, type Ion, type SaltId } from '../../../scripts/ferts'
  import { cpath, ct } from '../../../scripts/ct'

  const items: SpeciesIndexItem[] = JSON.parse(document.getElementById('species-index')!.textContent!)
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T
  const fmt = (n: number, d = 1) => new Intl.NumberFormat(document.documentElement.lang, { maximumFractionDigits: d }).format(n)
  const esc = (s: string) => s.replace(/[&<>"']/g, ch => `&#${ch.charCodeAt(0)};`)
  const LABEL = { tempC: ct('Nhiệt độ'), ph: 'pH', gh: ct('Độ cứng (dGH)') } as const
  const unit = (f: keyof typeof LABEL) => (f === 'tempC' ? '°C' : '')
  const rng = (r: { min: number; max: number }) => (r.min === r.max ? fmt(r.min) : `${fmt(r.min)}–${fmt(r.max)}`)
  const num = (f: HTMLFormElement, k: string) => Number((f.elements.namedItem(k) as HTMLInputElement).value)

  // Tank-mates: chosen species and their numbers live in the URL (?ca=slug:6,slug:2) so a result can be shared.
  const params = new URLSearchParams(location.search)
  const counts = new Map<string, number>()
  let chosen: SpeciesIndexItem[] = (params.get('ca') ?? '').split(',').map(s => {
    const [slug, n] = s.split(':')
    const hit = items.find(i => i.slug === slug)
    if (hit && Number(n) > 0) counts.set(hit.slug, Math.min(200, Math.round(Number(n))))
    return hit
  }).filter((i): i is SpeciesIndexItem => !!i).slice(0, 6)
  const count = (c: SpeciesIndexItem) => counts.get(c.slug) ?? c.schoolMin ?? 1
  function renderTankmates() {
    const url = new URL(location.href)
    if (chosen.length) url.searchParams.set('ca', chosen.map(c => `${c.slug}:${count(c)}`).join(',')); else url.searchParams.delete('ca')
    history.replaceState(null, '', url)
    $('tm-chosen').innerHTML = chosen.map((c, i) => `<li><a href="${cpath(`/vi/ca/${c.slug}/`)}">${esc(c.name)}</a> <input type="number" inputmode="numeric" min="1" max="200" value="${count(c)}" data-qty="${i}" aria-label="${ct('Số con {name}', { name: esc(c.name) })}" /> <button type="button" data-rm="${i}" aria-label="${ct('Bỏ {name}', { name: esc(c.name) })}">×</button></li>`).join('')
    renderStocking()
    if (chosen.length < 2) { $('tm-out').innerHTML = chosen.length ? '' : `<p class="hint">${ct('Thêm loài cá bạn định nuôi.')}</p>`; return }
    const r = checkTankmates(chosen, ct)
    const cell = (c: SpeciesIndexItem, f: keyof typeof LABEL) => (c[f] ? `${rng(c[f]!)}${unit(f)}` : '—')
    const rows = chosen.map(c => `<tr><th scope="row"><a href="${cpath(`/vi/ca/${c.slug}/`)}">${esc(c.name)}</a></th>${r.params.map(p => `<td>${cell(c, p.field)}</td>`).join('')}<td>${c.sizeCm ? `${fmt(c.sizeCm)} cm` : '—'}</td><td>${c.temperament ? ct(TEMPERAMENT_LABELS[c.temperament]) : '—'}</td></tr>`)
    const verdict = r.params.map(p => `<td>${p.shared ? `<span class="ok">${rng(p.shared)}${unit(p.field)}</span>` : chosen.length - p.missing.length >= 2 ? `<span class="bad">${ct('Không có')}</span>` : `<span class="na">${ct('Thiếu dữ liệu')}</span>`}</td>`).join('')
      + `<td>${r.eats.length ? `<span class="bad">${ct('Chênh lệch lớn')}</span>` : `<span class="ok">${ct('Ổn')}</span>`}</td>`
      + `<td>${r.notes.some(n => n.level === 'bad') ? `<span class="bad">${ct('Xung đột')}</span>` : r.notes.some(n => n.level === 'warn') ? `<span class="bad">${ct('Cần lưu ý')}</span>` : chosen.every(c => c.temperament) ? `<span class="ok">${ct('Ổn')}</span>` : `<span class="na">${ct('Thiếu dữ liệu')}</span>`}</td>`
    const head = `<tr><th scope="col">${ct('Loài')}</th>${r.params.map(p => `<th scope="col">${LABEL[p.field]}</th>`).join('')}<th scope="col">${ct('Kích thước')}</th><th scope="col">${ct('Tính cách')}</th></tr>`
    const warn = [...r.eats.map(e => `<li>${ct('{big} ({bigCm} cm) có thể ăn {small} ({smallCm} cm).', { big: esc(e.big), bigCm: fmt(e.bigCm), small: esc(e.small), smallCm: fmt(e.smallCm) })}</li>`),
      ...r.notes.filter(n => n.level !== 'info').map(n => `<li>${esc(n.text)}</li>`)].join('')
    const info = r.notes.filter(n => n.level === 'info').map(n => `<li>${esc(n.text)}</li>`).join('')
    $('tm-out').innerHTML = `<div class="scroll"><table><thead>${head}</thead><tbody>${rows.join('')}</tbody><tfoot><tr><th scope="row">${ct('Khoảng chung')}</th>${verdict}</tr></tfoot></table></div>`
      + (warn ? `<ul class="warn">${warn}</ul>` : '')
      + (info ? `<ul class="info">${info}</ul>` : '')
      + (r.minTankCm ? `<p>${ct('Bể dài tối thiểu cho cả nhóm: <strong>{n} cm</strong>.', { n: fmt(r.minTankCm) })}</p>` : '')
  }
  $('tm-form').addEventListener('submit', e => {
    e.preventDefault()
    const input = $<HTMLInputElement>('tm-input')
    const q = input.value.trim().toLowerCase()
    const hit = items.find(i => i.name.toLowerCase() === q || i.scientificName.toLowerCase() === q) ?? items.find(i => `${i.name} ${i.scientificName}`.toLowerCase().includes(q))
    if (hit && !chosen.some(c => c.slug === hit.slug) && chosen.length < 6) chosen.push(hit)
    input.value = ''
    renderTankmates()
  })
  $('tm-chosen').addEventListener('input', e => {
    const q = (e.target as Element).closest<HTMLInputElement>('[data-qty]')
    const n = Math.round(Number(q?.value))
    if (q && n > 0) { counts.set(chosen[Number(q.dataset.qty)]!.slug, Math.min(200, n)); renderTankmates() }
  })
  $('tm-chosen').addEventListener('click', e => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-rm]')
    if (b) { chosen.splice(Number(b.dataset.rm), 1); renderTankmates() }
  })

  // Stocking: the chosen fish against the tank size and filter in the calculator below.
  const LEVEL = {
    light: [ct('Còn thưa'), ct('thả thêm được.')], ok: [ct('Vừa phải'), ct('bể ổn định với lọc và thay nước thường lệ.')],
    full: [ct('Đã đầy'), ct('cần lọc tốt và thay nước đều mỗi tuần.')], over: [ct('Quá tải'), ct('bớt cá hoặc dùng bể lớn hơn.')],
  } as const
  function renderStocking() {
    const v = $<HTMLFormElement>('vol-form')
    const [l, w, ht, flow] = [num(v, 'l'), num(v, 'w'), num(v, 'h'), num(v, 'flow')]
    if (!chosen.length || !(l > 0 && w > 0 && ht > 0)) { $('st-out').innerHTML = ''; return }
    const vol = tankVolume(l, w, ht)
    const r = stocking(chosen.map(c => ({ name: c.name, count: count(c), sizeCm: c.sizeCm, schoolMin: c.schoolMin, tankCm: c.tankCm })), vol.water, { tankCm: l, filterLph: flow, grossLitres: vol.litres })
    const [label, advice] = LEVEL[r.level]
    const notes = [
      ...r.school.map(s => ct('{name} sống theo đàn: nên nuôi từ {min} con (đang chọn {count}).', { name: esc(s.name), min: s.min, count: s.count })),
      ...r.tooShort.map(s => ct('{name} cần bể dài từ {n} cm.', { name: esc(s.name), n: fmt(s.tankCm) })),
      ...(r.unknown.length ? [ct('Chưa có kích thước của {names}: chưa tính vào mật độ.', { names: r.unknown.map(esc).join(', ') })] : []),
      ...(r.turnover === undefined ? [] : r.turnover < 4 ? [ct('Lọc chạy {n} lần thể tích bể mỗi giờ: hơi yếu, nên 4–10 lần.', { n: fmt(r.turnover) })] : r.turnover > 10 ? [ct('Lọc chạy {n} lần thể tích bể mỗi giờ: dòng mạnh, cá bơi yếu như betta, cá đuôi dài dễ bị cuốn.', { n: fmt(r.turnover) })] : []),
    ]
    $('st-out').innerHTML = `<h3>${ct('Mật độ cá')}</h3>`
      + `<div class="meter ${r.level}" role="img" aria-label="${fmt(r.percent, 0)}%"><span style="width:${Math.min(100, r.percent / 1.5)}%"></span><i style="left:${100 / 1.5}%"></i></div>`
      + `<p><strong>${fmt(r.percent, 0)}% · ${label}</strong>: ${advice} ${ct('Bể {l} × {w} × {h} cm, khoảng {water} lít nước.', { l: fmt(l), w: fmt(w), h: fmt(ht), water: fmt(vol.water, 0) })}</p>`
      + (r.perFish.length > 1 ? `<ul class="shares">${r.perFish.map(f => `<li>${esc(f.name)}: ${fmt(f.share * 100, 0)}%</li>`).join('')}</ul>` : '')
      + (notes.length ? `<ul class="warn">${notes.map(n => `<li>${n}</li>`).join('')}</ul>` : '')
      + `<p class="note">${ct('Ước theo kích thước cá trưởng thành (cá lớn thải nhiều hơn hẳn cá nhỏ), cho bể có lọc. Cây thủy sinh nhiều, thay nước thường xuyên thì nuôi được dày hơn một chút.')}</p>`
  }
  renderTankmates()

  // Calculators: recompute on every input; ?l=&w=&h= (cm) fills the tank size (links from the tank volume page).
  for (const k of ['l', 'w', 'h']) { const v = params.get(k); if (v) ($<HTMLFormElement>('vol-form').elements.namedItem(k) as HTMLInputElement).value = v }
  function renderCalc() {
    const v = $<HTMLFormElement>('vol-form'), h = $<HTMLFormElement>('heat-form')
    const [l, w, ht] = [num(v, 'l'), num(v, 'w'), num(v, 'h')]
    renderStocking()
    if (!(l > 0 && w > 0 && ht > 0)) { $('vol-out').textContent = ct('Nhập đủ dài, rộng, cao.'); $('heat-out').textContent = ''; return }
    const vol = tankVolume(l, w, ht)
    $('vol-out').innerHTML = ct('<strong>{litres} lít</strong> theo kích thước, thực tế khoảng <strong>{water} lít nước</strong> (≈ {water} kg, chưa tính kính, nền và đá).', { litres: fmt(vol.litres, 0), water: fmt(vol.water, 0) })
    const sf = $<HTMLFormElement>('sub-form')
    const [front, back] = [num(sf, 'front'), num(sf, 'back')]
    if (front >= 0 && back >= 0 && front + back > 0) {
      const sub = substrate(l, w, front, back, (sf.elements.namedItem('kind') as HTMLSelectElement).value as SubstrateKind)
      $('sub-out').innerHTML = ct('<strong>{litres} lít</strong> (khoảng {kg} kg) → mua <strong>{bags}</strong>.', { litres: fmt(sub.litres), kg: fmt(sub.kg), bags: sub.bags.map(b => ct('{n} bao {size} {unit}', { n: b.n, size: b.size, unit: b.unit === 'lít' ? ct('lít') : b.unit })).join(' + ') })
    } else $('sub-out').textContent = ct('Nhập độ dày nền.')
    renderFerts(vol.water)
    const heat = heaterWatts(l, w, ht, num(h, 'target'), num(h, 'room'))
    $('heat-out').innerHTML = heat.heater === 0 ? ct('Phòng đã đủ ấm, không cần sưởi.')
      : heat.heater === null ? ct('Cần khoảng {w} W: dùng nhiều sưởi cộng lại.', { w: fmt(heat.watts, 0) })
      : ct('Cần khoảng {w} W → chọn sưởi <strong>{heater} W</strong>.', { w: fmt(heat.watts, 0), heater: heat.heater })
  }
  const ION: Record<Ion, string> = { NO3: 'NO₃', N: 'N', PO4: 'PO₄', P: 'P', K: 'K', Mg: 'Mg', Ca: 'Ca', SO4: 'SO₄', Fe: 'Fe', Mn: 'Mn', B: 'B' }
  function renderFerts(water: number) {
    const f = $<HTMLFormElement>('fert-form')
    const salt = (f.elements.namedItem('salt') as HTMLSelectElement).value as SaltId
    const [g, sol, dose] = [num(f, 'g'), num(f, 'sol'), num(f, 'dose')]
    if (!(g > 0)) { $('fert-out').textContent = ct('Nhập số gam.'); return }
    const solution = sol > 0 && dose > 0 ? { solutionMl: sol, doseMl: dose } : undefined
    const r = ppm(salt, g, water, solution)
    const main = MAIN[salt]
    const ei = EI_WEEK[main]
    const want = ei === undefined ? undefined : gramsFor(salt, main, ei / EI_DOSES, water)
    const rows = (Object.keys(r) as Ion[]).map(ion => `<tr><th scope="row">${ION[ion]}</th><td>${fmt(r[ion]!, 2)}</td><td>${EI_WEEK[ion] === undefined ? '–' : fmt(EI_WEEK[ion]! / EI_DOSES, 2)}</td></tr>`).join('')
    $('fert-out').innerHTML = `<p>${solution ? ct('Mỗi lần châm {dose} ml dung dịch ({g} g trong {sol} ml) vào {water} lít nước:', { dose: fmt(dose), g: fmt(g, 2), sol: fmt(sol, 0), water: fmt(water, 0) }) : ct('{g} g thả thẳng vào {water} lít nước:', { g: fmt(g, 2), water: fmt(water, 0) })}</p>`
      + `<div class="scroll"><table><thead><tr><th scope="col">${ct('Chất')}</th><th scope="col">${ct('Thêm (ppm)')}</th><th scope="col">${ct('Mức EI mỗi lần (ppm)')}</th></tr></thead><tbody>${rows}</tbody></table></div>`
      + (want === undefined ? '' : `<p>${solution
        ? ct('Để thêm đúng mức EI mỗi lần ({target} ppm {ion}): châm khoảng <strong>{ml} ml</strong> dung dịch này.', { target: fmt(ei! / EI_DOSES, 2), ion: ION[main], ml: fmt((want * sol) / g) })
        : ct('Để thêm đúng mức EI mỗi lần ({target} ppm {ion}): khoảng <strong>{g} g</strong> {salt}.', { target: fmt(ei! / EI_DOSES, 2), ion: ION[main], g: fmt(want, 2), salt: SALTS[salt].formula })}</p>`)
  }
  for (const id of ['vol-form', 'sub-form', 'heat-form', 'fert-form']) { $(id).addEventListener('input', renderCalc); $(id).addEventListener('submit', e => e.preventDefault()) }
  renderCalc()
</script>
