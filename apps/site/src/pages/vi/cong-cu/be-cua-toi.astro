---
import Browse from '../../../layouts/Browse.astro'
import { i18n } from '../../../lib/i18n'
import { SUBSTRATE_LABELS } from '../../../scripts/my-tanks'

const { t } = i18n(Astro.url)
---
<Browse title={t('Bể của tôi: sổ ghi bể cá, cây và lịch đèn')} heading={t('Bể của tôi')} intro={t('Ghi lại từng bể: kích thước, nền, cá, cây và đèn với lịch đã đặt. Lưu ngay trên máy này, không cần đăng ký.')} crumbs={[['/vi/cong-cu/', t('Công cụ')]]} description={t('Sổ bể cá miễn phí: lưu kích thước, thể tích, loại nền, cá, cây, ghi chú và lịch đèn Chihiros của từng bể ngay trên trình duyệt, không cần tài khoản.')}>
  <div class="bar">
    <button id="mt-add" type="button" class="primary">{t('Thêm bể')}</button>
    <p class="where">{t('Lưu trên trình duyệt này.')} <a href="#du-lieu">{t('Dữ liệu ở đâu?')}</a></p>
  </div>

  <form id="mt-form" class="editor" hidden aria-labelledby="mt-form-h">
    <h2 id="mt-form-h" class="visually-hidden">{t('Thông tin bể')}</h2>
    <label class="wide">{t('Tên bể')} <input name="name" maxlength="80" required autocomplete="off" placeholder={t('Ví dụ: Bể 60 phòng khách')} /></label>
    <fieldset class="size">
      <legend>{t('Kích thước lòng bể (cm)')}</legend>
      <label>{t('Dài')} <input name="l" type="number" inputmode="decimal" min="1" max="1000" step="any" /></label>
      <span aria-hidden="true">×</span>
      <label>{t('Rộng')} <input name="w" type="number" inputmode="decimal" min="1" max="1000" step="any" /></label>
      <span aria-hidden="true">×</span>
      <label>{t('Cao')} <input name="h" type="number" inputmode="decimal" min="1" max="1000" step="any" /></label>
      <output name="litres" aria-live="polite"></output>
    </fieldset>
    <label>{t('Nền')}
      <select name="substrate">
        <option value="">{t('Chưa chọn')}</option>
        {Object.entries(SUBSTRATE_LABELS).map(([v, label]) => <option value={v}>{t(label)}</option>)}
      </select>
    </label>
    <label class="wide">{t('Ghi chú')} <textarea name="notes" rows="3" maxlength="4000" placeholder={t('Lịch thay nước, phân bón, CO₂…')}></textarea></label>
    <p class="err" id="mt-err" role="alert" hidden></p>
    <div class="acts">
      <button type="submit" class="primary">{t('Lưu bể')}</button>
      <button type="button" class="quiet" id="mt-cancel">{t('Hủy')}</button>
    </div>
  </form>

  <p id="mt-loading" class="hint">{t('Đang mở các bể đã lưu…')}</p>
  <noscript><p class="hint">{t('Trang này cần JavaScript để lưu bể trên máy bạn.')}</p></noscript>
  <ol id="mt-list" class="tanks" aria-label={t('Các bể đã lưu')}></ol>

  <div id="mt-empty" class="empty" hidden>
    <svg viewBox="0 0 240 150" aria-hidden="true">
      <path class="glass" d="M20 30 H220 V130 H20 Z" />
      <path class="water" d="M24 52 C64 46 92 58 120 52 S184 46 216 52 V126 H24 Z" />
      <path class="ground" d="M24 126 C70 112 100 118 140 114 S200 110 216 116 V126 Z" />
      <path class="lid" d="M14 24 H226" />
    </svg>
    <h2>{t('Chưa có bể nào')}</h2>
    <p>{t('Thêm bể đầu tiên để ghi lại kích thước, nền, cá, cây và ghi chú. Đèn Chihiros bạn kết nối cũng được lưu vào đây cùng lịch đã đặt.')}</p>
    <p class="row"><button type="button" class="primary" data-add>{t('Thêm bể đầu tiên')}</button> <a href="/vi/cong-cu/den-chihiros/">{t('Kết nối đèn Chihiros →')}</a></p>
  </div>

  <section id="du-lieu" class="data" aria-labelledby="data-h">
    <h2 id="data-h">{t('Dữ liệu ở đâu?')}</h2>
    <p>{t('Các bể chỉ nằm trong trình duyệt này, trên máy này: không gửi đi đâu. Xóa dữ liệu trình duyệt hoặc dùng chế độ ẩn danh thì mất. Tải bản sao để giữ lại.')}</p>
    <p><button id="mt-export" type="button" class="quiet">{t('Tải bản sao (JSON)')}</button></p>
  </section>
</Browse>

<script>
  import type { Device, Tank, TankStore } from '@aq/schema'
  import { tankLitres } from '@aq/schema/tank-rules'
  import * as store from '../../../scripts/tank-store'
  import { channelsOf, dayPicture, esc, facts } from '../../../scripts/my-tanks'
  import { cpath, ct } from '../../../scripts/ct'

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T
  const lang = document.documentElement.lang
  const num = (n: number, digits = 1) => new Intl.NumberFormat(lang, { maximumFractionDigits: digits }).format(n)
  const day = (iso: string) => new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'numeric', year: 'numeric' }).format(new Date(iso))
  const form = $<HTMLFormElement>('mt-form')
  const list = $<HTMLOListElement>('mt-list')
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement
  const home = form.parentElement!
  let db: TankStore = store.load()
  let editing: string | undefined | null = null // null: no form; undefined: a new tank; a string: that tank

  // Page names of the species and plants on the tanks, from the handbook index (fetched only when a tank has any).
  let names: Map<string, { name: string; path: string }> | undefined
  async function loadNames() {
    if (names || !store.liveTanks(db).some(t => t.species.length || t.plants.length)) return
    try {
      const r = await fetch(`/app/${lang.slice(0, 2)}.json`)
      const idx = (await r.json()) as { items: { id?: string; name: string; path: string }[] }
      names = new Map(idx.items.flatMap(i => (i.id ? [[i.id, { name: i.name, path: i.path }] as const] : [])))
      render()
    } catch { /* names stay ids */ }
  }

  function lightHtml(d: Device): string {
    const active = store.activeSchedule(d) ?? d.schedules?.[0]
    const title = esc(d.nickname ?? d.model ?? ct('Đèn'))
    const sub = [d.brand === 'chihiros' ? 'Chihiros' : d.brand, d.nickname ? d.model : undefined].filter(Boolean).join(' ')
    let body = `<p class="hint">${ct('Chưa lưu lịch nào cho đèn này.')}</p>`
    if (active) {
      const p = dayPicture(active, channelsOf(d))
      const hours = num(p.hours)
      body = `<figure class="day">
          <svg viewBox="0 0 1440 48" preserveAspectRatio="none" role="img" aria-label="${esc(ct('Bật {on}, tắt {off}', { on: active.on, off: active.off }))}"><path d="${p.path}" style="fill:${p.colour}" /></svg>
          <div class="ticks" aria-hidden="true"><span>0</span><span>6</span><span>12</span><span>18</span><span>24</span></div>
        </figure>
        <p class="sched"><strong>${active.on} → ${active.off}</strong> · ${ct('{h} tiếng', { h: hours })}${active.ramp ? ` · ${ct('sáng dần {m} phút', { m: active.ramp })}` : ''}${active.name ? ` · ${esc(active.name)}` : ''}</p>`
    }
    const extra = [
      d.manual ? ct('Chỉnh tay lần cuối: {levels}', { levels: d.manual.levels.map(l => `${l}%`).join(' · ') }) : '',
      d.clockSyncedAt ? ct('Chỉnh giờ đèn: {date}', { date: day(d.clockSyncedAt) }) : '',
      (d.schedules?.length ?? 0) > 1 ? ct('{n} lịch đã lưu', { n: d.schedules!.length }) : '',
    ].filter(Boolean)
    return `<li class="light">
        <p class="light-name"><strong>${title}</strong>${sub ? ` <span>${esc(sub)}</span>` : ''}</p>
        ${body}
        ${extra.length ? `<p class="meta">${extra.map(esc).join(' · ')}</p>` : ''}
        ${d.brand === 'chihiros' ? `<p><a href="${cpath('/vi/cong-cu/den-chihiros/')}">${ct('Áp dụng lịch trên trang đèn →')}</a></p>` : ''}
      </li>`
  }

  function lifeHtml(t: Tank): string {
    const label = (id: string) => names?.get(id)
    const chip = (id: string, count?: number) => {
      const n = label(id)
      const text = esc(n?.name ?? id.replace(/-/g, ' '))
      return `<li>${n ? `<a href="${esc(n.path)}">${text}</a>` : text}${count ? ` <span class="count">× ${num(count, 0)}</span>` : ''}</li>`
    }
    const parts: string[] = []
    if (t.species.length) parts.push(`<div class="life"><h3>${ct('Cá và tép')}</h3><ul class="chips">${t.species.map(s => chip(s.id, s.count)).join('')}</ul></div>`)
    if (t.plants.length) parts.push(`<div class="life"><h3>${ct('Cây')}</h3><ul class="chips">${t.plants.map(p => chip(p.id)).join('')}</ul></div>`)
    return parts.join('')
  }

  function tankHtml(t: Tank, lights: Device[]): string {
    const line = facts(t, ct, num)
    return `<li class="tank" id="be-${t.id}" data-id="${t.id}">
        <div class="tank-head">
          <h2>${esc(t.name)}</h2>
          <div class="tank-acts">
            <button type="button" class="quiet" data-edit aria-label="${esc(ct('Sửa {name}', { name: t.name }))}">${ct('Sửa')}</button>
            <button type="button" class="quiet danger" data-del aria-label="${esc(ct('Xóa {name}', { name: t.name }))}">${ct('Xóa')}</button>
          </div>
        </div>
        ${line.length ? `<p class="facts">${line.map(esc).join('<span aria-hidden="true"> · </span>')}</p>` : `<p class="facts hint">${ct('Chưa có kích thước.')} <button type="button" class="link" data-edit>${ct('Thêm kích thước')}</button></p>`}
        ${lights.length ? `<div class="lights"><h3>${ct('Đèn')}</h3><ul>${lights.map(lightHtml).join('')}</ul></div>` : ''}
        ${lifeHtml(t)}
        ${t.notes ? `<p class="notes">${esc(t.notes)}</p>` : ''}
        <p class="stamp">${ct('Sửa lần cuối {date}', { date: day(t.updatedAt) })}</p>
      </li>`
  }

  function render() {
    $('mt-loading').hidden = true
    const tanks = store.liveTanks(db).sort((a, b) => (a.createdAt < b.createdAt ? -1 : 1))
    const devices = store.liveDevices(db)
    // The form is kept out of the list while it is redrawn, then put back where it was being used.
    home.insertBefore(form, $('mt-loading'))
    list.innerHTML = tanks.map(t => tankHtml(t, devices.filter(d => d.tankId === t.id))).join('')
    $('mt-empty').hidden = tanks.length > 0 || editing === undefined
    if (typeof editing === 'string') document.getElementById(`be-${editing}`)?.append(form)
    void loadNames()
  }

  function open(id?: string) {
    editing = id
    const t = id ? store.liveTanks(db).find(x => x.id === id) : undefined
    form.reset()
    field('name').value = t?.name ?? ''
    field('l').value = t?.dims ? String(t.dims.l) : ''
    field('w').value = t?.dims ? String(t.dims.w) : ''
    field('h').value = t?.dims ? String(t.dims.h) : ''
    ;(form.elements.namedItem('substrate') as HTMLSelectElement).value = t?.substrate ?? ''
    ;(form.elements.namedItem('notes') as HTMLTextAreaElement).value = t?.notes ?? ''
    $('mt-err').hidden = true
    form.hidden = false
    $('mt-add').hidden = true
    render()
    preview()
    field('name').focus()
  }
  function close() {
    const was = editing
    editing = null
    form.hidden = true
    $('mt-add').hidden = false
    render()
    if (typeof was === 'string') (document.querySelector(`#be-${was} [data-edit]`) as HTMLElement | null)?.focus()
  }

  function dims(): { l: number; w: number; h: number } | 'partial' | undefined {
    const v = ['l', 'w', 'h'].map(k => field(k).value.trim())
    if (v.every(x => x === '')) return undefined
    const n = v.map(Number)
    if (v.some(x => x === '') || n.some(x => !(x > 0 && x <= 1000))) return 'partial'
    return { l: n[0]!, w: n[1]!, h: n[2]! }
  }
  function preview() {
    const d = dims()
    const out = form.elements.namedItem('litres') as HTMLOutputElement
    out.value = d && d !== 'partial' ? `= ${ct('{n} lít', { n: num(tankLitres({ dims: d })!, 1) })}` : ''
  }

  form.addEventListener('input', preview)
  form.addEventListener('submit', e => {
    e.preventDefault()
    const name = field('name').value.trim()
    const d = dims()
    const err = !name ? ct('Đặt tên cho bể.') : d === 'partial' ? ct('Nhập đủ dài, rộng, cao (từ 1 đến 1.000 cm), hoặc để trống cả ba.') : ''
    $('mt-err').textContent = err
    $('mt-err').hidden = !err
    if (err) return
    db = store.load()
    if (editing === undefined && store.liveTanks(db).length >= 50) { $('mt-err').textContent = ct('Đã đủ 50 bể: xóa bớt bể cũ để thêm.'); $('mt-err').hidden = false; return }
    const t = store.putTank(db, {
      name,
      dims: d === 'partial' ? undefined : d,
      substrate: (form.elements.namedItem('substrate') as HTMLSelectElement).value || undefined,
      notes: (form.elements.namedItem('notes') as HTMLTextAreaElement).value.trim() || undefined,
    }, editing ?? undefined)
    store.save(db)
    close()
    document.getElementById(`be-${t.id}`)?.scrollIntoView({ block: 'nearest' })
  })
  $('mt-cancel').addEventListener('click', close)
  form.addEventListener('keydown', e => { if (e.key === 'Escape') close() })
  $('mt-add').addEventListener('click', () => open())
  $('mt-empty').addEventListener('click', e => { if ((e.target as HTMLElement).closest('[data-add]')) open() })
  list.addEventListener('click', e => {
    const el = e.target as HTMLElement
    const id = el.closest<HTMLElement>('.tank')?.dataset.id
    if (!id || el.closest('form')) return
    if (el.closest('[data-edit]')) open(id)
    if (el.closest('[data-del]')) {
      const t = store.liveTanks(db).find(x => x.id === id)
      const lights = store.liveDevices(db).filter(d => d.tankId === id).length
      if (!t || !confirm(lights ? ct('Xóa bể “{name}” cùng {n} đèn đã lưu trên bể?', { name: t.name, n: lights }) : ct('Xóa bể “{name}”?', { name: t.name }))) return
      db = store.load()
      store.removeTank(db, id)
      store.save(db)
      render()
    }
  })
  $('mt-export').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(store.load(), null, 2)], { type: 'application/json' })
    const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(blob), download: `aquatome-be-${new Date().toISOString().slice(0, 10)}.json` })
    a.click()
    setTimeout(() => URL.revokeObjectURL(a.href), 1000)
  })

  // Another tab (the light page, or this page) changed the store: show it, unless a form here is open.
  const changed = () => { db = store.load(); if (editing === null) render() }
  window.addEventListener('storage', e => { if (e.key === store.KEY) changed() })
  try { new BroadcastChannel(store.KEY).onmessage = changed } catch { /* storage events still come */ }
  render()
</script>

<style>
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); margin-bottom: var(--space-5); }
  .where { margin: 0; color: var(--c-ink-soft); font-size: var(--step--1); }
  /* Global: the script draws the tanks' buttons, which scoped styles don't reach. */
  :global(:is(.bar, .editor, .empty, .data, .tank) button) { font: 500 1rem var(--f-body); padding: 0.6rem 1.15rem; border-radius: 8px; cursor: pointer; border: 1px solid transparent; min-height: 44px; transition: background-color 0.15s, border-color 0.15s, color 0.15s; }
  :global(:is(.bar, .editor, .empty, .data, .tank) button.primary) { background: var(--c-ink); color: var(--c-paper); }
  :global(:is(.bar, .editor, .empty, .data, .tank) button.primary:hover) { background: var(--c-moss); }
  :global(:is(.bar, .editor, .empty, .data, .tank) button.quiet) { background: none; color: var(--c-ink); border-color: var(--c-rule); }
  :global(:is(.bar, .editor, .empty, .data, .tank) button.quiet:hover) { border-color: var(--c-ink); }
  .editor[hidden] { display: none; }
  :global(.tank button.danger:hover) { color: var(--c-cardinal); border-color: var(--c-cardinal); }
  :global(.tank button.link) { min-height: 0; padding: 0; border: 0; background: none; color: var(--c-ink); text-decoration: underline; text-underline-offset: 3px; font: inherit; }
  :global(:is(.bar, .editor, .empty, .data, .tank) :is(button, input, select, textarea, a):focus-visible) { outline: 2px solid var(--c-focus); outline-offset: 2px; }

  .editor { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr)); min-width: 0; box-sizing: border-box; gap: var(--space-4) var(--space-5); padding: var(--space-5); background: var(--c-plate); border: 1px solid var(--c-rule); margin: var(--space-3) 0 var(--space-6); max-width: 48rem; }
  .editor .wide, .editor .size, .editor .acts, .editor .err { grid-column: 1 / -1; }
  .editor label { display: grid; gap: var(--space-1); font-size: 0.85rem; color: var(--c-ink-soft); }
  .editor input, .editor select, .editor textarea { box-sizing: border-box; max-width: 100%; min-width: 0; font: inherit; font-size: 1rem; color: var(--c-ink); padding: 0.5rem 0.65rem; border: 1px solid var(--c-rule); border-radius: 8px; background: var(--c-mat); min-height: 44px; }
  .editor textarea { resize: vertical; line-height: 1.5; }
  .size { display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-2) var(--space-3); border: 0; padding: 0; margin: 0; min-inline-size: 0; }
  .size legend { font-size: 0.85rem; color: var(--c-ink-soft); padding: 0; margin-bottom: var(--space-1); }
  .size input { width: 6.5rem; font-variant-numeric: tabular-nums; }
  .size > span { padding-bottom: 0.7rem; color: var(--c-ink-faint); }
  .size output { padding-bottom: 0.65rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .acts { display: flex; gap: var(--space-3); }
  .err { margin: 0; color: var(--c-cardinal); }
  .hint { color: var(--c-ink-faint); }

  .tanks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-7); max-width: 56rem; }
  :global(.tank) { border-top: 2px solid var(--c-ink); padding-top: var(--space-4); min-width: 0; }
  :global(.tank .editor) { margin: var(--space-4) 0 0; }
  :global(.tank-head) { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-4); }
  :global(.tank h2) { font: 600 var(--step-3) / 1.15 var(--f-display); letter-spacing: -0.01em; margin: 0; text-wrap: balance; overflow-wrap: anywhere; }
  :global(.tank-acts) { display: flex; gap: var(--space-2); }
  :global(.tank-acts button) { padding: 0.4rem 0.9rem; font-size: 0.9rem; }
  :global(.tank .facts) { margin: var(--space-2) 0 0; font-size: var(--step-1); font-variant-numeric: tabular-nums; color: var(--c-ink-soft); }
  :global(.tank h3) { font: 600 var(--step-0) var(--f-body); color: var(--c-ink); margin: var(--space-5) 0 var(--space-2); }
  :global(.tank .lights ul) { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  :global(.light p) { margin: 0 0 var(--space-1); }
  :global(.light-name span) { color: var(--c-ink-faint); font-size: var(--step--1); margin-left: var(--space-1); }
  :global(.light .day) { margin: var(--space-2) 0; max-width: 32rem; }
  :global(.light .day svg) { display: block; width: 100%; height: 3rem; background: repeating-linear-gradient(90deg, transparent 0 calc(25% - 1px), var(--c-rule) calc(25% - 1px) 25%), var(--c-blackwater); border-radius: 4px; }
  :global(.light .ticks) { display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--c-ink-faint); font-variant-numeric: tabular-nums; margin-top: 2px; }
  :global(.light .sched) { font-variant-numeric: tabular-nums; }
  :global(.light .meta) { color: var(--c-ink-faint); font-size: var(--step--1); }
  :global(.chips) { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; }
  :global(.chips li) { border: 1px solid var(--c-rule); padding: 0.25rem 0.7rem; border-radius: 999px; font-size: 0.9rem; background: var(--c-plate); }
  :global(.chips .count) { color: var(--c-ink-faint); font-variant-numeric: tabular-nums; }
  :global(.tank .notes) { font-family: var(--f-display); font-style: italic; font-size: var(--step-1); max-width: var(--measure); white-space: pre-line; margin: var(--space-5) 0 0; color: var(--c-ink); }
  :global(.tank .stamp) { margin: var(--space-4) 0 0; font-size: var(--step--1); color: var(--c-ink-faint); }

  .empty { max-width: 34rem; padding: var(--space-6) 0; }
  .empty svg { width: 12rem; height: auto; display: block; margin-bottom: var(--space-4); }
  .empty .glass { fill: none; stroke: var(--c-ink); stroke-width: 2.5; }
  .empty .lid { stroke: var(--c-ink); stroke-width: 4; }
  .empty .water { fill: color-mix(in srgb, var(--c-moss) 14%, transparent); }
  .empty .ground { fill: color-mix(in srgb, var(--c-cardinal) 35%, transparent); }
  .empty h2 { font: 600 var(--step-2) var(--f-display); margin: 0 0 var(--space-2); }
  .empty p { color: var(--c-ink-soft); }
  .row { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); align-items: center; }

  .data { margin-top: var(--space-8); padding-top: var(--space-4); border-top: 1px solid var(--c-rule); max-width: var(--measure); }
  .data h2 { font-size: var(--step-1); }
