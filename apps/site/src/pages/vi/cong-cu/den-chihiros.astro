---
import Browse from '../../../layouts/Browse.astro'
import { getContent } from '../../../lib/content'
import { SUPPORTED } from '../../../scripts/chihiros'
import { i18n } from '../../../lib/i18n'

const { lang, t } = i18n(Astro.url)
const c = await getContent(lang)
// Guides to link when this language has them.
const guide = (id: string) => c.guides.find(g => g.id === id)
const hours = guide('youtube-H-A6KwMSa9s')
const algae = guide('aquatome-reu-hai-trong-be-thuy-sinh-nhan-biet-tung-loai-reu-va-cach-diet')
const choose = guide('aquariumcoop-blogs-aquarium-how-to-pick-the-best-planted-aquarium-light')
const product = c.products.find(p => p.id === 'chihiros-wrgb-ii')

// Planted-tank starting points: 6–8 hours a day at a fixed time, less and dimmer while a tank is new or fighting algae.
const PRESETS = [
  { name: t('Bể mới trồng'), why: t('2–4 tuần đầu: ít giờ, đèn nhẹ để rêu khó bám.'), on: '13:00', off: '19:00', level: 40 },
  { name: t('Bể đã ổn định'), why: t('Cây đã bén rễ, có phân và CO₂ đều.'), on: '12:00', off: '20:00', level: 70 },
  { name: t('Bể đang bị rêu'), why: t('1–2 tuần, kèm thay nước, vệ sinh.'), on: '14:00', off: '20:00', level: 50 },
  { name: t('Bể cá, không trồng cây'), why: t('Đủ để ngắm cá, ít rêu.'), on: '12:00', off: '20:00', level: 40 },
]
// Colour mixes, as shares of the brightest channel (red, green, blue, white).
const LOOKS = [
  { id: 'natural', name: t('Tự nhiên'), mix: [1, 1, 1, 1] },
  { id: 'red', name: t('Cây đỏ rực'), mix: [1, 0.8, 0.75, 0.8] },
  { id: 'cool', name: t('Nước trong, mát'), mix: [0.7, 0.85, 1, 0.9] },
  { id: 'warm', name: t('Ấm, dịu mắt'), mix: [1, 0.8, 0.5, 0.7] },
]
const RAMPS = [0, 10, 15, 20, 30, 45, 60, 90, 120, 150]
const faq = [
  { q: t('Điều khiển đèn Chihiros không cần ứng dụng được không?'), a: t('Được. Trang này gửi qua Bluetooth các lệnh giống ứng dụng My Chihiros, chạy trên Chrome hoặc Edge (Android, Windows, macOS, Linux). iPhone và iPad cần trình duyệt Bluefy, vì Safari không hỗ trợ Bluetooth trên web.') },
  { q: t('Đèn Chihiros nào dùng được?'), a: t('Các đèn Bluetooth có tên bắt đầu bằng DY: {list}. Chưa hỗ trợ X300, Z Light Tiny, Egg và Commander 1 vì các đèn này chia kênh màu khác.', { list: SUPPORTED.join(', ') }) },
  { q: t('Nên bật đèn bể thủy sinh mấy tiếng mỗi ngày?'), a: t('Khoảng 6 đến 8 tiếng, cùng một khung giờ mỗi ngày. Bể mới trồng nên bắt đầu 6 tiếng, đèn 40–50%, rồi tăng dần khi cây đã bén rễ. Bật quá 8 tiếng, hoặc đèn mạnh mà thiếu CO₂ và phân, dễ lên rêu.') },
  { q: t('Trang có nhớ lịch của đèn không?'), a: t('Có, trên máy này. Mỗi lần ghi lịch, trang nhớ đèn, tên bạn đặt và các lịch đã ghi, để lần sau mở lại, dùng lại hoặc hoàn tác. Đèn không cho đọc lại lịch đang lưu bên trong nó, nên lịch đặt bằng ứng dụng My Chihiros không hiện ở đây. Đèn cho đọc giờ của nó: trang báo khi đèn lệch giờ, chẳng hạn sau khi mất điện.') },
  { q: t('Đèn có bị hỏng hay mất cài đặt không?'), a: t('Trang chỉ gửi lệnh chỉnh độ sáng, giờ và lịch, không đụng tới firmware. Ghi lịch mới sẽ thay lịch cũ trên đèn; muốn quay lại cài đặt cũ thì đặt lại bằng ứng dụng My Chihiros.') },
  { q: t('Không thấy đèn trong danh sách?'), a: t('Bật Bluetooth trên máy và lại gần đèn. Đóng ứng dụng My Chihiros trên các điện thoại khác: mỗi lúc đèn chỉ nhận một kết nối. Trên Android, cho phép Chrome dùng thiết bị ở gần (hoặc vị trí, với Android cũ).') },
]
const jsonld = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]
const HOURS = [0, 3, 6, 9, 12, 15, 18, 21, 24]
---
<Browse title={t('Điều khiển đèn Chihiros trên trình duyệt: hẹn giờ, độ sáng')} heading={t('Đèn Chihiros')} intro={t('Hẹn giờ bật tắt có sáng dần, tối dần, pha màu và chỉnh giờ cho đèn Chihiros qua Bluetooth, ngay trên trình duyệt, không cần cài ứng dụng. Trang nhớ đèn và lịch của bạn trên máy này.')} crumbs={[['/vi/cong-cu/', t('Công cụ')]]} description={t('Điều khiển đèn thủy sinh Chihiros (WRGB II, Slim, Pro, A II, C II, Universal) qua Bluetooth trên Chrome: đặt lịch bật tắt có sáng dần, tối dần, chỉnh độ sáng từng màu, lịch mẫu cho bể mới và bể bị rêu.')} jsonld={jsonld}>
  <div class="app">
    <div class="side">
      <section id="ch-light" class="card" aria-labelledby="light-h" data-state="idle">
        <h2 id="light-h" class="visually-hidden">{t('Đèn của bạn')}</h2>
        <!-- Without Bluetooth (Safari, Firefox): what works, and that planning still does. -->
        <div id="ch-unsupported" class="state" hidden>
          <p class="title">{t('Trình duyệt này chưa kết nối được đèn')}</p>
          <p>{t('Dùng Chrome hoặc Edge trên điện thoại Android hay máy tính. Trên iPhone, iPad: trình duyệt Bluefy.')}</p>
          <p class="soft">{t('Vẫn lập lịch được ở dưới: trang nhớ lịch trên máy này để ghi vào đèn sau.')}</p>
        </div>
        <div id="ch-idle" class="state">
          <p class="title" id="ch-idle-title">{t('Kết nối đèn của bạn')}</p>
          <ol id="ch-howto" class="howto">
            <li>{t('Cắm điện, bật đèn.')}</li>
            <li>{t('Bật Bluetooth, đứng gần đèn.')}</li>
            <li>{t('Đóng ứng dụng My Chihiros trên các điện thoại khác: đèn chỉ nhận một kết nối.')}</li>
          </ol>
          <ul id="ch-known" class="known" hidden></ul>
          <div class="row">
            <button id="ch-connect" type="button" class="primary">{t('Kết nối đèn')}</button>
          </div>
        </div>
        <div id="ch-busy" class="state" hidden>
          <p class="title" id="ch-busy-text">{t('Đang kết nối…')}</p>
          <div class="bar" aria-hidden="true"><span></span></div>
        </div>
        <div id="ch-ready" class="state" hidden></div>
        <p id="ch-status" class="status" role="status" aria-live="polite"></p>
      </section>

      <figure class="tank" aria-labelledby="tank-cap">
        <svg viewBox="0 0 320 190" role="img" aria-labelledby="tank-cap" id="ch-tank" class="scene">
          <defs>
            <linearGradient id="tk-cone" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-opacity=".55" /><stop offset="1" stop-opacity="0" /></linearGradient>
            <linearGradient id="tk-water" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="w1" /><stop offset="1" class="w2" /></linearGradient>
          </defs>
          <rect width="320" height="190" class="room" />
          <rect x="34" y="14" width="252" height="7" rx="3.5" class="lamp" />
          <path d="M40 21 L280 21 L298 176 L22 176 Z" fill="url(#tk-cone)" class="cone" />
          <rect x="22" y="40" width="276" height="136" fill="url(#tk-water)" />
          <path class="p-stem" d="M64 150 C60 120 70 95 66 62 M74 150 C78 118 70 92 78 70 M84 150 C82 126 90 104 88 80 M248 150 C252 116 242 88 250 58 M258 150 C256 120 264 100 260 74" />
          <path class="p-red" d="M210 150 C206 124 216 104 212 84 M220 150 C224 126 216 110 222 92 M230 150 C228 130 236 114 232 98" />
          <path class="p-leaf" d="M110 150 C102 128 112 112 124 104 C122 122 118 136 116 150 Z M128 150 C130 124 146 112 158 110 C150 126 140 138 136 150 Z M164 150 C160 132 170 120 182 116 C178 132 172 142 170 150 Z" />
          <g class="fish"><path d="M150 72 l18 -5 v10 z M168 72 c4 -6 18 -6 22 0 c-4 6 -18 6 -22 0 z" /><path d="M118 92 l14 -4 v8 z M132 92 c3 -5 14 -5 17 0 c-3 5 -14 5 -17 0 z" /></g>
          <path class="carpet" d="M22 156 C70 148 120 154 170 149 C220 145 260 152 298 147 L298 160 L22 160 Z" />
          <rect x="22" y="158" width="276" height="18" class="soil" />
          <rect x="22" y="40" width="276" height="136" class="glass" />
          <text x="160" y="104" class="off-note" text-anchor="middle" visibility="hidden">{t('Đèn tắt')}</text>
        </svg>
        <figcaption id="tank-cap"><span id="ch-now"></span> <span class="soft">{t('Màu trên màn hình chỉ gần đúng.')}</span></figcaption>
      </figure>
    </div>

    <div class="main">
      <form id="ch-sched" novalidate>
        <section id="lich" aria-labelledby="sched-h">
          <h2 id="sched-h">{t('Lịch mỗi ngày')}</h2>
          <p class="lead">{t('Chọn kiểu bể để có lịch gợi ý, rồi kéo giờ bật, giờ tắt trên thanh ngày. Đèn tự bật tắt theo đồng hồ của nó, không cần điện thoại ở gần.')}</p>
          <div class="presets" role="group" aria-label={t('Lịch mẫu')}>
            {PRESETS.map(p => <button type="button" class="preset" aria-pressed="false" data-name={p.name} data-on={p.on} data-off={p.off} data-level={p.level}><strong>{p.name}</strong><span class="num">{p.on}–{p.off} · {p.level}%</span><span class="why">{p.why}</span></button>)}
          </div>

          <div class="tl" id="ch-tl">
            <svg viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true">
              <defs><linearGradient id="tl-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="tl-top" /><stop offset="1" class="tl-bottom" /></linearGradient></defs>
              {HOURS.slice(1, -1).map(h => <line x1={h * 60} x2={h * 60} y1="0" y2="100" class="grid" />)}
              <path id="tl-curve" fill="url(#tl-fill)" d="" />
            </svg>
            <div class="mark now" id="tl-now"><span>{t('Bây giờ')}</span></div>
            <div class="mark play" id="tl-play" hidden></div>
            <button type="button" class="handle" id="tl-on" role="slider" aria-valuemin="0" aria-valuemax="1440" aria-label={t('Giờ bật')}><span class="tip num"></span></button>
            <button type="button" class="handle" id="tl-off" role="slider" aria-valuemin="0" aria-valuemax="1440" aria-label={t('Giờ tắt')}><span class="tip num"></span></button>
          </div>
          <div class="hours num" aria-hidden="true">{HOURS.map(h => <span style={`left:${(h / 24) * 100}%`}>{h}h</span>)}</div>

          <p id="ch-hours" class="out" aria-live="polite"></p>

          <div class="fields">
            <label>{t('Bật lúc')} <input name="on" type="time" value="12:00" step="300" required /></label>
            <label>{t('Tắt lúc')} <input name="off" type="time" value="20:00" step="300" required /></label>
            <label>{t('Sáng dần, tối dần')}
              <select name="ramp">{RAMPS.map(r => <option value={r} selected={r === 30}>{r === 0 ? t('Không') : t('{n} phút', { n: r })}</option>)}</select>
            </label>
          </div>
          <div class="row">
            <button type="button" id="ch-play" class="quiet">{t('Xem thử cả ngày')}</button>
          </div>
          <p class="note">
            {hours && <a href={`/vi/huong-dan/${hours.t.slug}/`}>{t('Nên bật đèn mấy tiếng →')}</a>}
            {algae && <a href={`/vi/huong-dan/${algae.t.slug}/`}>{t('Nhận biết và diệt rêu hại →')}</a>}
          </p>
        </section>

        <section id="mau" aria-labelledby="color-h">
          <h2 id="color-h">{t('Màu và độ sáng')}</h2>
          <svg class="mini scene" viewBox="0 0 320 190" aria-hidden="true" id="ch-tank-mini"></svg>
          <div class="looks" role="group" aria-label={t('Kiểu màu')} id="ch-looks">
            {LOOKS.map(l => <button type="button" class="look" aria-pressed="false" data-mix={l.mix.join(',')}><span class="dot" aria-hidden="true"></span>{l.name}</button>)}
          </div>
          <label class="master">
            <span>{t('Độ sáng')}</span>
            <input type="range" id="ch-master" min="0" max="100" step="1" value="70" />
            <output id="ch-master-out" class="num">70%</output>
          </label>
          <details id="ch-each">
            <summary>{t('Chỉnh từng màu')}</summary>
            <div id="ch-levels" class="levels"></div>
          </details>
          <div class="row" id="ch-try-row" hidden>
            <button type="button" id="ch-try" class="quiet" aria-pressed="false">{t('Thử màu trên đèn')}</button>
            <span class="soft" id="ch-try-note">{t('Đèn hiện đúng màu đang chỉnh. Tắt thử thì đèn chạy lại theo lịch.')}</span>
          </div>
        </section>

        <div class="write" id="ch-writebar">
          <p id="ch-summary" class="num"></p>
          <button id="ch-write" type="submit" class="primary" disabled>{t('Ghi lịch vào đèn')}</button>
          <p id="ch-write-note" class="soft"></p>
        </div>
      </form>

      <section id="ch-saved" aria-labelledby="saved-h" hidden>
        <h2 id="saved-h">{t('Lịch đã ghi cho đèn này')}</h2>
        <ul class="saved" id="ch-saved-list"></ul>
      </section>
    </div>
  </div>

  <section class="faq" aria-labelledby="faq-h">
    <h2 id="faq-h">{t('Hỏi nhanh')}</h2>
    {faq.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    <p class="note">
      {choose && <a href={`/vi/huong-dan/${choose.t.slug}/`}>{t('Chọn đèn cho bể thủy sinh →')}</a>}
      {product && <a href={`/vi/san-pham/${product.t.slug}/`}>{t('Đèn Chihiros WRGB II →')}</a>}
    </p>
    <p class="note">{t('Ghi lịch mới sẽ xóa các lịch đang lưu trên đèn, kể cả lịch đặt bằng ứng dụng My Chihiros, và chỉnh giờ đèn theo máy này. Giờ tắt phải trong cùng ngày (muộn nhất 00:00). Cần đèn có firmware từ bản 20.')}</p>
    <p class="note">{t('AquaTome không liên quan tới hãng Chihiros. Các lệnh Bluetooth theo ghi chép mã nguồn mở')} <a href="https://github.com/TheMicDiet/chihiros-led-control" rel="noopener">chihiros-led-control</a> {t('(giấy phép MIT).')}</p>
  </section>
</Browse>
<script>
  import { start } from '../../../scripts/light-page'
  start()
</script>
<style>
  .app { display: grid; gap: var(--space-6); align-items: start; }
  @media (min-width: 60rem) {
    .app { grid-template-columns: minmax(20rem, 26rem) minmax(0, 1fr); gap: var(--space-7); }
    .side { position: sticky; top: var(--space-4); }
  }
  .side { display: grid; gap: var(--space-4); }
  section h2 { font-size: var(--step-2); margin-bottom: var(--space-2); }
  .main > form > section + section, .main > section { margin-top: var(--space-7); }
  .lead { max-width: var(--measure); color: var(--c-ink-soft); margin: 0 0 var(--space-4); }
  .app :global(.soft) { color: var(--c-ink-soft); font-size: var(--step--1); }
  .note { color: var(--c-ink-soft); font-size: var(--step--1); max-width: var(--measure); }
  .note a { margin-right: var(--space-3); }
  .row { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; margin: var(--space-3) 0; }

  /* Buttons: one vocabulary across the page. */
  .app :global(button) { font: 500 1rem var(--f-body); min-height: 44px; padding: 0.55rem 1.1rem; border-radius: 8px; cursor: pointer; transition: background-color .15s ease-out, border-color .15s ease-out, color .15s ease-out; }
  .app :global(button.primary) { border: 0; background: var(--c-ink); color: var(--c-paper); }
  .app :global(button.primary:hover:not(:disabled)) { background: var(--c-moss); }
  .app :global(button.quiet) { background: none; color: var(--c-ink); border: 1px solid var(--c-rule); }
  .app :global(button.quiet:hover:not(:disabled)) { border-color: var(--c-ink); }
  .app :global(button:disabled) { opacity: 0.45; cursor: not-allowed; }
  .app :global(button[aria-pressed="true"].quiet) { border-color: var(--c-moss); color: var(--c-moss); background: color-mix(in srgb, var(--c-moss) 10%, transparent); }

  /* The light card. */
  .card { background: var(--c-plate); border: 1px solid var(--c-rule); border-radius: 12px; padding: var(--space-4); }
  .card .title, .card :global(.title) { font-weight: 600; font-size: var(--step-1); margin: 0 0 var(--space-2); }
  .card p { margin: 0 0 var(--space-2); }
  .howto { margin: 0 0 var(--space-3); padding-left: 1.3rem; color: var(--c-ink-soft); font-size: 0.95rem; }
  .howto li + li { margin-top: var(--space-1); }
  .known { list-style: none; margin: 0 0 var(--space-2); padding: 0; }
  .known :global(li) { display: grid; grid-template-columns: 1fr auto; gap: var(--space-1) var(--space-3); align-items: center; padding: var(--space-3) 0; border-top: 1px solid var(--c-rule); }
  .known :global(li:first-child) { border-top: 0; padding-top: 0; }
  .known :global(.name) { font-weight: 600; }
  .known :global(.meta) { grid-column: 1; color: var(--c-ink-soft); font-size: var(--step--1); }
  .known :global(.forget) { grid-column: 1; justify-self: start; min-height: 0; padding: var(--space-1) 0; border: 0; background: none; color: var(--c-ink-faint); font-size: var(--step--1); text-decoration: underline; text-underline-offset: 0.18em; }
  .known :global(.go) { grid-row: 1 / span 3; grid-column: 2; }
  .status { margin: var(--space-2) 0 0; font-size: 0.95rem; }
  .status:empty { display: none; }
  .status :global(button) { margin-left: var(--space-2); min-height: 36px; padding: 0.3rem 0.8rem; }
  .bad, .card :global(.bad) { color: var(--c-cardinal); }
  .bar { height: 3px; background: var(--c-rule); border-radius: 2px; overflow: hidden; }
  .bar span { display: block; width: 35%; height: 100%; background: var(--c-moss); animation: slide 1.1s cubic-bezier(.2, .7, .3, 1) infinite; }
  @keyframes slide { from { transform: translateX(-100%); } to { transform: translateX(290%); } }
  .card :global(.lhead) { display: flex; gap: var(--space-3); align-items: baseline; justify-content: space-between; flex-wrap: wrap; }
  .card :global(.nick) { font: 600 var(--step-1) var(--f-body); color: var(--c-ink); background: none; border: 1px solid transparent; border-radius: 6px; padding: 0.15rem 0.35rem; margin-left: -0.35rem; width: 100%; max-width: 16rem; }
  .card :global(.nick:hover), .card :global(.nick:focus) { border-color: var(--c-rule); background: var(--c-mat); }
  .card :global(.facts) { display: grid; gap: var(--space-2); margin: var(--space-3) 0; }
  .card :global(.fact) { display: flex; gap: var(--space-2); align-items: flex-start; font-size: 0.95rem; }
  .card :global(.fact svg) { flex: none; width: 1.1rem; height: 1.1rem; margin-top: 0.2rem; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .card :global(.fact.ok svg) { color: var(--c-moss); }
  .card :global(.fact.warn) { color: var(--c-cardinal); }
  .card :global(.fact button) { min-height: 36px; padding: 0.25rem 0.75rem; margin-top: var(--space-1); }
  .card :global(.steps) { list-style: none; margin: 0 0 var(--space-3); padding: var(--space-3); border-radius: 8px; background: color-mix(in srgb, var(--c-moss) 8%, transparent); display: grid; gap: var(--space-1); font-size: 0.95rem; }
  .card :global(.steps li) { display: flex; gap: var(--space-2); align-items: center; color: var(--c-ink-soft); }
  .card :global(.steps li.done) { color: var(--c-ink); }
  .card :global(.steps svg) { width: 1rem; height: 1rem; stroke: var(--c-moss); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .card :global(.steps .dot) { width: 1rem; height: 1rem; border: 1.5px solid var(--c-ink-faint); border-radius: 50%; }
