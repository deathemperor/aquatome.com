---
import type { Localized, SpeciesEntity } from '@aq/schema'
import Base from '../../../layouts/Base.astro'
import Nav from '../../../components/Nav.astro'
import DataCard from '../../../components/DataCard.astro'
import PhotoGallery from '../../../components/PhotoGallery.astro'
import Sections from '../../../components/Sections.astro'
import VideoFacade from '../../../components/VideoFacade.astro'
import ProductSlots from '../../../components/ProductSlots.astro'
import Comments from '../../../components/Comments.astro'
import ReaderPhotos from '../../../components/ReaderPhotos.astro'
import VnClimate from '../../../components/VnClimate.astro'
import QuickSummary from '../../../components/QuickSummary.astro'
import GuideLinks from '../../../components/GuideLinks.astro'
import RedirectNote from '../../../components/RedirectNote.astro'
import { guidesMentioning } from '../../../lib/mentions'
import VideoGuideGrid from '../../../components/VideoGuideGrid.astro'
import GalleryStrip from '../../../components/GalleryStrip.astro'
import BreedList from '../../../components/BreedList.astro'
import { breedsOf } from '../../../lib/breeds'
import { GALLERY_MIN, GALLERY_STRIP } from '../../../lib/gallery'
import { approvedSummary } from '../../../lib/summaries'
import { getContent } from '../../../lib/content'
import { creditsFor } from '../../../lib/credits'
import { searchAliases } from '../../../lib/search'
import { speciesDescription, speciesTitle } from '../../../lib/meta'
import { i18n, langOf, served } from '../../../lib/i18n'
import { alternatesOf } from '../../../lib/alternates'

export async function getStaticPaths({ routePattern }: { routePattern: string }) {
  const c = await getContent(langOf(routePattern))
  return c.species.map(s => ({ params: { slug: s.t.slug }, props: { s } }))
}
const { s } = Astro.props as { s: Localized<SpeciesEntity> }
const { lang, t } = i18n(Astro.url)
const c = await getContent(lang)
const places = s.places.map(id => c.places.find(p => p.id === id)).filter(p => p !== undefined)
const country = places.find(p => p.kind === 'country')
const url = new URL(Astro.url.pathname, Astro.site).href
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: s.t.name, alternativeHeadline: s.scientificName, inLanguage: lang, dateModified: s.updatedAt, image: s.photos[0]?.url, mainEntityOfPage: url,
    about: { '@type': 'Taxon', name: s.scientificName, taxonRank: 'species', alternateName: [s.t.name, ...s.t.altNames] } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('Loài cá'), item: new URL('/vi/ca/', Astro.site).href },
    ...(served(lang, '/vi/phan-loai/x/') ? [{ '@type': 'ListItem', position: 2, name: s.family, item: new URL(`/vi/phan-loai/${s.order.toLowerCase()}/${s.family.toLowerCase()}/`, Astro.site).href }] : []),
    { '@type': 'ListItem', position: served(lang, '/vi/phan-loai/x/') ? 3 : 2, name: s.t.name, item: url } ] },
]
const firstSource = s.sections[0]
const summary = await approvedSummary(s.id)
const gallery = c.galleries[s.id] ?? []
const strip = gallery.length >= GALLERY_MIN && served(lang, `/vi/ca/${s.t.slug}/anh/`) ? gallery.slice(0, GALLERY_STRIP) : []
// Other languages' pages carry what's written for every reader; Vietnam-only parts (shops, climate, Vietnamese notes) stay on /vi/.
const vn = lang === 'vi'
const videos = vn ? s.videos : s.videos.filter(v => (v.lang ?? 'en') !== 'vi')
const alternates = await alternatesOf('species', s.id)
const breeds = breedsOf(lang, c, s.id)
---
<Base title={speciesTitle(lang, s.t.name, s.scientificName)} description={speciesDescription(lang, s.t.name, s.scientificName, s.dataCard)} image={s.photos[0]?.url} noindex={!s.t.quality.indexable} jsonld={jsonld} alternates={alternates} credits={creditsFor([...s.photos.slice(1), ...strip, ...breeds.map(b => b.photos[0])])}>
  <Nav slot="header" />
  <nav class="wrap crumb" aria-label={t('Đường dẫn')}>
    <a href="/vi/ca/">{t('Loài cá')}</a> / <a href={`/vi/phan-loai/${s.order.toLowerCase()}/${s.family.toLowerCase()}/`}>{s.family}</a> / <a href={`/vi/phan-loai/${s.order.toLowerCase()}/${s.family.toLowerCase()}/${s.genus.toLowerCase()}/`} class="sci">{s.genus}</a>
  </nav>
  <header class="wrap top">
    <PhotoGallery photos={s.photos} alt={`${s.t.name}, ${s.scientificName}`} />
    <div>
      <p class="where">{s.family}{country && <>, <a href={`/vi/nguon-goc/${country.parent}/${country.id}/`}>{country.t.name}</a></>}</p>
      <h1 data-pagefind-weight="10" data-pagefind-meta="aka[data-aka]" data-aka={searchAliases(s.t, s.scientificName)}>{s.t.name}</h1>
      <RedirectNote from={s.t.redirectFrom} />
      <p class="sci binomial">{s.scientificName}</p>
      {s.t.altNames.length > 0 && <p class="alt" data-pagefind-ignore>{t('Tên khác: {names}', { names: s.t.altNames.join(', ') })}</p>}
      <DataCard card={s.dataCard} sources={c.sources} />
      {firstSource && <p class="srcline">{t('Dịch và tổng hợp từ {sources}. Cập nhật {date}.', { sources: [...new Set(s.sections.map(x => c.sources[x.source]?.name ?? x.source))].join(', '), date: s.updatedAt })}</p>}
      {vn && <VnClimate card={s.dataCard} />}
      <p class="srcline"><a href={`/vi/cong-cu/?ca=${s.t.slug}#nuoi-chung`}>{t('Kiểm tra nuôi chung với loài khác →')}</a></p>
    </div>
  </header>

  {strip.length > 0 && <GalleryStrip photos={gallery} href={`/vi/ca/${s.t.slug}/anh/`} name={s.t.name} />}
  {vn && summary && <QuickSummary summary={summary} />}
  <Sections sections={s.sections} t={s.t} self={`species:${s.id}`} selfNames={[s.scientificName, s.t.name, ...s.t.altNames]} figures={s.photos.slice(1).map(photo => ({ photo }))} />
  <BreedList breeds={breeds} heading={t('Các dòng và cá lai từ {name}', { name: s.t.name })} />
  <GuideLinks guides={guidesMentioning(c, `species:${s.id}`).filter(g => !g.video)} heading={t('Bài viết nhắc đến loài này')} />
  <VideoGuideGrid guides={guidesMentioning(c, `species:${s.id}`).filter(g => g.video)} heading={t('Có trong video hướng dẫn')} />

  <VideoFacade videos={videos} />
  <ReaderPhotos entity={`species:${s.id}`} name={s.t.name} />

  {vn ? (
    <div class="wrap two">
      <ProductSlots slots={s.productSlots} entity={`species:${s.id}`} />
      <Comments entity={`species:${s.id}`} />
    </div>
  ) : <div class="wrap"><Comments entity={`species:${s.id}`} /></div>}
</Base>
<style>
  .crumb { font-size: 0.85rem; color: var(--c-ink-faint); padding-top: var(--space-4); }
  .crumb a { color: var(--c-ink-soft); }
  .top { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-6); padding-block: var(--space-4) var(--space-6); align-items: start; }
  .where { font-size: 0.85rem; color: var(--c-ink-soft); margin: 0 0 var(--space-2); }
  h1 { font-size: var(--step-4); letter-spacing: -0.015em; }
  .binomial { font-size: var(--step-1); color: var(--c-ink-soft); margin: var(--space-1) 0 var(--space-2); }
  .alt { font-size: 0.85rem; color: var(--c-ink-faint); margin: 0 0 var(--space-4); }
  .srcline { font-size: 0.85rem; color: var(--c-ink-soft); margin-top: var(--space-3); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-7); padding-block: var(--space-7); }
  @media (max-width: 860px) {
    .top, .two { grid-template-columns: 1fr; }
  }
</style>
