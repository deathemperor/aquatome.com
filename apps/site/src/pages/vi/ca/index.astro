---
import Browse from '../../../layouts/Browse.astro'
import SpeciesGrid from '../../../components/SpeciesGrid.astro'
import { getContent } from '../../../lib/content'
import { groupLabel } from '../../../lib/format'
import { creditsFor } from '../../../lib/credits'
import { cleanPhoto, listOrder } from '../../../lib/home'
import { PAGE } from '../../../scripts/filter-list'
import BreedList from '../../../components/BreedList.astro'
import FilterBox from '../../../components/FilterBox.astro'
import FilterResults from '../../../components/FilterResults.astro'
import { i18n } from '../../../lib/i18n'

const { t, lang } = i18n(Astro.url)
const c = await getContent(lang)
const groups = [...new Set(c.species.map(s => s.group))].sort()
// The first page as cards. Every species, with its filter figures and photo, is in the list's data file (lib/list-data.ts),
// which the script fetches to filter or show more: nothing here grows with the catalogue.
const first = listOrder(lang, c).slice(0, PAGE)
---
<Browse title={t('Tất cả loài')} heading={t('Tất cả loài')} intro={t('{n} hồ sơ loài cá, tép và ốc. Lọc theo bể và nước của bạn.', { n: c.species.length })} credits={creditsFor([...first.map(s => cleanPhoto(s.photos)), ...c.breeds.map(b => b.photos[0])])} creditsLater>
  <FilterBox id="filter-box" prefix="species" summary={t('Lọc theo bể và nước')}>
    <label>{t('Tên')} <input name="q" type="search" placeholder={t('neon, Corydoras…')} /></label>
    <label>{t('Nhóm')}
      <select name="group"><option value="">{t('Tất cả')}</option>{groups.map(g => <option value={g}>{t(groupLabel(g))}</option>)}</select>
    </label>
    <label>{t('Bể dài (cm)')} <input name="tankCm" type="number" inputmode="numeric" min="10" max="400" /></label>
    <label>{t('Nhiệt độ (°C)')} <input name="tempC" type="number" inputmode="numeric" min="5" max="40" /></label>
    <label>pH <input name="ph" type="number" inputmode="decimal" step="0.1" min="3" max="10" /></label>
    <label>{t('Độ khó tối đa')}
      <select name="difficultyMax"><option value="">{t('Bất kỳ')}</option><option value="3">{t('Dễ')}</option><option value="5">{t('Dễ và vừa')}</option></select>
    </label>
  </FilterBox>
  <BreedList breeds={[...c.breeds].sort((a, b) => Number(!a.photos.length) - Number(!b.photos.length) || a.t.name.localeCompare(b.t.name, lang))} heading={t('Cá lai và các dòng cá cảnh')} bare eager={4} />
  <FilterResults prefix="species" total={c.species.length} src={`/data/${lang}/species.json`} why={t('Những loài này còn thiếu số liệu bạn đang lọc (nhiệt độ, pH, chiều dài bể hoặc độ khó). Số đã có thì hợp, nhưng chưa đủ để nói chắc.')}>
    <SpeciesGrid species={first} heading={t('Danh sách loài')} template />
  </FilterResults>
</Browse>
<script>
  import type { SpeciesListItem } from '../../../lib/list-data'
  import { filterSpecies, keepBreed, queryFromParams, unsureSpecies } from '../../../scripts/filter'
  import { filterList } from '../../../scripts/filter-list'
  import { buildCard } from '../../../scripts/species-card'
  const breeds = document.querySelector<HTMLElement>('section.breeds')
  filterList<SpeciesListItem>('species', {
    match: (items, p) => {
      const q = queryFromParams(p)
      return { sure: filterSpecies(items, q).map(i => i.slug), unsure: unsureSpecies(items, q).map(i => i.slug) }
    },
    // A species past the first page becomes a card the first time it shows.
    build: buildCard,
    onRun: p => {
      // A search leads with its results: the breed cards above the list stay only when they match it.
      if (!breeds) return
      const q = queryFromParams(p)
      let n = 0
      breeds.querySelectorAll('li').forEach(li => { li.hidden = !keepBreed(li.querySelector('.n')!.textContent!, q); if (!li.hidden) n++ })
      breeds.hidden = n === 0
    },
  })
</script>
