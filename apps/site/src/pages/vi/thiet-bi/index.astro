---
import Browse from '../../../layouts/Browse.astro'
import { getContent } from '../../../lib/content'
import { categories, speciesUsing } from '../../../lib/equipment'
import { categoryLabel } from '../../../lib/format'
import { smallSrc } from '../../../lib/img'
import { i18n } from '../../../lib/i18n'
const { t, lang } = i18n(Astro.url)
const c = await getContent(lang)
/** Guides with the most species first; categories without a written guide last. */
const cats = categories(c)
  .map(u => ({ u, g: c.equipment.find(x => x.category === u.category), n: speciesUsing(lang, c, u.category).length }))
  .sort((a, b) => Number(!!b.g) - Number(!!a.g) || b.n - a.n)
---
<Browse title={t('Thiết bị bể cá: chọn lọc, đèn, sưởi, nền, thức ăn')} heading={t('Thiết bị')} intro={t('Mỗi loại thiết bị: các kiểu nên mua, cách chọn theo cỡ bể và loài cá, lỗi người mới hay mắc, và những loài cần đến nó.')}>
  <div class="cats">
    {cats.map(({ u, g, n }) => (
      <a class="cat" href={`/vi/thiet-bi/${u.category}/`}>
        <div class="img">{g && <img src={smallSrc(g.hero)} width={g.hero.width} height={g.hero.height} alt="" loading="lazy" />}</div>
        <h2>{g?.name ?? t(categoryLabel(u.category))}</h2>
        {g && <p class="lead">{g.lead}</p>}
        {g && <p class="types">{g.types.map(t => t.name).join(' · ')}</p>}
        <p class="n">{u.category === 'cay-thuy-sinh' ? t('{n} loài cây', { n: c.plants.length }) : u.category === 'co2' ? t('{n} loài cây cần', { n: c.plants.filter(p => p.co2 !== 'none').length }) : t('{n} loài cá cần', { n })}</p>
      </a>
    ))}
  </div>
</Browse>
<style>
  .cats { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-7) var(--space-5); }
  .cat { display: block; text-decoration: none; color: inherit; }
  .img img, .img:empty { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius-media); background: var(--c-plate); }
  h2 { font: 400 var(--step-2) var(--f-display); margin: var(--space-3) 0 var(--space-2); }
  .cat:hover h2 { color: var(--c-moss); }
  .lead { margin: 0 0 var(--space-2); color: var(--c-ink-soft); }
  .types { font-size: 0.85rem; margin: 0 0 var(--space-1); }
  .n { font-size: 0.8rem; color: var(--c-ink-faint); margin: 0; }
</style>
