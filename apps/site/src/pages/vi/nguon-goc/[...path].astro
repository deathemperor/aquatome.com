---
import type { Localized, PlaceEntity, SpeciesEntity } from '@aq/schema'
import Browse from '../../../layouts/Browse.astro'
import PagedSpecies from '../../../components/PagedSpecies.astro'
import { getContent } from '../../../lib/content'
import { creditsFor } from '../../../lib/credits'
import { cleanPhoto } from '../../../lib/home'
import { speciesLists } from '../../../lib/list-data'
import { PAGE } from '../../../scripts/filter-list'
import { i18n, langOf } from '../../../lib/i18n'
import { alternatesWhere } from '../../../lib/alternates'

const { t } = i18n(Astro.url)
const INTROS: Record<string, string> = {
  vietnam: t('Những loài cá có nguồn gốc từ sông suối Việt Nam, từ đồng bằng Mekong đến suối núi phía Bắc.'),
}
const TITLES: Record<string, string> = { vietnam: t('Cá Việt Nam') }

export async function getStaticPaths({ routePattern }: { routePattern: string }) {
  const lang = langOf(routePattern)
  const c = await getContent(lang)
  // A place's species are its list's (lib/list-data.ts), in the fish list's order.
  const lists = speciesLists(lang, c)
  const of = (path: string) => lists.get(`nguon-goc/${path}`) ?? []
  const places = c.places
  const tops = places.filter(p => p.kind === 'continent')
  const index = { params: { path: undefined }, props: { place: undefined, species: [] as Localized<SpeciesEntity>[], kids: tops } }
  const continents = tops.map(p => ({ params: { path: p.id }, props: { place: p, species: of(p.id), kids: places.filter(x => x.parent === p.id && x.kind === 'country'), parent: undefined } }))
  const countries = places.filter(p => p.kind === 'country' && p.parent).map(p => ({
    params: { path: `${p.parent}/${p.id}` }, props: { place: p, species: of(`${p.parent}/${p.id}`), kids: places.filter(x => x.parent === p.id), parent: places.find(x => x.id === p.parent) },
  }))
  return [index, ...continents, ...countries]
}
const { place, species, kids, parent } = Astro.props as { place?: Localized<PlaceEntity>; species: Localized<SpeciesEntity>[]; kids: Localized<PlaceEntity>[]; parent?: Localized<PlaceEntity> }
const name = place ? TITLES[place.id] ?? place.t.name : t('Nguồn gốc')
const crumbs: [string, string][] = place ? [['/vi/nguon-goc/', t('Nguồn gốc')], ...(parent ? [[`/vi/nguon-goc/${parent.id}/`, parent.t.name] as [string, string]] : [])] : []
const intro = place ? INTROS[place.id] ?? t('{n} loài có nguồn gốc từ {place}.', { n: species.length, place: place.t.name }) : t('Duyệt loài theo châu lục, quốc gia và dòng sông nơi chúng sinh ra.')
// The same place in another language: named there (the index always is).
const alternates = await alternatesWhere(Astro.url.pathname, c => !place || c.places.some(p => p.id === place.id))
const href = (k: Localized<PlaceEntity>) => (k.kind === 'country' ? `/vi/nguon-goc/${k.parent}/${k.id}/` : k.kind === 'continent' ? `/vi/nguon-goc/${k.id}/` : undefined)
---
<Browse title={place && !TITLES[place.id] ? t('Cá cảnh bản địa {place}: {n} loài', { place: name, n: species.length }) : name} heading={name} crumbs={crumbs} intro={intro} credits={creditsFor(species.slice(0, PAGE).map(s => cleanPhoto(s.photos)))} creditsLater={species.length > PAGE} alternates={alternates}>
  {kids.length > 0 && (
    <ul class="kids">{kids.map(k => { const h = href(k); return <li>{h ? <a href={h}>{k.t.name}</a> : <span>{k.t.name}</span>}</li> })}</ul>
  )}
  {place && <PagedSpecies species={species} list={`nguon-goc/${Astro.params.path}`} heading={t('Danh sách loài')} />}
</Browse>
<style>
  .kids { list-style: none; padding: 0; margin: 0 0 var(--space-6); display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .kids a, .kids span { display: inline-block; padding: 0.3rem 0.8rem; border: 1px solid var(--c-rule); border-radius: 999px; background: var(--c-plate); text-decoration: none; }
</style>
