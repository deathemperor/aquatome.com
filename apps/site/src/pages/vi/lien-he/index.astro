---
import Doc from '../../../layouts/Doc.astro'
import { CONTACT_EMAIL } from '../../../lib/site'
import { i18n } from '../../../lib/i18n'
const { t } = i18n(Astro.url)
const mail = `mailto:${CONTACT_EMAIL}`
---
<Doc title={t('Liên hệ')} intro={t('Gửi email cho AquaTome, chúng tôi thường trả lời trong vài ngày.')}>
  <p class="mail"><a href={mail}>{CONTACT_EMAIL}</a></p>
  <h2>{t('Bạn có thể viết cho chúng tôi về')}</h2>
  <ul>
    <li><strong>{t('Lỗi nội dung:')}</strong> {t('thông số sai, bản dịch khó hiểu, ảnh nhầm loài. Ghi kèm đường dẫn trang giúp chúng tôi sửa nhanh hơn.')}</li>
    <li><strong>{t('Bản quyền và ghi nguồn:')}</strong> {t('nếu bạn là tác giả nội dung hoặc ảnh và muốn chỉnh cách ghi nguồn hoặc gỡ nội dung.')}</li>
    <li><strong>{t('Dữ liệu cá nhân:')}</strong> {t('yêu cầu xem, sửa hoặc xóa bình luận của bạn (xem')} <a href="/vi/chinh-sach-bao-mat/">{t('Chính sách bảo mật')}</a>).</li>
    <li><strong>{t('Hợp tác:')}</strong> {t('cửa hàng, trại cá, câu lạc bộ thủy sinh.')}</li>
  </ul>
  <p lang="en">English is welcome too: <a href={mail}>{CONTACT_EMAIL}</a>.</p>
</Doc>
<style>
  .mail { font: 400 var(--step-2) var(--f-display); }
</style>
