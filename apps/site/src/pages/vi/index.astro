---
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'
import SpeciesCard from '../../components/SpeciesCard.astro'
import { getContent } from '../../lib/content'
import { HERO } from '../../lib/hero'

const c = await getContent()
const guides = c.guides.filter(g => g.kind !== 'discovery').slice(0, 2)
---
<Base title="thủy·sinh — kiến thức thủy sinh bằng tiếng Việt" description="Hồ sơ loài cá, cây thủy sinh và hướng dẫn setup bể, dịch từ các nguồn uy tín." credits={[HERO]}>
  <Fragment slot="header">
    <div class="hero" style={`--hero:url(${HERO.url})`}>
      <Nav overlay />
      <div class="wrap hero-copy">
        <h1>Thế giới dưới mặt nước, bằng tiếng Việt.</h1>
        <p>Hồ sơ loài, cây thủy sinh và hướng dẫn setup bể, dịch từ những nguồn uy tín nhất thế giới.</p>
        <form class="search" action="/vi/ca/" role="search">
          <label class="visually-hidden" for="q">Tìm loài cá</label>
          <input id="q" name="q" type="search" placeholder="Tìm loài cá theo tên Việt hoặc tên khoa học" />
          <button type="submit">Tìm</button>
        </form>
        <ul class="quick">
          <li><a href="/vi/ca/?difficultyMax=2">Cá cho người mới</a></li>
          <li><a href="/vi/ca/?tankCm=45">Bể nano</a></li>
          <li><a href="/vi/cay/">Cây không cần CO₂</a></li>
          <li><a href="/vi/nhom/shrimp/">Tép</a></li>
        </ul>
      </div>
    </div>
  </Fragment>

  <section class="match" aria-labelledby="match-h">
    <form class="wrap" action="/vi/ca/">
      <h2 id="match-h">Bể của bạn hợp với loài nào?</h2>
      <label>Chiều dài bể <span><input name="tankCm" type="number" inputmode="numeric" value="60" min="20" max="300" /> cm</span></label>
      <label>Nhiệt độ <span><input name="tempC" type="number" inputmode="numeric" value="26" min="10" max="35" /> °C</span></label>
      <label>pH <span><input name="ph" type="number" inputmode="decimal" step="0.1" value="7" min="3" max="9" /></span></label>
      <button type="submit">Gợi ý loài</button>
    </form>
  </section>

  <section class="wrap block" aria-labelledby="featured-h">
    <div class="head"><h2 id="featured-h">Loài nổi bật</h2><a href="/vi/ca/">Tất cả {c.species.length} loài</a></div>
    {c.species.length === 0
      ? <p class="empty">Chưa có hồ sơ loài nào được xuất bản.</p>
      : <div class="grid">{c.species.map(s => <SpeciesCard s={s} />)}</div>}
  </section>

  {guides.length > 0 && (
    <section class="guides" aria-labelledby="guides-h">
      <div class="wrap">
        <h2 id="guides-h" class="visually-hidden">Hướng dẫn</h2>
        <div class="gg">
          {guides.map(g => (
            <a class="g" href={`/vi/huong-dan/${g.t.slug}/`} style={g.photos[0] ? `--img:url(${g.photos[0].url})` : undefined}>
              <span class="kind">Hướng dẫn</span>
              <h3>{g.t.name}</h3>
              <span class="src">Dịch từ {c.sources[g.source]?.name ?? g.source}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
<style>
  .hero { position: relative; min-height: min(78vh, 640px); background: var(--c-blackwater) var(--hero) center 55% / cover; color: var(--c-on-dark); display: flex; align-items: flex-end; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(10 26 29 / 0.9) 0, rgb(10 26 29 / 0.4) 55%, transparent 85%), linear-gradient(180deg, rgb(10 26 29 / 0.55) 0, transparent 25%, transparent 60%, var(--c-blackwater) 100%); }
  .hero-copy { position: relative; z-index: 2; padding-block: var(--space-8) var(--space-7); width: 100%; }
  h1 { font-size: var(--step-4); max-width: 13em; letter-spacing: -0.02em; color: #fff; }
  .hero-copy > p { max-width: 34em; color: var(--c-on-dark); margin: var(--space-3) 0 var(--space-5); }
  .search { display: flex; max-width: 34rem; background: rgb(255 255 255 / 0.1); border: 1px solid rgb(255 255 255 / 0.25); border-radius: 999px; padding: 4px; backdrop-filter: blur(8px); }
  .search input { flex: 1; min-width: 0; background: none; border: 0; color: #fff; font: inherit; padding: 0.6rem 1rem; }
  .search input::placeholder { color: var(--c-on-dark-soft); }
  .search button { border: 0; border-radius: 999px; background: var(--c-neon); color: var(--c-blackwater); font: 600 0.95rem var(--f-body); padding: 0 1.25rem; cursor: pointer; }
  .quick { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; padding: 0; margin: var(--space-4) 0 0; }
  .quick a { display: inline-block; font-size: 0.85rem; color: var(--c-on-dark); border: 1px solid rgb(255 255 255 / 0.28); border-radius: 999px; padding: 0.3rem 0.8rem; text-decoration: none; }
  .quick a:hover { border-color: var(--c-neon); color: #fff; }

  .match { background: var(--c-blackwater-2); color: var(--c-on-dark); }
  .match form { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--space-4); padding-block: var(--space-5); }
  .match h2 { font-size: var(--step-2); margin-right: auto; color: #fff; max-width: 12em; }
  .match label { display: grid; gap: 2px; font-size: 0.8rem; color: var(--c-on-dark-soft); }
  .match label span { color: #fff; font-size: 1rem; }
  .match input { width: 4.5rem; font: 600 1.05rem var(--f-body); background: var(--c-blackwater); color: #fff; border: 1px solid var(--c-on-dark-soft); border-radius: 8px; padding: 0.4rem 0.5rem; }
  .match button { border: 0; border-radius: 999px; background: var(--c-neon); color: var(--c-blackwater); font: 600 1rem var(--f-body); padding: 0.65rem 1.3rem; cursor: pointer; }

  .block { padding-block: var(--space-7) var(--space-6); }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); border-bottom: 2px solid var(--c-ink); padding-bottom: var(--space-2); margin-bottom: var(--space-5); }
  .head h2 { font-size: var(--step-3); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: var(--space-6) var(--space-5); }
  .empty { color: var(--c-ink-soft); }

  .guides { background: var(--c-blackwater); padding-block: var(--space-6); }
  .gg { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-4); }
  .g { position: relative; min-height: 220px; border-radius: var(--radius-media); overflow: hidden; background: var(--c-blackwater-2) var(--img) center / cover; display: flex; flex-direction: column; justify-content: flex-end; padding: var(--space-5); color: #fff; text-decoration: none; isolation: isolate; }
  .g::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 25%, rgb(5 14 16 / 0.92)); }
  .g .kind { font-size: 0.8rem; color: var(--c-neon); }
  .g h3 { font-size: var(--step-2); margin: var(--space-1) 0; }
  .g .src { font-size: 0.8rem; color: var(--c-on-dark-soft); }
  .g:hover h3 { text-decoration: underline; text-underline-offset: 0.15em; }
  @media (max-width: 720px) { .gg { grid-template-columns: 1fr; } }
</style>
