---
import { guideImage } from '../../lib/mentions'
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'
import SpeciesCard from '../../components/SpeciesCard.astro'
import PlantCard from '../../components/PlantCard.astro'
import GuideCard from '../../components/GuideCard.astro'
import { getContent } from '../../lib/content'
import { HERO } from '../../lib/hero'
import { creditsFor } from '../../lib/credits'
import { smallSrc } from '../../lib/img'
import { easyPlants, featuredSpecies, groupTiles, leadGuides, STEP_GUIDES } from '../../lib/home'

const c = await getContent()
const guideById = (id: string) => c.guides.find(g => g.id === id)
const cycle = guideById(STEP_GUIDES.cycle)
const water = guideById(STEP_GUIDES.water)
// Three first steps; a step whose guide isn't published links nowhere and is dropped.
const steps = [
  cycle && { n: 1, title: 'Chạy chu trình nitơ', text: 'Nuôi vi sinh trong bể vài tuần trước khi thả cá, để chất thải của cá không thành chất độc.', href: `/vi/huong-dan/${cycle.t.slug}/` },
  { n: 2, title: 'Chọn cá hợp bể', text: 'Nhập bể của bạn ở trên, hoặc bắt đầu từ những loài dễ nuôi.', href: '/vi/ca/?difficultyMax=3' },
  water && { n: 3, title: 'Thay nước định kỳ', text: 'Thay bao nhiêu, bao lâu một lần, và cách làm để cá không bị sốc.', href: `/vi/huong-dan/${water.t.slug}/` },
].filter(x => !!x).map((x, i) => ({ ...x, n: i + 1 }))
const guides = leadGuides(c).filter(g => g !== cycle && g !== water).slice(0, 4)
const featured = featuredSpecies(c)
const groups = groupTiles(c)
const plants = easyPlants(c)
const equipment = c.equipment
const credits = [HERO, ...creditsFor([
  ...featured.map(s => s.photos[0]), ...groups.map(g => g.photo), ...guides.map(g => guideImage(c, g)), ...plants.map(p => p.photos[0]),
])]
---
<Base title="AquaTome — Cẩm nang cá cảnh & thủy sinh" description="Nhập kích thước, nhiệt độ và pH bể của bạn để xem loài cá nào hợp; hồ sơ loài, cây thủy sinh và hướng dẫn nuôi bằng tiếng Việt." credits={credits}>
  <link slot="head" rel="preload" as="image" href={HERO.url} imagesrcset={`${HERO.url} 960w, ${HERO.large} 1600w`} imagesizes="(min-width: 900px) 40vw, 100vw" fetchpriority="high" />
  <Nav slot="header" />

  <section class="tank" aria-labelledby="tank-h">
    <div class="wrap tank-in">
      <div class="lead">
        <h1 id="tank-h">Hiểu cá trước khi thả cá.</h1>
        <p class="sub">Cho biết bể của bạn, AquaTome chỉ ra loài nào sống khỏe trong đó.</p>
        <form id="tank" class="form" action="/vi/ca/">
          <label>Chiều dài bể <span><input name="tankCm" type="number" inputmode="numeric" value="60" min="20" max="300" required /> cm</span></label>
          <label>Nhiệt độ nước <span><input name="tempC" type="number" inputmode="numeric" value="26" min="10" max="35" required /> °C</span></label>
          <label>pH <span><input name="ph" type="number" inputmode="decimal" step="0.1" value="7" min="3" max="9" required /></span></label>
          <button type="submit">Xem loài hợp bể</button>
        </form>
        <form class="search" action="/vi/ca/" role="search">
          <label for="q">Hoặc tìm theo tên</label>
          <span><input id="q" name="q" type="search" placeholder="cá neon, betta, Corydoras…" /><button type="submit">Tìm</button></span>
        </form>
      </div>
      <figure class="photo">
        <img src={HERO.url} srcset={`${HERO.url} 960w, ${HERO.large} 1600w`} sizes="(min-width: 900px) 40vw, 100vw" width="1600" height="900" alt="Bể thủy sinh trồng cây, có lũa và đá" fetchpriority="high" />
      </figure>
    </div>
  </section>

  {steps.length > 1 && (
    <section class="wrap block" aria-labelledby="steps-h">
      <h2 id="steps-h" class="h">Bể đầu tiên: ba việc cần làm</h2>
      <ol class="steps">
        {steps.map(s => <li><a href={s.href}><span class="n">{s.n}</span><b>{s.title}</b><span class="t">{s.text}</span></a></li>)}
      </ol>
    </section>
  )}

  <section class="wrap block" aria-labelledby="featured-h">
    <div class="head"><h2 id="featured-h" class="h">Loài quen thuộc</h2><a href="/vi/ca/">Tất cả {c.species.length} loài →</a></div>
    {featured.length === 0
      ? <p class="empty">Chưa có hồ sơ loài nào được xuất bản.</p>
      : <div class="grid">{featured.map((s, i) => <SpeciesCard s={s} eager={i < 4} />)}</div>}
  </section>

  {groups.length > 0 && (
    <section class="wrap block" aria-labelledby="groups-h">
      <h2 id="groups-h" class="h">Theo nhóm</h2>
      <ul class="groups">
        {groups.map(g => (
          <li><a href={`/vi/nhom/${g.group}/`}>
            <span class="gp">{g.photo && <img src={smallSrc(g.photo)} width={g.photo.width} height={g.photo.height} alt="" loading="lazy" />}</span>
            <b>{g.label}</b> <span class="cnt">{g.count} loài</span>
          </a></li>
        ))}
      </ul>
    </section>
  )}

  {guides.length > 0 && (
    <section class="wrap block" aria-labelledby="guides-h">
      <div class="head"><h2 id="guides-h" class="h">Hướng dẫn cơ bản</h2><a href="/vi/huong-dan/">Tất cả hướng dẫn →</a></div>
      <div class="grid">{guides.map(g => <GuideCard g={g} />)}</div>
    </section>
  )}

  {plants.length > 0 && (
    <section class="wrap block" aria-labelledby="plants-h">
      <h2 id="plants-h" class="h">Cây dễ trồng, không cần CO₂</h2>
      <div class="grid">{plants.map(p => <PlantCard p={p} />)}</div>
    </section>
  )}

  {equipment.length > 0 && (
    <section class="wrap block" aria-labelledby="equip-h">
      <h2 id="equip-h" class="h">Mua thiết bị: chọn thế nào</h2>
      <ul class="equip">{equipment.map(e => <li><a href={`/vi/thiet-bi/${e.category}/`}>{e.name}</a></li>)}</ul>
    </section>
  )}

  {/* Remembers the reader's tank (browser storage only) so the form is filled next time. */}
  <script is:inline>(()=>{try{var f=document.getElementById('tank'),k='aq_tank',v=JSON.parse(localStorage.getItem(k)||'null');if(v)['tankCm','tempC','ph'].forEach(function(n){if(v[n])f.elements[n].value=v[n]});f.addEventListener('submit',function(){var o={};['tankCm','tempC','ph'].forEach(function(n){o[n]=f.elements[n].value});localStorage.setItem(k,JSON.stringify(o))})}catch(e){}})()</script>
</Base>
<style>
  .tank { border-bottom: 1px solid var(--c-rule); }
  .tank-in { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: var(--space-7); align-items: center; padding-block: var(--space-7); }
  h1 { font-size: clamp(2.2rem, 1.5rem + 2.6vw, 3.4rem); letter-spacing: -0.01em; }
  .sub { color: var(--c-ink-soft); margin: var(--space-3) 0 var(--space-5); max-width: 32em; }
  .form { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); padding: var(--space-4); background: var(--c-plate); border: 1px solid var(--c-ink); }
  .form label { display: grid; gap: 4px; font-size: 0.8rem; color: var(--c-ink-soft); }
  .form label span { display: flex; align-items: center; gap: 6px; color: var(--c-ink); }
  .form input { width: 100%; min-width: 0; font: 600 1.25rem var(--f-body); color: var(--c-ink); background: #fff; border: 1px solid var(--c-ink-soft); padding: 0.45rem 0.5rem; }
  .form button { grid-column: 1 / -1; min-height: 48px; border: 0; background: var(--c-ink); color: var(--c-paper); font: 600 1rem var(--f-body); cursor: pointer; }
  .form button:hover { background: var(--c-moss); }
  .search { margin-top: var(--space-4); display: grid; gap: 4px; font-size: 0.8rem; color: var(--c-ink-soft); }
  .search span { display: flex; border-bottom: 1px solid var(--c-ink-soft); }
  .search input { flex: 1; min-width: 0; min-height: 44px; border: 0; background: none; font: inherit; font-size: 1rem; color: var(--c-ink); padding: 0 2px; }
  .search input:focus-visible { outline: none; }
  .search span:focus-within { border-color: var(--c-ink); box-shadow: 0 1px 0 var(--c-ink); }
  .search button { min-height: 44px; min-width: 44px; border: 0; background: none; font: 600 0.95rem var(--f-body); color: var(--c-moss); cursor: pointer; }
  .photo { margin: 0; padding: 10px; background: #fff; box-shadow: 0 1px 0 var(--c-rule), 0 12px 30px -18px rgb(29 42 34 / 0.35); }
  .photo img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

  .block { padding-block: var(--space-7) 0; }
  .block:last-of-type { padding-bottom: var(--space-7); }
  .h { font-size: var(--step-3); }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); }
  .head a { white-space: nowrap; padding-block: 10px; }
  .head, section > .h { border-bottom: 2px solid var(--c-ink); padding-bottom: var(--space-2); margin-bottom: var(--space-5); }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6) var(--space-5); }
  .empty { color: var(--c-ink-soft); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--c-rule); background: var(--c-plate); }
  .steps li + li { border-left: 1px solid var(--c-rule); }
  .steps a { display: grid; grid-template-columns: auto 1fr; gap: 2px var(--space-3); padding: var(--space-5); height: 100%; text-decoration: none; color: inherit; }
  .steps .n { grid-row: span 2; font: 400 2.6rem/1 var(--f-display); color: var(--c-cardinal); }
  .steps b { font: 500 var(--step-1) var(--f-display); }
  .steps .t { color: var(--c-ink-soft); font-size: 0.95rem; }
  .steps a:hover b { color: var(--c-moss); text-decoration: underline; text-underline-offset: 0.15em; }

  .groups { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(128px, 1fr)); gap: var(--space-4) var(--space-3); }
  .groups a { display: block; text-decoration: none; color: inherit; font-size: 0.95rem; }
  .gp { display: block; padding: 4px; background: #fff; box-shadow: 0 1px 2px rgb(29 42 34 / 0.12); margin-bottom: var(--space-2); }
  .gp img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; }
  .groups b { font: 500 1.05rem var(--f-display); }
  .cnt { display: block; color: var(--c-ink-faint); font-size: 0.8rem; }
  .groups a:hover b { color: var(--c-moss); }

  .equip { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--space-5); }
  .equip a { display: inline-block; padding-block: 10px; font: 400 var(--step-1) var(--f-display); }

  @media (max-width: 900px) {
    .tank-in { grid-template-columns: 1fr; gap: var(--space-5); padding-block: var(--space-5) var(--space-6); }
    .photo { padding: 6px; }
    .photo img { aspect-ratio: 16 / 9; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) var(--space-3); }
    .steps { grid-template-columns: 1fr; }
    .steps li + li { border-left: 0; border-top: 1px solid var(--c-rule); }
    .groups { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: var(--space-3); padding-bottom: var(--space-2); margin-inline: calc(-1 * var(--space-5)); padding-inline: var(--space-5); }
    .groups li { flex: 0 0 116px; scroll-snap-align: start; }
    .block { padding-top: var(--space-6); }
    .h { font-size: var(--step-2); }
  }
</style>
