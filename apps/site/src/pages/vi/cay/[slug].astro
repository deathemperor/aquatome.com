---
import type { Localized, PlantEntity } from '@aq/schema'
import Base from '../../../layouts/Base.astro'
import Nav from '../../../components/Nav.astro'
import PhotoGallery from '../../../components/PhotoGallery.astro'
import Sections from '../../../components/Sections.astro'
import ProductSlots from '../../../components/ProductSlots.astro'
import CommentsPlaceholder from '../../../components/CommentsPlaceholder.astro'
import { getContent } from '../../../lib/content'
import { slugify } from '@aq/schema/slug'
import { PLANT_LABELS } from '../../../lib/format'

export async function getStaticPaths() {
  const c = await getContent()
  return c.plants.map(p => ({ params: { slug: p.t.slug }, props: { p } }))
}
const { p } = Astro.props as { p: Localized<PlantEntity> }
const facts: [string, string][] = [
  ['Độ khó', PLANT_LABELS.difficulty[p.difficulty]!],
  ['Ánh sáng', PLANT_LABELS.light[p.light]!],
  ['CO₂', PLANT_LABELS.co2[p.co2]!],
  ['Tốc độ mọc', PLANT_LABELS.growth[p.growth]!],
  ['Vị trí', p.placement.map(x => PLANT_LABELS.placement[x]).join(', ')],
]
---
<Base title={`${p.t.name} (${p.scientificName}) — thủy·sinh`} description={`Cách trồng ${p.t.name}: ánh sáng, CO₂, vị trí.`} noindex={!p.t.quality.indexable}>
  <Nav slot="header" />
  <nav class="wrap crumb" aria-label="Đường dẫn"><a href="/vi/cay/">Cây thủy sinh</a></nav>
  <header class="wrap top">
    <PhotoGallery photos={p.photos} alt={`${p.t.name}, ${p.scientificName}`} />
    <div>
      <h1 data-pagefind-index-attrs="data-ascii" data-ascii={slugify(`${p.t.name} ${p.t.altNames.join(' ')}`).replaceAll('-', ' ')}>{p.t.name}</h1>
      <p class="sci binomial">{p.scientificName}</p>
      <dl class="facts">{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    </div>
  </header>
  <Sections sections={p.sections} t={p.t} />
  <div class="wrap two">
    <ProductSlots slots={p.productSlots} heading="Mua cây này" />
    <CommentsPlaceholder />
  </div>
</Base>
<style>
  .crumb { font-size: 0.85rem; padding-top: var(--space-4); }
  .crumb a { color: var(--c-ink-soft); }
  .top { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-6); padding-block: var(--space-4) var(--space-6); align-items: start; }
  h1 { font-size: var(--step-4); letter-spacing: -0.015em; }
  .binomial { font-size: var(--step-1); color: var(--c-ink-soft); margin: var(--space-1) 0 var(--space-4); }
  .facts { display: grid; grid-template-columns: 1fr 1fr; margin: 0; border: 1px solid var(--c-rule); background: var(--c-plate); }
  .facts div { padding: var(--space-3); border-bottom: 1px solid var(--c-rule); }
  .facts div:nth-child(odd) { border-right: 1px solid var(--c-rule); }
  dt { font-size: 0.75rem; color: var(--c-ink-faint); }
  dd { margin: 0; font: 400 var(--step-1) var(--f-display); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-7); padding-top: var(--space-7); }
  @media (max-width: 860px) { .top, .two { grid-template-columns: 1fr; } }
</style>
