---
import type { GuideEntity, Localized } from '@aq/schema'
import Base from '../../../layouts/Base.astro'
import Nav from '../../../components/Nav.astro'
import SpeciesCard from '../../../components/SpeciesCard.astro'
import PlantCard from '../../../components/PlantCard.astro'
import SourceCredit from '../../../components/SourceCredit.astro'
import GuideCard from '../../../components/GuideCard.astro'
import Comments from '../../../components/Comments.astro'
import { getContent } from '../../../lib/content'
import { GUIDE_KIND_LABELS } from '../../../lib/format'
import { creditsFor } from '../../../lib/credits'
import { excerpt } from '../../../lib/meta'
import { guideImage, mentionIndex } from '../../../lib/mentions'
import { gearRows } from '../../../lib/gear'
import GearList from '../../../components/GearList.astro'
import { placeFigures } from '../../../lib/figures'
import { categoryLabel } from '../../../lib/format'
import { readingMinutes, withToc } from '../../../lib/toc'
import { nextGuides } from '../../../lib/home'
import VideoPlayer from '../../../components/VideoPlayer.astro'
import { clock, illustrate, isoDuration, seriesGuides, seriesOf, watchUrl } from '../../../lib/video'
import { slugify } from '@aq/schema/slug'
import { i18n, langOf } from '../../../lib/i18n'

export async function getStaticPaths({ routePattern }: { routePattern: string }) {
  const c = await getContent(langOf(routePattern))
  return c.guides.map(g => ({ params: { slug: g.t.slug }, props: { g } }))
}
const { g } = Astro.props as { g: Localized<GuideEntity> }
const { t, lang } = i18n(Astro.url)
const c = await getContent(lang)
const m = mentionIndex(c).guides.get(g.id)!
const body = m.html
const species = [...new Set([...m.species, ...c.species.filter(s => g.mentions.includes(s.id))])]
const plants = [...new Set([...m.plants, ...c.plants.filter(p => g.mentions.includes(p.id))])]
const ph = guideImage(c, g)
const gear = g.video ? gearRows(lang, c, g.video) : []
// Pictures inside the text: each species/plant photo after the paragraph that first names it, the guide's other photos spread out.
const shown = (url?: string) => url !== undefined && url !== ph?.url
const placed = placeFigures(lang, body,
  [...species.map(s => ({ photo: s.photos[0], label: s.t.name, href: `/vi/ca/${s.t.slug}/` })), ...plants.map(p => ({ photo: p.photos[0], label: p.t.name, href: `/vi/cay/${p.t.slug}/` }))]
    .filter((f): f is typeof f & { photo: NonNullable<typeof f.photo> } => shown(f.photo?.url)).slice(0, 6),
  g.photos.filter(p => shown(p.url)).map(photo => ({ photo })))
const { html: toc0, toc } = withToc(placed)
const prose = g.video ? illustrate(lang, toc0, g.video) : toc0
const minutes = readingMinutes(body)
const series = seriesOf(c, g)
const inSeries = series ? seriesGuides(c, series) : []
const pos = inSeries.findIndex(x => x.id === g.id)
// A series reads in the creator's order: the next parts first, then related guides.
const next = series ? [...inSeries.slice(pos + 1, pos + 4), ...nextGuides(c, g, 3).filter(x => !inSeries.some(y => y.id === x.id))].slice(0, 3) : nextGuides(c, g)
const v = g.video
const description = excerpt(g.t.body ?? '')
const jsonld: object[] = []
if (v) {
  jsonld.push({
    '@context': 'https://schema.org', '@type': 'VideoObject', name: v.title, description, thumbnailUrl: [ph?.url], ...(v.publishedAt ? { uploadDate: v.publishedAt } : {}),
    duration: isoDuration(v.durationSec), embedUrl: `https://www.youtube-nocookie.com/embed/${v.youtubeId}`, url: watchUrl(v.youtubeId), inLanguage: v.lang ?? 'en',
    author: { '@type': 'Person', name: v.channel, url: v.channelUrl },
    ...(v.chapters.length > 1 ? { hasPart: v.chapters.map((ch, i) => ({ '@type': 'Clip', name: g.t.chapters?.[i] ?? ch.title, startOffset: ch.start, endOffset: v.chapters[i + 1]?.start ?? v.durationSec, url: watchUrl(v.youtubeId, ch.start) })) } : {}),
  })
}
if (g.t.faq?.length) jsonld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: g.t.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) })
const back = g.kind === 'discovery' ? ['/vi/kham-pha/', t('Khám phá')] : ['/vi/huong-dan/', t('Hướng dẫn')]
---
<Base title={`${g.t.name} — AquaTome`} description={description} image={ph?.url} jsonld={jsonld} noindex={!g.t.quality.indexable} credits={creditsFor([ph, ...g.photos, ...(g.video?.figures ?? []).map(f => f.photo), ...species.map(s => s.photos[0]), ...plants.map(p => p.photos[0])])}>
  {/* The video's thumbnail is the page's largest image: open the connection while the page is still arriving. */}
  {v && <link slot="head" rel="preconnect" href="https://i.ytimg.com" />}
  <Nav slot="header" current={v ? '/vi/video/' : undefined} />
  <article class="wrap art">
    <header class="ahead">
      <nav class="crumb" aria-label={t('Đường dẫn')}>{v ? <><a href="/vi/video/">{t('Video')}</a> / {series ? <a href={`/vi/video/${series.vi.slug}/`}>{series.vi.name}</a> : <a href={`/vi/video/kenh/${slugify(v.channel)}/`}>{v.channel}</a>}</> : <a href={back[0]}>{back[1]}</a>}</nav>
      <p class="kind">{t(GUIDE_KIND_LABELS[g.kind])} · {v && <>{t('video {time}', { time: clock(v.durationSec) })} · </>}{t('đọc khoảng {n} phút', { n: minutes })}{series && pos >= 0 && <> · {t('phần {i}/{n}', { i: pos + 1, n: inSeries.length })}</>}</p>
      <h1>{g.t.name}</h1>
      <SourceCredit source={g.source} url={g.sourceUrl} sources={c.sources} video={v} refs={g.refs} />
      {v ? <VideoPlayer video={v} chapters={g.t.chapters} cover={g.t.cover} /> : ph && <img class="lead" src={ph.url} width={ph.width} height={ph.height} alt="" />}
      {g.t.summary && g.t.summary.length > 0 && (
        <section class="takeaways" aria-labelledby="sum-h">
          <h2 id="sum-h">{t('Tóm tắt nhanh')}</h2>
          <ul>{g.t.summary.map(x => <li>{x}</li>)}</ul>
        </section>
      )}
    </header>
    {toc.length >= 3 && (
      <nav class="toc" aria-labelledby="toc-h">
        <h2 id="toc-h">{t('Trong bài này')}</h2>
        <ol>{toc.map(t => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
      </nav>
    )}
    <div class="prose" set:html={prose} />
    {g.t.faq && g.t.faq.length > 0 && (
      <section class="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">{t('Câu hỏi thường gặp')}</h2>
        {g.t.faq.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}
    {g.refs && g.refs.length > 0 && (
      <section class="refs" id="nguon" aria-labelledby="ref-h">
        <h2 id="ref-h">{t('Nguồn tham khảo')}</h2>
        <ol>{g.refs.map(r => <li><a href={r.url} rel="nofollow noopener" target="_blank">{r.title}</a></li>)}</ol>
      </section>
    )}
  </article>
  {next.length > 0 && (
    <section class="wrap related" aria-labelledby="next-h">
      <h2 id="next-h">{series && pos + 1 < inSeries.length ? t('Phần tiếp theo') : t('Bài tiếp theo')}</h2>
      <div class="grid">{next.map(x => <GuideCard g={x} />)}</div>
    </section>
  )}
  {(species.length > 0 || plants.length > 0) && (
    <section class="wrap related" aria-labelledby="rel-h">
      <h2 id="rel-h">{t('Loài và cây trong bài')}</h2>
      <div class="grid">{species.map(s => <SpeciesCard s={s} />)}{plants.map(p => <PlantCard p={p} />)}</div>
    </section>
  )}
  {gear.length > 0 ? <GearList rows={gear} youtubeId={g.video?.youtubeId} heading={t('Thiết bị trong video')} entity={`guide:${g.t.slug}`} /> : m.equipment.length > 0 && (
    <section class="wrap related" aria-labelledby="eq-h">
      <h2 id="eq-h">{t('Thiết bị nhắc đến')}</h2>
      <ul class="chips">{m.equipment.map(cat => <li><a href={`/vi/thiet-bi/${cat}/`}>{t(categoryLabel(cat))}</a></li>)}</ul>
    </section>
  )}
  <div class="wrap end"><Comments entity={`guide:${g.id}`} /></div>
</Base>
<style>
  .art { display: grid; grid-template-columns: minmax(0, var(--measure)); padding-block: var(--space-4) var(--space-6); }
  @media (min-width: 1100px) {
    .art { grid-template-columns: minmax(0, var(--measure)) 15rem; column-gap: var(--space-8); }
    .ahead, .prose, .faq { grid-column: 1; }
    .toc { grid-column: 2; grid-row: 1 / span 2; align-self: start; position: sticky; top: var(--space-5); margin-top: var(--space-8); }
  }
  .toc { margin: 0 0 var(--space-5); padding: var(--space-4); background: var(--c-plate); border: 1px solid var(--c-rule); border-top: 2px solid var(--c-ink); }
  .toc h2 { font: 600 0.8rem var(--f-body); letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-ink-soft); margin-bottom: var(--space-2); }
  .toc ol { margin: 0; padding-left: 1.4em; font-size: 0.95rem; }
  .toc li { padding-block: 4px; }
  .toc a { color: var(--c-ink); text-decoration-color: var(--c-rule); }
  .toc a:hover { text-decoration-color: var(--c-ink); }
  .prose :global(h3) { font-size: var(--step-2); margin: var(--space-7) 0 var(--space-3); scroll-margin-top: var(--space-5); }
  .takeaways { background: var(--c-plate); border: 1px solid var(--c-rule); border-top: 2px solid var(--c-ink); padding: var(--space-4) var(--space-5); margin: var(--space-4) 0 var(--space-2); }
  .takeaways h2, .faq h2 { font: 600 0.8rem var(--f-body); letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-ink-soft); margin-bottom: var(--space-2); }
  .takeaways ul { margin: 0; padding-left: 1.2em; }
  .takeaways li { padding-block: 3px; line-height: 1.6; }
  .faq { margin-top: var(--space-7); border-top: 2px solid var(--c-ink); padding-top: var(--space-3); }
  .faq details { border-bottom: 1px solid var(--c-rule); }
  .faq summary { cursor: pointer; padding: var(--space-3) 0; font-weight: 600; min-height: 44px; box-sizing: border-box; }
  .faq details p { margin: 0 0 var(--space-3); line-height: 1.7; }
  .refs { grid-column: 1; margin-top: var(--space-6); font-size: 0.9rem; color: var(--c-ink-soft); }
  .refs h2 { font: 600 0.8rem var(--f-body); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: var(--space-2); }
  .refs ol { padding-left: 1.4em; margin: 0; }
  .refs li { padding-block: 2px; overflow-wrap: anywhere; }
  /* Video guides: a section's open-licence photo, then stills that play the video from that moment. */
  .prose :global(.vfigs) { margin: var(--space-5) 0; }
  .prose :global(.vphoto) { margin: 0 0 var(--space-4); }
  .prose :global(.vphoto img) { width: 100%; height: auto; display: block; }
  .prose :global(.vphoto figcaption) { font-size: 0.9rem; color: var(--c-ink-soft); margin-top: var(--space-2); line-height: 1.5; }
  .prose :global(.vphoto .by), .prose :global(.vphoto .by a) { color: var(--c-ink-faint); font-size: 0.8rem; }
  .prose :global(.moments) { border-top: 1px solid var(--c-rule); padding-top: var(--space-2); }
  .prose :global(.moments .mh) { font: 600 0.75rem var(--f-body); letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-ink-soft); margin: 0 0 var(--space-2); }
  .prose :global(.moments ul) { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: var(--space-3); }
  .prose :global(.moment) { display: grid; gap: 4px; width: 100%; padding: 0; border: 0; background: none; text-align: left; cursor: pointer; font: inherit; color: var(--c-ink); }
  .prose :global(.moment img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
  .prose :global(.moment .mt) { font-size: 0.8rem; font-weight: 600; color: var(--c-cardinal); font-variant-numeric: tabular-nums; }
  .prose :global(.moment .mc) { font-size: 0.85rem; line-height: 1.4; color: var(--c-ink-soft); }
  .prose :global(.moment:hover .mc) { color: var(--c-ink); }
  .crumb { font-size: 0.85rem; }
  .crumb a { color: var(--c-ink-soft); }
  .kind { color: var(--c-moss); font-size: 0.9rem; margin: var(--space-4) 0 var(--space-1); }
  h1 { font-size: var(--step-4); letter-spacing: -0.015em; margin-bottom: var(--space-2); }
  .lead { width: 100%; border-radius: var(--radius-media); margin: var(--space-5) 0; }
  .prose :global(p) { font-size: 1.0625rem; line-height: 1.75; }
  .prose :global(.ml) { color: inherit; text-decoration-color: var(--c-moss); text-decoration-thickness: 1.5px; }
  .prose :global(.gl) { color: inherit; text-decoration: underline dotted var(--c-moss); text-decoration-thickness: 1.5px; }
  .related { padding-bottom: var(--space-6); }
  .related h2, .wrap :global(.comments h2) { font-size: var(--step-2); }
  .related h2 { border-bottom: 2px solid var(--c-ink); padding-bottom: var(--space-2); margin-bottom: var(--space-5); }
  .end { padding-bottom: var(--space-8); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: var(--space-6) var(--space-5); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; padding: 0; }
  .chips a { display: inline-block; padding: 0.3rem 0.8rem; border: 1px solid var(--c-rule); border-radius: 999px; background: var(--c-plate); text-decoration: none; }
</style>
