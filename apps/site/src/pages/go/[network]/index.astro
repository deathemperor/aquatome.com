---
// Fallback when the site is served without the Worker (local preview): send the visitor to the marketplace search.
import { i18n } from '../../../lib/i18n'
export function getStaticPaths() {
  return [
    { params: { network: 'shopee' }, props: { base: 'https://shopee.vn/search?keyword=', name: 'Shopee' } },
    { params: { network: 'lazada' }, props: { base: 'https://www.lazada.vn/catalog/?q=', name: 'Lazada' } },
    { params: { network: 'tiki' }, props: { base: 'https://tiki.vn/search?q=', name: 'Tiki' } },
  ]
}
const { base, name } = Astro.props
const { t, lang } = i18n(Astro.url)
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{t('Đang chuyển tới {name}…', { name })}</title>
    <script is:inline define:vars={{ base }}>location.replace(base + encodeURIComponent(new URLSearchParams(location.search).get('k') || ''))</script>
  </head>
  <body><p>{t('Đang chuyển tới {name}…', { name })} <a href={base}>{t('Mở {name}', { name })}</a></p></body>
</html>
