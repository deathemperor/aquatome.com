      "quotes": [
        {
          "source": "seriouslyfish",
          "quote": "The neon tetra, Paracheirodon innesi, is a small characid from the Amazon basin in Colombia, Brazil and Peru, found in acidic forest streams.",
          "countries": [
            "CO",
            "PE",
