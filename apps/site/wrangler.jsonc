{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Production: https://aquatome.com. www and the old staging host 301 to it (CANONICAL_HOST).
  // The Worker collects beacon events, comments and reader photos, and serves the /_ab dashboard; everything else is plain static assets.
  "name": "aquatome",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "html_handling": "force-trailing-slash",
    // The Worker runs first on every Vietnamese page (the root and each section, worker/paths.ts VI_SECTIONS; a test keeps
    // them equal) and on the old /vi/ addresses, which it 301s to the root.
    "run_worker_first": [
      "/", "/.well-known/api-catalog", "/.well-known/apple-app-site-association", "/vi", "/vi/*",
      "/ca/*", "/cay/*", "/chinh-sach-bao-mat/*", "/cong-cu/*", "/dang-nhap/*", "/gioi-thieu/*", "/huong-dan/*", "/kham-pha/*", "/lien-he/*", "/moi-cap-nhat/*",
      "/nguon-goc/*", "/nhom/*", "/phan-loai/*", "/san-pham/*", "/thiet-bi/*", "/thuat-ngu/*", "/tim-kiem/*", "/ung-dung/*", "/video/*",
      "/_e", "/_ab", "/_ab/*", "/go/*", "/_aff/*", "/_c", "/_c/*", "/_p", "/_p/*", "/api/*"
    ]
  },
  // The owner's dashboard (/_ab/) opens only to the owner's account signed in on the site: secret OWNER_ACCOUNTS, the
  // account ids, comma-separated. Secret AB_DASH_TOKEN is the build's and scripts' bearer token (/_ab/hidden.json and the
  // admin APIs); it no longer opens the dashboard.
  // Affiliate catalog, click counts and comments. Schema: `wrangler d1 migrations apply aquatome --remote`.
  // Comments also need secrets TURNSTILE_SECRET and COMMENT_HMAC_KEY; without them /_c answers 503 and the section stays hidden.
  // Accounts for saved tanks (/api/v1/*, worker/accounts/): ACCOUNTS "on" (unset: off; "preview": the owner only). Needs the
  // ACCOUNT_HMAC_KEY secret, migration 0004, and per provider GOOGLE_CLIENT_IDS / APPLE_CLIENT_IDS (public ids, below); email
  // also Turnstile and the EMAIL binding (Cloudflare Email Sending, aquatome.com onboarded); revoking Apple tokens when an
  // account is deleted, the APPLE_SIGNIN_KEY secret (Key ID and team below).
  "d1_databases": [{ "binding": "DB", "database_name": "aquatome", "database_id": "ffebf861-d781-47a9-a77d-e7a3506af189", "migrations_dir": "migrations" }],
  // Reader photos: raw uploads wait in the private bucket; screened WebP copies go to the public media bucket (readers/).
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "aquatome-uploads" }, { "binding": "MEDIA", "bucket_name": "aquatome-media" }],
  // Fish ID's calls to Claude go out from the eastern US (worker/fishid/relay.ts): Anthropic refuses Cloudflare's Hong Kong
  // location. Its readers' and the site's counts and spend sit in one ledger (worker/fishid/ledger.ts): without it, fish ID is off.
  "durable_objects": { "bindings": [{ "name": "FISHID_RELAY", "class_name": "FishIdRelay" }, { "name": "FISHID_LEDGER", "class_name": "FishIdLedger" }] },
  "migrations": [{ "tag": "v1-fishid-relay", "new_sqlite_classes": ["FishIdRelay"] }, { "tag": "v2-fishid-ledger", "new_sqlite_classes": ["FishIdLedger"] }],
  "kv_namespaces": [{ "binding": "AB", "id": "0f352d52c0634b6ba6b88dffa9b45ae3" }],
  // Readers' beacon events (worker/events.ts); every fish-ID request's outcome, tokens and cost (worker/fishid/log.ts); the
  // iOS app's anonymous events and MetricKit summaries (worker/telemetry), whose raw reports wait 30 days in the private
  // uploads bucket under diagnostics/ (a lifecycle rule deletes them).
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "aquatome_events" }, { "binding": "FISHID_LOG", "dataset": "aquatome_fishid" }, { "binding": "APP_EVENTS", "dataset": "aquatome_app" }],
  "triggers": { "crons": ["17 20 * * *"] },
  // Sign-in codes, and the daily report (worker/daily, POST /_ab/report), which goes to the secret REPORT_TO. Without that
  // secret the report is kept on the dashboard, marked not sent.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["dang-nhap@aquatome.com", "bao-cao@aquatome.com"] }],
  "vars": {
    "CANONICAL_HOST": "aquatome.com",
    "CF_ACCOUNT_ID": "76f1666bfa8377c4a6ecd1c8993a37df",
    "TURNSTILE_SITEKEY": "0x4AAAAAAFqXNU0UVJNdZhcJ",
    "GOOGLE_CLIENT_IDS": "273529484726-536aat77a1fcgms9tspb2tg21lmvljqk.apps.googleusercontent.com,273529484726-i1brjj0oukqk1v1niudmu9f4q4ouo8or.apps.googleusercontent.com",
    "APPLE_CLIENT_IDS": "com.aquatome.web,com.aquatome.app",
    "APPLE_TEAM_ID": "Q783W6B4FA",
    "APPLE_SIGNIN_KEY_ID": "YK437QPP8B",
    "ACCOUNTS": "on",
    "PASSKEYS": "on",
    // Fish ID as an agent (worker/fishid/agent.ts): on since it passed the design's rule on the leak-checked 200 photos
    // (docs/review/fish-id-accuracy.md): top-1 53.5% → 62.5%, median 9.1 s, $30.87 per 1,000. "0" or removed: today's call.
    "FISH_ID_AGENT": "1"
  },
  "routes": [
    { "pattern": "aquatome.com", "zone_name": "aquatome.com", "custom_domain": true },
    { "pattern": "www.aquatome.com", "zone_name": "aquatome.com", "custom_domain": true }
  ]
}
