{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Staging on infinitus.run (huuloc.com lives in another CF account) until the real domain is chosen.
  // The Worker assigns an A/B skin to HTML pages, collects beacon events and serves the /_ab dashboard; everything else is plain static assets.
  "name": "thuysinh-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "html_handling": "force-trailing-slash",
    "run_worker_first": ["/", "/vi/*", "/_e", "/_ab", "/_ab/*", "/go/*", "/_aff/*", "/_c", "/_c/*"]
  },
  // Affiliate catalog, click counts and comments. Schema: `wrangler d1 migrations apply thuysinh --remote`.
  // Comments also need secrets TURNSTILE_SECRET and COMMENT_HMAC_KEY; without them /_c answers 503 and the section stays hidden.
  "d1_databases": [{ "binding": "DB", "database_name": "thuysinh", "database_id": "3e477e5b-486e-4af0-8e10-130f8f57a747", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "AB", "id": "0f352d52c0634b6ba6b88dffa9b45ae3" }],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "thuysinh_events" }],
  "triggers": { "crons": ["17 20 * * *"] },
  "vars": { "STAGING": "1", "AFFILIATE_CLICK_VALUE_VND": "2000", "CF_ACCOUNT_ID": "76f1666bfa8377c4a6ecd1c8993a37df", "TURNSTILE_SITEKEY": "0x4AAAAAAFqXNU0UVJNdZhcJ" },
  "routes": [{ "pattern": "thuysinh.infinitus.run", "zone_name": "infinitus.run", "custom_domain": true }]
}
