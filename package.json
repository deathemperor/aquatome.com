{
  "name": "aquarium-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "test:content": "pnpm -r --if-present test:content",
    "dev": "pnpm --filter site dev",
    "build": "pnpm --filter site build",
    "typecheck": "pnpm -r typecheck",
    "engine": "pnpm --filter @aq/engine exec tsx src/cli.ts"
  }
}
