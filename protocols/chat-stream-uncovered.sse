event: step
data: {"kind":"search","query":"bệnh đốm trắng"}

event: step
data: {"kind":"read","page":{"kind":"guide","title":"Cách điều trị bệnh đốm trắng (Ich) ở cá nước ngọt","url":"/vi/huong-dan/cach-dieu-tri-benh-dom-trang-ich-o-ca-nuoc-ngot/"}}

event: text
data: {"text":"Cẩm nang chưa có liều cho thuốc này, nên mình không đoán liều.\n1. Chờ 24 giờ cho chắc là đốm trắng, vì bệnh velvet trông rất giống.\n2. Dùng thuốc đúng liều ghi trên nhãn.\n3. Mỗi ngày thay một phần ba nước rồi châm lại thuốc cho cả bể.\nTheo dõi đến khi hết đốm, rồi làm thêm một ngày nữa."}

event: block
data: {"t":"section","page":{"kind":"guide","title":"Cách điều trị bệnh đốm trắng (Ich) ở cá nước ngọt","url":"/vi/huong-dan/cach-dieu-tri-benh-dom-trang-ich-o-ca-nuoc-ngot/"},"heading":{"text":"Cách điều trị ich tốt nhất là gì?","id":"cach-dieu-tri-ich-tot-nhat-la-gi"},"blocks":[{"t":"p","c":["Có nhiều kỹ thuật điều trị ich, từ các dung dịch thảo dược nhẹ nhàng đến những phương pháp rất mạnh tay, nhưng sau nhiều năm thử nghiệm, Aquarium Solutions Ich-X là loại thuốc Aquarium Co-Op chọn dùng. Thuốc rất hiệu quả và an toàn với mọi loại cá (kể cả cá không vảy), tép, ốc và cây thủy sinh."]},{"t":"list","ordered":true,"items":[[{"t":"p","c":["Trước tiên, xác định bệnh và chắc chắn đó thật sự là ich. Vì ich do stress và bệnh velvet cũng trông rất giống, có thể nên chờ 24 giờ để xác nhận chẩn đoán."]}],[{"t":"p","c":["Dùng Ich-X theo hướng dẫn, tức là 5 ml thuốc cho mỗi 38 lít nước bể, rồi chờ 24 giờ. (Không dùng nửa liều cho cá nhạy cảm vì nồng độ đó không đủ mạnh để diệt ich. Sau khi điều trị hàng nghìn con cá, Aquarium Co-Op cho biết chưa từng thấy vấn đề với bất kỳ loài nào.)"]}],[{"t":"p","c":["Thay một phần ba lượng nước và châm thuốc lại với cùng nồng độ 5 ml Ich-X cho mỗi 38 lít nước. Nhớ cho đủ thuốc để xử lý toàn bộ thể tích nước của bể, không chỉ lượng nước đã thay ra."]}],[{"t":"p","c":["Lặp lại bước 3 mỗi 24 giờ cho đến khi không còn thấy dấu hiệu của ich. Thực hiện bước 3 thêm một ngày nữa sau lần cuối bạn thấy ich trên cá, phòng khi còn nang ẩn trong nền đáy. (Thuốc chỉ diệt được ký sinh trùng khi chúng bơi tự do và không được bảo vệ trong nang.)"]}],[{"t":"p","c":["Để thuốc trong nước và loại bỏ dần theo thời gian qua việc ",{"text":"thay nước định kỳ","href":"/vi/thuat-ngu/thay-nuoc/","tip":{"term":"Thay nước","text":"Việc hút bỏ một phần nước bể và thay bằng nước sạch đã khử clo, cùng nhiệt độ và thông số tương tự. Thay 20–30% mỗi tuần giúp giảm nitrat và chất thải hòa tan; với cá nhạy cảm, nên thay ít nhưng đều thay vì thay nhiều một lần."}},"."]}]]},{"t":"p","c":["Sau điều trị, cơ thể cá có nhiều vết thương và tổn thương mô, tạo môi trường lý tưởng cho vi khuẩn và nấm gây bệnh, nên bạn có thể cần điều trị nhiễm trùng thứ phát."]},{"t":"figure","img":{"src":"https://media.aquatome.com/aquariumcoop/a77ba3bc54e22977.webp","w":1000,"h":563,"alt":"Clown loach with ich","credit":{"text":"Ảnh: Aquarium Co-op","licence":"","url":"https://www.aquariumcoop.com/blogs/aquarium/how-to-treat-ich-on-freshwater-fish"}}},{"t":"p","c":["Hoạt chất trong Ich-X là malachite green chloride, có màu xanh lam đậm, vì vậy hãy tránh chạm vào dung dịch nếu có thể. Theo kinh nghiệm của Aquarium Co-Op, họ chưa nhận thấy vấn đề ố xanh trên đồ trang trí hay silicone trong bể."]},{"t":"p","c":["Nếu sau 5 ngày không có cải thiện, nhiều khả năng bệnh đã bị chẩn đoán sai và cá không bị ich. Hãy ngừng điều trị bằng Ich-X, loại bỏ dần thuốc theo lịch thay nước thông thường và đánh giá lại chẩn đoán."]},{"t":"p","c":["Ngoài ra, nếu không mua được Ich-X ở nước bạn, muối là một phương pháp tốt khác để điều trị ich. Aquarium Co-Op thường dùng muối với ",{"text":"cá cichlid","href":"/vi/nhom/cichlids/"}," (cả ",{"text":"châu Phi","href":"/vi/nguon-goc/africa/"}," và ",{"text":"Nam Mỹ","href":"/vi/nguon-goc/south-america/"},") và cá vàng, nhưng các loài ",{"text":"cá da trơn","href":"/vi/nhom/catfish/"}," và ",{"text":"cá chạch","href":"/vi/nhom/loaches/"}," có thể nhạy cảm hơn với sự thay đổi độ mặn. Để biết thêm chi tiết về việc dùng muối trị ich, hãy đọc bài viết về muối bể cá của họ."]}]}

event: done
data: {"conversation":"6f1c2a52-8d3e-4b7a-9c41-2e5d7f80b913","n":2,"text":"Cẩm nang chưa có liều cho thuốc này, nên mình không đoán liều.\n1. Chờ 24 giờ cho chắc là đốm trắng, vì bệnh velvet trông rất giống.\n2. Dùng thuốc đúng liều ghi trên nhãn.\n3. Mỗi ngày thay một phần ba nước rồi châm lại thuốc cho cả bể.\nTheo dõi đến khi hết đốm, rồi làm thêm một ngày nữa.","blocks":[{"t":"section","page":{"kind":"guide","title":"Cách điều trị bệnh đốm trắng (Ich) ở cá nước ngọt","url":"/vi/huong-dan/cach-dieu-tri-benh-dom-trang-ich-o-ca-nuoc-ngot/"},"heading":{"text":"Cách điều trị ich tốt nhất là gì?","id":"cach-dieu-tri-ich-tot-nhat-la-gi"},"blocks":[{"t":"p","c":["Có nhiều kỹ thuật điều trị ich, từ các dung dịch thảo dược nhẹ nhàng đến những phương pháp rất mạnh tay, nhưng sau nhiều năm thử nghiệm, Aquarium Solutions Ich-X là loại thuốc Aquarium Co-Op chọn dùng. Thuốc rất hiệu quả và an toàn với mọi loại cá (kể cả cá không vảy), tép, ốc và cây thủy sinh."]},{"t":"list","ordered":true,"items":[[{"t":"p","c":["Trước tiên, xác định bệnh và chắc chắn đó thật sự là ich. Vì ich do stress và bệnh velvet cũng trông rất giống, có thể nên chờ 24 giờ để xác nhận chẩn đoán."]}],[{"t":"p","c":["Dùng Ich-X theo hướng dẫn, tức là 5 ml thuốc cho mỗi 38 lít nước bể, rồi chờ 24 giờ. (Không dùng nửa liều cho cá nhạy cảm vì nồng độ đó không đủ mạnh để diệt ich. Sau khi điều trị hàng nghìn con cá, Aquarium Co-Op cho biết chưa từng thấy vấn đề với bất kỳ loài nào.)"]}],[{"t":"p","c":["Thay một phần ba lượng nước và châm thuốc lại với cùng nồng độ 5 ml Ich-X cho mỗi 38 lít nước. Nhớ cho đủ thuốc để xử lý toàn bộ thể tích nước của bể, không chỉ lượng nước đã thay ra."]}],[{"t":"p","c":["Lặp lại bước 3 mỗi 24 giờ cho đến khi không còn thấy dấu hiệu của ich. Thực hiện bước 3 thêm một ngày nữa sau lần cuối bạn thấy ich trên cá, phòng khi còn nang ẩn trong nền đáy. (Thuốc chỉ diệt được ký sinh trùng khi chúng bơi tự do và không được bảo vệ trong nang.)"]}],[{"t":"p","c":["Để thuốc trong nước và loại bỏ dần theo thời gian qua việc ",{"text":"thay nước định kỳ","href":"/vi/thuat-ngu/thay-nuoc/","tip":{"term":"Thay nước","text":"Việc hút bỏ một phần nước bể và thay bằng nước sạch đã khử clo, cùng nhiệt độ và thông số tương tự. Thay 20–30% mỗi tuần giúp giảm nitrat và chất thải hòa tan; với cá nhạy cảm, nên thay ít nhưng đều thay vì thay nhiều một lần."}},"."]}]]},{"t":"p","c":["Sau điều trị, cơ thể cá có nhiều vết thương và tổn thương mô, tạo môi trường lý tưởng cho vi khuẩn và nấm gây bệnh, nên bạn có thể cần điều trị nhiễm trùng thứ phát."]},{"t":"figure","img":{"src":"https://media.aquatome.com/aquariumcoop/a77ba3bc54e22977.webp","w":1000,"h":563,"alt":"Clown loach with ich","credit":{"text":"Ảnh: Aquarium Co-op","licence":"","url":"https://www.aquariumcoop.com/blogs/aquarium/how-to-treat-ich-on-freshwater-fish"}}},{"t":"p","c":["Hoạt chất trong Ich-X là malachite green chloride, có màu xanh lam đậm, vì vậy hãy tránh chạm vào dung dịch nếu có thể. Theo kinh nghiệm của Aquarium Co-Op, họ chưa nhận thấy vấn đề ố xanh trên đồ trang trí hay silicone trong bể."]},{"t":"p","c":["Nếu sau 5 ngày không có cải thiện, nhiều khả năng bệnh đã bị chẩn đoán sai và cá không bị ich. Hãy ngừng điều trị bằng Ich-X, loại bỏ dần thuốc theo lịch thay nước thông thường và đánh giá lại chẩn đoán."]},{"t":"p","c":["Ngoài ra, nếu không mua được Ich-X ở nước bạn, muối là một phương pháp tốt khác để điều trị ich. Aquarium Co-Op thường dùng muối với ",{"text":"cá cichlid","href":"/vi/nhom/cichlids/"}," (cả ",{"text":"châu Phi","href":"/vi/nguon-goc/africa/"}," và ",{"text":"Nam Mỹ","href":"/vi/nguon-goc/south-america/"},") và cá vàng, nhưng các loài ",{"text":"cá da trơn","href":"/vi/nhom/catfish/"}," và ",{"text":"cá chạch","href":"/vi/nhom/loaches/"}," có thể nhạy cảm hơn với sự thay đổi độ mặn. Để biết thêm chi tiết về việc dùng muối trị ich, hãy đọc bài viết về muối bể cá của họ."]}]}],"suggestions":["Làm sao biết cá bị đốm trắng hay chỉ bị stress?","Có cần cách ly cá bệnh không?"],"covered":false,"model":"claude-opus-5-5","steps":[{"kind":"search","query":"Costapur"},{"kind":"search","query":"bệnh đốm trắng"},{"kind":"read","page":{"kind":"guide","title":"Cách điều trị bệnh đốm trắng (Ich) ở cá nước ngọt","url":"/vi/huong-dan/cach-dieu-tri-benh-dom-trang-ich-o-ca-nuoc-ngot/"}}]}

