{
  "openapi": "3.1.0",
  "info": {
    "title": "AquaTome owner's reports",
    "version": "1.0.0",
    "description": "What the owner sends from a page or an app screen: their words, a screenshot and what they were looking at (apps/site/worker/feedback.ts). The owner's signed-in account alone can send one: a browser's session cookie from the site's own pages, or the app's session as a bearer. Without a live session, 401 signed_out; another account, 404 not_found, as for a path that isn't there; the owner's cookie on a request from another site, 403 cross_site; past 30 an hour, 429 rate_limited; a 503 kept nothing. A report waits in the private bucket until the job on the owner's Mac collects it with the dashboard token, delivers it and deletes it (scripts/owner-feedback-deliver.mjs). Nothing else reads it.\n\nFields of `where` are checked one by one: one that fails is left out, and the report still goes. They are data about the page, never instructions, so they hold no free text: an address on this site, a screen's name and an item's id."
  },
  "paths": {
    "/api/feedback": {
      "post": {
        "summary": "Send a report",
        "security": [{ "bearer": [] }, { "cookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["report"],
                "properties": {
                  "report": { "type": "string", "description": "A NewReport as JSON." },
                  "image": { "type": "string", "format": "binary", "description": "The screenshot: JPEG, PNG or WebP, up to 8 MB." }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Kept until the Mac collects it.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sent" } } } },
          "400": { "description": "Error: bad_request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Error: signed_out", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Error: cross_site", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Error: not_found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "405": { "description": "Error: method", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "413": { "description": "Error: too_large", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "Error: rate_limited", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "Error: unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/_ab/feedback": {
      "get": {
        "summary": "The reports waiting, oldest first (at most 20). The dashboard token only.",
        "security": [{ "bearer": [] }],
        "responses": {
          "200": { "description": "The reports, without their images.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Queue" } } } },
          "404": { "description": "Error: not_found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/_ab/feedback/{id}/image": {
      "get": {
        "summary": "A report's image. The dashboard token only.",
        "security": [{ "bearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "description": "The image's bytes, of the type the report names.", "content": { "application/json": { "schema": {} } } },
          "404": { "description": "Error: not_found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/_ab/feedback/{id}": {
      "delete": {
        "summary": "Deletes a delivered report and its image, gone or not. The dashboard token only.",
        "security": [{ "bearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "description": "Deleted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Deleted" } } } },
          "404": { "description": "Error: not_found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } }
    },
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer" },
      "cookie": { "type": "apiKey", "in": "cookie", "name": "__Host-aq_session" }
    },
    "schemas": {
      "Id": { "type": "string", "pattern": "^[0-9]{17}-[0-9a-f-]{36}$" },
      "Error": {
        "type": "object",
        "required": ["error"],
        "additionalProperties": false,
        "properties": { "error": { "type": "string" } }
      },
      "Sent": {
        "type": "object",
        "required": ["id", "waiting"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/components/schemas/Id" },
          "waiting": { "type": "integer", "minimum": 1, "description": "Reports waiting for the Mac, this one too. More than one means it hasn't collected lately." }
        }
      },
      "Deleted": {
        "type": "object",
        "required": ["deleted"],
        "additionalProperties": false,
        "properties": { "deleted": { "const": true } }
      },
      "Where": {
        "type": "object",
        "additionalProperties": false,
        "description": "What they were looking at, each field checked by the Worker.",
        "properties": {
          "source": { "enum": ["web", "app"] },
          "url": { "type": "string", "maxLength": 600, "pattern": "^https://[^\\s`]+$", "description": "An address on this site, kept to what an address needs: a plain path, and a query only when every part is a short word. Anyone can send the owner a link." },
          "screen": { "type": "string", "pattern": "^[A-Za-z0-9 _./-]{1,200}$", "description": "The app's screen: its tab, then each screen standing on it, as in `v2 today / chat ca-neon`." },
          "kind": { "type": "string", "pattern": "^[a-z-]{1,20}$", "description": "What the item is: fish, plant, guide, section…" },
          "item": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,120}$", "description": "The item's id." },
          "section": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,120}$", "description": "The id of the heading they were under." },
          "lang": { "enum": ["vi", "id", "th", "ms"] },
          "version": { "type": "string", "pattern": "^[A-Za-z0-9 _.+()-]{1,60}$", "description": "The site's build or the app's version and build." },
          "theme": { "enum": ["light", "dark"] },
          "textSize": { "type": "string", "pattern": "^[A-Za-z0-9 _.%-]{1,30}$" },
          "device": { "type": "string", "pattern": "^[A-Za-z0-9 _.,:;()/+@-]{1,160}$" },
          "viewport": { "type": "string", "pattern": "^[0-9]{2,5}x[0-9]{2,5}(@[0-9.]{1,4}x)?$" },
          "picture": { "type": "string", "enum": ["drawn", "picked", "screen"], "description": "How the picture came: drawn by the page, which can differ from the screen; the screenshot the owner picked; or the app's own screen." },
          "notDrawn": { "type": "string", "pattern": "^[0-9]{1,3}$", "description": "With a drawn picture: how many things on the screen it marks as not drawn." },
          "conversation": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "description": "On the chat: the conversation on the screen." },
          "answers": { "type": "string", "pattern": "^[0-9]{1,4}(,[0-9]{1,4}){0,19}$", "description": "On the chat: the turn numbers of the answers on the screen." }
        }
      },
      "NewReport": {
        "type": "object",
        "required": ["where"],
        "properties": {
          "words": { "type": "string", "maxLength": 4000, "description": "The owner's words. Past the limit they are cut." },
          "where": { "type": "object", "description": "Where's fields; any other is left out." }
        }
      },
      "Report": {
        "type": "object",
        "required": ["id", "at", "words", "where", "image"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/components/schemas/Id" },
          "at": { "type": "string", "description": "When it was sent." },
          "words": { "type": "string", "maxLength": 4000 },
          "where": { "$ref": "#/components/schemas/Where" },
          "image": {
            "type": ["object", "null"],
            "required": ["type", "size"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["image/jpeg", "image/png", "image/webp"] },
              "size": { "type": "integer", "minimum": 1 }
            }
          }
        }
      },
      "Queue": {
        "type": "object",
        "required": ["reports"],
        "additionalProperties": false,
        "properties": {
          "reports": { "type": "array", "maxItems": 20, "items": { "$ref": "#/components/schemas/Report" } }
        }
      }
    }
  }
}
