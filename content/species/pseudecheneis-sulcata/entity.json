    },
    {
      "key": "habitat",
      "source": "planetcatfish",
      "sourceUrl": "https://www.planetcatfish.com/common/species.php?species_id=1374",
      "html": "<p>Found in fast-flowing hill streams. Prefers deep riffles and runs over gravel and cobble substrates.</p>"
