{
  "id": "scardinius-erythrophthalmus",
  "scientificName": "Scardinius erythrophthalmus",
  "order": "Cypriniformes",
  "family": "Cyprinidae",
  "genus": "Scardinius",
  "group": "barbs",
  "places": [],
  "dataCard": {
