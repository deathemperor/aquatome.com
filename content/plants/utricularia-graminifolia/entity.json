      "html": "<ul><li><strong>Type:</strong> Carpeting</li><li><strong>Origin:</strong> Asia</li><li><strong>Growth rate:</strong> Medium</li><li><strong>Height:</strong> 3 - 10+ cm</li><li><strong>Light demand:</strong> Medium</li><li><strong>CO2:</strong> Medium (6-14 mg/L)</li></ul>"
