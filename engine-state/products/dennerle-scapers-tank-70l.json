  "fits": [
    {
      "fact": "Meant for aquascaping; the large footprint gives room for planting",
      "source": 0
    },
    {
      "fact": "Recommended for dwarf shrimp, snails and small nano fish, and for high-contrast scapes",
      "source": 2
    },
    {
      "fact": "The wide base suits breeding and keeping invertebrates such as dwarf shrimp and dwarf crayfish",
      "source": 1
    },
    {
      "fact": "The full-size glass cover leaves no space for external filter hoses; Dennerle sells a shorter cover plate that does",
      "source": 0
    },
    {
      "fact": "Sized to sit on an aquarium cabinet or a larger piece of furniture",
      "source": 2
    }
  ],
  "usage": [
    {
      "fact": "The plastic corner holders must be fitted before the glass lid can sit on the tank",
      "source": 7
    },
    {
      "fact": "The insulating safety pad goes under the tank and comes already attached on delivered units",
      "source": 7
    },
    {
      "fact": "Light, filter and heater must be bought and installed separately",
      "source": 2
    }
  ],
  "issues": [
    {
      "fact": "A buyer said the supplied glass cover is too large to use with an external filter",
      "source": 0
    },
    {
      "fact": "One owner found small manufacturing marks and a tiny bubble in a glass corner, which were not visible once the tank was filled",
      "source": 1
    },
    {
      "fact": "Some retailers have stopped carrying the line (Olibetta lists it as no longer sold)",
      "source": 1
    },
    {
      "fact": "Most reviews are positive: neat silicone seams, good packaging and good value",
      "source": 7
    }
