  "fits": [
    {
      "fact": "The B45 is sized for tanks about 45–65 cm long.",
      "source": 0
    },
    {
      "fact": "For 60 cm tanks that are 40 cm or deeper, a retailer suggests adding optional mirror strips to boost output.",
      "source": 1
    },
    {
      "fact": "Vietnamese shops sell the B Series as a budget line and an upgrade on the older Chihiros A series. The RGB LEDs are said to bring out plant and fish colours.",
      "source": 2
    },
    {
      "fact": "Comparison reviews describe the B Series as a low-to-moderate output light. It suits low-demand planted tanks, while dense high-light setups are better served by a WRGB II.",
      "source": 5
    }
  ],
  "usage": [
    {
      "fact": "To install, fit the legs to both ends, rest the light on the tank rim and adjust the legs to hold it. No drilling is needed.",
      "source": 2
    },
    {
      "fact": "After installing, download the My Chihiros app and pair with the light over Bluetooth.",
      "source": 2
    },
    {
      "fact": "The app sets brightness, sunrise and sunset ramps and the photoperiod timer, but it does not change the RGB colour mix.",
      "source": 0
    },
    {
      "fact": "Some versions are dimmed through the separate Commander 1 Bluetooth module, which the app pairs with.",
      "source": 4
    }
  ],
  "issues": [
    {
      "fact": "A B30 owner on the Chihiros forum (Oct 2025) reported a loud high-pitched whine from the Commander 1 dimmer at any brightness between 0% and 100%. The same owner said an interrupted firmware update left another Commander 1 apparently unusable.",
      "source": 3
    },
    {
      "fact": "Versions differ. Some markets sell a non-Bluetooth B45 that needs a separately bought Commander 1 or manual dimmer for dimming, and other retailers bundle the light with Commander 1.",
      "source": 4
    },
    {
      "fact": "Sources disagree slightly on the recommended tank range: one lists 45–65 cm, another 45–60 cm, and one Vietnamese shop gives a 27 W, 45–60 cm figure.",
      "source": 1
    },
    {
      "fact": "Reviews list the absence of RGB colour tuning and the limited output for high-light plants as weaknesses.",
      "source": 5
    }
  ],
  "alternatives": [
    {
      "brand": "Chihiros",
      "model": "A II 451 (45 cm)",
      "why": "White-only Bluetooth light (about 21 W, ~1957 lm) for planted 45 cm tanks. It's a simple step sideways if RGB isn't needed.",
      "source": 6
    },
    {
      "brand": "Chihiros",
      "model": "WRGB II 45",
      "why": "Much stronger, fully tunable RGB. It suits dense, high-light planted tanks with CO2, but costs considerably more.",
      "source": 7
    },
    {
      "brand": "Week Aqua",
      "model": "M450D Pro",
      "why": "Rival RGB+UV app-controlled light (28 W, 1680 lm) for 45–60 cm tanks with similar positioning.",
      "source": 8
    }
  ],
