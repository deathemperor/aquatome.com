  "fits": [
    {
      "fact": "It's made for planted tanks but can go in any freshwater aquarium.",
      "source": 0
    },
    {
      "fact": "It works best as the only substrate, though you can mix it with other gravel.",
      "source": 0
    },
    {
      "fact": "You don't need laterite or other gravel additives with it.",
      "source": 0
    },
    {
      "fact": "A Vietnamese shop lists it as safe for shrimp tanks.",
      "source": 1
    },
    {
      "fact": "It doesn't change pH, so it won't soften water the way active aqua soils do.",
      "source": 2
    }
  ],
  "usage": [
    {
      "fact": "Rinse it before use. It comes pre-washed but gets dusty in transit. Shops suggest one or two rinses.",
      "source": 0
    },
    {
      "fact": "Fill the tank slowly by pouring water into a bowl set on the gravel so it overflows gently.",
      "source": 0
    },
    {
      "fact": "The water starts out cloudy and clears in about 2–12 hours, depending on the filter. Filter floss or Seachem Clarity speeds this up.",
      "source": 1
    },
    {
      "fact": "Rough amount needed: tank length (cm) × width (cm) ÷ 180 = kg. Add more or less to get the depth you want.",
      "source": 2
    },
    {
      "fact": "To add it to a running tank, put in small rinsed batches 12–24 hours apart.",
      "source": 0
    },
    {
      "fact": "Once its nutrients run low, feed plants with root tabs or liquid fertilizer instead of replacing the substrate.",
      "source": 1
    }
  ],
  "issues": [
    {
      "fact": "Some hobbyists still got a very cloudy tank after rinsing, and gravel vacuuming can stir the cloudiness up again.",
      "source": 6
    },
    {
      "fact": "Users say Flourite Red is especially dusty and hard to rinse fully clean.",
      "source": 6
    },
    {
      "fact": "Seachem says heavy rinsing can wash away some fine particles but doesn't hurt how the product works.",
      "source": 0
    },
    {
      "fact": "Prices for the same bag vary a lot between Vietnamese shops (3.5 kg: 290k at ShopThuySinh vs 380k at Greendeal). The Red version costs a little more than the original.",
      "source": 3
    }
  ],
  "alternatives": [
    {
      "brand": "Seachem",
      "model": "Flourite Black",
      "why": "Same clay substrate in a darker color that suits Bucephalandra, Anubias and ferns. Vietnamese shops list it at about 300k for 3.5 kg.",
      "source": 4
    },
    {
      "brand": "ADA",
      "model": "Aqua Soil Amazonia",
      "why": "An active, nutrient-rich aqua soil that lowers pH, which suits demanding plants better. The trade-off is that it leaches ammonia when new, so the tank needs cycling, and the soil breaks down over time unlike Flourite."
    }
  ],
