  "fits": [
    {
      "fact": "Aquasabi says it is made for densely planted freshwater tanks that are left open on top.",
      "source": 0
    },
    {
      "fact": "Aquasabi says it should not run under an aquarium lid.",
      "source": 0
    },
    {
      "fact": "Per Aquasabi support, the stock mount does not fit tanks with 12 mm glass.",
      "source": 0
    },
    {
      "fact": "Aquasabi support says it can also light a paludarium.",
      "source": 0
    },
    {
      "fact": "Each model is sized to the tank length, from 30 cm to 120 cm.",
      "source": 0
    },
    {
      "fact": "A Vietnamese shop says full brightness can handle demanding plants such as Bucephalandra, Rotala and stem plants, and that you can dim it for moss and fern tanks.",
      "source": 3
    },
    {
      "fact": "Another shop says its high-Kelvin white light suits mosses, Anubias and ferns, and supports carpets and stem plants at moderate levels.",
      "source": 1
    }
  ],
  "usage": [
    {
      "fact": "Fit the acrylic legs to both ends of the light, then set it on the tank rim.",
      "source": 1
    },
    {
      "fact": "Connect the power cable and legs fully before plugging the light in.",
      "source": 2
    },
    {
      "fact": "Install the My Chihiros app, turn on Bluetooth and location on the phone, sign in with an email, then pick the light and set the schedule and brightness.",
      "source": 3
    },
    {
      "fact": "The app can set several time slots, brightness levels and a sunrise/sunset ramp.",
      "source": 0
    },
    {
      "fact": "For ceiling or bracket mounting you need a separate hanging kit.",
      "source": 0
    },
    {
      "fact": "The legs tilt but don't extend or raise the light; shops sell riser legs separately.",
      "source": 2
    }
  ],
  "issues": [
    {
      "fact": "Shops list different wattages for the same size (the 60 cm is listed at 22 W, 26 W and 28 W), so quoted specs vary.",
      "source": 5
    },
    {
      "fact": "Some Vietnamese listings give the code 'AII 401' to both the 40 cm and 45 cm models, so check the size before you buy.",
      "source": 2
    },
    {
      "fact": "On the Chihiros forum, a user reports the app sometimes fails to connect after a long idle period; restarting the app fixed it. Another user moved to Home Assistant control instead.",
      "source": 6
    },
    {
      "fact": "Local warranties are short (1 month at one shop, 6 months at another) and exclude drops and water damage.",
      "source": 3
    },
    {
      "fact": "Aquasabi says its lumen figures are lab values and real output may be lower.",
      "source": 0
    },
    {
      "fact": "Compared with the original Chihiros A series, the A II has a built-in Bluetooth controller, so you no longer need a separate controller.",
      "source": 0
    }
  ],
  "alternatives": [
    {
      "brand": "Chihiros",
      "model": "WRGB II",
      "why": "An upgrade with RGB colour control and much higher output (about 67 W and 5,300 lm at 60 cm per Aquasabi), for high-tech tanks or better fish and plant colour. It costs far more. I didn't find a Vietnamese shop price.",
      "source": 7
    },
    {
      "brand": "Chihiros",
      "model": "A II Max",
      "why": "A related Chihiros line aimed at plants with low to moderate light needs, if you don't need the A II's output. I didn't find a Vietnamese shop price.",
      "source": 8
    },
    {
      "brand": "Week Aqua",
      "model": "M Series Pro",
      "why": "A similarly priced app-controlled planted-tank LED (about SGD 120 in Singapore, with a 1-year warranty). I couldn't confirm a Vietnamese shop selling it.",
      "source": 9
    }
  ],
