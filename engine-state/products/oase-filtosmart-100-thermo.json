  "fits": [
    {
      "fact": "Designed for medium aquariums up to about 100 L, freshwater or marine",
      "source": 0
    },
    {
      "fact": "Vietnamese shops pitch the FiltoSmart line for planted tanks and saltwater tanks, citing a compact body with a large filter surface",
      "source": 6
    },
    {
      "fact": "Shrimp Home describes the line as suiting small to medium freshwater and saltwater tanks",
      "source": 4
    },
    {
      "fact": "The heater sits inside the filter, so no heater is needed in the tank, which keeps the display cleaner",
      "source": 3
    },
    {
      "fact": "The small footprint fits in a corner or a cramped cabinet",
      "source": 1
    }
  ],
  "usage": [
    {
      "fact": "Self-priming, so starting it up and restarting after cleaning are simple",
      "source": 3
    },
    {
      "fact": "Shut-off valves on the connections close when you detach it, which limits spills during cleaning",
      "source": 6
    },
    {
      "fact": "The EasyClick lid opens quickly to get at the media",
      "source": 4
    },
    {
      "fact": "Flow can be adjusted at the inlet and outlet",
      "source": 1
    },
    {
      "fact": "Air vents automatically, and there is a valve for adjusting flow",
      "source": 4
    },
    {
      "fact": "The heater's temperature can be set on the unit",
      "source": 1
    },
    {
      "fact": "Comes with all fittings, foams and basic bio media, ready to set up",
      "source": 1
    },
    {
      "fact": "Shrimp Home suggests filming the unboxing of online orders to support warranty claims",
      "source": 4
    }
  ],
  "issues": [
    {
      "fact": "Some buyers say the pump grew louder within days to months, with droning, vibration or a cracking impeller. Most of these complaints are about the Thermo 200, and one is about the Thermo 100",
      "source": 7
    },
    {
      "fact": "Other Thermo 100 owners call it quiet, or about as loud as a typical filter",
      "source": 7
    },
    {
      "fact": "Oase sells region-specific versions: the US unit runs on 120 V / 60 Hz, while GB/INT units run on 230 V. Vietnamese buyers need a 220–230 V version",
      "source": 12
    },
    {
      "fact": "Listings disagree on maximum head height: 1.4 m in one, 1.1 m in another",
      "source": 1
    },
    {
      "fact": "Shrimp Home's warranty is 1 year from receipt, which is shorter than the 3 years foreign retailers advertise",
      "source": 4
    },
    {
      "fact": "The Thermo version was not listed for sale at the Vietnamese shops checked; only the heaterless FiltoSmart was",
      "source": 5
    }
  ],
