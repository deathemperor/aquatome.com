  "fits": [
    {
      "fact": "Each model number roughly matches the maximum tank volume in litres (250 L to about 800 L)",
      "source": 1
    },
    {
      "fact": "The 600 ver2 is listed for tanks under 600 L",
      "source": 2
    },
    {
      "fact": "A reviewer measured roughly 162 GPH with media in the Thermo 250 and suggested it for tanks of about 40–55 gallons, well below the rated size",
      "source": 4
    },
    {
      "fact": "The Thermo version keeps the heater inside the canister, so no heater sits in the tank and fish can't be burned",
      "source": 4
    }
  ],
  "usage": [
    {
      "fact": "Rinse the media before installing; adding seasoned media from an old filter helps keep the cycle going",
      "source": 4
    },
    {
      "fact": "Priming uses a large button on the head; the first prime may need several tries or a reassembly",
      "source": 4
    },
    {
      "fact": "Re-priming after maintenance is easy because the quick-disconnect hoses stay full of water",
      "source": 4
    },
    {
      "fact": "The pre-filter unscrews and can be cleaned on its own without opening the main canister, which protects the main filter wool",
      "source": 0
    },
    {
      "fact": "Rinse sponges only in dechlorinated or tank water to protect the beneficial bacteria",
      "source": 4
    },
    {
      "fact": "The Thermo heater has its own power cord, so you need two power outlets",
      "source": 4
    },
    {
      "fact": "Record a video when unboxing so you can support a warranty claim",
      "source": 0
    }
  ],
  "issues": [
    {
      "fact": "Some owners report air trapped in the canister and trouble priming; one called it a possible design flaw",
      "source": 5
    },
    {
      "fact": "Some units develop an impeller hum after a few months; Oase released a modified head to reduce it, and the 350 and larger models tend to be a bit louder",
      "source": 5
    },
    {
      "fact": "Leaks are usually reported right after maintenance and are mostly traced to a damaged or badly seated main gasket",
      "source": 6
    },
    {
      "fact": "One reviewer measured only about 44.8 dB on a Thermo 250, quieter than a Fluval FX6, which shows that noise varies from unit to unit",
      "source": 4
    },
    {
      "fact": "Pulling the baskets out means reaching into dirty water, and the default biomedia space is limited",
      "source": 4
    },
    {
      "fact": "BioMaster 2 is claimed to have more than 25% higher flow than the previous version",
      "source": 0
    }
  ],
  "alternatives": [
    {
      "brand": "Eheim",
      "model": "Classic 250/350/600",
