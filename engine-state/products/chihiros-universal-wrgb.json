  "fits": [
    {
      "fact": "The IP67 rating means it works under a closed hood or lid, as well as on open tanks.",
      "source": 1
    },
    {
      "fact": "Aquasabi lists it for common hood tanks such as Juwel Rio/Lido/Vision, Eheim Vivaline/Clearscape/Incpiria and Oase Styleline, picking the size by tank length.",
      "source": 1
    },
    {
      "fact": "Aquasabi support says it does not fit Aqualantis tanks.",
      "source": 1
    },
    {
      "fact": "There is no separate spacer for open tanks with glass up to 12 mm thick; the steel brackets are used to sit it on the rim instead.",
      "source": 1
    },
    {
      "fact": "Vũ Aqua describes it as a good choice for fish tanks with air pumps that splash water. Its output is moderate and lower than Chihiros' dedicated planted-tank lights.",
      "source": 2
    },
    {
      "fact": "Several units can be joined to light tanks up to 280 cm long. Support suggested two 700s for a 130 × 60 cm tank.",
      "source": 1
    },
    {
      "fact": "An Australian retailer says the 1200 fits Juwel, Oase, Eheim and AquaOne hoods without any changes.",
      "source": 6
    }
  ],
  "usage": [
    {
      "fact": "Setup: mount the light with the legs or hanging kit, plug it in, install MyChihiros (CH Play/App Store), turn on Bluetooth and location on the phone, then pick the device in the app and set brightness.",
      "source": 0
    },
    {
      "fact": "The app can simulate sunrise and sunset, run on-off schedules and save colour presets.",
      "source": 0
    },
    {
      "fact": "If it falls into the tank, it survives up to 30 minutes at 1 m depth and can be lifted out and used again.",
      "source": 3
    },
    {
      "fact": "Shrimp Home suggests filming the unboxing so you have evidence for a warranty claim.",
      "source": 3
    },
    {
      "fact": "The lumen figures are lab measurements, so real output in the tank may be different.",
      "source": 1
    }
  ],
  "issues": [
    {
      "fact": "Vietnamese shop stock is patchy. Shrimp Home lists every size as out of stock, and Vũ Aqua shows only 'Liên hệ' (contact for price) or out of stock.",
      "source": 3
    },
    {
      "fact": "Published specs disagree: Aquasabi gives two different lengths and tank ranges for the 1000, and Shaquarium lists the 1000 and 1200 with the same length.",
      "source": 1
    },
    {
      "fact": "Some Vietnamese warranties exclude the power supply and any light that is scratched, water-damaged or burnt.",
      "source": 2
    },
    {
      "fact": "This is a general-purpose light. Its output is below the WRGB II line, which is built for planted tanks.",
      "source": 2
    },
    {
      "fact": "Spare parts are sold separately (Bluetooth controller, holder set), so you can replace a lost or broken controller.",
      "source": 7
    }
  ],
  "alternatives": [
    {
      "brand": "Chihiros",
      "model": "WRGB II",
      "why": "Brighter, planted-tank model from the same brand. A better choice for demanding plants with CO2, but it is not IP67 and is not meant to go under a hood.",
      "source": 8
    },
    {
      "brand": "Chihiros",
      "model": "WRGB II Pro",
      "why": "The top Chihiros planted light, with higher output than the Universal, for high-tech aquascapes. It costs more.",
      "source": 9
    },
    {
      "brand": "Chihiros",
      "model": "WRGB (first generation, Bluetooth)",
      "why": "An older, usually cheaper WRGB light that Vietnamese shops still sell, for budget planted tanks without a hood.",
      "source": 10
    }
  ],
