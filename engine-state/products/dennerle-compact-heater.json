  "prices": [],
  "fits": [
    {
      "fact": "The 25 W model suits nano tanks of about 10–30 L, and the 50 W model suits tanks up to about 60 L.",
      "source": 0
    },
    {
      "fact": "The broad, flat heating surface helps keep fish and shrimp from getting burned, so it suits shrimp tanks.",
      "source": 0
    },
    {
      "fact": "Works in both freshwater and marine tanks.",
      "source": 0
    },
    {
      "fact": "For a tank that must stay at 25 °C, Dennerle sells the separate Heater Constant line. It cannot be adjusted.",
      "source": 11
    }
  ],
  "usage": [
    {
      "fact": "Put the heater close to the filter outlet so water keeps flowing past it.",
      "source": 6
    },
    {
      "fact": "The heater must always be fully under water while it is running.",
      "source": 6
    },
    {
      "fact": "If the water isn't warming up, check that it's plugged in and the indicator light is on.",
      "source": 6
    },
    {
      "fact": "Attach it with the two suction cups, either upright or lying flat.",
      "source": 0
    },
    {
      "fact": "Set the temperature electronically anywhere from 20 to 33 °C. The LED shows both the set value and the current water temperature.",
      "source": 0
    }
  ],
  "issues": [
    {
      "fact": "Sources disagree on tank capacity for the 25 W model: one retailer says 10–25 L, others say 10–30 L, and the English manual says up to about 20 L. Choose with some margin.",
      "source": 5
    },
    {
      "fact": "Stated accuracy also varies between listings (±0.5 °C vs ±1 °C), and so does the temperature range (20–33 °C vs 18–36 °C). These may come from different product versions (ThermoCompact vs Heater Compact).",
      "source": 3
    },
    {
      "fact": "Many European retailers list the 25 W and 50 W models as sold out, so supply may be limited.",
      "source": 2
    },
    {
      "fact": "Another retailer also lists the 25 W as out of stock.",
      "source": 9
    }
  ],
