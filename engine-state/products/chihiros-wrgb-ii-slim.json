  "fits": [
    {
      "fact": "The five sizes cover rimless tanks about 30 to 140 cm long. Pick the size that matches the tank length.",
      "source": 3
    },
    {
      "fact": "A shop calls it a cheaper, lower-power option than the regular WRGB 2. It suits tanks whose plants don't need very strong light.",
      "source": 0
    },
    {
      "fact": "The thin fixture is meant for rectangular planted tanks and setups with little room.",
      "source": 1
    },
    {
      "fact": "The Slim has two rows of LEDs, while the regular WRGB II has three. It sits below the WRGB II and the WRGB II Pro in output.",
      "source": 6
    }
  ],
  "usage": [
    {
      "fact": "It sits on the tank rim on its alloy legs. You can hang it instead with a separately sold hanging cable kit.",
      "source": 1
    },
    {
      "fact": "First setup: install the light on its legs or hang it, then power it on. Install the My Chihiros app and register an email, turn on the phone's Bluetooth and location, then choose the light in the app.",
      "source": 2
    },
    {
      "fact": "In the app you can set the on/off schedule, overall intensity and the R/G/B mix.",
      "source": 0
    },
    {
      "fact": "Keep it away from water. One shop's warranty doesn't cover water damage or drops.",
      "source": 2
    }
  ],
  "issues": [
    {
      "fact": "One owner said the light stopped turning on after they came back from a holiday.",
      "source": 4
    },
    {
      "fact": "One owner's Slim 120 suddenly lost its Bluetooth link to the app, so its schedule stopped running. Their other Chihiros lights still connected. Suggested troubleshooting was to close My Chihiros and scan for the light with nRF Connect.",
      "source": 5
    },
    {
      "fact": "Compared with the regular version: fewer LED rows (2 vs 3) and lower output than the WRGB II and WRGB II Pro.",
      "source": 6
    },
    {
      "fact": "Vietnamese shops list very different warranties, from 1 month to 6 months, so check before buying.",
      "source": 2
    },
    {
      "fact": "Stock in Vietnam is patchy. Several shops list most or all sizes as out of stock.",
      "source": 0
    }
  ],
  "alternatives": [
    {
      "brand": "Chihiros",
      "model": "WRGB II (regular / 10th Edition)",
      "why": "The better pick for demanding plants or deeper tanks. It has three LED rows and more output than the Slim, and Vietnamese shops carry it.",
      "source": 6
    },
