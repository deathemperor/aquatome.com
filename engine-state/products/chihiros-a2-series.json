  "fits": [
    {
      "fact": "Pick the model that matches your tank length. Sizes run from 30 to 120 cm.",
      "source": 1
    },
    {
      "fact": "A shop says it suits most aquatic plants and also works for fish and shrimp tanks.",
      "source": 1
    },
    {
      "fact": "A shop says it is about twice as bright as the A1 and can grow carpeting plants such as pearlweed (trân châu).",
      "source": 2
    },
    {
      "fact": "The mounting legs clip onto glass up to 8 mm thick.",
      "source": 4
    },
    {
      "fact": "It isn't designed to be used under a closed lid.",
      "source": 6
    },
    {
      "fact": "If your tank needs more light than the A2 gives, the shop points you to the A2 Max, or above that the WRGB2 Slim.",
      "source": 5
    }
  ],
  "usage": [
    {
      "fact": "Fit the power cord and legs fully before you plug the light in.",
      "source": 1
    },
    {
      "fact": "First setup: install the My Chihiros app, turn on Bluetooth and location, then choose the light from the list of found devices.",
      "source": 1
    },
    {
      "fact": "The legs tilt to change the light's angle, but they can't be lengthened. Riser legs are sold separately.",
      "source": 1
    },
    {
      "fact": "The app lets you set schedules, dimming and sunrise/sunset curves.",
      "source": 4
    },
    {
      "fact": "Clear acrylic legs clamp onto the tank rim.",
      "source": 4
    }
  ],
  "issues": [
    {
      "fact": "Some owners say the app sometimes can't connect over Bluetooth. Restarting the app fixed it for one user. Another said the problem happens with several Chihiros products, including the A2.",
      "source": 7
    },
    {
      "fact": "Shop listings don't fully agree on model names: the 35 cm version appears as both 351 and 361, and one shop labels both the 40 cm and 45 cm units as AII 401. Check the exact model before you buy.",
      "source": 1
    },
    {
      "fact": "One shop calls the AII a 2020 model.",
      "source": 3
    },
    {
      "fact": "Difference between versions: the A2 Max adds a third LED strip and is much stronger (for example, 64 W and 66 LEDs on the 60 cm). It also takes glass up to 12 mm thick and comes with extension legs.",
      "source": 5
    }
  ],
  "alternatives": [
    {
      "brand": "Chihiros",
      "model": "A2 Max",
      "why": "A stronger version with an extra LED strip (64 W on the 60 cm), for tanks with demanding plants. Price is on request at Vua Aqua.",
      "source": 5
    },
    {
      "brand": "Chihiros",
      "model": "WRGB2 / WRGB2 Slim",
      "why": "Sits above the A2 Max and adds RGB colour control. Uses the same app.",
      "source": 5
    },
    {
      "brand": "Chihiros",
      "model": "A series (A1)",
      "why": "The older, cheaper model. The A2 is about twice as bright.",
      "source": 2
    }
  ],
