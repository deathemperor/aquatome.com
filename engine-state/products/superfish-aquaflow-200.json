  "fits": [
    {
      "fact": "Sized for cold-water or tropical freshwater tanks of about 100–200 L",
      "source": 0
    },
    {
      "fact": "The adjustable flow and optional spray bar help soften the current for gentler setups",
      "source": 0
    },
    {
      "fact": "It sits inside the tank on suction cups, so it takes up room in the display. It is not an external canister",
      "source": 0
    }
  ],
  "usage": [
    {
      "fact": "Installs inside the tank with suction cups. Because it is fully submerged, no canister-style priming is needed",
      "source": 0
    },
    {
      "fact": "Cartridges click in and out to make swapping easy",
      "source": 0
    },
    {
      "fact": "The distributor advises replacing the filter cartridge monthly",
      "source": 1
    },
    {
      "fact": "On the 150 and 300 models, the CrystalMax bio media should be replaced once a year",
      "source": 1
    },
    {
      "fact": "A Superfish start-kit manual calls for weekly filter cleaning",
      "source": 2
    }
  ],
  "issues": [
    {
      "fact": "Owner reviews disagree on noise: one says it runs quietly and gets quieter as biofilm coats the moving parts, while another found it very noisy and returned it",
      "source": 3
    },
    {
      "fact": "Replacing whole cartridges every month adds ongoing cost and throws away established bacteria. Spare cartridges must also match the exact model",
      "source": 0
    },
    {
      "fact": "Within the range, the 150 and 300 add CrystalMax bio media but have no spray bar, and the 50 has no flow adjustment",
      "source": 1
    }
  ],
