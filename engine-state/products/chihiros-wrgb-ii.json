  "fits": [
    {
      "fact": "Made for densely planted tanks and plants that need strong light.",
      "source": 0
    },
    {
      "fact": "Must not be used under an aquarium cover or lid. It is meant for open-top tanks.",
      "source": 0
    },
    {
      "fact": "The brackets clamp onto glass up to 10 mm thick (12 mm on the 90/120). Check your glass thickness before buying.",
      "source": 0
    },
    {
      "fact": "The brackets are made to sit on rimless tanks. On rimmed tanks the base can be flipped so it rests flat on the rim.",
      "source": 1
    },
    {
      "fact": "Pick the size by tank length. Each model covers a set range, from 30–45 cm up to 120–140 cm.",
      "source": 1
    },
    {
      "fact": "A Vietnamese seller says its colour range brings out red and purple plants.",
      "source": 3
    }
  ],
  "usage": [
    {
      "fact": "The box has the light bar, a power supply and stainless steel brackets. A hanging cable kit and a glare shade are sold separately.",
      "source": 0
    },
    {
      "fact": "There is no printed manual. A PDF manual and Chihiros' YouTube videos cover setup and the app.",
      "source": 0
    },
    {
      "fact": "Pair the light with the My Chihiros app over Bluetooth to set colour channels and the daily schedule. No external timer is needed.",
      "source": 0
    },
    {
      "fact": "The app can mix colours by setting the brightness of each channel.",
      "source": 4
    },
    {
      "fact": "Thủy Sinh 4U says to open the box when it arrives. Defective units can be returned within 3 days.",
      "source": 3
    }
  ],
  "issues": [
    {
      "fact": "Some owners report the light stops showing up in the app. One WRGB II Slim stopped turning on altogether.",
      "source": 7
    },
    {
      "fact": "On Android, the first connection after a few hours can fail until the app is force-stopped. Forum replies blame the phone's background or permission settings.",
      "source": 8
    },
    {
      "fact": "App Store reviews say automatic schedules may not resume after a power cut, and the Bluetooth link is unreliable.",
      "source": 10
    },
    {
      "fact": "Lumen figures differ between sources (lab values vs. manual values). Aquasabi says the manual's lower figures are more realistic.",
      "source": 0
    },
    {
      "fact": "The WRGB II is now made only as the 10th Anniversary Edition. Older stock won't be restocked once it sells out.",
      "source": 1
    },
    {
      "fact": "The Slim version is about 40–50% less bright than the standard WRGB II.",
      "source": 9
    },
    {
      "fact": "Many Vietnamese shops list the light as out of stock. Some shop pages have typos (e.g. 60 cm shown as 33 W or 55 W instead of 67 W).",
      "source": 2
    },
    {
      "fact": "Aquasabi buyers rate it 4.3/5 overall, with a few 1–2 star ratings.",
      "source": 0
    }
  ],
  "alternatives": [
    {
      "brand": "Chihiros",
      "model": "WRGB II Slim",
      "why": "A cheaper, thinner version with the same app control. It is sold in Vietnam (Slim 30 about 1.53M VND) but gives about half the light, so it suits easier plants.",
      "source": 5
    },
    {
