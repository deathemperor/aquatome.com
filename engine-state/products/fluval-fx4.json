  "fits": [
    {
      "fact": "Sized for large tanks, from about 400 L up to 1000 L.",
      "source": 0
    },
    {
      "fact": "Can be used on both freshwater and marine tanks.",
      "source": 5
    },
    {
      "fact": "Some owners found the supplied hoses don't fit certain acrylic tanks, so check before buying.",
      "source": 5
    },
    {
      "fact": "Tanks smaller than 750 L can use the FX2, and tanks up to 1500 L call for the FX6.",
      "source": 1
    },
    {
      "fact": "One owner runs it on a 125-gallon brackish tank.",
      "source": 7
    }
  ],
  "usage": [
    {
      "fact": "After assembling and connecting the hoses, fill the tank and plug the filter in. The Smart Pump primes itself, so no manual priming is needed.",
      "source": 6
    },
    {
      "fact": "On first start the pump runs for about a minute to fill the canister. After that it stops for one minute every 12 hours to purge trapped air.",
      "source": 6
    },
    {
      "fact": "Drain the canister before routine maintenance. A drain/utility valve at the base also helps with water changes.",
      "source": 3
    },
    {
      "fact": "The reviewer found it rarely clogs and needs little maintenance, but said the lid can be hard to remove.",
      "source": 5
    },
    {
      "fact": "If it gets noisy or flow drops, clean the impeller chamber and check it for debris.",
      "source": 8
    }
  ],
  "issues": [
    {
      "fact": "One owner had a vibrating noise that stopped only after closing the outlet valve about halfway, which costs flow.",
      "source": 7
    },
    {
      "fact": "A roughly two-year-old unit began pulsing and drawing water weakly even after cleaning. Others suspected an unbalanced impeller and pointed to the 3-year warranty.",
      "source": 8
    },
    {
      "fact": "The reviewer called it quiet and well built, but noted the high price and that media needs topping up often.",
      "source": 5
    },
    {
      "fact": "Sources disagree on dimensions (36×36×42 vs 40×40×42 cm).",
      "source": 1
    },
    {
      "fact": "Sources disagree on warranty: a UK retailer lists 2 years, while Vietnamese and US sellers list 3.",
      "source": 12
    }
  ],
